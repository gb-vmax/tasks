+async function getAllStoreKeys(store) {
+  const keys = [];
+  const maxKeys = 10000;
+  
+  for (let i = 0; i < maxKeys; i++) {
+    try {
+      const key = await store.key(i);
+      if (key === null) break;
+      keys.push(key);
+    } catch (err) {
+      break;
+    }
+  }
+  
+  return keys;
+}
+
+function matchesPattern(key, pattern) {
+  if (!pattern || pattern === '*') return true;
+  
+  const regex = new RegExp(
+    pattern
+      .split('*')
+      .map(s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
+      .join('.*'),
+    'i'
+  );
+  
+  return regex.test(key);
+}
+
