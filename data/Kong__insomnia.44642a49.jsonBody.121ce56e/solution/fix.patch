+const isPathSelector = (obj: object): boolean => {
+    return '$path' in obj && '$value' in obj;
+};
+
+const getValueByPath = (obj: any, path: string): any => {
+    const pathParts = path.split('.');
+    let current = obj;
+    
+    for (const part of pathParts) {
+        const arrayMatch = part.match(/^(.+?)\[(\d+)\]$/);
+        
+        if (arrayMatch) {
+            const [, key, index] = arrayMatch;
+            current = current[key];
+            if (!Array.isArray(current)) {
+                throw Error(`Path "${path}": "${key}" is not an array`);
+            }
+            current = current[parseInt(index, 10)];
+        } else {
+            if (current === null || current === undefined) {
+                throw Error(`Path "${path}": cannot access property "${part}" of ${current}`);
+            }
+            current = current[part];
+        }
+        
+        if (current === undefined) {
+            throw Error(`Path "${path}": property "${part}" does not exist`);
+        }
+    }
+    
+    return current;
+};
+
+ jsonBody: (expected: object) => {
