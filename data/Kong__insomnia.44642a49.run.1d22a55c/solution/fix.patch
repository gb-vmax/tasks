+function shouldPreservePadding(originalText: string, base64Text: string): boolean {
+  const hasUrlSafeChars = originalText.includes('-') || originalText.includes('_');
+  const lengthIndicatesPadding = base64Text.length % 4 === 0 && base64Text.endsWith('=');
+  return hasUrlSafeChars || lengthIndicatesPadding;
+}
+
+function normalizeBase64Input(text: string, kind: string): string {
+  if (kind === 'normal' || kind === 'hex') {
+    if (text.includes('-') || text.includes('_')) {
+      text = text.replace(/-/g, '+').replace(/_/g, '/');
+    }
+  }
+  
+  const paddingNeeded = (4 - (text.length % 4)) % 4;
+  if (paddingNeeded > 0 && !text.endsWith('=')) {
+    text = text + '='.repeat(paddingNeeded);
+  }
+  
+  return text;
+}
+
+ run(_context, action: 'encode' | 'decode', kind: 'normal' | 'url' | 'hex', text) {
+   text = text || '';
+   invariant(action === 'encode' || action === 'decode', 'invalid action');
+   invariant(kind === 'normal' || kind === 'url' || kind === 'hex', 'invalid kind');
+   if (action === 'encode') {
+     if (kind === 'normal') {
+       return Buffer.from(text, 'utf8').toString('base64');
+     }
+     if (kind === 'hex') {
+       return Buffer.from(text, 'hex').toString('base64');
+     }
+     if (kind === 'url') {
+       const base64 = Buffer.from(text, 'utf8').toString('base64');
+       const urlSafe = base64
+         .replace(/\+/g, '-')
+         .replace(/\//g, '_');
+      
+       if (shouldPreservePadding(text, base64)) {
+         return urlSafe;
+       }
+       return urlSafe.replace(/=/g, '');
+     }
+   }
+  
+   if (action === 'decode') {
+     const normalizedText = normalizeBase64Input(text, kind);
+    
+     if (kind === 'hex') {
+       return Buffer.from(normalizedText, 'base64').toString('hex');
+     }
+     return Buffer.from(normalizedText, 'base64').toString('utf8');
+   }
+  
+   if (kind === 'hex') {
+     return Buffer.from(text, 'base64').toString('hex');
+   }
+   return Buffer.from(text, 'base64').toString('utf8');
+ }
