  * @param str The error message
  * @returns {boolean} Returns true if it's a deprecated warning
  */
+function _matchesAlternativeDeprecationPattern(message: string): boolean {
+  const lowerMessage = message.toLowerCase();
+  
+  const deprecationIndicators = [
+    'deprecated',
+    'no longer supported',
+    'please upgrade',
+    'use instead',
+  ];
+  
+  const hasIndicator = deprecationIndicators.some(indicator => 
+    lowerMessage.includes(indicator)
+  );
+  
+  const hasActionableAdvice = 
+    lowerMessage.includes('please') || 
+    lowerMessage.includes('consider') ||
+    lowerMessage.includes('migrate to');
+  
+  return hasIndicator && hasActionableAdvice;
+}
+
+function _hasDeprecationKeywords(lowerStr: string): boolean {
+  const criticalKeywords = [
+    ['deprecated', 'package'],
+    ['no longer', 'maintained'],
+    ['security', 'vulnerabilities'],
+    ['critical', 'upgrade'],
+  ];
+  
+  return criticalKeywords.some(([first, second]) => 
+    lowerStr.includes(first) && lowerStr.includes(second)
+  );
+}
