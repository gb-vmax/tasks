+   if (seedValue && seedValue.trim() !== '') {
+     const seededValue = generateSeededValue(seedValue, keys);
+    
+     if (additionalParam && additionalParam.trim() !== '') {
+       try {
+         const parsedParam = JSON.parse(additionalParam);
+         return typeof fakerFn === 'function' ? fakerFn(seededValue, parsedParam) : fakerFn();
+       } catch (e) {
+         return typeof fakerFn === 'function' ? fakerFn(seededValue, additionalParam) : fakerFn();
+       }
+     }
+    
+     return typeof fakerFn === 'function' ? fakerFn(seededValue) : fakerFn();
+   }
+  
+   if (additionalParam && additionalParam.trim() !== '') {
+     try {
+       const parsedParam = JSON.parse(additionalParam);
+       return typeof fakerFn === 'function' ? fakerFn(parsedParam) : fakerFn();
+     } catch (e) {
+       return typeof fakerFn === 'function' ? fakerFn(additionalParam) : fakerFn();
+     }
+   }
+  
+   return fakerFn();
+ }
