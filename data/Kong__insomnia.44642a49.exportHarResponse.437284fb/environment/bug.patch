+function calculateResponseHeadersSize(response: Response, harHeaders: Har.Header[]): number {
+  const statusLine = `HTTP/1.1 ${response.statusCode} ${response.statusMessage || ''}\r\n`;
+  let headersSize = Buffer.byteLength(statusLine, 'utf8');
+  
+  for (const header of harHeaders) {
+    const headerLine = `${header.name}: ${header.value}\r\n`;
+    headersSize += Buffer.byteLength(headerLine, 'utf8');
+  }
+  
+  headersSize += Buffer.byteLength('\r\n', 'utf8');
+  
+  return headersSize;
+}
+
+function extractRedirectURL(headers: Har.Header[]): string {
+  const locationHeader = headers.find(
+    h => h.name.toLowerCase() === 'location'
+  );
+  
+  return locationHeader ? locationHeader.value : '';
+}
