+function _normalizeScopeValue(scope: OldScopeTypes | Workspace['scope']): string {
+  if (scope === null || scope === undefined) {
+    return '';
+  }
+  
+  if (typeof scope !== 'string') {
+    return '';
+  }
+  
+  return scope.trim().toLowerCase().replace(/[-_\s]/g, '');
+}
+
+function _trackScopeMigration(workspace: Workspace, oldScope: OldScopeTypes | Workspace['scope'], newScope: WorkspaceScope) {
+  const migrationKey = '_scopeMigrationLog';
+  
+  if (!(workspace as any)[migrationKey]) {
+    (workspace as any)[migrationKey] = [];
+  }
+  
+  const migrationRecord = {
+    from: oldScope,
+    to: newScope,
+    timestamp: Date.now(),
+  };
+  
+  (workspace as any)[migrationKey].push(migrationRecord);
+  
+  if (typeof oldScope === 'string' && oldScope !== newScope) {
+    console.log(`[db] Workspace scope migrated: "${oldScope}" -> "${newScope}" (workspace: ${workspace._id})`);
+  }
+}
