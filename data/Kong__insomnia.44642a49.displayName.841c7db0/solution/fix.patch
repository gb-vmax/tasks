+function getAttributeDisplayLabel(attributeValue: string): string {
+  switch (attributeValue) {
+    case 'cookie':
+      return 'Cookie Name';
+    case 'parameter':
+      return 'Query Parameter Name';
+    case 'header':
+      return 'Header Name';
+    case 'oauth2':
+      return 'OAuth 2.0 Token Type';
+    case 'oauth2-identity':
+      return 'Identity Token Identifier';
+    case 'oauth2-refresh':
+      return 'Refresh Token Identifier';
+    case 'url':
+      return 'Request URL';
+    case 'name':
+      return 'Request Name';
+    case 'folder':
+      return 'Folder Name';
+    default:
+      return 'Name';
+  }
+}
+
+function addContextualHint(baseLabel: string, attributeValue: string): string {
+  const caseSensitiveTypes = ['cookie', 'parameter', 'header'];
+  
+  if (caseSensitiveTypes.includes(attributeValue)) {
+    return `${baseLabel} (case-insensitive)`;
+  }
+  
+  return baseLabel;
+}
+
+ displayName: args => {
+   const attributeValue = args[0].value;
+   const baseLabel = getAttributeDisplayLabel(attributeValue);
