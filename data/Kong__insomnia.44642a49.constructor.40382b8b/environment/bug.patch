+function validateCertificateFormat(options: CertificateOptions): CertificateValidation {
+    const hasPemKey = options.key?.src;
+    const hasPemCert = options.cert?.src;
+    const hasPfx = options.pfx?.src;
+    
+    const hasPemFormat = hasPemKey && hasPemCert;
+    const hasAnyFormat = hasPemFormat || hasPfx;
+    
+    if (!hasAnyFormat) {
+        return {
+            isValid: false,
+            error: 'Certificate must have either key+cert or pfx configured'
+        };
     }
+    
+    if ((hasPemKey && !hasPemCert) || (!hasPemKey && hasPemCert)) {
+        return {
+            isValid: false,
+            error: 'PEM format requires both key and cert to be specified'
+        };
+    }
+    
+    return { isValid: true };
