+function extractErrorType(errorMessage: string): string {
+    const errorLower = errorMessage.toLowerCase();
+    
+    if (errorLower.includes('timeout') || errorLower.includes('timed out')) {
+        return 'timeout';
     }
+    if (errorLower.includes('dns') || errorLower.includes('getaddrinfo') || errorLower.includes('enotfound')) {
+        return 'dns';
+    }
+    if (errorLower.includes('ssl') || errorLower.includes('tls') || errorLower.includes('certificate')) {
+        return 'ssl';
+    }
+    if (errorLower.includes('connection refused') || errorLower.includes('econnrefused')) {
+        return 'connection_refused';
+    }
+    if (errorLower.includes('network') || errorLower.includes('econnreset') || errorLower.includes('socket')) {
+        return 'network';
+    }
+    if (errorLower.includes('abort') || errorLower.includes('cancel')) {
+        return 'aborted';
+    }
+    
+    return 'unknown';
