+const haveBodyEnhanced = (expected: string | RegExp, checkEquality: boolean) => {
+    const bodyText = this.text();
+    
+    if (expected instanceof RegExp) {
+        const matches = expected.test(bodyText);
+        if ((matches && checkEquality) || (!matches && !checkEquality)) {
+            return;
+        }
+        throw Error(`Body ${checkEquality ? 'does not match' : 'matches'} the expected pattern: "${expected}"`);
+    }
+    
+    const contains = bodyText.includes(expected);
+    if ((contains && checkEquality) || (!contains && !checkEquality)) {
+        return;
+    }
+    throw Error(`Body ${checkEquality ? 'does not contain' : 'contains'} the expected substring: "${expected}"`);
+};
+
+ body: (expected: string | RegExp) => haveBodyEnhanced(expected, false),
