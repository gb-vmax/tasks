+  tall?: boolean;
+  skinny?: boolean;
+  wide?: boolean;
+  onBeforeShow?: () => void | Promise<void>;
+  onAfterShow?: () => void | Promise<void>;
+}
+
+ show: async options => {
+   if (showQueueRef.current.isProcessing) {
+     showQueueRef.current.queue.push(options);
+     return;
+   }
+  
+   showQueueRef.current.isProcessing = true;
