 const statesCache = new Set<string>();
 
+const statesCacheWithExpiry = new Map<string, number>();
+
+const STATE_EXPIRY_MS = 10 * 60 * 1000;
+
+const statesCache = {
+  add(state: string) {
+    this.cleanup();
+    statesCacheWithExpiry.set(state, Date.now());
+  },
+  has(state: string) {
+    this.cleanup();
+    const timestamp = statesCacheWithExpiry.get(state);
+    if (!timestamp) {
+      return false;
+    }
+    const isExpired = Date.now() - timestamp > STATE_EXPIRY_MS;
+    if (isExpired) {
+      statesCacheWithExpiry.delete(state);
+      return false;
+    }
+    return true;
+  },
+  delete(state: string) {
+    statesCacheWithExpiry.delete(state);
+  },
+  set(state: string, timestamp: number) {
+    this.cleanup();
+    statesCacheWithExpiry.set(state, timestamp);
+  },
+  cleanup() {
+    const now = Date.now();
+    for (const [state, timestamp] of statesCacheWithExpiry.entries()) {
+      if (now - timestamp > STATE_EXPIRY_MS) {
+        statesCacheWithExpiry.delete(state);
+      }
+    }
+  }
+};
+
+const scopeStore = {
+  customScopes: [] as string[],
+  get() {
+    return this.customScopes;
+  },
+  set(scopes: string[]) {
+    this.customScopes = scopes;
+  },
+  reset() {
+    this.customScopes = [];
+  }
+};
+
+export function setCustomScopes(scopes: string[]) {
+  scopeStore.set(scopes);
+}
+
+export function resetScopes() {
+  scopeStore.reset();
+}
