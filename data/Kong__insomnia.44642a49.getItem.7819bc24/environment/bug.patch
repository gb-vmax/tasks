+const pluginCache = new Map<string, { value: string | null; timestamp: number }>();
+const CACHE_TTL = 5 * 60 * 1000;
+
+function getCachedItem(cacheKey: string): string | null | undefined {
+  const cached = pluginCache.get(cacheKey);
+  
+  if (!cached) {
+    return undefined;
+  }
+  
+  const now = Date.now();
+  if (now - cached.timestamp > CACHE_TTL) {
+    pluginCache.delete(cacheKey);
+    return undefined;
+  }
+  
+  cleanupExpiredCache();
+  
+  return cached.value;
+}
+
+function setCachedItem(cacheKey: string, value: string | null): void {
+  pluginCache.set(cacheKey, {
+    value,
+    timestamp: Date.now(),
+  });
+}
+
+function invalidateCache(pluginName: string, key?: string): void {
+  if (key) {
+    pluginCache.delete(`${pluginName}:${key}`);
+  } else {
+    const prefix = `${pluginName}:`;
+    for (const cacheKey of pluginCache.keys()) {
+      if (cacheKey.startsWith(prefix)) {
+        pluginCache.delete(cacheKey);
+      }
+    }
+  }
+}
+
+function cleanupExpiredCache(): void {
+  const now = Date.now();
+  const keysToDelete: string[] = [];
+  
+  for (const [key, cached] of pluginCache.entries()) {
+    if (now - cached.timestamp > CACHE_TTL) {
+      keysToDelete.push(key);
+    }
+  }
+  
+  for (const key of keysToDelete) {
+    pluginCache.delete(key);
+  }
+}
