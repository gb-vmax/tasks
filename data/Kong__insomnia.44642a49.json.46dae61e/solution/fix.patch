+function extractJsonPath(obj: any, path: string): any {
+    const segments = path.split('.');
+    let current = obj;
+    
+    for (const segment of segments) {
+        if (current == null) {
+            throw Error(`json: path '${path}' traversal failed - encountered null/undefined at '${segment}'`);
+        }
+        
+        const arrayMatch = segment.match(/^([^\[]+)\[(\d+)\]$/);
+        if (arrayMatch) {
+            const key = arrayMatch[1];
+            const index = parseInt(arrayMatch[2], 10);
+            
+            if (!(key in current)) {
+                throw Error(`json: path '${path}' - property '${key}' not found`);
+            }
+            current = current[key];
+            
+            if (!Array.isArray(current)) {
+                throw Error(`json: path '${path}' - '${key}' is not an array`);
+            }
+            if (index < 0 || index >= current.length) {
+                throw Error(`json: path '${path}' - array index ${index} out of bounds`);
+            }
+            current = current[index];
+        } else {
+            if (!(segment in current)) {
+                throw Error(`json: path '${path}' - property '${segment}' not found`);
+            }
+            current = current[segment];
         }
     }
+    
+    return current;
+}
+
+ json(reviver?: (key: string, value: any) => any | string, _strict?: boolean) {
+     if (_strict) {
+         const contentType = this.headers.find(header => header.key.toLowerCase() === 'content-type');
+         if (contentType) {
+             const mimeType = contentType.valueOf().split(';')[0].trim().toLowerCase();
+             if (!mimeType.includes('json')) {
+                 throw Error(`json: strict mode enabled but Content-Type is '${mimeType}', expected JSON`);
+             }
+         } else {
+             throw Error('json: strict mode enabled but Content-Type header is missing');
+         }
+     }
+
+     try {
+         const parsed = JSON.parse(this.body.toString(), typeof reviver === 'function' ? reviver : undefined);
+        
+         if (typeof reviver === 'string' && reviver.length > 0) {
+             return extractJsonPath(parsed, reviver);
+         }
+        
+         return parsed;
+     } catch (e) {
+         throw Error(`json: failed to parse: ${e}`);
+     }
+ }
 
