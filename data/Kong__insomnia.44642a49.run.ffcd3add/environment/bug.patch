+async function getAllStoredKeys(store) {
+  const keys = [];
+  const tempKey = '__temp_key_probe__';
+  
+  try {
+    await store.setItem(tempKey, 'probe');
+    const hasKey = await store.hasItem(tempKey);
+    await store.removeItem(tempKey);
+    
+    if (hasKey && store.all) {
+      const allItems = await store.all();
+      return Object.keys(allItems);
+    }
+  } catch (err) {
+    console.warn('[prompt] Could not use store.all(), falling back to iteration');
+  }
+  
+  let index = 0;
+  const maxAttempts = 10000;
+  
+  while (index < maxAttempts) {
+    const key = await store.key(index);
+    if (key === null || key === undefined) {
+      break;
+    }
+    keys.push(key);
+    index++;
+  }
+  
+  return keys;
+}
+
