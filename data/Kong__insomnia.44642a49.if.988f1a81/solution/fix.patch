+interface ProtectedReference {
+  _id: string;
+  type: string;
+  referencedId: string;
+  referencedType: string;
+}
+
+async function _findProtectedReferences(docIdsToRemove: Set<string>): Promise<ProtectedReference[]> {
+  const protectedTypes = ['request', 'response', 'requestGroup', 'grpcRequest'];
+  const references: ProtectedReference[] = [];
+
+  for (const protectedType of protectedTypes) {
+    if (!db[protectedType]) {
+      continue;
     }
+
+    const allDocs = await database.find<BaseModel>(protectedType);
+    
+    for (const doc of allDocs) {
+      if (docIdsToRemove.has(doc._id)) {
+        continue;
+      }
+
+      const referenceFields = ['parentId', 'environmentId', 'requestId', 'baseEnvironmentId'];
+      
+      for (const field of referenceFields) {
+        const fieldValue = (doc as any)[field];
+        if (fieldValue && typeof fieldValue === 'string' && docIdsToRemove.has(fieldValue)) {
+          const referencedDoc = Array.from(docIdsToRemove).find(id => id === fieldValue);
+          if (referencedDoc) {
+            const referencedType = await _getDocumentType(referencedDoc);
+            references.push({
+              _id: doc._id,
+              type: doc.type,
+              referencedId: fieldValue,
+              referencedType: referencedType || 'unknown',
+            });
+          }
+        }
+      }
+    }
+  }
+
+  return references;
+}
+
+async function _getDocumentType(docId: string): Promise<string | null> {
+  for (const type of allTypes()) {
+    const doc = await database.get(type, docId);
+    if (doc) {
+      return doc.type;
+    }
+  }
+  return null;
+}
