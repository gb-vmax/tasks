+const applyWorkspaceFilters = (
+  workspaces: Workspace[],
+  options: {
+    filterByType?: string;
+    filterByModifiedAfter?: number;
+  }
+): Workspace[] => {
+  let filtered = workspaces;
+
+  if (options.filterByType) {
+    filtered = filtered.filter(ws => ws.scope === options.filterByType);
+  }
+
+  if (options.filterByModifiedAfter) {
+    filtered = filtered.filter(ws => ws.modified >= options.filterByModifiedAfter);
+  }
+
+  return filtered;
+};
+
+const sortWorkspaces = (
+  workspaces: Workspace[],
+  sortBy?: 'name' | 'modified' | 'created',
+  sortOrder: 'asc' | 'desc' = 'asc'
+): Workspace[] => {
+  if (!sortBy) {
+    return workspaces;
+  }
+
+  const sorted = [...workspaces].sort((a, b) => {
+    let compareValue = 0;
+
+    switch (sortBy) {
+      case 'name':
+        compareValue = (a.name || '').localeCompare(b.name || '');
+        break;
+      case 'modified':
+        compareValue = a.modified - b.modified;
+        break;
+      case 'created':
+        compareValue = a.created - b.created;
+        break;
+    }
+
+    return sortOrder === 'asc' ? compareValue : -compareValue;
+  });
+
+  return sorted;
+};
