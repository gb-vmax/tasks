+const _templateCache = new Map<string, { result: any; timestamp: number; context: string }>();
+const CACHE_MAX_SIZE = 100;
+const CACHE_DEFAULT_TTL = 5000;
+
+function _getCacheKey(template: string, context: any): string {
+  try {
+    const contextStr = JSON.stringify({
+      vars: context.ctx || {},
+      purpose: context.getPurpose ? context.getPurpose() : null,
+    });
+    return `${template}:${contextStr}`;
+  } catch {
+    return template;
+  }
+}
+
+function _cleanExpiredCache(ttl: number): void {
+  const now = Date.now();
+  const keysToDelete: string[] = [];
+  
+  for (const [key, entry] of _templateCache.entries()) {
+    if (now - entry.timestamp > ttl) {
+      keysToDelete.push(key);
+    }
+  }
+  
+  keysToDelete.forEach(key => _templateCache.delete(key));
+  
+  if (_templateCache.size > CACHE_MAX_SIZE) {
+    const entries = Array.from(_templateCache.entries());
+    entries.sort((a, b) => a[1].timestamp - b[1].timestamp);
+    const toRemove = entries.slice(0, entries.length - CACHE_MAX_SIZE);
+    toRemove.forEach(([key]) => _templateCache.delete(key));
+  }
+}
