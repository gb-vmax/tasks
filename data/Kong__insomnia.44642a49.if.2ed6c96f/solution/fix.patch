+     return null;
+   }
+
+   const cacheKey = `${type}:${id}`;
+   const cached = _getCachedDoc<T>(cacheKey);
+  
+   if (cached !== undefined) {
+     return cached;
+   }
+
+   const doc = await database.getWhere<T>(type, { _id: id });
+   _setCachedDoc(cacheKey, doc);
+  
+   return doc;
+ }
 
