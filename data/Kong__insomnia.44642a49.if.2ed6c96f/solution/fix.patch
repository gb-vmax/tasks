+interface CacheEntry<T> {
+  value: T | null;
+  timestamp: number;
+}
+
+const docCache = new Map<string, CacheEntry<any>>();
+const cacheAccessOrder: string[] = [];
+const MAX_CACHE_SIZE = 1000;
+let cacheInvalidationListenerRegistered = false;
+
+function _getCachedDoc<T extends BaseModel>(key: string): T | null | undefined {
+  const entry = docCache.get(key);
+  
+  if (!entry) {
+    return undefined;
+  }
+
+  const index = cacheAccessOrder.indexOf(key);
+  if (index > -1) {
+    cacheAccessOrder.splice(index, 1);
+  }
+  cacheAccessOrder.push(key);
+  
+  return entry.value;
+}
+
+function _setCachedDoc<T extends BaseModel>(key: string, doc: T | null): void {
+  if (!cacheInvalidationListenerRegistered) {
+    database.onChange(_handleCacheInvalidation);
+    cacheInvalidationListenerRegistered = true;
+  }
+
+  docCache.set(key, {
+    value: doc,
+    timestamp: Date.now(),
+  });
+  
+  const index = cacheAccessOrder.indexOf(key);
+  if (index > -1) {
+    cacheAccessOrder.splice(index, 1);
+  }
+  cacheAccessOrder.push(key);
+
+  if (docCache.size > MAX_CACHE_SIZE) {
+    const oldestKey = cacheAccessOrder.shift();
+    if (oldestKey) {
+      docCache.delete(oldestKey);
     }
+  }
+}
+
+function _handleCacheInvalidation(changes: ChangeBufferEvent[]): void {
+  for (const [event, doc] of changes) {
+    if (event === 'update' || event === 'remove') {
+      const cacheKey = `${doc.type}:${doc._id}`;
+      docCache.delete(cacheKey);
+      
+      const index = cacheAccessOrder.indexOf(cacheKey);
+      if (index > -1) {
+        cacheAccessOrder.splice(index, 1);
+      }
+    }
+  }
+}
