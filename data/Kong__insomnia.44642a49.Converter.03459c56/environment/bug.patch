+    return {
+      _type: 'environment',
+      _id: envId,
+      parentId: parentId,
+      name: `${schemeName} environment`,
+      data: {
+        base_path: basePath,
+        scheme: scheme,
+        host: host,
+      },
+    };
+  });
+};
