+const extractSecurityVariables = (
+  securityDefinitions?: OpenAPIV2.SecurityDefinitionsObject,
+): Record<string, string> => {
+  if (!securityDefinitions) {
+    return {};
+  }
+
+  const variables: Record<string, string> = {};
+
+  for (const [defName, securityScheme] of Object.entries(securityDefinitions)) {
+    if (securityScheme.type === 'basic') {
+      variables.username = '';
+      variables.password = '';
+    }
+
+    if (securityScheme.type === 'apiKey') {
+      variables.api_key = '';
+    }
+
+    if (securityScheme.type === 'oauth2') {
+      variables.client_id = '';
+      variables.client_secret = '';
+      
+      if (securityScheme.flow === 'password') {
+        variables.username = '';
+        variables.password = '';
+      }
+    }
+  }
+
+  return variables;
+};
+
+const generateSchemeEnvironments = (
+  parentId: string,
+  host: string,
+  basePath: string,
