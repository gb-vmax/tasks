+async function _validateUpdate<T extends BaseModel>(doc: T): Promise<void> {
+  const m: Record<string, any> | null = models.getModel(doc.type);
+  
+  if (!m) {
+    return;
+  }
+  
+  if (typeof m.hookValidateUpdate === 'function') {
+    const validationResult = await m.hookValidateUpdate(doc);
+    
+    if (validationResult === false) {
+      throw new Error(`Validation failed for ${doc.type} ${doc._id}`);
+    }
+    
+    if (validationResult && typeof validationResult === 'object' && validationResult.valid === false) {
+      throw new Error(validationResult.message || `Validation failed for ${doc.type} ${doc._id}`);
     }
+  }
