+private _calculateProxyPriority(proxyConfig: ProxyConfig): number {
+    let priority = 0;
+    
+    const match = proxyConfig.match;
+    const protocolEnd = match.indexOf('://');
+    if (protocolEnd === -1) {
+        return priority;
+    }
+    
+    const protocols = match.substring(0, protocolEnd).split('+');
+    priority += (3 - protocols.length) * 100;
+    
+    const pathPart = match.substring(protocolEnd + 3);
+    const pathSegments = pathPart.split('/').filter(seg => seg.length > 0);
+    priority += pathSegments.length * 10;
+    
+    const wildcardCount = (match.match(/\*/g) || []).length;
+    priority -= wildcardCount * 5;
+    
+    const hasPortInMatch = pathPart.includes(':');
+    if (hasPortInMatch) {
+        priority += 15;
+    }
+    
+    return priority;
+}
