+  existingHints.forEach(hint => {
+    if (hint && hint.trim() && uniqueHints.size < 15) {
+      uniqueHints.add(hint.trim());
+    }
+  });
+  
+  return Array.from(uniqueHints).slice(0, 15);
+};
