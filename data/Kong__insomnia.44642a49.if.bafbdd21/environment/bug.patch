+    const normalized = new Set<number>();
+    
+    for (const idx of indices) {
+        const normalizedIdx = idx < 0 ? this.list.length + idx : idx;
+        if (normalizedIdx >= 0 && normalizedIdx < this.list.length) {
+            normalized.add(normalizedIdx);
+        }
+    }
+    
+    return normalized;
+}
