+_dialogStateHistory: Array<{
+  id: string;
+  state: string;
+  timestamp: number;
+  metadata?: any;
+}> = [];
+
+_trackDialogState(dialogId: string, state: string, metadata?: any) {
+  this._dialogStateHistory.push({
+    id: dialogId,
+    state,
+    timestamp: Date.now(),
+    metadata,
+  });
+  
+  if (this._dialogStateHistory.length > 100) {
+    this._dialogStateHistory.shift();
+  }
+}
+
+_generateFallbackSavePath(options: ShowDialogOptions): string | null {
+  if (options.defaultPath) {
+    const timestamp = new Date().toISOString().replace(/[:.]/g, '-').split('T')[0];
+    const pathParts = options.defaultPath.split(/[/\\]/);
+    const filename = pathParts[pathParts.length - 1];
+    const nameWithoutExt = filename.replace(/\.[^.]+$/, '');
+    const ext = filename.includes('.') ? filename.substring(filename.lastIndexOf('.')) : '';
+    
+    return options.defaultPath.replace(filename, `${nameWithoutExt}-${timestamp}${ext}`);
+  }
+  
+  return null;
+}
+
