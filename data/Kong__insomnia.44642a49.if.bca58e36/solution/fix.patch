+private static _hasCircularReference(obj: object, seen = new WeakSet()): boolean {
+    if (obj === null || typeof obj !== 'object') {
+        return false;
+    }
+
+    if (seen.has(obj)) {
+        return true;
+    }
+
+    seen.add(obj);
+
+    for (const key of Object.keys(obj)) {
+        const value = (obj as Record<string, any>)[key];
+        if (value !== null && typeof value === 'object') {
+            if (Property._hasCircularReference(value, seen)) {
+                return true;
+            }
         }
+    }
+
+    return false;
+}
+
+private static _sanitizeVariableObject(obj: object): object {
+    const sanitized: Record<string, any> = {};
+
+    for (const [key, value] of Object.entries(obj)) {
+        if (typeof value === 'function' || typeof value === 'symbol' || typeof value === 'undefined') {
+            continue;
+        }
+
+        if (value !== null && typeof value === 'object') {
+            if (Array.isArray(value)) {
+                sanitized[key] = value.map(item => {
+                    if (item !== null && typeof item === 'object' && !Array.isArray(item)) {
+                        return Property._sanitizeVariableObject(item);
+                    }
+                    return item;
+                });
+            } else {
+                sanitized[key] = Property._sanitizeVariableObject(value);
+            }
+        } else {
+            sanitized[key] = value;
+        }
+    }
+
+    return sanitized;
+}
+
+ static replaceSubstitutions(content: string, ...variables: object[]): string {
+     if (!Array.isArray(variables) || typeof content !== 'string') {
+         throw Error("replaceSubstitutions: the first param's type is not string or other parameters are not an array");
+     }
+
+     if (content.length > 10000000) {
+         throw Error("replaceSubstitutions: content string exceeds maximum allowed size of 10MB");
+     }
+
+     for (let i = 0; i < variables.length; i++) {
+         const variable = variables[i];
+         if (typeof variable !== 'object' || variable === null) {
+             throw Error(`replaceSubstitutions: variable at index ${i} is not a valid object`);
+         }
+
+         if (Property._hasCircularReference(variable)) {
+             throw Error(`replaceSubstitutions: variable at index ${i} contains circular references`);
+         }
+
+         variables[i] = Property._sanitizeVariableObject(variable);
+     }
+
+     let context: object = {};
+     variables.reverse().forEach(variable => context = { ...context, ...variable });
+
+     return getInterpolator().render(content, context);
+ }
 
