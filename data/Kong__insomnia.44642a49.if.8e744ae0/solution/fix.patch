+function detectDuplicateKeys(state: SnapshotState): boolean {
+  if (!state || state.length === 0) {
+    return false;
+  }
+
+  const seenKeys = new Set<string>();
+  
+  for (const entry of state) {
+    if (seenKeys.has(entry.key)) {
