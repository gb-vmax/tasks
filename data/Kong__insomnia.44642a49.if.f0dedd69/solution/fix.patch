+const WORKSPACE_CACHE_TTL = 5000;
+
+const workspaceCache = new Map<string, { data: Workspace[]; timestamp: number }>();
+
+ const getWorkspaces = (activeProjectId?: string, options?: { scope?: string; bypassCache?: boolean }) => {
+   const cacheKey = `${activeProjectId || 'all'}_${options?.scope || 'all'}`;
+   const now = Date.now();
+  
+   if (!options?.bypassCache && workspaceCache.has(cacheKey)) {
+     const cached = workspaceCache.get(cacheKey)!;
+     if (now - cached.timestamp < WORKSPACE_CACHE_TTL) {
+       return Promise.resolve(cached.data);
+     } else {
+       workspaceCache.delete(cacheKey);
+     }
+   }
+
+   const fetchWorkspaces = async () => {
+     let workspaces;
+     if (activeProjectId) {
+       workspaces = await models.workspace.findByParentId(activeProjectId);
+     } else {
+       workspaces = await models.workspace.all();
+     }
+
+     if (options?.scope) {
+       workspaces = workspaces.filter(ws => ws.scope === options.scope);
+     }
+
+     workspaceCache.set(cacheKey, { data: workspaces, timestamp: now });
+     return workspaces;
+   };
+
+   return fetchWorkspaces();
+ };
