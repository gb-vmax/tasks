+function applyFakerTransformation(value: string, transform: string, param?: string): string {
+  switch (transform.toLowerCase()) {
+    case 'uppercase':
+      return value.toUpperCase();
+    case 'lowercase':
+      return value.toLowerCase();
+    case 'trim':
+      return value.trim();
+    case 'substring':
+      if (param) {
+        const parts = param.split(',').map(p => parseInt(p.trim(), 10));
+        if (parts.length === 1 && !isNaN(parts[0])) {
+          return value.substring(parts[0]);
+        } else if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
+          return value.substring(parts[0], parts[1]);
+        }
+      }
+      return value;
+    case 'replace':
+      if (param) {
+        const parts = param.split('|');
+        if (parts.length === 2) {
+          return value.replace(new RegExp(parts[0], 'g'), parts[1]);
+        }
+      }
+      return value;
+    default:
+      return value;
+  }
+}
+
+ run(_context, keys: keyof typeof fakerFunctions, argsJson?: string, transform?: string, transformParam?: string) {
+   let result = fakerFunctions[keys]();
+  
+   if (argsJson) {
+     try {
+       const parsedArgs = JSON.parse(argsJson);
+       if (Array.isArray(parsedArgs)) {
+         result = fakerFunctions[keys](...parsedArgs);
+       } else {
+         result = fakerFunctions[keys](parsedArgs);
+       }
+     } catch (err) {
+       result = fakerFunctions[keys]();
+     }
+   }
+  
+   if (transform && typeof result === 'string') {
+     result = applyFakerTransformation(result, transform, transformParam);
+   }
+  
+   return result;
+ }
