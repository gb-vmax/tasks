+ removeQueryParams(params: QueryParam[] | string[] | string, options?: { matchValue?: boolean; includeDisabled?: boolean; valuePattern?: string }) {
+     const matchValue = options?.matchValue ?? false;
+     const includeDisabled = options?.includeDisabled ?? true;
+     const valuePattern = options?.valuePattern;
+
+     if (typeof params === 'string') {
+         this.query = new PropertyList(
+             QueryParam,
+             undefined,
+             this.query.filter(queryParam => {
+                 if (!includeDisabled && this.isParamDisabled(queryParam)) {
+                     return true;
+                 }
+                 if (valuePattern) {
+                     return !(queryParam.key === params && this.matchesValuePattern(queryParam.value, valuePattern));
+                 }
+                 return queryParam.key !== params;
+             }, {})
+         );
+     } else if (params.length > 0) {
+         let toBeRemoved: Set<string> | Map<string, Set<string>>;
+
+         if (typeof params[0] === 'string') {
+             toBeRemoved = new Set(params as string[]);
+             this.query = new PropertyList(
+                 QueryParam,
+                 undefined,
+                 this.query.filter(queryParam => {
+                     if (!includeDisabled && this.isParamDisabled(queryParam)) {
+                         return true;
+                     }
+                     if (valuePattern) {
+                         return !((toBeRemoved as Set<string>).has(queryParam.key) && this.matchesValuePattern(queryParam.value, valuePattern));
+                     }
+                     return !(toBeRemoved as Set<string>).has(queryParam.key);
+                 }, {})
+             );
+         } else {
+             const queryParams = params as QueryParam[];
+            
+             if (matchValue) {
+                 toBeRemoved = new Map<string, Set<string>>();
+                 queryParams.forEach(param => {
+                     if (!toBeRemoved.has(param.key)) {
+                         (toBeRemoved as Map<string, Set<string>>).set(param.key, new Set());
+                     }
+                     (toBeRemoved as Map<string, Set<string>>).get(param.key)!.add(param.value);
+                 });
+
+                 this.query = new PropertyList(
+                     QueryParam,
+                     undefined,
+                     this.query.filter(queryParam => {
+                         if (!includeDisabled && this.isParamDisabled(queryParam)) {
+                             return true;
+                         }
+                         const valueSet = (toBeRemoved as Map<string, Set<string>>).get(queryParam.key);
+                         if (!valueSet) {
+                             return true;
+                         }
+                         return !valueSet.has(queryParam.value);
+                     }, {})
+                 );
+             } else {
+                 toBeRemoved = new Set(queryParams.map(param => param.key));
+                 this.query = new PropertyList(
+                     QueryParam,
+                     undefined,
+                     this.query.filter(queryParam => {
+                         if (!includeDisabled && this.isParamDisabled(queryParam)) {
+                             return true;
+                         }
+                         return !(toBeRemoved as Set<string>).has(queryParam.key);
+                     }, {})
+                 );
+             }
+         }
