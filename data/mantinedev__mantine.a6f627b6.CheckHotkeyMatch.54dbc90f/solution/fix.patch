@@ -13,6 +13,51 @@ export type Hotkey = KeyboardModifiers & {
 
 type CheckHotkeyMatch = (event: KeyboardEvent) => boolean;
 
+export function parseHotkey(hotkey: string): {
+  key: string;
+  modifiers: Set<string>;
+} {
+  const parts = hotkey.toLowerCase().split('+').map(p => p.trim());
+  const key = parts[parts.length - 1];
+  const modifiers = new Set(parts.slice(0, -1));
+  
+  return { key, modifiers };
+}
+
+export function isHotkeyMatch(
+  hotkey: string,
+  event: KeyboardEvent
+): boolean {
+  const { key, modifiers } = parseHotkey(hotkey);
+  
+  const eventKey = event.key.toLowerCase();
+  
+  if (!key.includes(eventKey)) {
+    return false;
+  }
+  
+  const eventModifiers = new Set<string>();
+  if (event.ctrlKey || event.metaKey) eventModifiers.add('ctrl');
+  if (event.altKey) eventModifiers.add('alt');
+  if (event.shiftKey) eventModifiers.add('shift');
+  
+  if (eventModifiers.size !== modifiers.size) {
+    return false;
+  }
+  
+  for (const mod of eventModifiers) {
+    if (!modifiers.has(mod)) {
+      return false;
+    }
+  }
+  
+  return true;
+}
+
+export function createHotkeyMatcher(hotkey: string): CheckHotkeyMatch {
+  return (event: KeyboardEvent) => isHotkeyMatch(hotkey, event);
+}
