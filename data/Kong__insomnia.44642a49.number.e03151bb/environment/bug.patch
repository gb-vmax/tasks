+       : (minimum !== undefined ? minimum : undefined);
+    
+     const effectiveMax = exclusiveMaximum !== undefined
+       ? (typeof exclusiveMaximum === 'boolean' ? (maximum || 0) : exclusiveMaximum)
+       : (maximum !== undefined ? maximum : undefined);
+    
+     const adjustedMin = exclusiveMinimum === true || (typeof exclusiveMinimum === 'number')
+       ? (effectiveMin !== undefined ? effectiveMin + (multipleOf || 1) : undefined)
+       : effectiveMin;
+    
+     const adjustedMax = exclusiveMaximum === true || (typeof exclusiveMaximum === 'number')
+       ? (effectiveMax !== undefined ? effectiveMax - (multipleOf || 1) : undefined)
+       : effectiveMax;
+    
+     return generateConstrainedNumber(adjustedMin, adjustedMax, multipleOf);
+   }
+   return 0;
+ },
