+const validateCollectionStructure = (collection: PostmanCollection): string[] => {
+  const warnings: string[] = [];
+  
+  if (!collection.info || !collection.info.name) {
+    warnings.push('Collection is missing a name');
+  }
+  
+  if (!collection.item || collection.item.length === 0) {
+    warnings.push('Collection contains no items');
+  }
+  
+  const checkItemsForIssues = (items: PostmanCollection['item'], path = 'root') => {
+    if (!items) return;
+    
+    items.forEach((item, index) => {
+      const itemPath = `${path}[${index}]`;
+      
+      if (Object.prototype.hasOwnProperty.call(item, 'request')) {
+        const requestItem = item as Item;
+        if (typeof requestItem.request === 'object') {
+          if (!requestItem.request.url) {
+            warnings.push(`Request at ${itemPath} is missing URL`);
+          }
+          
+          if (requestItem.request.auth && requestItem.request.auth.type === 'noauth') {
+            warnings.push(`Request at ${itemPath} uses deprecated 'noauth' type`);
+          }
+        }
+      } else if (item.item) {
+        checkItemsForIssues(item.item as PostmanCollection['item'], itemPath);
+      }
+    });
+  };
+  
+  checkItemsForIssues(collection.item);
+  
+  if (collection.auth && (collection.auth as any).type === 'noauth') {
+    warnings.push('Collection uses deprecated authentication type');
+  }
+  
+  return warnings;
+};
+
+const migrateDeprecatedFields = (collection: PostmanCollection): PostmanCollection => {
+  const migrated = { ...collection };
+  
+  if (migrated.variable && Array.isArray(migrated.variable)) {
+    migrated.variable = migrated.variable.map((v: any) => {
+      if (v.id && !v.key) {
+        return { ...v, key: v.id };
+      }
+      if (v.value === null || v.value === undefined) {
+        return { ...v, value: '' };
+      }
+      return v;
+    });
+  }
+  
+  const migrateItems = (items: PostmanCollection['item']): PostmanCollection['item'] => {
+    if (!items) return items;
+    
+    return items.map(item => {
+      const migratedItem = { ...item };
+      
+      if (Object.prototype.hasOwnProperty.call(migratedItem, 'request')) {
+        const requestItem = migratedItem as Item;
+        if (typeof requestItem.request === 'object') {
+          const req = { ...requestItem.request };
+          
+          if (typeof req.url === 'string' && req.url.includes('{{') && req.url.includes('}}')) {
+            const normalizedUrl = req.url.replace(/\{\{([^}]+)\}\}/g, (match, varName) => {
+              const trimmed = varName.trim();
+              return `{{${trimmed}}}`;
+            });
+            req.url = normalizedUrl;
+          }
+          
+          if (req.auth && (req.auth as any).type === 'noauth') {
+            req.auth = undefined;
+          }
+          
+          migratedItem.request = req;
+        }
+        return migratedItem;
+      } else if (migratedItem.item) {
+        return {
+          ...migratedItem,
+          item: migrateItems(migratedItem.item as PostmanCollection['item']),
+        };
+      }
+      
+      return migratedItem;
+    });
+  };
+  
+  migrated.item = migrateItems(migrated.item);
+  
+  if (migrated.auth && (migrated.auth as any).type === 'noauth') {
+    migrated.auth = undefined;
+  }
+  
+  return migrated;
+};
