+_convertWildcardToRegex(pattern: string): RegExp {
+  const escaped = pattern.replace(/[.+?^${}()|[\]\\]/g, '\\$&');
+  const regexPattern = escaped.replace(/\*/g, '.*');
+  return new RegExp(`^${regexPattern}$`);
+}
+
+ async removeItem(key: string) {
+   const keyStr = String(key);
+  
+   if (keyStr.includes('*')) {
+     let deletedCount = 0;
+     const pattern = this._convertWildcardToRegex(keyStr);
+    
+     for (const dbKey of Object.keys(this._db)) {
+       if (pattern.test(dbKey)) {
+         delete this._db[dbKey];
+         deletedCount++;
+       }
+     }
+    
+     return deletedCount;
+   } else {
+     const exists = this._db[keyStr] instanceof Buffer;
+     delete this._db[keyStr];
+     return exists ? 1 : 0;
+   }
+ }
 
