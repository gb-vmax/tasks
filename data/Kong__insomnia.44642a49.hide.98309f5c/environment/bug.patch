+const supportsIndexing = (attributeValue: string): boolean => {
+  return ['folder', 'header', 'parameter'].includes(attributeValue);
+};
+
+const hasArrayNotation = (nameValue: string): boolean => {
+  if (!nameValue) return false;
+  return /\[\d*\]|\[\*\]/.test(nameValue);
+};
+
+const shouldShowIndexField = (args: any[]): boolean => {
+  if (!args || args.length === 0) return false;
+  
+  const attributeValue = args[0]?.value;
+  if (!attributeValue) return false;
+  
+  if (attributeValue === 'folder') {
+    return true;
+  }
+  
+  if ((attributeValue === 'header' || attributeValue === 'parameter') && args.length > 1) {
+    const nameValue = args[1]?.value;
+    return hasArrayNotation(nameValue);
+  }
+  
+  return false;
+};
+
+ hide: args => !shouldShowIndexField(args),
           displayName: 'Parent Index',
           help: 'Specify an index (Starting at 0) for how high up the folder tree to look',
           type: 'number',
