+private _selectProxyProtocol(protocols: string[]): string {
+    if (protocols.length === 1) {
+        const proto = protocols[0].toLowerCase();
+        if (proto === 'https') {
+            return 'https';
+        } else if (proto === 'socks' || proto === 'socks5') {
+            return 'socks5';
+        } else if (proto === 'socks4') {
+            return 'socks4';
         }
+    }
+    return 'http';
+}
+
+private _encodeCredential(credential: string): string {
+    return encodeURIComponent(credential);
+}
+
+ getProxyUrl(): string {
+     const protocols = this.getProtocols();
+     const protocol = this._selectProxyProtocol(protocols);
+    
+     if (this.authenticate) {
+         const encodedUsername = this._encodeCredential(this.username);
+         const encodedPassword = this._encodeCredential(this.password);
+         return `${protocol}://${encodedUsername}:${encodedPassword}@${this.host}:${this.port}`;
+     }
+     return `${protocol}://${this.host}:${this.port}`;
+ }
         return `${this.host}:${this.port}`;
     }
 
