+const generateNumericExample = (schema: OpenAPIV3.SchemaObject): number => {
+  const minimum = schema.minimum;
+  const maximum = schema.maximum;
+  const exclusiveMinimum = schema.exclusiveMinimum;
+  const exclusiveMaximum = schema.exclusiveMaximum;
+  const multipleOf = schema.multipleOf;
+
+  let lowerBound = typeof minimum === 'number' ? minimum : (typeof exclusiveMinimum === 'number' ? exclusiveMinimum : -Infinity);
+  let upperBound = typeof maximum === 'number' ? maximum : (typeof exclusiveMaximum === 'number' ? exclusiveMaximum : Infinity);
+
+  if (typeof exclusiveMinimum === 'number') {
+    lowerBound = exclusiveMinimum;
+    if (multipleOf) {
+      lowerBound = Math.ceil((exclusiveMinimum + Number.EPSILON) / multipleOf) * multipleOf;
+    } else {
+      lowerBound = exclusiveMinimum + 1;
+    }
+  }
+
+  if (typeof exclusiveMaximum === 'number') {
+    upperBound = exclusiveMaximum;
+    if (multipleOf) {
+      upperBound = Math.floor((exclusiveMaximum - Number.EPSILON) / multipleOf) * multipleOf;
+    } else {
+      upperBound = exclusiveMaximum - 1;
+    }
+  }
+
+  if (lowerBound === -Infinity && upperBound === Infinity) {
+    return multipleOf ? multipleOf : 0;
+  }
+
+  if (lowerBound === -Infinity) {
+    const candidate = upperBound - 1;
+    if (multipleOf) {
+      return Math.floor(candidate / multipleOf) * multipleOf;
+    }
+    return candidate;
+  }
+
+  if (upperBound === Infinity) {
+    const candidate = lowerBound + 1;
+    if (multipleOf) {
+      return Math.ceil(candidate / multipleOf) * multipleOf;
+    }
+    return candidate;
+  }
+
+  let midpoint = (lowerBound + upperBound) / 2;
+
+  if (multipleOf) {
+    midpoint = Math.round(midpoint / multipleOf) * multipleOf;
+    if (midpoint < lowerBound) {
+      midpoint = Math.ceil(lowerBound / multipleOf) * multipleOf;
+    }
+    if (midpoint > upperBound) {
+      midpoint = Math.floor(upperBound / multipleOf) * multipleOf;
+    }
+  }
+
+  return midpoint;
+};
+
+ number: (schema: OpenAPIV3.SchemaObject) => generateNumericExample(schema),
     number_float: () => 0.0,
