+function generateConflictMessage(mineBlob: string | null, theirsBlob: string | null, name: string): string {
+  if (mineBlob && theirsBlob) {
+    return `Conflict: Both branches modified '${name}'`;
+  }
+  
+  if (!mineBlob && theirsBlob) {
+    return `Conflict: '${name}' was deleted in current branch but modified in incoming branch`;
+  }
+  
+  if (mineBlob && !theirsBlob) {
+    return `Conflict: '${name}' was modified in current branch but deleted in incoming branch`;
+  }
+  
+  return `Conflict: Both branches added '${name}' with different content`;
+}
+
+ message: function() {
+   const mineBlob = this.mineBlob?.() || null;
+   const theirsBlob = this.theirsBlob?.() || null;
+   const name = this.name?.() || 'resource';
+  
+   return generateConflictMessage(mineBlob, theirsBlob, name);
+ }
   name: () => 'name',
 };
 
