+function resolveHotkeyConflicts(registry: Settings['hotKeyRegistry']): Settings['hotKeyRegistry'] {
+  const resolvedRegistry = { ...registry };
+  const keyComboToAction = new Map<string, KeyboardShortcut>();
+  const conflicts = new Set<KeyboardShortcut>();
+  
+  for (const action of Object.keys(resolvedRegistry) as KeyboardShortcut[]) {
