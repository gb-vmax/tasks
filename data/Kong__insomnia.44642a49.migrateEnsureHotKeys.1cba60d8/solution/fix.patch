+function isValidHotkeyValue(value: any): boolean {
+  if (typeof value !== 'string') {
+    return false;
+  }
+  
+  const trimmed = value.trim();
+  if (trimmed.length === 0) {
+    return false;
+  }
+  
+  return true;
+}
