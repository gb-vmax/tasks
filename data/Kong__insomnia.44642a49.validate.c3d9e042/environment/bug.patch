+const hasProblematicCharacters = (str: string): boolean => {
+  const controlCharPattern = /[\x00-\x1F\x7F]/;
+  if (controlCharPattern.test(str)) {
+    return true;
+  }
+  
+  const problematicChars = /[<>:"|?*\\/]/;
+  if (problematicChars.test(str)) {
+    return true;
+  }
+  
+  if (str !== str.trim()) {
+    return true;
+  }
+  
+  return false;
+};
+
+ validate: v => {
