+
+const uniqueFieldsByType: Record<string, string[]> = {
+  'Environment': ['parentId', 'name'],
+  'Request': ['parentId', 'name'],
+  'RequestGroup': ['parentId', 'name'],
+  'Workspace': ['name'],
+  'CookieJar': ['parentId'],
+  'ApiSpec': ['parentId'],
+};
+
+async function _checkForDuplicate<T extends BaseModel>(doc: T): Promise<T | null> {
+  const uniqueFields = uniqueFieldsByType[doc.type];
+  
+  if (!uniqueFields || uniqueFields.length === 0) {
+    return null;
+  }
+  
+  const query: Query<T> = {
+    _id: { $ne: doc._id } as any,
+  };
+  
+  for (const field of uniqueFields) {
+    if (doc[field] !== undefined) {
+      query[field] = doc[field];
     }
+  }
+  
+  const existingDocs = await database.find<T>(doc.type, query);
+  return existingDocs.length > 0 ? existingDocs[0] : null;
+}
