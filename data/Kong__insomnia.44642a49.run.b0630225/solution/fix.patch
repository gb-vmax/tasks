+ {
+   templateTag: {
+     name: 'file',
+     displayName: 'File',
+     description: 'read contents from a file',
+     args: [
+       {
+         displayName: 'Choose File',
+         type: 'file',
+       },
+       {
+         displayName: 'Encoding',
+         type: 'enum',
+         options: [
+           { displayName: 'UTF-8 Text', value: 'utf8' },
+           { displayName: 'Base64', value: 'base64' },
+           { displayName: 'Hexadecimal', value: 'hex' },
+           { displayName: 'Binary/Latin1', value: 'binary' },
+         ],
+         defaultValue: 'utf8',
+       },
+       {
+         displayName: 'Max Size (MB)',
+         type: 'number',
+         help: 'Maximum file size to read in megabytes. Set to 0 for no limit.',
+         defaultValue: 10,
+       },
+     ],
+     run(_context, path, encoding = 'utf8', maxSizeMB = 10) {
+       if (!path) {
+         throw new Error('No file selected');
+       }
+
+       if (!fs.existsSync(path)) {
+         throw new Error(`File not found: ${path}`);
+       }
+
+       const stats = fs.statSync(path);
+      
+       if (maxSizeMB > 0) {
+         const maxSizeBytes = maxSizeMB * 1024 * 1024;
+         if (stats.size > maxSizeBytes) {
+           throw new Error(
+             `File size (${(stats.size / 1024 / 1024).toFixed(2)} MB) exceeds maximum allowed size (${maxSizeMB} MB)`
+           );
+         }
+       }
+
+       const validEncodings = ['utf8', 'base64', 'hex', 'binary'];
+       if (!validEncodings.includes(encoding)) {
+         throw new Error(`Invalid encoding "${encoding}". Choices are ${validEncodings.join(', ')}`);
+       }
+
+       if (encoding === 'utf8') {
+         return fs.readFileSync(path, 'utf8');
+       } else if (encoding === 'binary') {
+         return fs.readFileSync(path, 'latin1');
