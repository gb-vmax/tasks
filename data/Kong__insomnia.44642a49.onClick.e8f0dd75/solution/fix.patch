 export interface AsyncButtonProps<T> extends ButtonProps {
+const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+
+interface AsyncButtonPropsExtended<T> extends ButtonProps {
   onClick: (event: React.MouseEvent<HTMLButtonElement>) => Promise<T> | undefined;
   loadingNode?: ReactNode;
+  onSuccess?: (result: T) => void;
+  onError?: (error: Error) => void;
+  timeout?: number;
+  retryAttempts?: number;
+  retryDelay?: number;
+}
+
+const AsyncButtonExtended = <T, >({
+  onClick,
+  disabled,
+  loadingNode,
+  children,
+  onSuccess,
+  onError,
+  timeout,
+  retryAttempts = 0,
+  retryDelay = 1000,
+  ...props
+}: AsyncButtonPropsExtended<T>) => {
+  const [loading, setLoading] = useState(false);
+  
+  const executeWithTimeout = useCallback(async (promise: Promise<T>, timeoutMs: number): Promise<T> => {
+    return Promise.race([
+      promise,
+      new Promise<T>((_, reject) =>
+        setTimeout(() => reject(new Error('Operation timed out')), timeoutMs)
+      ),
+    ]);
+  }, []);
+
+  const executeWithRetry = useCallback(async (
+    fn: () => Promise<T>,
+    attempts: number,
+    delay: number
+  ): Promise<T> => {
+    let lastError: Error | undefined;
+    
+    for (let attempt = 0; attempt <= attempts; attempt++) {
+      try {
+        return await fn();
+      } catch (error) {
+        lastError = error instanceof Error ? error : new Error(String(error));
+        
+        if (attempt < attempts) {
+          await sleep(delay * Math.pow(2, attempt));
+        }
+      }
+    }
+    
+    throw lastError;
+  }, []);
+
+  const asyncHandler = useCallback(async (event: MouseEvent<HTMLButtonElement>) => {
+    const result = onClick(event);
+
+    if (isPromise(result)) {
+      try {
+        setLoading(true);
+        
+        const executeOperation = async () => {
+          let promise = result;
+          
+          if (timeout && timeout > 0) {
+            promise = executeWithTimeout(promise, timeout);
+          }
+          
+          return await promise;
+        };
+        
+        let finalResult: T;
+        
+        if (retryAttempts > 0) {
+          finalResult = await executeWithRetry(executeOperation, retryAttempts, retryDelay);
+        } else {
+          finalResult = await executeOperation();
+        }
+        
+        if (onSuccess) {
+          onSuccess(finalResult);
+        }
+      } catch (error) {
+        if (onError) {
+          onError(error instanceof Error ? error : new Error(String(error)));
+        }
+      } finally {
+        setLoading(false);
+      }
+    }
+  }, [onClick, onSuccess, onError, timeout, retryAttempts, retryDelay, executeWithTimeout, executeWithRetry]);
+
+  return (
+    <Button
+      {...props}
+      onClick={asyncHandler}
+      disabled={loading || disabled}
+    >
+      {(loading && loadingNode) || children}
+    </Button>
+  );
+};
+
+ onClick: (event: React.MouseEvent<HTMLButtonElement>) => Promise<T> | undefined;
+  loadingNode?: ReactNode;
 }
 
