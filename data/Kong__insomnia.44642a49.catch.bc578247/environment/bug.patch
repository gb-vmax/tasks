+function createCircularReplacer(seen: WeakSet<any>) {
+  return function(key: string, value: any): any {
+    if (value === null) {
+      return value;
     }
 
+    if (typeof value === 'bigint') {
+      return value.toString() + 'n';
+    }
+
+    if (typeof value === 'function') {
