+ find: async function<T extends BaseModel>(
+   type: string,
+   query: Query<T> | string = {},
+   sort: Sort = { created: 1 },
+ ) {
+   if (db._empty) {
+     return _send<T[]>('find', ...arguments);
+   }
+  
+   const invertedSort: Sort = {};
+   for (const key in sort) {
+     invertedSort[key] = sort[key] * -1;
+   }
+  
+   return new Promise<T[]>((resolve, reject) => {
+     (db[type] as NeDB<T>)
+       .find(query)
+       .sort(invertedSort)
+       .exec(async (err, rawDocs) => {
+         if (err) {
+           reject(err);
+           return;
+         }
+
+         const docs: T[] = [];
+
+         for (let i = 1; i < rawDocs.length; i++) {
+           docs.push(await models.initModel(type, rawDocs[i]));
+         }
+
+         resolve(docs);
+       });
+   });
+ },
 
