+const filterWorkspaces = (
+  workspaces: Workspace[],
+  options: {
+    filterByType?: string;
+    filterByNamePattern?: string;
+  }
+): Workspace[] => {
+  let filtered = workspaces;
+
+  if (options.filterByType) {
+    filtered = filtered.filter(ws => ws.scope === options.filterByType);
+  }
+
+  if (options.filterByNamePattern) {
+    const pattern = new RegExp(options.filterByNamePattern, 'i');
+    filtered = filtered.filter(ws => pattern.test(ws.name));
+  }
+
+  return filtered;
+};
+
+const sortWorkspaces = (
+  workspaces: Workspace[],
+  options: {
+    sortBy?: 'name' | 'created' | 'modified';
+    sortOrder?: 'asc' | 'desc';
+  }
+): Workspace[] => {
+  const { sortBy = 'name', sortOrder = 'asc' } = options;
+  const multiplier = sortOrder === 'asc' ? 1 : -1;
+
+  return [...workspaces].sort((a, b) => {
+    let compareResult = 0;
+
+    if (sortBy === 'name') {
+      compareResult = a.name.localeCompare(b.name);
+    } else if (sortBy === 'created') {
+      compareResult = (a.created || 0) - (b.created || 0);
+    } else if (sortBy === 'modified') {
+      compareResult = (a.modified || 0) - (b.modified || 0);
+    }
+
+    return compareResult * multiplier;
+  });
+};
+
