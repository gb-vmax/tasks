+ commaOrSpaceSeparated: () => {
+   const commaOrSpaceSeparated = (input) => {
+     if (typeof input !== 'string') {
+       return [];
+     }
+    
+     const trimmed = input.trim();
+     if (!trimmed) {
+       return [];
+     }
+    
+     if (/^[,\s]*$/.test(input)) {
+       return [];
+     }
+    
+     return trimmed
+       .split(/[,\s]/)
+       .map(item => item)
+       .filter(item => item.trim() !== '')
+       .map(item => item.trim());
+   };
+  
+   return commaOrSpaceSeparated;
+ }
