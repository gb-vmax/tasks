+const generateConstrainedFloat = (schema: OpenAPIV3.SchemaObject): number => {
+  const { minimum, maximum, exclusiveMinimum, exclusiveMaximum, multipleOf } = schema;
+  
+  let min = typeof minimum === 'number' ? minimum : null;
+  let max = typeof maximum === 'number' ? maximum : null;
+  
+  if (typeof exclusiveMinimum === 'number') {
+    min = exclusiveMinimum + Number.EPSILON;
+  } else if (typeof exclusiveMinimum === 'boolean' && exclusiveMinimum && min !== null) {
+    min = min + Number.EPSILON;
+  }
+  
+  if (typeof exclusiveMaximum === 'number') {
+    max = exclusiveMaximum - Number.EPSILON;
+  } else if (typeof exclusiveMaximum === 'boolean' && exclusiveMaximum && max !== null) {
+    max = max - Number.EPSILON;
+  }
+  
+  if (multipleOf && typeof multipleOf === 'number') {
+    if (min !== null && max !== null) {
+      const midpoint = (min + max) / 2;
+      const multiple = Math.round(midpoint / multipleOf) * multipleOf;
+      if (multiple >= min && multiple <= max) {
+        return multiple;
+      }
+      return Math.ceil(min / multipleOf) * multipleOf;
+    } else if (min !== null) {
+      return Math.ceil(min / multipleOf) * multipleOf;
+    } else if (max !== null) {
+      return Math.floor(max / multipleOf) * multipleOf;
+    }
+    return multipleOf;
+  }
+  
+  if (min !== null && max !== null) {
+    return (min + max) / 2;
+  }
+  
+  if (min !== null) {
+    return min + 1.0;
+  }
+  
+  if (max !== null) {
+    return max - 1.0;
+  }
+  
+  return 0.0;
+};
