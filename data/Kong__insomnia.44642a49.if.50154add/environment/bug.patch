+function sanitizePatchForDuplication<T extends object>(patch: Partial<T>): Partial<T> {
+  const readOnlyFields = ['_id', 'created', 'modified', 'parentId'];
+  const sanitized = { ...patch };
+  
+  for (const field of readOnlyFields) {
+    if (field in sanitized) {
+      delete sanitized[field as keyof typeof sanitized];
+    }
   }
+  
+  return sanitized;
+}
+
