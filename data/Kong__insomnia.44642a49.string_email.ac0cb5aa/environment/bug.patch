+const deriveEmailUsername = (schema?: OpenAPIV3.SchemaObject): string => {
+  if (!schema || typeof schema !== 'object') {
+    return 'user';
+  }
+
+  const title = schema.title || '';
+  const description = schema.description || '';
+  
+  const emailPattern = /\b(admin|user|contact|support|info|sales|billing|customer|account|email|mail)\b/i;
+  
+  const titleMatch = title.match(emailPattern);
+  if (titleMatch) {
+    return titleMatch[1].toLowerCase();
+  }
+  
+  const descMatch = description.match(emailPattern);
+  if (descMatch) {
+    return descMatch[1].toLowerCase();
+  }
+  
+  return 'user';
+};
+
+ string_email: (schema?: OpenAPIV3.SchemaObject) => {
+   const domain = (schema && typeof schema === 'object' && 'x-example-domain' in schema)
+     ? schema['x-example-domain']
+     : 'example.com';
+  
+   const username = deriveEmailUsername(schema);
+  
+   return `${username}@${domain}`;
+ }
