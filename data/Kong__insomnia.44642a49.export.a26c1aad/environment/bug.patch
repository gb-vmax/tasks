   [key in EnvVar['key']]: EnvVar['value'];
 };
 
+const resolveVariableReferences = (data: Data): Data => {
+  const maxIterations = 10;
+  let currentData = { ...data };
+  let hasChanges = true;
+  let iterations = 0;
+
+  while (hasChanges && iterations < maxIterations) {
+    hasChanges = false;
+    const nextData: Data = {};
+
+    for (const [key, value] of Object.entries(currentData)) {
+      if (typeof value !== 'string') {
+        nextData[key] = value;
+        continue;
+      }
+
+      const resolved = value.replace(/\{\{([^}]+)\}\}/g, (match, varName) => {
+        const trimmedVarName = varName.trim();
+        if (trimmedVarName in currentData) {
+          hasChanges = true;
+          return currentData[trimmedVarName];
+        }
+        return match;
+      });
+
+      nextData[key] = resolved;
+    }
+
+    currentData = nextData;
+    iterations++;
+  }
+
+  return currentData;
+};
+
+const detectSecrets = (vars: EnvVar[]): string[] => {
+  const secretPatterns = [
+    /api[_-]?key/i,
+    /secret/i,
+    /password/i,
+    /passwd/i,
+    /token/i,
+    /auth/i,
+    /credential/i,
+    /private[_-]?key/i,
+    /access[_-]?key/i,
+  ];
+
+  return vars
+    .filter(({ enabled, key }) => {
+      if (!enabled) {
+        return false;
+      }
+      return secretPatterns.some(pattern => pattern.test(key));
+    })
+    .map(({ key }) => key);
+};
