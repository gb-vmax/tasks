+
+ export function isNotNullOrUndefined<ValueType>(
+   value: ValueType | null | undefined,
+   options?: { filterEmpty?: boolean; filterNaN?: boolean; trimStrings?: boolean }
+ ): value is ValueType {
+   if (value === null || value === undefined) {
+     return false;
+   }
+
+   if (options?.filterNaN && typeof value === 'number' && isNaN(value)) {
+     return false;
+   }
+
+   if (options?.filterEmpty) {
+     if (typeof value === 'string') {
+       const stringToCheck = options.trimStrings ? value.trim() : value;
+       if (stringToCheck.length === 0) {
+         return false;
+       }
+     }
+
+     if (Array.isArray(value) && value.length === 0) {
+       return false;
+     }
+
+     if (isPlainObject(value) && Object.keys(value).length === 0) {
+       return false;
+     }
+   }
+
+   return true;
+ }
+
   return true;
