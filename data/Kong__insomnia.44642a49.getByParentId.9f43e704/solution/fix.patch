+interface CacheEntry<T> {
+  data: T;
+  timestamp: number;
+  accessCount: number;
+}
+
+interface CacheStats {
+  hits: number;
+  misses: number;
+  evictions: number;
+}
+
+const metadataCache = new Map<string, CacheEntry<GrpcRequestMeta | null>>();
+const CACHE_TTL_MS = 5 * 60 * 1000;
+const MAX_CACHE_SIZE = 1000;
+const cacheStats: CacheStats = { hits: 0, misses: 0, evictions: 0 };
+
+function getCachedMetadata(parentId: string): GrpcRequestMeta | null | undefined {
+  const entry = metadataCache.get(parentId);
+  
+  if (!entry) {
+    cacheStats.misses++;
+    return undefined;
+  }
+  
+  const now = Date.now();
+  if (now - entry.timestamp > CACHE_TTL_MS) {
+    metadataCache.delete(parentId);
+    cacheStats.misses++;
+    return undefined;
+  }
+  
+  entry.accessCount++;
+  cacheStats.hits++;
+  return entry.data;
+}
+
+function setCachedMetadata(parentId: string, data: GrpcRequestMeta | null) {
+  if (metadataCache.size >= MAX_CACHE_SIZE) {
+    evictLeastRecentlyUsed();
+  }
+  
+  metadataCache.set(parentId, {
+    data,
+    timestamp: Date.now(),
+    accessCount: 1,
+  });
+}
+
+function evictLeastRecentlyUsed() {
+  let oldestKey: string | null = null;
+  let oldestTime = Infinity;
+  let lowestAccessCount = Infinity;
+  
+  for (const [key, entry] of metadataCache.entries()) {
+    if (entry.accessCount < lowestAccessCount || 
+        (entry.accessCount === lowestAccessCount && entry.timestamp < oldestTime)) {
+      oldestKey = key;
+      oldestTime = entry.timestamp;
+      lowestAccessCount = entry.accessCount;
+    }
+  }
+  
+  if (oldestKey) {
+    metadataCache.delete(oldestKey);
+    cacheStats.evictions++;
+  }
+}
+
+function invalidateCache(parentId: string) {
+  metadataCache.delete(parentId);
+}
+
+function clearCache() {
+  metadataCache.clear();
+  cacheStats.hits = 0;
+  cacheStats.misses = 0;
+  cacheStats.evictions = 0;
+}
+
+export function getCacheStats() {
+  return { ...cacheStats, size: metadataCache.size };
+}
+
+const originalUpdate = update;
+export function update(requestMeta: GrpcRequestMeta, patch: Partial<GrpcRequestMeta>) {
+  const result = originalUpdate(requestMeta, patch);
+  invalidateCache(requestMeta.parentId);
+  return result;
+}
