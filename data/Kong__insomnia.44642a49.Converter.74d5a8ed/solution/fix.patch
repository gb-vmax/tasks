+const validateCollection = (collection: PostmanCollection): boolean => {
+  if (!collection.info || !collection.info.name) {
+    return false;
+  }
+  
+  if (!collection.item || !Array.isArray(collection.item)) {
+    return false;
+  }
+  
+  if (!collection.info.schema) {
+    return false;
+  }
+  
+  return true;
+};
+
+const sanitizeCollection = (collection: PostmanCollection): PostmanCollection => {
+  const sanitized = { ...collection };
+  
+  if (sanitized.info && typeof sanitized.info.name === 'string') {
+    sanitized.info.name = sanitized.info.name.trim() || 'Imported Collection';
+  }
+  
+  if (sanitized.info && typeof sanitized.info.description === 'string') {
+    sanitized.info.description = sanitized.info.description.trim();
+  }
+  
+  if (sanitized.item && Array.isArray(sanitized.item)) {
+    sanitized.item = sanitizeItems(sanitized.item);
+  }
+  
+  return sanitized;
+};
+
+const sanitizeItems = (items: PostmanCollection['item']): PostmanCollection['item'] => {
+  if (!items) {
+    return items;
+  }
+  
+  return items.map(item => {
+    const sanitizedItem = { ...item };
+    
+    if (sanitizedItem.name && typeof sanitizedItem.name === 'string') {
+      sanitizedItem.name = sanitizedItem.name.trim() || 'Unnamed';
+    }
+    
+    if ('item' in sanitizedItem && Array.isArray(sanitizedItem.item)) {
+      sanitizedItem.item = sanitizeItems(sanitizedItem.item);
+    }
+    
+    return sanitizedItem;
+  });
+};
+
+const calculateImportStatistics = (items: ImportRequest[]) => {
+  const stats = {
+    requestCount: 0,
+    groupCount: 0,
+    variableCount: 0,
+  };
+  
+  items.forEach(item => {
+    if (item._type === 'request') {
+      stats.requestCount++;
+    } else if (item._type === 'request_group') {
+      stats.groupCount++;
+      if (item.variable) {
+        stats.variableCount += Object.keys(item.variable).length;
+      }
+    }
+  });
+  
+  return stats;
+};
+
 export const convert: Converter = rawData => {
