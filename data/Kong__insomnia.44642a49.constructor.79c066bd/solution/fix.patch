+
+function deduplicateCookies(cookies: Cookie[]): Cookie[] {
+    const cookieMap = new Map<string, Cookie>();
+
+    for (const cookie of cookies) {
+        const cookieJson = cookie.toJSON();
+        const key = `${cookieJson.domain || ''}|${cookieJson.path || ''}|${cookieJson.key}`;
+        
+        const existing = cookieMap.get(key);
+        if (!existing) {
+            cookieMap.set(key, cookie);
+            continue;
+        }
+
+        const existingJson = existing.toJSON();
+        const shouldReplace = compareCookieRecency(cookieJson, existingJson);
+        
+        if (shouldReplace) {
+            cookieMap.set(key, cookie);
+        }
     }
 
+    return Array.from(cookieMap.values());
+}
+
+function compareCookieRecency(
+    cookie1: ReturnType<Cookie['toJSON']>,
+    cookie2: ReturnType<Cookie['toJSON']>
+): boolean {
+    if (cookie1.lastAccessed && cookie2.lastAccessed) {
+        const time1 = new Date(cookie1.lastAccessed).getTime();
+        const time2 = new Date(cookie2.lastAccessed).getTime();
+        return time1 > time2;
+    }
+
+    if (cookie1.lastAccessed) {
+        return true;
+    }
+
+    if (cookie2.lastAccessed) {
+        return false;
+    }
+
+    if (cookie1.creationIndex !== undefined && cookie2.creationIndex !== undefined) {
+        return cookie1.creationIndex > cookie2.creationIndex;
+    }
+
+    return false;
+}
