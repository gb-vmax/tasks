+const matchBody = (actual: string, expected: string | RegExp, mode: 'exact' | 'contains' = 'exact'): boolean => {
+    if (expected instanceof RegExp) {
+        return expected.test(actual);
+    }
+    if (mode === 'contains') {
+        return actual.includes(expected);
+    }
+    return actual === expected;
+};
+
+const haveBody = (expected: string | RegExp, checkEquality: boolean, options?: { mode?: 'exact' | 'contains' }) => {
+    const mode = options?.mode || 'exact';
+    const actualBody = this.text();
+    const matches = matchBody(actualBody, expected, mode);
+    
+    if ((matches && checkEquality) || (!matches && !checkEquality)) {
+        return;
+    }
+    
+    let expectedDesc: string;
+    if (expected instanceof RegExp) {
+        expectedDesc = `match pattern ${expected}`;
+    } else if (mode === 'contains') {
+        expectedDesc = `contain "${expected}"`;
+    } else {
+        expectedDesc = `equal "${expected}"`;
+    }
+    
+    const notPrefix = checkEquality ? '' : 'not ';
+    throw Error(`Expected response body to ${notPrefix}${expectedDesc}, but got: "${actualBody.substring(0, 100)}${actualBody.length > 100 ? '...' : ''}"`);
+};
+
+ body: (expected: string | RegExp, options?: { mode?: 'exact' | 'contains' }) => haveBody(expected, false, options),
                     jsonBody: (expected: object) => haveJsonBody(expected, false),
                     jsonSchema: (expected: object) => haveJsonSchema(expected, false),
                 },
