+function translateLegacyPostmanAPI(scriptContent: string): string {
+  let translated = scriptContent;
+  let offset = 0;
+
+  for (let i = 0; i < scriptContent.length - 8; i++) {
+    const isPostman = scriptContent.slice(i, i + 8) === 'postman.';
+    const isPrevCharacterAlphaNumeric = i - 1 >= 0 && /[0-9a-zA-Z\_\$]/.test(scriptContent[i - 1]);
+    
+    if (isPostman && !isPrevCharacterAlphaNumeric) {
+      const methodStartIndex = i + 8;
+      const remainingScript = scriptContent.slice(methodStartIndex);
+      
+      if (remainingScript.startsWith('setEnvironmentVariable')) {
+        const replacement = 'insomnia.environment.set';
+        translated = translated.slice(0, i + offset) + replacement + translated.slice(methodStartIndex + 22 + offset);
+        offset += replacement.length - 30;
+      } else if (remainingScript.startsWith('getEnvironmentVariable')) {
+        const replacement = 'insomnia.environment.get';
+        translated = translated.slice(0, i + offset) + replacement + translated.slice(methodStartIndex + 22 + offset);
+        offset += replacement.length - 30;
+      } else if (remainingScript.startsWith('setGlobalVariable')) {
+        const replacement = 'insomnia.globals.set';
+        translated = translated.slice(0, i + offset) + replacement + translated.slice(methodStartIndex + 17 + offset);
+        offset += replacement.length - 25;
+      } else if (remainingScript.startsWith('getGlobalVariable')) {
+        const replacement = 'insomnia.globals.get';
+        translated = translated.slice(0, i + offset) + replacement + translated.slice(methodStartIndex + 17 + offset);
+        offset += replacement.length - 25;
+      } else {
+        translated = translated.slice(0, i + offset) + 'insomnia.' + translated.slice(methodStartIndex + offset);
+        offset += 1;
+      }
+    }
+  }
+
+  return translated;
+}
+
+function translateVariableAccessors(scriptContent: string): string {
+  let translated = scriptContent;
+  
+  const patterns = [
+    { from: 'insomnia.variables.get(', to: 'insomnia.environment.get(' },
+    { from: 'insomnia.environment.get(', to: 'insomnia.environment.get(' },
+    { from: 'insomnia.globals.get(', to: 'insomnia.globals.get(' },
+    { from: 'insomnia.variables.set(', to: 'insomnia.environment.set(' },
+  ];
+
+  for (const pattern of patterns) {
+    if (pattern.from === pattern.to) {
+      continue;
+    }
+    let pos = 0;
+    while ((pos = translated.indexOf(pattern.from, pos)) !== -1) {
+      translated = translated.slice(0, pos) + pattern.to + translated.slice(pos + pattern.from.length);
+      pos += pattern.to.length;
+    }
+  }
+
+  return translated;
+}
