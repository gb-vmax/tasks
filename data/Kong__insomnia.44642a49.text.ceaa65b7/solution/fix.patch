-        return this.body.toString();
+function decodeStreamToText(stream: Buffer | ArrayBuffer, charset: string): string {
+    let buffer: Buffer;
+    
+    if (stream instanceof ArrayBuffer) {
+        buffer = Buffer.from(stream);
+    } else {
+        buffer = stream;
     }
 
+    const supportedEncodings = [
+        'utf-8', 'utf8',
+        'ascii',
+        'latin1', 'binary', 'iso-8859-1',
+        'ucs2', 'ucs-2', 'utf16le', 'utf-16le',
+        'base64',
+        'hex'
+    ];
+
+    const normalizedCharset = charset.toLowerCase().replace(/[_-]/g, '');
+    const matchedEncoding = supportedEncodings.find(enc => 
+        enc.replace(/[_-]/g, '') === normalizedCharset
+    );
+
+    if (matchedEncoding) {
+        return buffer.toString(matchedEncoding as BufferEncoding);
+    }
+
+    return buffer.toString('utf-8');
+}
+
+ text() {
+     if (this.body) {
+         return this.body.toString();
+     }
+
+     if (this.stream) {
+         const contentInfo = this.contentInfo();
+         const charset = contentInfo.charset.toLowerCase();
+        
+         return decodeStreamToText(this.stream, charset);
+     }
+
+     return this.body.toString();
+ }
+
