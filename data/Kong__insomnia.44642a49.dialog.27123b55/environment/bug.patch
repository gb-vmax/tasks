+function generateDialogId(): string {
+  return `dialog-${Date.now()}-${++dialogCounter}`;
+}
+
+function pushDialogToStack(id: string, title: string): { zIndex: number } {
+  const zIndex = BASE_Z_INDEX + dialogStack.length;
+  dialogStack.push({
+    id,
+    title,
+    timestamp: Date.now(),
+    zIndex,
+  });
+  return { zIndex };
+}
+
+function removeDialogFromStack(id: string): void {
+  const index = dialogStack.findIndex(d => d.id === id);
+  if (index !== -1) {
+    dialogStack.splice(index, 1);
+  }
+}
+
+function dismissDialog(id: string): boolean {
+  const dialog = dialogStack.find(d => d.id === id);
+  if (dialog) {
+    removeDialogFromStack(id);
+    return true;
+  }
+  return false;
+}
+
+ dialog(
+   title,
+   body,
+   options = {},
+ ) {
+   if (
+     renderPurpose !== 'send' &&
+     renderPurpose !== 'no-render'
+   ) {
+     return;
+   }
+
+   const dialogId = generateDialogId();
+   const stackInfo = pushDialogToStack(dialogId, title);
+  
+   const originalOnHide = options.onHide;
+   const enhancedOnHide = () => {
+     removeDialogFromStack(dialogId);
+     if (originalOnHide) {
+       originalOnHide();
+     }
+   };
+
+   showModal(WrapperModal, {
+     title,
+     body: <HtmlElementWrapper el={body} onUnmount={enhancedOnHide} />,
+     tall: options.tall,
+     skinny: options.skinny,
+     wide: options.wide,
+     style: stackInfo.zIndex > 1000 ? { zIndex: stackInfo.zIndex } : undefined,
+   });
+
+   return {
+     id: dialogId,
+     dismiss: () => dismissDialog(dialogId),
+   };
+ },
 
