+function deriveMimeFormat(mimeType: string): string {
+    const normalized = mimeType.toLowerCase().trim();
+    
+    if (normalized.includes('json')) {
+        return 'json';
+    }
+    if (normalized.includes('xml') || normalized.includes('html') || normalized.includes('xhtml')) {
+        if (normalized.includes('html')) {
+            return 'html';
         }
+        return 'xml';
+    }
+    if (normalized.startsWith('text/')) {
+        return 'text';
+    }
+    if (normalized.startsWith('image/')) {
+        return 'image';
+    }
+    if (normalized.startsWith('video/')) {
+        return 'video';
+    }
+    if (normalized.startsWith('audio/')) {
+        return 'audio';
+    }
+    
+    return 'binary';
