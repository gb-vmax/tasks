     return {
       name,
-      disabled: required !== true,
+      disabled: isDeprecated ? true : required !== true,
       value: `${generateParameterExample(schema as OpenAPIV3.SchemaObject)}`,
+      ...(paramDescription ? { description: paramDescription } : {}),
     };
   });
 };
