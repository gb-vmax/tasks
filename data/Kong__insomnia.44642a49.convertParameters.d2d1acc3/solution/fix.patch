+const formatParameterDescription = (description?: string, isDeprecated?: boolean) => {
+  const deprecatedPrefix = '[DEPRECATED] ';
+  
+  if (!description && !isDeprecated) {
+    return undefined;
+  }
+  
+  if (isDeprecated && !description) {
+    return `${deprecatedPrefix}This parameter is deprecated and should not be used.`;
+  }
+  
+  if (isDeprecated && description) {
+    return description.startsWith(deprecatedPrefix) 
+      ? description 
+      : `${deprecatedPrefix}${description}`;
+  }
+  
+  return description;
+};
+
 const convertParameters = (parameters: OpenAPIV3.ParameterObject[] = []) => {
