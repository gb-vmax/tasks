+function wildcardToRegex(pattern: string, caseInsensitive: boolean): RegExp {
+  const escaped = pattern
+    .replace(/[.+^${}()|[\]\\]/g, '\\$&')
+    .replace(/\*/g, '.*')
+    .replace(/\?/g, '.');
+  
+  const flags = caseInsensitive ? 'i' : '';
+  return new RegExp(`^${escaped}$`, flags);
+}
+
+ export function filterParameters<T extends { name: string; value: string }>(
+   parameters: T[],
+   name: string,
+   options?: { caseInsensitive?: boolean; wildcard?: boolean }
+ ): T[] {
+   if (!Array.isArray(parameters) || !name) {
+     return [];
+   }
+
+   const caseInsensitive = options?.caseInsensitive ?? false;
+   const wildcard = options?.wildcard ?? false;
+
+   if (wildcard) {
+     const pattern = wildcardToRegex(name, caseInsensitive);
+     return parameters.filter(h => (!h || !h.name ? false : pattern.test(h.name)));
+   }
+
+   if (caseInsensitive) {
+     const lowerName = name.toLowerCase();
+     return parameters.filter(h => (!h || !h.name ? false : h.name.toLowerCase() === lowerName));
+   }
+
+   return parameters.filter(h => (!h || !h.name ? false : h.name === name));
+ }
 
   return parameters.filter(h => (!h || !h.name ? false : h.name === name));
 }
