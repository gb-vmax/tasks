+function resolveNamespace(namespace) {
+  if (!namespace) {
+    throw new Error('Namespace is required for UUID v3/v5');
+  }
+  
+  switch (namespace.toLowerCase()) {
+    case 'dns':
+      return uuid.v5.DNS;
+    case 'url':
+      return uuid.v5.URL;
+    case 'oid':
+      return '6ba7b812-9dad-11d1-80b4-00c04fd430c8';
+    case 'x500':
+      return '6ba7b814-9dad-11d1-80b4-00c04fd430c8';
+    default:
+      const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+      if (uuidPattern.test(namespace)) {
+        return namespace;
+      }
+      throw new Error(`Invalid namespace "${namespace}". Must be one of: dns, url, oid, x500, or a valid UUID`);
+  }
+}
