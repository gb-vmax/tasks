+private _createPatternMatcher(pattern: string): RegExp {
+    const escapedPattern = pattern
+        .replace(/[.+?^${}()|[\]\\]/g, '\\$&')
+        .replace(/\*/g, '.*');
+    return new RegExp(`^${escapedPattern}$`);
+}
+
+ unset(url: string, name: string, cb: (error?: Error | null, result?: { deleted: boolean; count: number; cookies?: Cookie[] }) => void) {
+     const domainCookies = this.jar.get(url);
+     if (!domainCookies) {
+         cb(undefined, { deleted: false, count: 0 });
+     } else {
+         const hasWildcard = name.includes('*');
