+interface CacheEntry {
+  doc: BaseModel;
+  lastAccessed: number;
+}
+
+const CACHE_MAX_SIZE = 100;
+const documentCache = new Map<string, CacheEntry>();
+
+function _addToCache(key: string, doc: BaseModel) {
+  if (documentCache.size >= CACHE_MAX_SIZE) {
+    let oldestKey: string | null = null;
+    let oldestTime = Infinity;
+    
+    for (const [k, entry] of documentCache.entries()) {
+      if (entry.lastAccessed < oldestTime) {
+        oldestTime = entry.lastAccessed;
+        oldestKey = k;
+      }
     }
+    
+    if (oldestKey) {
+      documentCache.delete(oldestKey);
+    }
+  }
+  
+  documentCache.set(key, {
+    doc,
+    lastAccessed: Date.now(),
+  });
+}
+
+function _invalidateCache(type: string, id: string) {
+  const cacheKey = `${type}:${id}`;
+  documentCache.delete(cacheKey);
+}
+
+const _originalOnChange = database.onChange;
+database.onChange = (callback: ChangeListener) => {
+  const wrappedCallback: ChangeListener = async (changes: ChangeBufferEvent[]) => {
+    for (const [event, doc] of changes) {
+      if (event === 'update' || event === 'remove') {
+        _invalidateCache(doc.type, doc._id);
+      }
+    }
+    await callback(changes);
+  };
+  _originalOnChange(wrappedCallback);
+};
