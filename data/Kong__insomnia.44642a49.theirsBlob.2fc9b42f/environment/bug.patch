+function generateBlobId(seed: string): string {
+  let hash = 0;
+  for (let i = 0; i < seed.length; i++) {
+    const char = seed.charCodeAt(i);
+    hash = ((hash << 5) - hash) + char;
+    hash = hash & hash;
+  }
+  const hex = Math.abs(hash).toString(16).padStart(8, '0');
+  return `${hex}${'0'.repeat(32 - hex.length)}${seed.length.toString(16).padStart(8, '0')}`;
+}
