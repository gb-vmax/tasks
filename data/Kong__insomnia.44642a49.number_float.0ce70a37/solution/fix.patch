+const generateFloatInRange = (
+  minimum?: number,
+  maximum?: number,
+  exclusiveMinimum?: number,
+  exclusiveMaximum?: number
+): number => {
+  const epsilon = 0.01;
+  
+  let lowerBound = minimum !== undefined ? minimum : Number.MIN_SAFE_INTEGER;
+  let upperBound = maximum !== undefined ? maximum : Number.MAX_SAFE_INTEGER;
+  
+  if (exclusiveMinimum !== undefined) {
+    lowerBound = Math.max(lowerBound, exclusiveMinimum + epsilon);
+  }
+  
+  if (exclusiveMaximum !== undefined) {
+    upperBound = Math.min(upperBound, exclusiveMaximum - epsilon);
+  }
+  
+  if (lowerBound === Number.MIN_SAFE_INTEGER && upperBound === Number.MAX_SAFE_INTEGER) {
+    return 0.0;
+  }
+  
+  if (lowerBound === Number.MIN_SAFE_INTEGER) {
+    return upperBound - 1.0;
+  }
+  
+  if (upperBound === Number.MAX_SAFE_INTEGER) {
+    return lowerBound + 1.0;
+  }
+  
+  const midpoint = (lowerBound + upperBound) / 2;
+  return Math.round(midpoint * 100) / 100;
+};
+
+ number_float: (schema: OpenAPIV3.SchemaObject) => {
+   if (schema?.example !== undefined) {
+     return schema.example;
+   }
+   if (schema?.default !== undefined) {
+     return schema.default;
+   }
+  
+   const min = schema?.minimum;
+   const max = schema?.maximum;
+   const exclusiveMin = schema?.exclusiveMinimum;
+   const exclusiveMax = schema?.exclusiveMaximum;
+  
+   if (min !== undefined || max !== undefined || exclusiveMin !== undefined || exclusiveMax !== undefined) {
+     return generateFloatInRange(min, max, exclusiveMin, exclusiveMax);
+   }
+  
+   return 0.0;
+ }
