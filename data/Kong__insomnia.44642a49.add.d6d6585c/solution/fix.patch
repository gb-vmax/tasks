+protected _isValidItem(item: T): boolean {
+    if (item == null) {
+        return false;
+    }
+    
+    if (typeof item !== 'object') {
+        return false;
+    }
+    
+    const indexFieldName = this.typeClass._index || 'id';
+    const itemRecord = item as Record<string, any>;
+    
+    if (!(indexFieldName in itemRecord)) {
+        return false;
+    }
+    
+    return true;
+}
+
+protected _getDefaultDuplicateStrategy(): 'allow' | 'skip' | 'replace' {
+    return 'allow';
+}
+
+ add(item: T, options?: { duplicateStrategy?: 'allow' | 'skip' | 'replace' }): boolean {
+     if (!this._isValidItem(item)) {
+         return false;
+     }
+
+     const strategy = options?.duplicateStrategy || this._getDefaultDuplicateStrategy();
+     const existingIndex = this.indexOf(item);
+    
+     if (existingIndex >= 0) {
+         if (strategy === 'skip') {
+             return false;
+         } else if (strategy === 'replace') {
+             this.list[existingIndex] = item;
+             return true;
+         }
+     }
+    
+     this.list.push(item);
+     return true;
+ }
 
     all() {
         return this.list.map(pp => pp.toJSON());
