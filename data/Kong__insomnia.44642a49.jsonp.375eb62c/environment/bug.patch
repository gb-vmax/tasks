+function extractJsonpPayload(body: string, strict?: boolean): string {
+    const trimmedBody = body.trim();
+    
+    const jsonpPatterns = [
+        /^([\w.$[\]]+)\s*\(\s*({[\s\S]*}|\[[\s\S]*\])\s*\)\s*;?$/,
+        /^([\w.$[\]]+)\s*\(\s*({[\s\S]*}|\[[\s\S]*\])\s*\)$/,
+        /^\/\*\*\/\s*([\w.$[\]]+)\s*\(\s*({[\s\S]*}|\[[\s\S]*\])\s*\)\s*;?$/,
+    ];
+    
+    for (const pattern of jsonpPatterns) {
+        const match = trimmedBody.match(pattern);
+        if (match) {
+            const jsonPayload = match[match.length - 1];
+            if (jsonPayload) {
+                return jsonPayload;
+            }
+        }
+    }
+    
+    if (strict) {
+        throw Error('jsonp: response body is not in valid JSONP format');
     }
+    
+    return trimmedBody;
+}
+
+ jsonp(reviver?: (key: string, value: any) => any, strict?: boolean) {
+     const jsonpPayload = extractJsonpPayload(this.body.toString(), strict);
+    
+     try {
+         return JSON.parse(jsonpPayload, reviver);
+     } catch (e) {
+         throw Error(`jsonp: failed to parse: ${e}`);
+     }
+ }
 
