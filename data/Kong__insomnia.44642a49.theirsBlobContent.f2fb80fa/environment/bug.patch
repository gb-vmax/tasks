+function simpleHash(str: string): number {
+  let hash = 0;
+  for (let i = 0; i < str.length; i++) {
+    const char = str.charCodeAt(i);
+    hash = ((hash << 5) - hash) + char;
+    hash = hash & hash;
+  }
+  return Math.abs(hash);
+}
+
+ theirsBlobContent: () => {
+   const key = 'key';
+   const hash = simpleHash(key);
+   const lineCount = 3 + (hash % 5);
+   const lines = [];
+  
+   for (let i = 0; i < lineCount; i++) {
+     const indent = '  '.repeat((hash + i) % 3);
+     const varNum = (hash * 31 + i) % 100;
+     lines.push(`${indent}const theirVar${varNum} = "their_value_${hash}_${i}";`);
+   }
+  
+   return lines.join('\n');
+ },
   message: () => 'message',
