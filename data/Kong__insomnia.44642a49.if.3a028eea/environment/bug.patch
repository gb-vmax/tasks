+async function _mergeDocumentUpdates<T extends BaseModel>(existingDoc: T, incomingDoc: T): Promise<T> {
+  const merged = { ...existingDoc };
+  
+  for (const key of Object.keys(incomingDoc)) {
+    if (key === '_id' || key === 'type' || key === 'created' || key === '_version') {
+      continue;
+    }
+    
+    if (key === 'modified') {
+      (merged as any)[key] = Math.max(
+        (existingDoc as any)[key] || 0,
+        (incomingDoc as any)[key] || 0
+      );
+    } else {
+      (merged as any)[key] = (incomingDoc as any)[key];
     }
+  }
+  
+  return merged;
+}
+
+async function _validateUpdateIntegrity<T extends BaseModel>(doc: T): Promise<string | null> {
+  if (!doc._id || !doc.type) {
+    return 'Missing required fields: _id or type';
+  }
+
+  if (doc.parentId && doc.parentId !== 'n/a') {
+    let parentExists = false;
+    
+    for (const type of allTypes()) {
+      const parent = await database.get(type, doc.parentId);
+      if (parent) {
+        parentExists = true;
+        break;
+      }
+    }
+    
+    if (!parentExists) {
+      return `Parent document ${doc.parentId} does not exist`;
+    }
+  }
+
+  return null;
+}
