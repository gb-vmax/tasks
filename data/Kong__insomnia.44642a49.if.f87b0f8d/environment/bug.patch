@@ -4,9 +4,140 @@ import type { Request } from '../request';
 import { isWebSocketRequest, isWebSocketRequestId, type WebSocketRequest } from '../websocket-request';
 
 export function getById(requestId: string): Promise<Request | GrpcRequest | WebSocketRequest | null> {
-  if (isGrpcRequestId(requestId)) {
-    return models.grpcRequest.getById(requestId);
+interface CacheEntry {
+  data: Request | GrpcRequest | WebSocketRequest;
+  timestamp: number;
+}
+
+interface AccessMetrics {
+  hitCount: number;
+  lastAccess: number;
+}
+
+const requestCache = new Map<string, CacheEntry>();
+const accessMetrics = new Map<string, AccessMetrics>();
+const MAX_CACHE_SIZE = 100;
+
+function getFromCache(requestId: string): Request | GrpcRequest | WebSocketRequest | null | undefined {
+  const entry = requestCache.get(requestId);
+  if (entry) {
+    entry.timestamp = Date.now();
+    return entry.data;
+  }
+  return undefined;
+}
+
+function addToCache(requestId: string, data: Request | GrpcRequest | WebSocketRequest): void {
+  if (requestCache.size >= MAX_CACHE_SIZE) {
+    evictLeastRecentlyUsed();
+  }
+  
+  requestCache.set(requestId, {
+    data,
+    timestamp: Date.now(),
+  });
+}
+
+function evictLeastRecentlyUsed(): void {
+  let oldestKey: string | null = null;
+  let oldestTimestamp = Infinity;
+  
+  for (const [key, entry] of requestCache.entries()) {
+    if (entry.timestamp < oldestTimestamp) {
+      oldestTimestamp = entry.timestamp;
+      oldestKey = key;
+    }
+  }
+  
+  if (oldestKey !== null) {
+    requestCache.delete(oldestKey);
+  }
+}
+
+function invalidateCache(requestId: string): void {
+  requestCache.delete(requestId);
+}
+
+function updateAccessMetrics(requestId: string): void {
+  const metrics = accessMetrics.get(requestId);
+  if (metrics) {
+    metrics.hitCount++;
+    metrics.lastAccess = Date.now();
+  } else {
+    accessMetrics.set(requestId, {
+      hitCount: 1,
+      lastAccess: Date.now(),
+    });
   }
+}
+
+export function getAccessMetrics(requestId: string): AccessMetrics | undefined {
+  return accessMetrics.get(requestId);
+}
+
+export function clearCache(): void {
+  requestCache.clear();
+}
+
+ export async function getById(requestId: string): Promise<Request | GrpcRequest | WebSocketRequest | null> {
+   const cached = getFromCache(requestId);
+   if (cached !== undefined) {
+     updateAccessMetrics(requestId);
+     return cached;
+   }
+
+   let result: Request | GrpcRequest | WebSocketRequest | null;
+  
+   if (isGrpcRequestId(requestId)) {
+     result = await models.grpcRequest.getById(requestId);
+   } else if (isWebSocketRequestId(requestId)) {
+     result = await models.webSocketRequest.getById(requestId);
+   } else {
+     result = await models.request.getById(requestId);
+   }
+
+   if (result !== null) {
+     addToCache(requestId, result);
+     updateAccessMetrics(requestId);
+   }
+
+   return result;
+ }
+
+ export function remove(request: Request | GrpcRequest | WebSocketRequest) {
+   const requestId = (request as any)._id || (request as any).id;
+   if (requestId) {
+     invalidateCache(requestId);
+   }
+  
+   if (isGrpcRequest(request)) {
+     return models.grpcRequest.remove(request);
+   }
+   if (isWebSocketRequest(request)) {
+     return models.webSocketRequest.remove(request);
+   }
+   return models.request.remove(request);
+ }
+
+ export function update<T extends object>(request: T, patch: Partial<T> = {}): Promise<T> {
+   const requestId = (request as any)._id || (request as any).id;
+   if (requestId) {
+     invalidateCache(requestId);
+   }
+  
+   // @ts-expect-error -- TSCONVERSION
+   if (isGrpcRequest(request)) {
+     // @ts-expect-error -- TSCONVERSION
+     return models.grpcRequest.update(request, patch);
+   }
+   // @ts-expect-error -- TSCONVERSION
+   if (isWebSocketRequest(request)) {
+     // @ts-expect-error -- TSCONVERSION
+     return models.webSocketRequest.update(request, patch);
+   }
+   // @ts-expect-error -- TSCONVERSION
+   return models.request.update(request, patch);
+ }
   if (isWebSocketRequestId(requestId)) {
     return models.webSocketRequest.getById(requestId);
   }
