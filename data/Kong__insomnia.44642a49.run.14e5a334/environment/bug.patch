+function applyResponseTransform(transform: string, value: any): string {
+  const valueStr = typeof value === 'string' ? value : JSON.stringify(value);
+  const [transformType, ...args] = transform.split(':');
+  
+  switch (transformType.toLowerCase()) {
+    case 'base64encode':
+      return Buffer.from(valueStr, 'utf8').toString('base64');
+    
+    case 'base64decode':
+      return Buffer.from(valueStr, 'base64').toString('utf8');
+    
+    case 'base64urlencode':
+      return Buffer.from(valueStr, 'utf8')
+        .toString('base64')
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=/g, '');
+    
+    case 'urlencode':
+      return encodeURIComponent(valueStr);
+    
+    case 'urldecode':
+      return decodeURIComponent(valueStr);
+    
+    case 'hash':
+      const algorithm = args[0] || 'sha256';
+      const encoding = args[1] || 'hex';
+      if (encoding !== 'hex' && encoding !== 'base64') {
+        throw new Error(`Invalid hash encoding ${encoding}. Choices are hex, base64`);
+      }
+      const hash = crypto.createHash(algorithm);
+      hash.update(valueStr, 'utf8');
+      return hash.digest(encoding as 'hex' | 'base64');
+    
+    case 'lowercase':
+      return valueStr.toLowerCase();
+    
+    case 'uppercase':
+      return valueStr.toUpperCase();
+    
+    default:
+      throw new Error(`Unknown transform type "${transformType}"`);
+  }
+}
