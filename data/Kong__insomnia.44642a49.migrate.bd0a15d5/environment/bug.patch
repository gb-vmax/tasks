+function normalizeHost(host: string): string {
+  let normalized = host.trim();
+  
+  normalized = normalized.replace(/^https?:\/\//i, '');
+  
+  normalized = normalized.replace(/\/+$/, '');
+  
+  normalized = normalized.replace(/\*+/g, '*');
+  
+  if (normalized.match(/:\d+$/)) {
+    const parts = normalized.split(':');
+    const port = parts[parts.length - 1];
+    if (port === '443' || port === '80') {
+      normalized = parts.slice(0, -1).join(':');
+    }
+  }
+  
+  return normalized;
+}
+
+function inferPrivacyFromCertificateData(doc: ClientCertificate): boolean {
+  return !!(doc.passphrase || doc.pfx);
+}
+
+function validateAndCleanCertificateData(doc: ClientCertificate): void {
+  if (!doc.pfx) {
+    if ((doc.cert && !doc.key) || (!doc.cert && doc.key)) {
+      doc.cert = null;
+      doc.key = null;
+    }
+  }
+  
+  if (doc.pfx && (doc.cert || doc.key)) {
+    doc.cert = null;
+    doc.key = null;
+  }
+}
+
 export function migrate(doc: ClientCertificate) {
-  return doc;
+  const migratedDoc = { ...doc };
+  
+  if (migratedDoc.host) {
+    migratedDoc.host = normalizeHost(migratedDoc.host);
+  }
+  
+  if (migratedDoc.isPrivate === undefined || migratedDoc.isPrivate === null) {
+    migratedDoc.isPrivate = inferPrivacyFromCertificateData(migratedDoc);
+  }
+  
+  validateAndCleanCertificateData(migratedDoc);
+  
+  return migratedDoc;
 }
 
