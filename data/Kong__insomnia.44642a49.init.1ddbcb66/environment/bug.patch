+function getEnvironmentOverrides(): Partial<BaseSettings> {
+  const env = detectEnvironment();
+  
+  const environmentDefaults: Record<string, Partial<BaseSettings>> = {
+    development: {
+      enableAnalytics: false,
+      timeout: 60_000,
+      maxHistoryResponses: 50,
+      disableUpdateNotification: true,
+      updateAutomatically: false,
+      showVariableSourceAndValue: true,
+    },
+    test: {
+      enableAnalytics: false,
+      timeout: 5_000,
+      maxHistoryResponses: 5,
+      disableUpdateNotification: true,
+      updateAutomatically: false,
+      clearOAuth2SessionOnRestart: false,
+    },
+    production: {},
+  };
+
+  return environmentDefaults[env] || {};
+}
+
+function detectEnvironment(): string {
+  if (typeof process !== 'undefined' && process.env) {
+    const nodeEnv = process.env.NODE_ENV?.toLowerCase();
+    if (nodeEnv === 'development' || nodeEnv === 'dev') {
+      return 'development';
+    }
+    if (nodeEnv === 'test' || nodeEnv === 'testing') {
+      return 'test';
+    }
+    if (nodeEnv === 'production' || nodeEnv === 'prod') {
+      return 'production';
+    }
+  }
+
+  return 'production';
+}
+
+function getCustomDefaultOverrides(): Partial<BaseSettings> {
+  if (typeof globalThis !== 'undefined' && 
+      (globalThis as any).__INSOMNIA_CUSTOM_DEFAULTS__) {
+    const customDefaults = (globalThis as any).__INSOMNIA_CUSTOM_DEFAULTS__;
+    if (typeof customDefaults === 'object' && customDefaults !== null) {
+      return customDefaults;
+    }
+  }
+
+  return {};
+}
