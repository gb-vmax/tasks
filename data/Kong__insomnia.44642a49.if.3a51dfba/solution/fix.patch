+interface UpsertCacheEntry<T = any> {
+  doc: T;
+  timestamp: number;
+}
+
+const upsertCache: Map<string, UpsertCacheEntry> = new Map();
+const UPSERT_CACHE_TTL = 5000;
+
+function _getFromUpsertCache<T extends BaseModel>(key: string): T | null {
+  const entry = upsertCache.get(key);
+  if (!entry) {
+    return null;
+  }
+  
+  const now = Date.now();
+  if (now - entry.timestamp > UPSERT_CACHE_TTL) {
+    upsertCache.delete(key);
+    return null;
+  }
+  
+  return entry.doc as T;
+}
+
+function _addToUpsertCache<T extends BaseModel>(key: string, doc: T, timestamp: number): void {
+  upsertCache.set(key, { doc, timestamp });
+  
+  if (upsertCache.size > 1000) {
+    const oldestKey = Array.from(upsertCache.entries())
+      .sort((a, b) => a[1].timestamp - b[1].timestamp)[0][0];
+    upsertCache.delete(oldestKey);
+  }
+}
+
+async function _mergeConflictingDocs<T extends BaseModel>(existingDoc: T, incomingDoc: T): Promise<T> {
+  const safeFields = ['name', 'description', 'data', 'metaData', 'authentication', 'headers', 'body', 'parameters'];
+  
+  const merged = { ...existingDoc };
+  
+  for (const field of safeFields) {
+    if (field in incomingDoc && incomingDoc[field as keyof T] !== undefined) {
+      const existingValue = existingDoc[field as keyof T];
+      const incomingValue = incomingDoc[field as keyof T];
+      
+      if (typeof incomingValue === 'object' && incomingValue !== null && 
+          typeof existingValue === 'object' && existingValue !== null &&
+          !Array.isArray(incomingValue)) {
+        merged[field as keyof T] = { ...existingValue, ...incomingValue } as any;
+      } else if (incomingValue !== existingValue) {
+        merged[field as keyof T] = incomingValue;
+      }
     }
+  }
+  
+  merged.modified = Date.now();
+  
+  return merged;
+}
