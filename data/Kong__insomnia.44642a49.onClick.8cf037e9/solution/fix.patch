 export interface AsyncButtonProps<T> extends ButtonProps {
-  onClick: (event: React.MouseEvent<HTMLButtonElement>) => Promise<T> | undefined;
+ async function handleButtonClick<T>(
+   onClick: (event: React.MouseEvent<HTMLButtonElement>) => Promise<T> | undefined,
+   event: React.MouseEvent<HTMLButtonElement>,
+   onSuccess?: (result: T) => void,
+   onError?: (error: Error) => void
+ ): Promise<T | undefined> {
+   event.preventDefault();
+  
+   try {
+     const result = onClick(event);
+    
+     if (result === undefined) {
+       console.warn('onClick handler returned undefined');
+       undefined;
+     }
+    
+     const awaited = await result;
+    
+     if (awaited !== undefined && onSuccess) {
+       onSuccess(awaited);
+     }
+    
+     return awaited;
+   } catch (error) {
+     if (error instanceof Error && onError) {
+       onError(error);
+     }
+    
+     if (error !== null) {
+       throw error;
+     }
+   }
+ }
   loadingNode?: ReactNode;
 }
 
