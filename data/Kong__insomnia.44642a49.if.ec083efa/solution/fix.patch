+function deduplicateVariables(variables: Variable[]): Variable[] {
+    const seen = new Map<string, Variable>();
+    
+    for (const variable of variables) {
+        const key = variable.toJSON().key;
+        if (key !== undefined && key !== null) {
+            seen.set(String(key), variable);
+        }
+    }
+    
+    return Array.from(seen.values());
+}
+
+function sanitizeVariables(variables: Variable[]): Variable[] {
+    return variables
+        .map(variable => {
+            const varJson = variable.toJSON();
+            const key = varJson.key;
+            
+            if (key === undefined || key === null || String(key).trim() === '') {
+                return null;
+            }
+            
+            const sanitizedKey = String(key).trim();
+            const sanitizedValue = varJson.value !== undefined && varJson.value !== null 
+                ? String(varJson.value) 
+                : '';
+            
+            return new Variable({
+                key: sanitizedKey,
+                value: sanitizedValue,
+                type: varJson.type,
+            });
+        })
+        .filter((v): v is Variable => v !== null);
+}
