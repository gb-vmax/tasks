+_branchCache: Record<string, { branch: Branch; timestamp: number }> = {};
+_branchCacheTTL: number = 5000;
+
+_getCachedBranch(name: string): Branch | null {
+  const backendProjectId = this._backendProject?.id;
+  if (!backendProjectId) {
+    return null;
+  }
+
+  const cacheKey = `${backendProjectId}:${name}`;
+  const cached = this._branchCache[cacheKey];
+  
+  if (!cached) {
+    return null;
+  }
+
+  const age = Date.now() - cached.timestamp;
+  if (age > this._branchCacheTTL) {
+    delete this._branchCache[cacheKey];
+    return null;
+  }
+
+  return cached.branch;
+}
+
+_cacheBranch(branch: Branch): void {
+  const backendProjectId = this._backendProject?.id;
+  if (!backendProjectId) {
+    return;
+  }
+
+  const cacheKey = `${backendProjectId}:${branch.name}`;
+  this._branchCache[cacheKey] = {
+    branch: clone(branch),
+    timestamp: Date.now(),
+  };
+}
+
+_invalidateBranchCache(name?: string): void {
+  const backendProjectId = this._backendProject?.id;
+  if (!backendProjectId) {
+    return;
+  }
+
+  if (name) {
+    const cacheKey = `${backendProjectId}:${name}`;
+    delete this._branchCache[cacheKey];
+  } else {
+    const prefix = `${backendProjectId}:`;
+    for (const key of Object.keys(this._branchCache)) {
+      if (key.startsWith(prefix)) {
+        delete this._branchCache[key];
+      }
     }
+  }
+}
