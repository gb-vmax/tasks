+private _statusCache: Map<string, { data: any; timestamp: number }> = new Map();
+private _statusCacheTTL = 500;
+
+private async _checkFileExists(posixPath: string): Promise<boolean> {
+  try {
+    const fs = this._baseOpts.fs;
+    const fullPath = path.join(this._baseOpts.dir, posixPath);
+    
+    if ('promises' in fs) {
+      const stats = await fs.promises.stat(fullPath);
+      return stats.isFile();
+    } else {
+      return new Promise((resolve) => {
+        fs.stat(fullPath, (err: any, stats: any) => {
+          if (err) {
+            resolve(false);
+          } else {
+            resolve(stats.isFile());
+          }
+        });
+      });
+    }
+  } catch (err) {
+    return false;
   }
+}
+
+clearStatusCache() {
+  this._statusCache.clear();
+}
