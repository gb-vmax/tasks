+           });
+          
+           const exists = await this._checkFileExists(posixPath);
+           const result = { status: gitStatus, exists };
+          
+           this._statusCache.set(cacheKey, { data: result, timestamp: now });
+          
+           return { filepath: fp, ...result };
+         } catch (err) {
+           return { filepath: fp, status: 'unknown', exists: false, error: err };
+         }
+       })
+     );
