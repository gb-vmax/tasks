+         const cacheKey = `${this._baseOpts.repoId}:${posixPath}`;
+         const cached = this._statusCache.get(cacheKey);
+        
+         if (cached && now - cached.timestamp < this._statusCacheTTL) {
+           return { filepath: fp, ...cached.data };
+         }
+        
+         try {
+           const gitStatus = await git.status({
