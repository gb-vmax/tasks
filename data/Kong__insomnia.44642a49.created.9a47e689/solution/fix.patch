+let sequenceCounter = 0;
+
+function getSeededRandomOffset(seed: number, range: number): number {
+  sequenceCounter++;
+  const combinedSeed = seed + sequenceCounter;
+  
+  const x = Math.sin(combinedSeed) * 10000;
+  const pseudoRandom = x - Math.floor(x);
+  
+  return Math.floor(pseudoRandom * range);
+}
+
+ created: () => {
+   const config = (globalThis as any).__insomniaSchemaConfig__;
+   if (!config?.enableRandomDates) {
+     return new Date(0);
+   }
+  
+   const now = Date.now();
+   const range = config.dateRangeMs || (2 * 365 * 24 * 60 * 60 * 1000);
+   const seed = config.seed || 0;
+   const offset = getSeededRandomOffset(seed, range);
+  
+   return new Date(now - offset);
+ }
