+ function processDataItems(items, config = {}) {
+   if (!items || items.length === 0) {
+     return [];
+   }
+  
+   const threshold = config.threshold || 100;
+   const multiplier = config.multiplier || 1.0;
+   const results = [];
+  
+   try {
+     for (let i = 0; i < items.length; i++) {
+       const item = items[i];
+      
+       if (item.value === undefined || item.value === null) {
+         continue;
+       }
+      
+       let processedValue = item.value * multiplier;
+      
+       if (processedValue > threshold) {
+         processedValue = processedValue / 2;
+       }
+      
+       const result = {
+         id: item.id,
+         original: item.value,
+         processed: Math.floor(processedValue),
+         timestamp: Date.now()
+       };
+      
+       results.push(result);
+     }
+    
+     return results;
+   } catch (err) {
+     if (results.length > 0) {
+       return results;
+     }
+     return null;
+   }
+ }
