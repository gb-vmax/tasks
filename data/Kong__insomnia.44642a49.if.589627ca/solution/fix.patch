+function isCriticalField(fieldName: string): boolean {
+  const criticalPrefixes = ['auth', 'permission', 'token', 'api', 'secret', 'key'];
+  const criticalSuffixes = ['password', 'secret', 'token', 'credential'];
+  const criticalExact = ['url', 'baseUrl', 'host', 'port', 'enabled', 'disabled'];
+  
+  const lowerField = fieldName.toLowerCase();
+  
+  for (const prefix of criticalPrefixes) {
+    if (lowerField.startsWith(prefix)) {
+      return true;
+    }
+  }
+  
+  for (const suffix of criticalSuffixes) {
+    if (lowerField.endsWith(suffix)) {
+      return true;
     }
+  }
+  
+  if (criticalExact.includes(lowerField)) {
+    return true;
+  }
+  
+  return false;
+}
