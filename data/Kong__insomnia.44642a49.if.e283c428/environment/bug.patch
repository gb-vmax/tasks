+async function _mergeConflictingDocs<T extends BaseModel>(existingDoc: T, incomingDoc: T): Promise<T> {
+  const merged = { ...existingDoc };
+  
+  const protectedFields = ['_id', 'type', 'created', '_version', 'parentId'];
+  
+  for (const key of Object.keys(incomingDoc)) {
+    if (protectedFields.includes(key)) {
+      continue;
     }
+    
+    const existingValue = (existingDoc as any)[key];
+    const incomingValue = (incomingDoc as any)[key];
+    
+    if (incomingValue === undefined || incomingValue === null) {
+      continue;
+    }
+    
+    if (typeof incomingValue === 'object' && !Array.isArray(incomingValue) && 
+        typeof existingValue === 'object' && !Array.isArray(existingValue)) {
+      (merged as any)[key] = {
+        ...existingValue,
+        ...incomingValue,
+      };
+    } else if (key === 'modified' || key === 'name' || key === 'description') {
+      (merged as any)[key] = incomingValue;
+    } else if (incomingDoc.modified && existingDoc.modified && 
+               incomingDoc.modified >= existingDoc.modified) {
+      (merged as any)[key] = incomingValue;
+    } else if (!existingValue) {
+      (merged as any)[key] = incomingValue;
+    }
+  }
+  
+  merged.modified = Math.max(
+    incomingDoc.modified || 0,
+    existingDoc.modified || 0,
+    Date.now()
+  );
+  
+  return merged;
+}
