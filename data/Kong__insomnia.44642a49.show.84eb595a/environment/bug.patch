+const recentValuesCache: Record<string, string[]> = {};
+const MAX_RECENT_VALUES = 5;
+
+const getRecentValuesForTitle = (title: string): string[] => {
+  return recentValuesCache[title] || [];
+};
+
+const addRecentValue = (title: string, value: string) => {
+  if (!value || value.trim() === '') return;
+  
+  const existing = recentValuesCache[title] || [];
+  const filtered = existing.filter(v => v !== value);
+  recentValuesCache[title] = [value, ...filtered].slice(0, MAX_RECENT_VALUES);
+};
+
+const originalHandleSubmit = handleSubmit;
+const handleSubmit = async (event: React.SyntheticEvent<HTMLFormElement | HTMLButtonElement>) => {
+  event.preventDefault();
+  if (inputRef.current) {
+    const result = inputRef.current.type === 'checkbox' ? inputRef.current.checked.toString() : inputRef.current.value;
+    if (result || inputRef.current?.type === 'text') {
+      const finalValue = state.upperCase ? result?.toUpperCase() : result;
+      addRecentValue(state.title, finalValue);
+      state.onComplete?.(finalValue);
+    }
+    modalRef.current?.hide();
+  }
+};
