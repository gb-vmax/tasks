+function getBodyFilterDisplayName(filterValue) {
+  if (!filterValue) {
+    return 'Filter (JSONPath or XPath)';
+  }
+  
+  const decodedFilter = typeof filterValue === 'string' 
+    ? (filterValue.startsWith('$') ? filterValue : decodeBase64Filter(filterValue))
+    : '';
+  
+  if (decodedFilter.startsWith('$')) {
+    return 'JSONPath Query (e.g., $.data.items[0])';
+  } else if (decodedFilter.includes('/') || decodedFilter.includes('[')) {
+    return 'XPath Query (e.g., //item/@id)';
+  }
+  
+  return 'Filter (JSONPath or XPath)';
+}
+
+function decodeBase64Filter(value) {
+  try {
+    return Buffer.from(value, 'base64').toString('utf8');
+  } catch {
+    return value;
+  }
+}
