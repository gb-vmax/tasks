+const parseJsonSchemaInput = (input: object | { schema: object; options?: object }) => {
+    if ('schema' in input && typeof input.schema === 'object') {
+        return {
+            schema: input.schema,
+            options: input.options || {},
+        };
+    }
+    return {
+        schema: input,
+        options: {},
+    };
+};
+
+const formatAjvErrors = (errors: any[] | null | undefined): string => {
+    if (!errors || errors.length === 0) {
+        return 'No specific error details available';
+    }
+    
+    return errors.map(err => {
+        const path = err.instancePath || '/';
+        const message = err.message || 'validation failed';
+        const details = err.params ? JSON.stringify(err.params) : '';
+        return `  - Path: ${path}, Message: ${message}${details ? `, Details: ${details}` : ''}`;
+    }).join('\n');
+};
