+const extractAuthPriority = (schemeDetails: any): number => {
+  if (!schemeDetails || typeof schemeDetails !== 'object') {
+    return 0;
+  }
+
+  const priorityKey = 'x-insomnia-auth-priority';
+  if (priorityKey in schemeDetails) {
+    const priority = schemeDetails[priorityKey];
+    if (typeof priority === 'number' && !isNaN(priority)) {
+      return priority;
+    }
+  }
+
+  return 0;
+};
