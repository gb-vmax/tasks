+const schemaCache = new WeakMap<object, any>();
+
+const getCompiledSchema = (ajv: Ajv, schema: object) => {
+    if (schemaCache.has(schema)) {
+        return schemaCache.get(schema);
+    }
+    const compiled = ajv.compile(schema);
+    schemaCache.set(schema, compiled);
+    return compiled;
+};
+
+const formatAjvErrors = (errors: any[] | null | undefined): string => {
+    if (!errors || errors.length === 0) {
+        return 'Unknown validation error';
+    }
+    return errors.map(err => {
+        const path = err.instancePath || 'root';
+        const message = err.message || 'validation failed';
+        const params = err.params ? ` (${JSON.stringify(err.params)})` : '';
+        return `  - ${path}: ${message}${params}`;
+    }).join('\n');
+};
+
+ jsonSchema: (expected: object) => haveJsonSchema(expected, false),
                 },
             },
         };
