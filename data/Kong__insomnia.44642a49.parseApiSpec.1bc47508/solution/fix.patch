+interface ValidationResult {
+  isValid: boolean;
+  errors: string[];
+}
+
+function validateApiSpec(contents: Record<string, any>, format: string): ValidationResult {
+  const errors: string[] = [];
+
+  if (!contents.info) {
+    errors.push('Missing required field: info');
+  } else {
+    if (!contents.info.title) {
+      errors.push('Missing required field: info.title');
+    }
+    if (!contents.info.version) {
+      errors.push('Missing required field: info.version');
+    }
+  }
+
+  if (!contents.paths) {
+    errors.push('Missing required field: paths');
+  } else if (Object.keys(contents.paths).length === 0) {
+    errors.push('API spec has no defined paths');
+  }
+
+  if (format === 'openapi') {
+    const version = contents.openapi;
+    if (version && version.startsWith('3.')) {
+      if (!contents.info && !contents.paths && !contents.components) {
+        errors.push('OpenAPI 3.x spec appears to be empty');
+      }
+    }
+  }
+
+  return {
+    isValid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractMetadata(contents: Record<string, any>, format: string): Record<string, any> {
+  const metadata: Record<string, any> = {};
+
+  if (contents.info) {
+    if (contents.info.title) {
+      metadata.title = contents.info.title;
+    }
+    if (contents.info.version) {
+      metadata.version = contents.info.version;
+    }
+    if (contents.info.description) {
+      metadata.description = contents.info.description;
+    }
+  }
+
+  if (contents.servers && Array.isArray(contents.servers) && contents.servers.length > 0) {
+    metadata.servers = contents.servers.map((server: any) => ({
+      url: server.url,
+      description: server.description,
+    }));
+  } else if (contents.host || contents.basePath) {
+    const scheme = contents.schemes && contents.schemes[0] ? contents.schemes[0] : 'https';
+    const host = contents.host || '';
+    const basePath = contents.basePath || '';
+    metadata.servers = [{ url: `${scheme}://${host}${basePath}` }];
+  }
+
+  if (contents.paths) {
+    metadata.pathCount = Object.keys(contents.paths).length;
+  }
+
+  if (contents.tags && Array.isArray(contents.tags)) {
+    metadata.tags = contents.tags.map((tag: any) => tag.name).filter(Boolean);
+  }
+
+  return metadata;
+}
