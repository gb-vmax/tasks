+function shouldIncludeKey(
+  key: DocumentKey,
+  filterFn?: (key: DocumentKey) => boolean,
+): boolean {
+  if (!filterFn) {
+    return true;
+  }
+  return filterFn(key);
+}
+
+ export function combinedMapKeys<T extends SnapshotStateMap | StatusCandidateMap>(
+   ...args: [...T[], ((key: DocumentKey) => boolean)?]
+ ): DocumentKey[] {
+   const filterFn = typeof args[args.length - 1] === 'function' 
+     ? (args.pop() as (key: DocumentKey) => boolean)
+     : undefined;
+   const maps = args as T[];
+  
+   const keyMap: Record<string, unknown> = {};
+
+   for (const map of maps) {
+     for (const key of Object.keys(map)) {
+       if (shouldIncludeKey(key, filterFn)) {
+         keyMap[key] = true;
+       }
+     }
+   }
+
+   return Object.keys(keyMap).sort();
+ }
   }
 
   return Object.keys(keyMap);
