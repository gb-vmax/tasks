+function shouldReplaceCertificate(cert: ClientCertificate, patterns: string[]): boolean {
+    const certHost = cert.host || '';
+    
+    for (const pattern of patterns) {
+        if (certHost === pattern) {
+            return true;
+        }
+        
+        if (pattern.includes('*')) {
+            const regexPattern = pattern
+                .replace(/\./g, '\\.')
+                .replace(/\*/g, '.*');
+            const regex = new RegExp(`^${regexPattern}$`);
+            if (regex.test(certHost)) {
+                return true;
+            }
+        }
+        
+        if (certHost.includes('*')) {
+            const regexPattern = certHost
+                .replace(/\./g, '\\.')
+                .replace(/\*/g, '.*');
+            const regex = new RegExp(`^${regexPattern}$`);
+            if (regex.test(pattern)) {
+                return true;
+            }
+        }
+    }
+    
+    return false;
+}
