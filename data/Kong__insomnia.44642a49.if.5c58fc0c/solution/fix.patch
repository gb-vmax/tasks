+function extractCertificateHost(req: Request): string {
+    if (req.certificate?.matches && req.certificate.matches.length > 0) {
+        const firstMatch = req.certificate.matches[0].toString();
+        return firstMatch;
+    }
+    return req.url.getHost() || '';
+}
