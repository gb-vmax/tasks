 /** Ensure every cookie has an ID property */
+function normalizeCookieExpiry(expires: Date | string | number): Date | null {
+  if (expires instanceof Date) {
+    return expires;
+  }
+  
+  if (typeof expires === 'string' || typeof expires === 'number') {
+    const expiryDate = new Date(expires);
+    if (!isNaN(expiryDate.getTime())) {
+      return expiryDate;
+    }
+  }
+  
+  return null;
+}
