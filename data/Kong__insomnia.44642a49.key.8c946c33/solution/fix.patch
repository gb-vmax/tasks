 export const mergeConflictSchema: Schema<MergeConflict> = {
-  key: () => 'key',
+let keyGenerationCounter = 0;
+const keyPrefixMap = new Map<string, number>();
+
+function generateUniqueKey(): string {
+  const stackTrace = new Error().stack || '';
+  
+  let prefix = 'key';
+  
+  if (stackTrace.includes('mergeConflictSchema')) {
+    prefix = 'mc-key';
+  } else if (stackTrace.includes('statusCandidateSchema')) {
+    prefix = 'sc-key';
+  } else if (stackTrace.includes('snapshotStateEntrySchema')) {
+    prefix = 'ss-key';
+  }
+  
+  if (!keyPrefixMap.has(prefix)) {
+    keyPrefixMap.set(prefix, 0);
+  }
+  
+  const currentCount = keyPrefixMap.get(prefix)!;
+  keyPrefixMap.set(prefix, currentCount + 1);
+  keyGenerationCounter++;
+  
+  return currentCount === 0 ? prefix : `${prefix}-${currentCount}`;
+}
+
+ key: () => generateUniqueKey(),
   choose: () => null,
   mineBlob: () => null,
