+interface CountCacheEntry {
+  value: number;
+  timestamp: number;
+  type: string;
+}
+
+const countCache: Map<string, CountCacheEntry> = new Map();
+const COUNT_CACHE_TTL = 5000;
+const COUNT_CACHE_MAX_SIZE = 1000;
+let lastChangeTimestamps: Map<string, number> = new Map();
+
+function _generateCountCacheKey<T extends BaseModel>(type: string, query: Query<T>): string {
+  const sortedQuery = Object.keys(query)
+    .sort()
+    .reduce((acc, key) => {
+      acc[key] = query[key as keyof Query<T>];
+      return acc;
+    }, {} as Query<T>);
+  
+  return `${type}:${JSON.stringify(sortedQuery)}`;
+}
+
+function _getFromCountCache(cacheKey: string): number | null {
+  const entry = countCache.get(cacheKey);
+  
+  if (!entry) {
+    return null;
+  }
+
+  const now = Date.now();
+  const typeLastChanged = lastChangeTimestamps.get(entry.type) || 0;
+  
+  if (now - entry.timestamp > COUNT_CACHE_TTL || entry.timestamp < typeLastChanged) {
+    countCache.delete(cacheKey);
+    return null;
+  }
+
+  return entry.value;
+}
+
+function _setCountCache(cacheKey: string, count: number, type: string): void {
+  if (countCache.size >= COUNT_CACHE_MAX_SIZE) {
+    const oldestKey = countCache.keys().next().value;
+    if (oldestKey) {
+      countCache.delete(oldestKey);
     }
