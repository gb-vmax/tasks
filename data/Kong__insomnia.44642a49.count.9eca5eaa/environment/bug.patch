+
+function _invalidateCountCacheForType(type: string): void {
+  lastChangeTimestamps.set(type, Date.now());
+  
+  const keysToDelete: string[] = [];
+  for (const [key, entry] of countCache.entries()) {
+    if (entry.type === type) {
+      keysToDelete.push(key);
+    }
+  }
+  
+  for (const key of keysToDelete) {
+    countCache.delete(key);
+  }
+}
+
+const originalNotifyOfChange = notifyOfChange;
+notifyOfChange = async function<T extends BaseModel>(event: ChangeType, doc: T, fromSync: boolean) {
+  _invalidateCountCacheForType(doc.type);
