+const flushCallbacks = new Map<number, Array<() => void>>();
+
+function _registerFlushCallback(bufferId: number, callback: () => void) {
+  const callbacks = flushCallbacks.get(bufferId) || [];
+  callbacks.push(callback);
+  flushCallbacks.set(bufferId, callbacks);
+}
+
+function _executeFlushCallbacks(bufferId: number) {
+  const callbacks = flushCallbacks.get(bufferId);
+  if (callbacks) {
+    callbacks.forEach(cb => {
+      try {
+        cb();
+      } catch (err) {
+        console.warn('[db] Flush callback error:', err);
+      }
+    });
+    flushCallbacks.delete(bufferId);
+  }
+}
