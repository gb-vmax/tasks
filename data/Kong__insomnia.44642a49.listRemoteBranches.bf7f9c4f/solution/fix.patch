+interface BranchMetadata {
+  name: string;
+  isStale: boolean;
+  isDefault: boolean;
+  toString(): string;
+}
+
+function createBranchMetadata(
+  branchName: string, 
+  serverBranches: Set<string>, 
+  defaultBranch: string | null
+): BranchMetadata {
+  const isStale = serverBranches.size > 0 && !serverBranches.has(branchName);
+  const isDefault = branchName === defaultBranch;
+  
+  return {
+    name: branchName,
+    isStale,
+    isDefault,
+    toString() {
+      return this.name;
+    }
+  };
+}
+
+ async listRemoteBranches() {
