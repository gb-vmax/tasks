+         .map(ref => ref.ref.replace('refs/heads/', ''));
+     }
+   } catch (err) {
+     console.log('[git] Could not fetch remote server refs for stale branch detection', err);
+   }
+  
+   const serverBranchSet = new Set(serverBranches);
+   const enrichedBranches = filteredBranches.map(branch => 
+     createBranchMetadata(branch, serverBranchSet, defaultBranch)
+   );
+  
+   return GitVCS.sortBranches(enrichedBranches as any) as string[];
