+function _selectCanonicalCookieJar(cookieJars: CookieJar[]): CookieJar {
+  return cookieJars.reduce((oldest, current) => {
+    return (current.created || 0) < (oldest.created || 0) ? current : oldest;
+  }, cookieJars[0]);
 }
 
