+private resolveVariablesInString(str: string): string {
+    if (!str || !str.includes('{{')) {
+        return str;
+    }
+    
+    let resolved = str;
+    const variablePattern = /\{\{([^}]+)\}\}/g;
+    const matches = str.matchAll(variablePattern);
+    
+    for (const match of matches) {
+        const varName = match[1].trim();
+        const variable = this.variables.find(v => v.key === varName);
+        
+        if (variable && variable.value !== undefined) {
+            resolved = resolved.replace(match[0], String(variable.value));
         }
