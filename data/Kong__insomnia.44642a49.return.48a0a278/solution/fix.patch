+ removeQueryParams(params: QueryParam[] | string[] | string, mode?: 'remove' | 'disable') {
+     const shouldDisable = mode === 'disable';
+    
+     if (typeof params === 'string') {
+         const resolvedKey = this.resolveVariablesInString(params);
+        
+         if (shouldDisable) {
+             this.query.each(queryParam => {
+                 if (queryParam.key === resolvedKey || queryParam.key === params) {
+                     (queryParam as any).disabled = true;
+                 }
+             }, {});
+         } else {
+             this.query = new PropertyList(
+                 QueryParam,
+                 undefined,
+                 this.query.filter(queryParam => {
+                     return queryParam.key !== resolvedKey && queryParam.key !== params;
+                 }, {})
+             );
+         }
+     } else if (params.length > 0) {
+         let toBeRemoved: Set<string>;
+
+         if (typeof params[0] === 'string') {
+             const resolvedKeys = (params as string[]).map(key => this.resolveVariablesInString(key));
+             toBeRemoved = new Set([...(params as string[]), ...resolvedKeys]);
+         } else {
+             const queryParams = params as QueryParam[];
+             const keys = queryParams.map(param => param.key);
+             const resolvedKeys = keys.map(key => this.resolveVariablesInString(key));
+             toBeRemoved = new Set([...keys, ...resolvedKeys]);
+         }
+
+         if (shouldDisable) {
+             this.query.each(queryParam => {
+                 if (toBeRemoved.has(queryParam.key)) {
+                     (queryParam as any).disabled = true;
+                 }
+             }, {});
+         } else {
+             this.query = new PropertyList(
+                 QueryParam,
+                 undefined,
+                 this.query.filter(queryParam => !toBeRemoved.has(queryParam.key), {})
+             );
+         }
+     } else {
+         throw Error('failed to remove query params: unknown params type, only supports QueryParam[], string[] or string');
+     }
+ }
 
