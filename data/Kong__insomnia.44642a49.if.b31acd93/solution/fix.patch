+    const existingDocs = await database.find<T>(doc.type, query);
+    const duplicate = existingDocs.find(d => d._id !== doc._id);
+    
+    if (duplicate) {
+      return {
+        hasDuplicate: true,
+        duplicateId: duplicate._id,
+        existingDoc: duplicate,
+      };
     }
+  }
+
+  return { hasDuplicate: false };
+}
+
+function _getUniqueFields(type: string): string[][] {
