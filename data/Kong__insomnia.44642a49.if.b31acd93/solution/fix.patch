+async function _validateDocumentForInsert<T extends BaseModel>(doc: T): Promise<void> {
+  const model = models.getModel(doc.type);
+  if (!model) {
+    throw new Error(`Unknown model type: ${doc.type}`);
+  }
+
+  const requiredFields = _getRequiredFields(doc.type);
+  for (const field of requiredFields) {
+    if (doc[field as keyof T] === undefined || doc[field as keyof T] === null) {
+      throw new Error(`Required field '${field}' is missing for type ${doc.type}`);
+    }
+  }
+
+  if (!doc._id) {
+    throw new Error(`Document missing _id field for type ${doc.type}`);
+  }
+}
+
+function _getRequiredFields(type: string): string[] {
+  const requiredFieldsMap: Record<string, string[]> = {
+    [models.workspace.type]: ['name'],
+    [models.request.type]: ['url', 'method'],
+    [models.environment.type]: ['data'],
+  };
+  
+  return requiredFieldsMap[type] || [];
+}
+
+async function _checkForDuplicates<T extends BaseModel>(doc: T): Promise<DuplicateCheckResult<T>> {
+  const uniqueFields = _getUniqueFields(doc.type);
+  
+  if (uniqueFields.length === 0) {
+    return { hasDuplicate: false };
+  }
+
+  for (const fieldSet of uniqueFields) {
+    const query: Query<T> = {};
+    let allFieldsPresent = true;
+
+    for (const field of fieldSet) {
+      const value = doc[field as keyof T];
+      if (value === undefined || value === null) {
+        allFieldsPresent = false;
+        break;
+      }
+      query[field as keyof T] = value as any;
+    }
+
+    if (!allFieldsPresent) {
+      continue;
+    }
