+const generateStringWithLength = (minLength?: number, maxLength?: number): string => {
+  const defaultLength = 6;
+  let targetLength = defaultLength;
+
+  if (minLength !== undefined && maxLength !== undefined) {
+    targetLength = Math.min(maxLength, Math.max(minLength, defaultLength));
+  } else if (minLength !== undefined) {
+    targetLength = Math.max(minLength, defaultLength);
+  } else if (maxLength !== undefined) {
+    targetLength = Math.min(maxLength, defaultLength);
+  }
+
+  return 'string'.padEnd(targetLength, 'x').slice(0, targetLength);
+};
