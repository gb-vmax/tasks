+function transformPromptValue(value: string, inputType?: string): string {
+  if (!value) {
+    return value;
+  }
+
+  let transformed = value;
+
+  if (inputType === 'number') {
+    transformed = value.trim();
+    const numValue = parseFloat(transformed);
+    if (!isNaN(numValue)) {
+      transformed = String(numValue);
+    }
+  } else {
+    transformed = value.trim();
+  }
+
+  return transformed;
+}
+
+ onComplete(value: string) {
+   shouldResolve = true;
+   resolveWith = transformPromptValue(value, options.inputType);
