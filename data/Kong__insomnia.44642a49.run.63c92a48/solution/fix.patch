+function encodeFileContent(buffer, encoding) {
+  const normalizedEncoding = (encoding || 'utf8').toLowerCase();
+  
+  switch (normalizedEncoding) {
+    case 'utf8':
+    case 'utf-8':
+      return buffer.toString('utf8');
+    case 'base64':
+      return buffer.toString('base64');
+    case 'hex':
+      return buffer.toString('hex');
+    case 'latin1':
+    case 'binary':
+      return buffer.toString('latin1');
+    default:
+      throw new Error(`Unsupported encoding "${encoding}". Supported encodings are: utf8, base64, hex, latin1`);
+  }
+}
+
+ async run(context, path, encoding = 'utf8') {
+   if (!path) {
+     throw new Error('No file selected');
+   }
+
+   const buffer = fs.readFileSync(path);
+  
+   return encodeFileContent(buffer, encoding);
+ }
