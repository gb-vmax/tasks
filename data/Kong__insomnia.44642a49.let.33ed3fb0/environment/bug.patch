+ function getRequestPostData(renderedRequest: RenderedRequest): Har.PostData | undefined {
+   let body;
+   if (renderedRequest.body.fileName) {
+     try {
+       const filePath = renderedRequest.body.fileName;
+       const maxFileSize = renderedRequest.body.maxFileSize || 100 * 1024 * 1024;
+      
+       const stats = fs.statSync(filePath);
+       if (stats.size > maxFileSize) {
+         console.warn(`[code gen] File size (${stats.size} bytes) exceeds limit (${maxFileSize} bytes)`);
+         return;
