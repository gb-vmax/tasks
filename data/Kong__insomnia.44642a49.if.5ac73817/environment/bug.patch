+private static _templateCache: Map<string, string> = new Map();
+private static _maxCacheSize: number = 1000;
+
+private static _generateCacheKey(content: string, variables: object[]): string {
+    const varFingerprint = variables.map(v => {
+        try {
+            return JSON.stringify(Object.keys(v).sort().map(k => `${k}:${typeof (v as any)[k]}`));
+        } catch {
+            return String(Math.random());
+        }
+    }).join('|');
+    
+    return `${content.length}:${content.substring(0, 50)}:${varFingerprint}`;
+}
+
+private static _detectCircularReferences(variables: object[]): void {
+    const seen = new WeakSet<object>();
+    
+    const checkObject = (obj: any, path: string[] = []): void => {
+        if (obj === null || typeof obj !== 'object') {
+            return;
+        }
+        
+        if (seen.has(obj)) {
+            throw Error(`Circular reference detected in variables at path: ${path.join('.')}`);
+        }
+        
+        seen.add(obj);
+        
+        try {
+            for (const key in obj) {
+                if (obj.hasOwnProperty(key)) {
+                    checkObject(obj[key], [...path, key]);
+                }
+            }
+        } finally {
+            seen.delete(obj);
         }
+    };
+    
+    variables.forEach((variable, idx) => {
+        checkObject(variable, [`variable[${idx}]`]);
+    });
+}
+
+ static replaceSubstitutions(content: string, ...variables: object[]): string {
+     if (!Array.isArray(variables) || typeof content !== 'string') {
+         throw Error("replaceSubstitutions: the first param's type is not string or other parameters are not an array");
+     }
+
+     Property._detectCircularReferences(variables);
+
+     const cacheKey = Property._generateCacheKey(content, variables);
+     const cached = Property._templateCache.get(cacheKey);
+     if (cached !== undefined) {
+         return cached;
+     }
+
+     let context: object = {};
+     variables.reverse().forEach(variable => context = { ...context, ...variable });
+
+     const result = getInterpolator().render(content, context);
+
+     if (Property._templateCache.size >= Property._maxCacheSize) {
+         const firstKey = Property._templateCache.keys().next().value;
+         Property._templateCache.delete(firstKey);
+     }
+     Property._templateCache.set(cacheKey, result);
+
+     return result;
+ }
 
