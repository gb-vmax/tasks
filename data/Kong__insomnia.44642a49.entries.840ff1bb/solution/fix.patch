+export function resolveComponentSchemaRefs(
+  spec: ParsedApiSpec,
+  methodInfo: Record<string, any>,
+) {
+  const schemas = spec.contents?.components?.schemas;
+  if (!schemas) {
+    return;
+  }
+
+  const resolveRefs = (obj: Record<string, any>, visitedRefs?: Set<string>): Record<string, any> => {
+    if (typeof obj !== 'object') {
+      return obj;
+    }
+
+    if (Array.isArray(obj)) {
+      return obj.map(item => resolveRefs(item, visitedRefs ? new Set(visitedRefs) : undefined));
+    }
+
+    if (obj.$ref) {
+      const ref = obj.$ref.replace('#/components/schemas/', '');
+      
+      if (!visitedRefs) {
+        visitedRefs = new Set();
+      }
+      
+      if (visitedRefs.has(ref)) {
+        return {
+          $circularRef: obj.$ref,
+          $refPath: Array.from(visitedRefs).concat(ref).join(' -> ')
+        };
+      }
+      
+      const newVisited = new Set(visitedRefs);
+      newVisited.add(ref);
+      
+      if (schemas[ref]) {
+        return resolveRefs(schemas[ref], newVisited);
+      }
+      
+      return obj;
+    }
+
     const resolved: Record<string, any> = {};
     for (const [key, value] of Object.entries(obj)) {
-      resolved[key] = resolveRefs(value);
+      resolved[key] = resolveRefs(value, visitedRefs ? new Set(visitedRefs) : undefined);
     }
 
     return resolved;
