+function extractJsonPath(obj: any, path: string): any {
+    if (!path || path === '') {
+        return obj;
+    }
+    
+    const segments = path.split('.').filter(s => s.length > 0);
+    let current = obj;
+    
+    for (let i = 0; i < segments.length; i++) {
+        const segment = segments[i];
+        const arrayMatch = segment.match(/^(.+)\[(\d+)\]$/);
+        
+        if (arrayMatch) {
+            const prop = arrayMatch[1];
+            const index = parseInt(arrayMatch[2], 10);
+            
+            if (current === null || current === undefined) {
+                throw Error(`json: cannot access property '${prop}' of ${current} at path segment ${i}`);
+            }
+            
+            current = current[prop];
+            
+            if (!Array.isArray(current)) {
+                throw Error(`json: expected array at '${prop}' but got ${typeof current}`);
+            }
+            
+            if (index < 0 || index >= current.length) {
+                throw Error(`json: array index ${index} out of bounds at '${prop}'`);
+            }
+            
+            current = current[index];
+        } else {
+            if (current === null || current === undefined) {
+                throw Error(`json: cannot access property '${segment}' of ${current} at path segment ${i}`);
+            }
+            
+            if (typeof current !== 'object') {
+                throw Error(`json: cannot access property '${segment}' of non-object type ${typeof current}`);
+            }
+            
+            if (!(segment in current)) {
+                throw Error(`json: property '${segment}' does not exist in object`);
+            }
+            
+            current = current[segment];
         }
     }
+    
+    return current;
+}
