+         const mimeType = contentInfo.mimeType.toLowerCase();
+        
+         if (!mimeType.includes('json') && !mimeType.includes('javascript')) {
+             throw Error(`json: strict mode requires JSON content-type, got: ${mimeType}`);
+         }
+        
+         const trimmedBody = this.body.toString().trim();
+         if (trimmedBody.length !== this.body.toString().length) {
+             throw Error('json: strict mode detected leading or trailing whitespace in response body');
+         }
+        
+         if (trimmedBody.length === 0) {
+             throw Error('json: strict mode requires non-empty response body');
+         }
+     }
