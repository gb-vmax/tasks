+  type!: string;
+  reason!: string;
+  extraInfo?: Record<string, string>;
+  snippet?: {
+    before: string;
+    line: string;
+    after: string;
+  };
+  originalStack?: string;
+
+  setSnippet(text: string, maxContextLines: number = 2): void {
+    if (!text || !this.location) {
+      return;
+    }
+
+    const lines = text.split('\n');
+    const errorLine = this.location.line - 1;
+
+    if (errorLine < 0 || errorLine >= lines.length) {
+      return;
+    }
+
+    const startLine = Math.max(0, errorLine - maxContextLines);
+    const endLine = Math.min(lines.length - 1, errorLine + maxContextLines);
+
+    this.snippet = {
+      before: lines.slice(startLine, errorLine).join('\n'),
+      line: lines[errorLine],
+      after: lines.slice(errorLine + 1, endLine + 1).join('\n'),
+    };
+  }
+
+  preserveOriginalStack(originalError: Error): void {
+    if (originalError && originalError.stack) {
+      this.originalStack = originalError.stack;
+    }
+  }
+}
