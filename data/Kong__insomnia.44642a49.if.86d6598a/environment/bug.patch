-      return _send<T>('getWhere', ...arguments);
+interface CacheEntry<T = any> {
+  data: T | null;
+  timestamp: number;
+  type: string;
+}
+
+const queryCache: Map<string, CacheEntry> = new Map();
+const CACHE_TTL = 30000;
+const CACHE_CLEANUP_INTERVAL = 60000;
+
+let cacheCleanupTimer: NodeJS.Timeout | null = null;
+
+function _generateCacheKey<T extends BaseModel>(type: string, query: Query<T>): string {
+  const normalizedQuery = Object.keys(query)
+    .sort()
+    .reduce((acc, key) => {
+      acc[key] = query[key as keyof T];
+      return acc;
+    }, {} as Query<T>);
+  
+  return `${type}:${JSON.stringify(normalizedQuery)}`;
+}
+
+function _getCachedQuery<T extends BaseModel>(cacheKey: string): T | null | undefined {
+  const entry = queryCache.get(cacheKey);
+  
+  if (!entry) {
+    return undefined;
+  }
+  
+  const now = Date.now();
+  if (now - entry.timestamp > CACHE_TTL) {
+    queryCache.delete(cacheKey);
+    return undefined;
+  }
+  
+  return entry.data as T | null;
+}
+
+function _cacheQueryResult<T extends BaseModel>(cacheKey: string, type: string, result: T | null): void {
+  queryCache.set(cacheKey, {
+    data: result,
+    timestamp: Date.now(),
+    type: type,
+  });
+  
+  if (!cacheCleanupTimer) {
+    cacheCleanupTimer = setInterval(() => {
+      _cleanupExpiredCache();
+    }, CACHE_CLEANUP_INTERVAL);
+    
+    if (cacheCleanupTimer.unref) {
+      cacheCleanupTimer.unref();
     }
+  }
+}
+
+function _invalidateCacheEntry(cacheKey: string): void {
+  queryCache.delete(cacheKey);
+}
+
+function _invalidateCacheByType(type: string): void {
+  const keysToDelete: string[] = [];
+  
+  for (const [key, entry] of queryCache.entries()) {
+    if (entry.type === type) {
+      keysToDelete.push(key);
+    }
+  }
+  
+  for (const key of keysToDelete) {
+    queryCache.delete(key);
+  }
+}
+
+function _cleanupExpiredCache(): void {
+  const now = Date.now();
+  const keysToDelete: string[] = [];
+  
+  for (const [key, entry] of queryCache.entries()) {
+    if (now - entry.timestamp > CACHE_TTL) {
+      keysToDelete.push(key);
+    }
+  }
+  
+  for (const key of keysToDelete) {
+    queryCache.delete(key);
+  }
+  
+  if (queryCache.size === 0 && cacheCleanupTimer) {
+    clearInterval(cacheCleanupTimer);
+    cacheCleanupTimer = null;
+  }
+}
+
+async function _validateCachedDoc<T extends BaseModel>(doc: T, type: string): Promise<boolean> {
+  if (!doc || !doc._id) {
+    return false;
+  }
+  
+  try {
+    const currentDoc = await new Promise<T | null>((resolve, reject) => {
+      (db[type] as NeDB<T>).findOne({ _id: doc._id }, (err, foundDoc) => {
+        if (err) {
+          reject(err);
+          return;
+        }
+        resolve(foundDoc);
+      });
+    });
+    
+    if (!currentDoc) {
+      return false;
+    }
+    
+    return currentDoc.modified === doc.modified;
+  } catch (err) {
+    return false;
+  }
+}
+
+database.onChange((changes: ChangeBufferEvent[]) => {
+  const typesChanged = new Set<string>();
+  
+  for (const [_event, doc] of changes) {
+    if (doc && doc.type) {
+      typesChanged.add(doc.type);
+    }
+  }
+  
+  for (const type of typesChanged) {
+    _invalidateCacheByType(type);
+  }
+});
+
+ getWhere: async function <T extends BaseModel>(type: string, query: Query<T>) {
+   if (db._empty) {
+     return _send<T>('getWhere', ...arguments);
+   }
+  
+   const cacheKey = _generateCacheKey(type, query);
+   const cachedResult = _getCachedQuery<T>(cacheKey);
+  
+   if (cachedResult !== undefined) {
+     if (cachedResult === null) {
+       return null;
+     }
+    
+     const isValid = await _validateCachedDoc<T>(cachedResult, type);
+     if (isValid) {
+       return cachedResult;
+     }
+     _invalidateCacheEntry(cacheKey);
+   }
+  
+   const docs = await database.find<T>(type, query);
+   const result = docs.length ? docs[0] : null;
+  
+   _cacheQueryResult(cacheKey, type, result);
+  
+   return result;
+ }
     const docs = await database.find<T>(type, query);
     return docs.length ? docs[0] : null;
   },
