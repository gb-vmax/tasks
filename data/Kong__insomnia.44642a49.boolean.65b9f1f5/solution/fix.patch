+  for (const pattern of likelyTruePatterns) {
+    if (pattern.test(combined)) {
+      return true;
+    }
+  }
+  
+  for (const pattern of likelyFalsePatterns) {
+    if (pattern.test(combined)) {
+      return false;
+    }
+  }
+  
+  return null;
+};
