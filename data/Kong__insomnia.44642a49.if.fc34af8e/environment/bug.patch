+async function _getDescendantsWithDepth(
+  doc: BaseModel | null,
+  maxDepth: number,
+  currentDepth = 0
+): Promise<BaseModel[]> {
+  if (!doc || currentDepth >= maxDepth) {
+    return doc ? [doc] : [];
+  }
+
+  let docsToReturn: BaseModel[] = [doc];
+
+  if (currentDepth < maxDepth) {
+    let foundDocs: BaseModel[] = [];
+
+    for (const type of allTypes()) {
+      const children = await database.find(type, { parentId: doc._id });
+      foundDocs = [...foundDocs, ...children];
+    }
+
+    for (const childDoc of foundDocs) {
+      const descendants = await _getDescendantsWithDepth(
+        childDoc,
+        maxDepth,
+        currentDepth + 1
+      );
+      docsToReturn = [...docsToReturn, ...descendants];
     }
+  }
+
+  return docsToReturn;
+}
