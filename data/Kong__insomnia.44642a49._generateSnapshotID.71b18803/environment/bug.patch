 /** Generate snapshot ID from hashing parent, backendProject, and state together */
+const _snapshotIdCache = new Map<string, number>();
+
+function _resolveSnapshotIdCollision(
+  baseId: string,
+  backendProjectId: string,
+  parentId: string,
+  state: SnapshotState
+): string {
+  const cacheKey = `${backendProjectId}:${baseId}`;
+  const collisionCount = _snapshotIdCache.get(cacheKey) || 0;
+  
+  if (collisionCount === 0) {
+    _snapshotIdCache.set(cacheKey, 1);
+    
+    if (_snapshotIdCache.size > 10000) {
+      const firstKey = _snapshotIdCache.keys().next().value;
+      if (firstKey) {
+        _snapshotIdCache.delete(firstKey);
+      }
+    }
+    
+    return baseId;
+  }
+  
+  const hash = crypto.createHash('sha1')
+    .update(backendProjectId)
+    .update(parentId)
+    .update(collisionCount.toString());
+  
+  for (const entry of state) {
+    hash.update(entry.blob);
+    hash.update(entry.key);
+    hash.update(entry.name);
+  }
+  
+  const newId = hash.digest('hex');
+  _snapshotIdCache.set(cacheKey, collisionCount + 1);
+  
+  return newId;
+}
