+function parseAncestorOptions(options: any): { types: string[]; sort: string | null } {
+  if (!options || typeof options !== 'object') {
+    return { types: [], sort: null };
+  }
+  
+  const result: { types: string[]; sort: string | null } = {
+    types: [],
+    sort: null,
+  };
+  
+  if (options.type) {
+    result.types = Array.isArray(options.type) ? options.type : [options.type];
+  } else if (options.types) {
+    result.types = Array.isArray(options.types) ? options.types : [options.types];
+  }
+  
+  if (options.sort === 'closest' || options.sort === 'farthest') {
+    result.sort = options.sort;
+  }
+  
+  return result;
+}
+
+ getAncestors: async (request: any, options?: any) => {
