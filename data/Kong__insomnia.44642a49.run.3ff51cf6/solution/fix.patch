+function parseUuidNamespace(namespaceInput) {
+  if (!namespaceInput || typeof namespaceInput !== 'string') {
+    return uuid.v5.DNS;
+  }
+  
+  const input = namespaceInput.toLowerCase().trim();
+  
+  switch (input) {
+    case 'dns':
+      return uuid.v5.DNS;
+    case 'url':
+      return uuid.v5.URL;
+    case 'oid':
+      return uuid.v5.OID;
+    case 'x500':
+      return uuid.v5.X500;
+    default:
+      if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(input)) {
+        return input;
+      }
+      return uuid.v5.DNS;
+  }
+}
+
+function applyUuidFormatting(uuidString, format) {
+  if (!format || typeof format !== 'string') {
+    return uuidString;
+  }
+  
+  const formatLower = format.toLowerCase().trim();
+  let result = uuidString;
+  
+  if (formatLower.includes('upper') || formatLower.includes('uppercase')) {
+    result = result.toUpperCase();
+  }
+  
+  if (formatLower.includes('nohyphen') || formatLower.includes('no-hyphen') || formatLower.includes('compact')) {
+    result = result.replace(/-/g, '');
+  }
+  
+  return result;
+}
