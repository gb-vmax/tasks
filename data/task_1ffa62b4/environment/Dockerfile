FROM endless-base:latest
RUN <<'ENDSETUP'
#!/bin/bash
set -e

# Create the edge directory
mkdir -p /home/user/edge

# Create the master INI configuration file
cat > /home/user/edge/device_master.ini << 'EOF'
; Master configuration for IoT edge sensor nodes
; Generated by provisioning system

[device]
id = node-47-alpha
firmware_version = 2.11.4
location = warehouse-B
manufacturer = SensorTech

[network]
broker_host = mqtt.edgefleet.internal
broker_port = 1883
use_tls = false
keepalive_sec = 60
reconnect_delay = 5

[sensors]
poll_interval_sec = 30
enabled_sensors = temp,humidity,pressure
calibration_offset = -1.2

[thresholds]
temp_max_celsius = 85
temp_min_celsius = -10
humidity_max_pct = 95
battery_min_pct = 15
EOF

# Do NOT create deploy_summary.conf — the agent will create it

chown -R user:user /home/user
ENDSETUP

WORKDIR /home/user
