+function normalizeUrlSafeBase64(text: string): string {
+  let normalized = text.replace(/-/g, '+').replace(/_/g, '/');
+  return restoreBase64Padding(normalized);
+}
+
+function restoreBase64Padding(text: string): string {
+  const paddingNeeded = (4 - (text.length % 4)) % 4;
+  return text + '='.repeat(paddingNeeded);
+}
+
+ run(_context, action: 'encode' | 'decode', kind: 'normal' | 'url' | 'hex', text) {
+   text = text || '';
+   invariant(action === 'encode' || action === 'decode', 'invalid action');
+   invariant(kind === 'normal' || kind === 'url' || kind === 'hex', 'invalid kind');
+   if (action === 'encode') {
+     if (kind === 'normal') {
+       return Buffer.from(text, 'utf8').toString('base64');
+     }
+     if (kind === 'hex') {
+       return Buffer.from(text, 'hex').toString('base64');
+     }
+     if (kind === 'url') {
+       return Buffer.from(text, 'utf8')
+         .toString('base64')
+         .replace(/\+/g, '-')
+         .replace(/\//g, '_')
+         .replace(/=/g, '');
+     }
+   }
+   if (action === 'decode') {
+     let processedText = text;
+    
+     if (kind === 'url') {
+       processedText = normalizeUrlSafeBase64(text);
+     } else if (kind === 'normal') {
+       processedText = restoreBase64Padding(text);
+       processedText = normalizeUrlSafeBase64(processedText);
+     }
+    
+     if (kind === 'hex') {
+       processedText = restoreBase64Padding(processedText);
+       return Buffer.from(processedText, 'base64').toString('hex');
+     }
+     return Buffer.from(processedText, 'base64').toString('utf8');
+   }
+   if (kind === 'hex') {
+     return Buffer.from(text, 'base64').toString('hex');
+   }
+   return Buffer.from(text, 'base64').toString('utf8');
+ }
