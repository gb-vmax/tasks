+async _cleanupExpiredDeletions(prefix: string, gracePeriodMs: number) {
+  const allDocs = await models.pluginData.all(plugin.name) || [];
+  const now = Date.now();
+  
+  for (const doc of allDocs) {
+    if (doc.key.startsWith(prefix)) {
+      const timestampMatch = doc.key.match(/^__deleted__(\d+):/);
+      if (timestampMatch) {
+        const deletionTime = parseInt(timestampMatch[1], 10);
+        if (now - deletionTime > gracePeriodMs) {
+          await models.pluginData.removeByKey(plugin.name, doc.key);
+        }
+      }
+    }
+  }
+}
+
+ async removeItem(key: string) {
+   const SOFT_DELETE_PREFIX = '__deleted__';
+   const GRACE_PERIOD_MS = 7 * 24 * 60 * 60 * 1000;
+  
+   await this._cleanupExpiredDeletions(SOFT_DELETE_PREFIX, GRACE_PERIOD_MS);
+  
+   const doc = await models.pluginData.getByKey(plugin.name, key);
+   if (doc) {
+     const deletionKey = `${SOFT_DELETE_PREFIX}${Date.now()}:${key}`;
+     await models.pluginData.upsertByKey(plugin.name, deletionKey, doc.value);
+     await models.pluginData.removeByKey(plugin.name, key);
+   } else {
+     await models.pluginData.removeByKey(plugin.name, key);
+   }
+ },
 
