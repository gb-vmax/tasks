+function generateColorVariations(color: Color) {
+  try {
+    const hsl = color.hsl();
+    const lightness = hsl.color[2];
+    
+    const lighter10 = color.lightness(Math.min(100, lightness + 10));
+    const lighter20 = color.lightness(Math.min(100, lightness + 20));
+    const darker10 = color.lightness(Math.max(0, lightness - 10));
+    const darker20 = color.lightness(Math.max(0, lightness - 20));
+    
+    return {
+      lighter10: lighter10.rgb().string(),
+      lighter20: lighter20.rgb().string(),
+      darker10: darker10.rgb().string(),
+      darker20: darker20.rgb().string(),
+    };
+  } catch (err) {
+    console.log('[theme] Failed to generate color variations', err);
+    return null;
+  }
+}
