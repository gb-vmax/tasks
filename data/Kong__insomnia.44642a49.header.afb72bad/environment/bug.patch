+const haveHeader = (expected: string | { name: string; value?: string; namePattern?: RegExp; valuePattern?: RegExp }, checkEquality: boolean) => {
+    if (typeof expected === 'string') {
+        verify(
+            this.headers.toObject().find(header => header.key === expected) !== undefined,
+            checkEquality,
+        );
+    } else {
+        const headers = this.headers.toObject();
+        let matchFound = false;
+
+        for (const header of headers) {
+            let nameMatches = false;
+            
+            if (expected.namePattern) {
+                nameMatches = expected.namePattern.test(header.key);
+            } else {
+                nameMatches = header.key === expected.name;
+            }
+
+            if (!nameMatches) {
+                continue;
+            }
+
+            if (expected.value !== undefined) {
+                if (header.value === expected.value) {
+                    matchFound = true;
+                    break;
+                }
+            } else if (expected.valuePattern) {
+                if (expected.valuePattern.test(header.value)) {
+                    matchFound = true;
+                    break;
+                }
+            } else {
+                matchFound = true;
+                break;
+            }
+        }
+
+        verify(matchFound, checkEquality);
+    }
+};
+
