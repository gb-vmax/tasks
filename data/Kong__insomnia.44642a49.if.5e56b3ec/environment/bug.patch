+function describeNestedChanges(
+  aValue: any,
+  bValue: any,
+  prefix: string,
+  maxDepth: number
+): string[] {
+  const changes: string[] = [];
+  
+  if (maxDepth < 0) {
+    changes.push(prefix);
+    return changes;
+  }
+  
+  const aObj = aValue || {};
+  const bObj = bValue || {};
+  const allNestedKeys = [...Object.keys({ ...aObj, ...bObj })];
+  
+  for (const nestedKey of allNestedKeys) {
+    const aNestedValue = aObj[nestedKey];
+    const bNestedValue = bObj[nestedKey];
+    const fullPath = `${prefix}.${nestedKey}`;
+    
+    const aNestedStr = deterministicStringify(aNestedValue);
+    const bNestedStr = deterministicStringify(bNestedValue);
+    
+    if (aNestedValue === undefined && bNestedValue !== undefined) {
+      changes.push(`+${fullPath}`);
+      continue;
+    }
+    
+    if (aNestedValue !== undefined && bNestedValue === undefined) {
+      changes.push(`-${fullPath}`);
       continue;
