+function getChangeType(aValue: any, bValue: any): 'primitive' | 'nested' | 'array' {
+  const aType = Object.prototype.toString.call(aValue);
+  const bType = Object.prototype.toString.call(bValue);
+  
+  if (aType === '[object Array]' || bType === '[object Array]') {
+    return 'array';
+  }
+  
+  if (aType === '[object Object]' && bType === '[object Object]') {
+    return 'nested';
