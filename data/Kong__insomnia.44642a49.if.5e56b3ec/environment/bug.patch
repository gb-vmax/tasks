+        const deeperChanges = describeNestedChanges(
+          aNestedValue,
+          bNestedValue,
+          fullPath,
+          maxDepth - 1
+        );
+        changes.push(...deeperChanges);
+      } else {
+        changes.push(fullPath);
+      }
+    }
+  }
+  
+  return changes;
+}
