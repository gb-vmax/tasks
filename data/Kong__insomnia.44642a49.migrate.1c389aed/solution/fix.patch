+function normalizeMetadata(metadata: any[]): GrpcRequestHeader[] {
+  return metadata
+    .filter(item => item && typeof item === 'object' && typeof item.name === 'string')
+    .map(item => ({
+      name: item.name,
+      value: typeof item.value === 'string' ? item.value : '',
+      description: typeof item.description === 'string' ? item.description : undefined,
+      disabled: typeof item.disabled === 'boolean' ? item.disabled : undefined,
+    }));
+}
+
+function normalizeBodyText(text: string): string {
+  if (!text || text.trim() === '') {
+    return '{}';
+  }
+  
+  try {
+    const parsed = JSON.parse(text);
+    return JSON.stringify(parsed);
+  } catch {
+    return '{}';
+  }
+}
+
+function arraysEqual(a: GrpcRequestHeader[], b: any[]): boolean {
+  if (a.length !== b.length) return false;
+  
+  for (let i = 0; i < a.length; i++) {
+    if (a[i].name !== b[i].name || 
+        a[i].value !== b[i].value ||
+        a[i].description !== b[i].description ||
+        a[i].disabled !== b[i].disabled) {
+      return false;
+    }
+  }
+  
+  return true;
+}
