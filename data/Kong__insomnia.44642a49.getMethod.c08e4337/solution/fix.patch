+function normalizeHttpMethod(method: string): string {
+  if (typeof method !== 'string') {
+    return method;
+  }
+  return method.toUpperCase();
+}
+
+function trackMethodAccess(renderedRequest: RenderedRequest) {
+  if (!renderedRequest._methodAccessHistory) {
+    (renderedRequest as any)._methodAccessHistory = [];
+  }
+  
+  const history = (renderedRequest as any)._methodAccessHistory;
+  const timestamp = Date.now();
+  
+  history.push(timestamp);
+  
+  if (history.length > 100) {
+    history.shift();
+  }
+}
+
+ getMethod(options?: { raw?: boolean; track?: boolean }) {
+   const opts = options || {};
+   const shouldTrack = opts.track !== false;
+   const returnRaw = opts.raw === true;
+  
+   if (shouldTrack) {
+     trackMethodAccess(renderedRequest);
+   }
+  
+   const method = renderedRequest.method;
+  
+   if (returnRaw || !method) {
+     return method;
+   }
+  
+   return normalizeHttpMethod(method);
+ },
 
