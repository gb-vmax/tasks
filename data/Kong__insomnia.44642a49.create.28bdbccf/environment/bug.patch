+function validateAndSanitizeCookies(cookies: Cookie[]): Cookie[] {
+  if (!Array.isArray(cookies)) {
+    return [];
+  }
+
+  return cookies.filter(cookie => {
+    if (!cookie || typeof cookie !== 'object') {
+      return false;
+    }
+    
+    if (typeof cookie.key !== 'string' || typeof cookie.value !== 'string') {
+      return false;
+    }
+    
+    if (typeof cookie.domain !== 'string' || typeof cookie.path !== 'string') {
+      return false;
+    }
+    
+    return true;
+  }).map(cookie => ({
+    ...cookie,
+    secure: Boolean(cookie.secure),
+    httpOnly: Boolean(cookie.httpOnly),
+    expires: cookie.expires || null,
+  }));
+}
+
+function ensureCookieIds(cookies: Cookie[]): Cookie[] {
+  return cookies.map(cookie => {
+    if (!cookie.id) {
+      return { ...cookie, id: uuidv4() };
+    }
+    return cookie;
+  });
+}
