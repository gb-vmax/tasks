+const haveBody = (expected: string | RegExp, checkEquality: boolean) => {
+    const bodyText = this.text();
+    
+    if (expected instanceof RegExp) {
+        const matches = expected.test(bodyText);
+        if ((matches && checkEquality) || (!matches && !checkEquality)) {
+            return;
+        }
+        throw Error(`Body does not match the expected pattern: "${expected}"`);
+    }
+    
+    if (typeof expected === 'string' && expected.startsWith('contains:')) {
+        const substring = expected.slice('contains:'.length);
+        const contains = bodyText.includes(substring);
+        if ((contains && checkEquality) || (!contains && !checkEquality)) {
+            return;
+        }
+        throw Error(`Body does not contain the expected substring: "${substring}"`);
+    }
+    
+    verify(bodyText, expected, checkEquality);
+};
