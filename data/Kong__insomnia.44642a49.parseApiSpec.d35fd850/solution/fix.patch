+export interface ParsedApiSpec {
+  contents: Record<string, any> | null;
+  rawContents: string;
+  format: 'openapi' | 'swagger' | null;
+  formatVersion: string | null;
+  metadata: {
+    title: string | null;
+    version: string | null;
+    description: string | null;
+  };
+  validationWarnings: string[];
+}
+
+function isValidOpenApiVersion(version: string): boolean {
+  const validVersionPatterns = [
+    /^3\.0\.\d+$/,
+    /^3\.1\.\d+$/,
+  ];
+  return validVersionPatterns.some(pattern => pattern.test(version));
+}
+
+function isValidSwaggerVersion(version: string): boolean {
+  return version === '2.0';
+}
+
+function extractApiMetadata(info: Record<string, any>): {
+  title: string | null;
+  version: string | null;
+  description: string | null;
+} {
+  return {
+    title: typeof info.title === 'string' ? info.title : null,
+    version: typeof info.version === 'string' ? info.version : null,
+    description: typeof info.description === 'string' ? info.description : null,
+  };
+}
