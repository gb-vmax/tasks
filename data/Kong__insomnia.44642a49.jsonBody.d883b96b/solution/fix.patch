+    if (options?.partial && typeof expected === 'object') {
+        const matches = partialDeepEqual(actualValue, expected);
+        if ((matches && checkEquality) || (!matches && !checkEquality)) {
+            return;
+        }
+        throw Error(`Response JSON does not ${checkEquality ? '' : 'not '}partially match the expected value`);
+    }
+    
+    verify(actualValue, expected, checkEquality);
+}
