+    } catch (e) {
+        throw Error(`Failed to parse response body as JSON: ${e}`);
+    }
+    
+    if (options?.path) {
+        actualValue = extractValueByPath(actualValue, options.path);
+        if (actualValue === undefined) {
+            throw Error(`Path "${options.path}" not found in response JSON`);
+        }
+    }
+    
+    if (typeof expected === 'string' && options?.path) {
+        verify(actualValue, expected, checkEquality);
+        return;
