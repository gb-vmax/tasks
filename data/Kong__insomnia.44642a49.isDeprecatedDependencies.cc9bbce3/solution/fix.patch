  * @param str The error message
  * @returns {boolean} Returns true if it's a deprecated warning
  */
+function _matchesAlternativeDeprecationPattern(str: string): boolean {
+  const lowerStr = str.toLowerCase();
+  
+  const hasWarningKeyword = lowerStr.includes('warning') || lowerStr.includes('deprecated');
+  if (!hasWarningKeyword) {
+    return false;
+  }
+  
+  const alternativePatterns = [
+    ['deprecated', 'please update'],
+    ['deprecated', 'use', 'instead'],
+    ['no longer supported', 'migrate'],
+    ['security vulnerabilities', 'upgrade'],
+    ['end of life', 'recommend upgrading']
+  ];
+  
+  return alternativePatterns.some(keywords => 
+    keywords.every(keyword => lowerStr.includes(keyword))
+  );
+}
+
+function _matchesFallbackDeprecationPattern(str: string): boolean {
+  const lowerStr = str.toLowerCase();
+  
+  if (!lowerStr.includes('warning')) {
+    return false;
+  }
+  
+  const deprecationIndicators = [
+    'deprecated',
+    'deprecation',
+    'unmaintained',
+    'obsolete'
+  ];
+  
+  const hasDeprecationIndicator = deprecationIndicators.some(indicator => 
+    lowerStr.includes(indicator)
+  );
+  
+  if (!hasDeprecationIndicator) {
+    return false;
+  }
+  
+  const actionKeywords = [
+    'upgrade',
+    'update',
+    'migrate',
+    'replace',
+    'use instead'
+  ];
+  
+  const hasActionKeyword = actionKeywords.some(keyword => 
+    lowerStr.includes(keyword)
+  );
+  
+  return hasActionKeyword;
+}
