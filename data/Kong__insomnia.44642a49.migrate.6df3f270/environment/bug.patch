+function migrateToV1(doc: ApiSpec): ApiSpec {
+  const migrated = { ...doc };
+
+  if (!migrated.contentType || (migrated.contentType !== 'json' && migrated.contentType !== 'yaml')) {
+    migrated.contentType = inferContentType(migrated.fileName, migrated.contents);
+  }
+
+  if (!migrated.fileName || migrated.fileName.trim() === '') {
+    migrated.fileName = `New ${strings.document.singular}`;
+  } else {
+    migrated.fileName = migrated.fileName.trim();
+  }
+
+  if (migrated.contents === undefined || migrated.contents === null) {
+    migrated.contents = '';
+  }
+
+  (migrated as any).schemaVersion = 1;
+
+  return migrated;
+}
+
+function migrateToV2(doc: ApiSpec): ApiSpec {
+  const migrated = { ...doc };
+
+  if (migrated.fileName) {
+    migrated.fileName = migrated.fileName.replace(/\s+/g, ' ').trim();
+  }
+
+  if (migrated.contentType === 'yaml' && migrated.contents) {
+    migrated.contents = normalizeYamlLineEndings(migrated.contents);
+  }
+
+  (migrated as any).schemaVersion = 2;
+
+  return migrated;
+}
+
+function inferContentType(fileName: string, contents: string): 'json' | 'yaml' {
+  if (fileName) {
+    const lowerFileName = fileName.toLowerCase();
+    if (lowerFileName.endsWith('.json')) {
+      return 'json';
+    }
+    if (lowerFileName.endsWith('.yaml') || lowerFileName.endsWith('.yml')) {
+      return 'yaml';
+    }
+  }
+
+  if (contents) {
+    const trimmed = contents.trim();
+    if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
+      return 'json';
+    }
+  }
+
+  return 'yaml';
+}
+
+function normalizeYamlLineEndings(contents: string): string {
+  return contents.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
