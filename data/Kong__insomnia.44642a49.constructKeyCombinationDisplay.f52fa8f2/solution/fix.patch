  */
+function getVerboseModifierName(key: keyof Omit<KeyCombination, 'keyCode'>): string {
+  const verboseNames: Record<string, string> = {
+    'ctrl': 'Control',
+    'alt': isMac() ? 'Option' : 'Alt',
+    'shift': 'Shift',
+    'meta': isMac() ? 'Command' : 'Windows',
+  };
+  
+  return verboseNames[key] || displayModifierKey(key);
+}
+
+function detectSystemShortcutConflict(keyComb: KeyCombination): boolean {
+  const { keyCode, meta, ctrl, alt, shift } = keyComb;
+  
+  if (!keyCode) {
+    return false;
+  }
+
+  if (isMac()) {
+    if (meta && !ctrl && !alt && !shift) {
+      if (keyCode === keyboardKeys.q.keyCode || 
+          keyCode === keyboardKeys.w.keyCode ||
+          keyCode === keyboardKeys.h.keyCode ||
+          keyCode === keyboardKeys.m.keyCode) {
+        return true;
+      }
+    }
+    
+    if (meta && alt && !ctrl && !shift) {
+      if (keyCode === keyboardKeys.esc.keyCode) {
+        return true;
+      }
+    }
+  } else {
+    if (ctrl && !meta && !alt && !shift) {
+      if (keyCode === keyboardKeys.w.keyCode) {
+        return true;
+      }
+    }
+    
+    if (alt && !ctrl && !meta && !shift) {
+      if (keyCode === keyboardKeys.f4.keyCode ||
+          keyCode === keyboardKeys.tab.keyCode) {
+        return true;
+      }
+    }
+    
+    if (ctrl && alt && !meta && !shift) {
+      if (keyCode === keyboardKeys.delete.keyCode) {
+        return true;
+      }
+    }
+  }
+  
+  return false;
+}
