+const alignToMultipleOf = (value: number, multipleOf: number, min: number, max: number): number => {
+  const aligned = Math.round(value / multipleOf) * multipleOf;
+  
+  if (aligned < min) {
+    return Math.ceil(min / multipleOf) * multipleOf;
+  }
+  
+  if (aligned > max) {
+    return Math.floor(max / multipleOf) * multipleOf;
+  }
+  
+  return aligned;
+};
