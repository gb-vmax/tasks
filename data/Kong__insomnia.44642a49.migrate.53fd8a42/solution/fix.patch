+function normalizeGitUri(uri: string): string {
+  let normalized = uri.trim();
+  
+  if (normalized.startsWith('git://')) {
+    normalized = normalized.replace('git://', 'https://');
+  }
+  
+  if (normalized.startsWith('http://')) {
+    normalized = normalized.replace('http://', 'https://');
+  }
+  
+  if (normalized.endsWith('/')) {
+    normalized = normalized.slice(0, -1);
+  }
+  
+  if (normalized.endsWith('.git')) {
+    normalized = normalized.slice(0, -4);
+  }
+  
+  return normalized;
+}
+
+function normalizeCredentials(credentials: GitCredentials): GitCredentials {
+  const normalized = { ...credentials };
+  
+  if ('token' in normalized && normalized.token) {
+    if ('oauth2format' in normalized) {
+      const oauth2format = (normalized as any).oauth2format as OauthProviderName | undefined;
+      if (oauth2format === 'gitlab' || oauth2format === 'github') {
+        if (!(normalized as any).provider) {
+          (normalized as any).provider = oauth2format;
+        }
+      }
+    }
+  }
+  
+  return normalized;
+}
+
 export function migrate(doc: GitRepository) {
-  return doc;
