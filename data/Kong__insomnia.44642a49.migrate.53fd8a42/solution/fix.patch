+    }
+  }
+  
+  if (migrated.credentials) {
+    migrated.credentials = normalizeCredentials(migrated.credentials);
+  }
+  
+  if (migrated.needsFullClone === undefined) {
+    migrated.needsFullClone = false;
+  }
+  
+  return migrated;
 }
 
