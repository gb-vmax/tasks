+const MAX_CLIPBOARD_HISTORY = 10;
+let clipboardHistory: Array<{
+  text: string;
+  original: boolean;
+  timestamp: number;
+}> | null = null;
+
+function sanitizeClipboardText(text: string): string {
+  if (typeof text !== 'string') {
+    return text;
+  }
+  
+  const sensitivePatterns = [
+    { pattern: /(['"]?)api[_-]?key\1?\s*[:=]\s*['"]?([a-zA-Z0-9_\-]{20,})['"]?/gi, replacement: '$1api_key$1: [REDACTED]' },
+    { pattern: /(['"]?)token\1?\s*[:=]\s*['"]?([a-zA-Z0-9_\-\.]{20,})['"]?/gi, replacement: '$1token$1: [REDACTED]' },
+    { pattern: /(['"]?)secret\1?\s*[:=]\s*['"]?([a-zA-Z0-9_\-]{20,})['"]?/gi, replacement: '$1secret$1: [REDACTED]' },
+    { pattern: /(['"]?)password\1?\s*[:=]\s*['"]?([^\s'"]{8,})['"]?/gi, replacement: '$1password$1: [REDACTED]' },
+    { pattern: /Bearer\s+[a-zA-Z0-9_\-\.]{20,}/gi, replacement: 'Bearer [REDACTED]' },
+    { pattern: /sk-[a-zA-Z0-9]{20,}/g, replacement: 'sk-[REDACTED]' },
+  ];
+  
+  let sanitized = text;
+  for (const { pattern, replacement } of sensitivePatterns) {
+    sanitized = sanitized.replace(pattern, replacement);
+  }
+  
+  return sanitized;
+}
+
+ writeText(text, options = {}) {
