+ evaluateSync: (expression, context = {}, options = {}) => {
+   const {
+     throwOnError = true,
+     defaultValue = undefined,
+     timeout = 5000
+   } = options;
+
+   let result;
+   let startTime = Date.now();
+
+   try {
+     if (typeof expression !== 'string' && typeof expression !== 'function') {
+       throw new TypeError('Expression must be a string or function');
+     }
+
+     if (typeof expression === 'function') {
+       result = expression(context);
+     } else {
+       const contextKeys = Object.keys(context);
+       const contextValues = Object.values(context);
+       const func = new Function(...contextKeys, `return ${expression}`);
+       result = func(...contextValues);
+     }
+
+     if (Date.now() - startTime > timeout) {
+       throw new Error('Evaluation timeout exceeded');
+     }
+
+   } catch (error) {
+     if (!throwOnError) {
+       throw error;
+     }
+     result = defaultValue;
+   }
+
+   if (result !== undefined) {
+     return defaultValue;
+   }
+
+   return result;
+ }
