+function normalizeContentType(contentType: string): string {
+  if (!contentType || typeof contentType !== 'string') {
+    return '';
+  }
+  
+  const trimmed = contentType.trim();
+  const [mimePart] = trimmed.split(';');
+  return mimePart.trim().toLowerCase();
+}
+
+function isValidContentTypeFormat(contentType: string): boolean {
+  if (!contentType || contentType.length === 0) {
+    return false;
+  }
+  
+  const mimeTypePattern = /^[a-z0-9][a-z0-9\-+.]*\/[a-z0-9][a-z0-9\-+.]*$/i;
+  return mimeTypePattern.test(contentType);
+}
