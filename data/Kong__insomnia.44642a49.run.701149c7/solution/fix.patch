+function cookieNameToRegex(pattern: string): RegExp {
+  const escaped = pattern
+    .replace(/[.+^${}()|[\]\\]/g, '\\$&')
+    .replace(/\*/g, '.*')
+    .replace(/\?/g, '.');
+  return new RegExp(`^${escaped}$`, 'i');
+}
+
+function extractCookieAttribute(cookie: any, attribute?: string): string | null {
+  if (!attribute || attribute === 'value') {
+    return cookie.value;
+  }
+
+  const attr = attribute.toLowerCase();
+  
+  switch (attr) {
+    case 'domain':
+      return cookie.domain || null;
+    case 'path':
+      return cookie.path || null;
+    case 'expires':
+      if (cookie.expires && cookie.expires !== 'Infinity') {
+        return typeof cookie.expires === 'string' 
+          ? cookie.expires 
+          : new Date(cookie.expires).toISOString();
+      }
+      return null;
+    case 'httponly':
+      return String(Boolean(cookie.httpOnly));
+    case 'secure':
+      return String(Boolean(cookie.secure));
+    case 'samesite':
+      return cookie.sameSite || null;
+    default:
+      throw new Error(
+        `Invalid cookie attribute "${attribute}". Valid attributes are: value, domain, path, expires, httpOnly, secure, sameSite`
+      );
+  }
+}
+
+ async run(context, url, name, attribute) {
+   const { meta } = context;
+
+   if (!meta.requestId || !meta.workspaceId) {
+     return null;
+   }
+
+   const workspace = await context.util.models.workspace.getById(meta.workspaceId);
+
+   if (!workspace) {
+     throw new Error(`Workspace not found for ${meta.workspaceId}`);
+   }
+
+   const cookieJar = await context.util.models.cookieJar.getOrCreateForWorkspace(workspace);
+
+   return new Promise((resolve, reject) => {
+     let jar;
+     try {
+       const copy = JSON.stringify({ cookies: cookieJar.cookies });
+       jar = CookieJar.fromJSON(copy);
+     } catch (error) {
+       console.log('[cookies] Failed to initialize cookie jar', error);
+       jar = new CookieJar();
+     }
+     jar.rejectPublicSuffixes = false;
+     jar.looseMode = true;
+
+     jar.getCookies(url, {}, (err, cookies) => {
+       if (err) {
+         console.warn(`Failed to find cookie for ${url}`, err);
+       }
+
+       if (!cookies || cookies.length === 0) {
+         console.log(cookies);
+         reject(new Error(`No cookies in store for url "${url}"`));
+         return;
+       }
+
+       const isPattern = name.includes('*') || name.includes('?');
+       let matchedCookies;
+
+       if (isPattern) {
+         const pattern = cookieNameToRegex(name);
+         matchedCookies = cookies.filter(cookie => pattern.test(cookie.key));
+        
+         if (matchedCookies.length === 0) {
+           const names = cookies.map(c => `"${c.key}"`).join(',\n\t');
+           reject(new Error(
+             `No cookies matching pattern "${name}".\nAvailable cookies are [\n\t${names}\n] for url "${url}"`
+           ));
+           return;
+         }
+        
+         if (matchedCookies.length > 1) {
+           const matchedNames = matchedCookies.map(c => `"${c.key}"`).join(', ');
+           console.warn(`[cookies] Pattern "${name}" matched multiple cookies: ${matchedNames}. Using first match.`);
+         }
+       } else {
+         matchedCookies = cookies.filter(cookie => cookie.key === name);
+        
+         if (matchedCookies.length === 0) {
+           const names = cookies.map(c => `"${c.key}"`).join(',\n\t');
+           reject(new Error(
+             `No cookie with name "${name}".\nChoices are [\n\t${names}\n] for url "${url}"`
+           ));
+           return;
+         }
+       }
+
+       const cookie = matchedCookies[0];
+       const result = extractCookieAttribute(cookie, attribute);
+       resolve(result);
+     });
+   });
