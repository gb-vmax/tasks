+export default class Store {
+  _getCachedValue(key: string): JSONValue | null | undefined {
+    const entry = this._cache.get(key);
+    if (!entry) {
+      return undefined;
+    }
+
+    const now = Date.now();
+    if (now - entry.timestamp > this._cacheTTL) {
+      this._cache.delete(key);
+      this._cacheStats.evictions++;
+      return undefined;
+    }
+
+    return entry.value;
+  }
