+  _setCachedValue(key: string, value: JSONValue | null): void {
+    if (this._cache.size >= this._cacheMaxSize) {
+      const firstKey = this._cache.keys().next().value;
+      if (firstKey !== undefined) {
+        this._cache.delete(firstKey);
+        this._cacheStats.evictions++;
+      }
+    }
+
+    this._cache.set(key, {
+      value,
+      timestamp: Date.now()
+    });
+  }
+
+  _invalidateCache(key: string): void {
+    const deleted = this._cache.delete(key);
+    if (deleted) {
+      this._cacheStats.evictions++;
+    }
+  }
+
+  getCacheStats(): CacheStats {
+    return { ...this._cacheStats };
+  }
+
+  clearCache(): void {
+    this._cacheStats.evictions += this._cache.size;
+    this._cache.clear();
+  }
+
+  configureCaching(options: { maxSize?: number; ttl?: number }): void {
+    if (options.maxSize !== undefined) {
+      this._cacheMaxSize = options.maxSize;
+    }
+    if (options.ttl !== undefined) {
+      this._cacheTTL = options.ttl;
+    }
+  }
+}
