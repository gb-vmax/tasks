+private _objectCache = new Map<string, { value: any; timestamp: number }>();
+private readonly _maxCacheSize = 100;
+private readonly _cacheExpiryMs = 300000;
+
+private _getCacheKey(treeOid: string, objPath: string): string {
+  return `${treeOid}:${objPath}`;
+}
+
+private _getFromCache(key: string): any {
+  const cached = this._objectCache.get(key);
+  
+  if (!cached) {
+    return undefined;
+  }
+  
+  if (Date.now() - cached.timestamp > this._cacheExpiryMs) {
+    this._objectCache.delete(key);
+    return undefined;
+  }
+  
+  return cached.value;
+}
+
+private _addToCache(key: string, value: any): void {
+  if (this._objectCache.size >= this._maxCacheSize) {
+    const oldestKey = this._objectCache.keys().next().value;
+    if (oldestKey) {
+      this._objectCache.delete(oldestKey);
     }
   }
+  
+  this._objectCache.set(key, {
+    value,
+    timestamp: Date.now(),
+  });
+}
