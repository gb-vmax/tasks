+function formatMultipleResults(results) {
+  const allStrings = results.every(r => typeof r === 'string');
+  
+  if (allStrings) {
+    return results.join(', ');
+  }
+  
+  const allPrimitives = results.every(r => 
+    typeof r === 'string' || 
+    typeof r === 'number' || 
+    typeof r === 'boolean' || 
+    r === null
+  );
+  
+  if (allPrimitives) {
+    return JSON.stringify(results);
+  }
+  
+  return JSON.stringify(results);
+}
+
+ run(_context, jsonString, filter) {
+   let body;
+   try {
+     body = JSON.parse(jsonString);
+   } catch (err) {
+     throw new Error(`Invalid JSON: ${err.message}`);
+   }
+
+   let results;
+   try {
+     results = JSONPath({ json: body, path: filter });
+     if (!Array.isArray(results)) {
+       results = [results];
+     }
+   } catch (err) {
+     throw new Error(`Invalid JSONPath query: ${filter}`);
+   }
+
+   const returnAllResults = _context.context?.getExtraInfo?.('jsonpathReturnAll') || false;
+   const defaultValue = _context.context?.getExtraInfo?.('jsonpathDefault');
+   const hasDefaultValue = defaultValue !== undefined;
+
+   if (results.length === 0) {
+     if (hasDefaultValue) {
+       return defaultValue;
+     }
+     throw new Error(`JSONPath query returned no results: ${filter}`);
+   }
+
+   if (returnAllResults && results.length > 1) {
+     return formatMultipleResults(results);
+   }
+
+   return results[0];
+ }
