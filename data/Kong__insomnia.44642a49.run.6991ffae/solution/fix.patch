+async function getAllStorageKeys(store) {
+  const keys = [];
+  let hasMore = true;
+  let index = 0;
+  
+  while (hasMore) {
+    try {
+      const key = await store.key(index);
+      if (key !== null && key !== undefined) {
+        keys.push(key);
+        index++;
+      } else {
+        hasMore = false;
+      }
+    } catch (e) {
+      hasMore = false;
+    }
+  }
+  
+  return keys;
+}
+
+function isPromptStorageKey(key) {
+  if (!key || typeof key !== 'string') {
+    return false;
+  }
+  
+  const hasRequestIdPattern = /^[a-zA-Z0-9_-]+\.[a-f0-9]{32}$/.test(key);
+  const isExplicitKey = key.length > 0 && !key.includes('.');
+  
+  return hasRequestIdPattern || (isExplicitKey && key.length < 200);
+}
+
+ run: async context => {
+   console.log('[prompt] Clear action');
+  
+   const allKeys = await getAllStorageKeys(context.store);
+   const clearedKeys = [];
+  
+   for (const key of allKeys) {
+     if (isPromptStorageKey(key)) {
+       await context.store.removeItem(key);
+       clearedKeys.push(key);
+     }
+   }
+  
+   const clearedCount = clearedKeys.length;
+   console.log(`[prompt] Cleared ${clearedCount} prompt value(s)`);
+  
+   if (clearedCount > 0) {
+     console.log(`[prompt] Cleared keys: ${clearedKeys.join(', ')}`);
+   }
+  
+   return {
+     cleared: clearedCount,
+     keys: clearedKeys
+   };
+ }
