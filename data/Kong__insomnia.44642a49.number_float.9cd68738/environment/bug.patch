+       : schema.minimum;
+     const max = schema.exclusiveMaximum !== undefined
+       ? (typeof schema.exclusiveMaximum === 'number' ? schema.exclusiveMaximum : schema.maximum)
+       : schema.maximum;
+     const isMinExclusive = schema.exclusiveMinimum !== undefined && schema.exclusiveMinimum !== false;
+     const isMaxExclusive = schema.exclusiveMaximum !== undefined && schema.exclusiveMaximum !== false;
+    
+     let value = 0.0;
+    
+     if (min !== undefined && max !== undefined) {
+       const effectiveMin = isMinExclusive ? min + Number.EPSILON : min;
+       const effectiveMax = isMaxExclusive ? max - Number.EPSILON : max;
+       value = (effectiveMin + effectiveMax) / 2;
+     } else if (min !== undefined) {
+       value = isMinExclusive ? min + 1.0 : min;
+     } else if (max !== undefined) {
+       value = isMaxExclusive ? max - 1.0 : max;
+     }
+    
+     if (schema.multipleOf !== undefined && schema.multipleOf > 0) {
+       value = adjustToMultipleOf(value, schema.multipleOf, min, max, isMinExclusive, isMaxExclusive);
+     }
+    
+     return value;
+   }
+   return 0.0;
+ },
