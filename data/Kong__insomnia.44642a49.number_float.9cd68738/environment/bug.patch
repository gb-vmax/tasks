+const adjustToMultipleOf = (
+  value: number,
+  multipleOf: number,
+  min?: number,
+  max?: number,
+  isMinExclusive?: boolean,
+  isMaxExclusive?: boolean
+): number => {
+  const rounded = Math.round(value / multipleOf) * multipleOf;
+  
+  const effectiveMin = min !== undefined && isMinExclusive ? min + Number.EPSILON : min;
+  const effectiveMax = max !== undefined && isMaxExclusive ? max - Number.EPSILON : max;
+  
+  if (effectiveMin !== undefined && rounded < effectiveMin) {
+    return Math.ceil(effectiveMin / multipleOf) * multipleOf;
+  }
+  
+  if (effectiveMax !== undefined && rounded > effectiveMax) {
+    return Math.floor(effectiveMax / multipleOf) * multipleOf;
+  }
+  
+  return rounded;
+};
+
