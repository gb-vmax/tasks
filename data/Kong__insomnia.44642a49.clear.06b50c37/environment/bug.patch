+const clipboardHistory: string[] = [];
+const MAX_CLIPBOARD_HISTORY = 10;
+
+function addToClipboardHistory(text: string): void {
+  if (clipboardHistory.length >= MAX_CLIPBOARD_HISTORY) {
+    clipboardHistory.shift();
+  }
+  clipboardHistory.push(text);
+}
+
+function getClipboardHistory(): readonly string[] {
+  return Object.freeze([...clipboardHistory]);
+}
+
+ clear() {
+   const currentText = window.clipboard.readText();
+   if (currentText && currentText.trim().length > 0) {
+     addToClipboardHistory(currentText);
+   }
+   window.clipboard.clear();
+ },
