+function normalizeAndAggregateHeaders(rawHeaders: ResponseHeader[]): ResponseHeader[] {
+  const headerMap = new Map<string, string[]>();
+  const setCookieHeaders: ResponseHeader[] = [];
+
+  for (const { name, value } of rawHeaders) {
+    const normalizedName = name.toLowerCase();
+    
+    if (normalizedName === 'set-cookie') {
+      setCookieHeaders.push({ name: normalizedName, value });
+      continue;
+    }
+
+    if (!headerMap.has(normalizedName)) {
+      headerMap.set(normalizedName, []);
+    }
+    headerMap.get(normalizedName)!.push(value);
+  }
+
+  const aggregatedHeaders: ResponseHeader[] = [];
+  
+  for (const [name, values] of headerMap) {
+    aggregatedHeaders.push({
+      name,
+      value: values.join(', '),
+    });
+  }
+
+  return [...aggregatedHeaders, ...setCookieHeaders];
+}
