+function validateAndNormalizePath(filePath: string | undefined, defaultPath?: string): string | null {
+  if (!filePath || filePath.trim() === '') {
+    return null;
+  }
+
+  let normalizedPath = filePath.trim();
+
+  if (defaultPath && !normalizedPath.includes('.')) {
+    const defaultExtension = defaultPath.substring(defaultPath.lastIndexOf('.'));
+    if (defaultExtension && defaultExtension.length > 1) {
+      normalizedPath = normalizedPath + defaultExtension;
+    }
+  }
+
+  return normalizedPath;
