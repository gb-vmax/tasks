+function isPeerDependencyWarning(str: string) {
+  const peerDepPatterns = [
+    /warning\s+[^@]+@[^:]+:\s+peer\s+dependency/i,
+    /warning\s+"[^"]+"\s+has\s+(unmet|incorrect)\s+peer\s+dependency/i,
+  ];
+  return peerDepPatterns.some(pattern => pattern.test(str));
+}
+
+function isSecurityWarning(str: string) {
+  const securityPatterns = [
+    /warning\s+[^:]+:\s+\d+\s+(moderate|high|critical)\s+severity\s+vulnerabilit/i,
+    /warning\s+found\s+\d+\s+vulnerabilit/i,
+  ];
+  return securityPatterns.some(pattern => pattern.test(str));
+}
