+const formatAjvErrors = (errors: any[] | null | undefined): string => {
+    if (!errors || errors.length === 0) {
+        return 'Unknown validation error';
+    }
+    
+    return errors.map(err => {
+        const path = err.instancePath || err.dataPath || '/';
+        const message = err.message || 'validation failed';
+        const details: string[] = [];
+        
+        if (err.params) {
+            if (err.params.allowedValues) {
+                details.push(`allowed values: ${JSON.stringify(err.params.allowedValues)}`);
+            }
+            if (err.params.type) {
+                details.push(`expected type: ${err.params.type}`);
+            }
+            if (err.params.missingProperty) {
+                details.push(`missing property: ${err.params.missingProperty}`);
+            }
+            if (err.params.additionalProperty) {
+                details.push(`additional property: ${err.params.additionalProperty}`);
+            }
+        }
+        
+        const detailsStr = details.length > 0 ? ` (${details.join(', ')})` : '';
+        return `  - Path "${path}": ${message}${detailsStr}`;
+    }).join('\n');
+};
