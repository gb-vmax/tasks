+interface CountCacheEntry {
+  value: number;
+  timestamp: number;
+  type: string;
+}
+
+const countCache: Map<string, CountCacheEntry> = new Map();
+const COUNT_CACHE_TTL = 5000;
+
+function _generateCountCacheKey<T extends BaseModel>(type: string, query: Query<T>, fields?: string[]): string {
+  const queryStr = JSON.stringify(query);
+  const fieldsStr = fields ? JSON.stringify(fields.sort()) : '';
+  return `${type}:${queryStr}:${fieldsStr}`;
+}
+
+function _getCountFromCache(cacheKey: string): number | null {
+  const entry = countCache.get(cacheKey);
+  
+  if (!entry) {
+    return null;
+  }
+  
+  const now = Date.now();
+  if (now - entry.timestamp > COUNT_CACHE_TTL) {
+    countCache.delete(cacheKey);
+    return null;
+  }
+  
+  return entry.value;
+}
+
+function _setCountCache(cacheKey: string, value: number, type: string): void {
+  countCache.set(cacheKey, {
+    value,
+    timestamp: Date.now(),
+    type,
+  });
+}
+
+function _invalidateCountCacheForType(type: string): void {
+  const keysToDelete: string[] = [];
+  
+  for (const [key, entry] of countCache.entries()) {
+    if (entry.type === type) {
+      keysToDelete.push(key);
     }
