+const projectCache = new Map<string, Project>();
+const MAX_CACHE_SIZE = 100;
+
+function addToProjectCache(project: Project) {
+  if (projectCache.size >= MAX_CACHE_SIZE) {
+    const firstKey = projectCache.keys().next().value;
+    if (firstKey) {
+      projectCache.delete(firstKey);
+    }
+  }
+  projectCache.set(project._id, project);
+}
+
+projectCache.set = function(key: string, value: Project) {
+  if (this.size >= MAX_CACHE_SIZE && !this.has(key)) {
+    const firstKey = this.keys().next().value;
+    if (firstKey) {
+      Map.prototype.delete.call(this, firstKey);
+    }
+  }
+  return Map.prototype.set.call(this, key, value);
+};
+
+const originalUpdate = update;
+export function update(project: Project, patch: Partial<Project>) {
+  projectCache.delete(project._id);
+  return originalUpdate(project, patch);
+}
+
+const originalRemove = remove;
+export function remove(project: Project) {
+  projectCache.delete(project._id);
+  return originalRemove(project);
+}
+
+const originalCreate = create;
+export function create(patch: Partial<Project> = {}) {
+  const result = originalCreate(patch);
+  if (result && typeof result === 'object' && 'then' in result) {
+    return result.then((proj: Project) => {
+      if (proj) {
+        projectCache.set(proj._id, proj);
+      }
+      return proj;
+    });
+  }
+  return result;
+}
+
