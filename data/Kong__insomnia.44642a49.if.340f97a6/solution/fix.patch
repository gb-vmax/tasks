+async function _checkUpsertConditions<T extends BaseModel>(
+  existingDoc: T,
+  conditions: Partial<T>
+): Promise<boolean> {
+  for (const [key, expectedValue] of Object.entries(conditions)) {
+    const actualValue = existingDoc[key as keyof T];
+    
+    if (typeof expectedValue === 'object' && expectedValue !== null && !Array.isArray(expectedValue)) {
+      if (JSON.stringify(actualValue) !== JSON.stringify(expectedValue)) {
+        return false;
+      }
+    } else {
+      if (actualValue !== expectedValue) {
+        return false;
+      }
     }
+  }
+  
+  return true;
+}
+
+function _applyVersionIncrement<T extends BaseModel>(doc: T, existingDoc: T): T {
+  const currentVersion = (existingDoc as any)._version || 0;
+  const docVersion = (doc as any)._version;
+  
+  if (docVersion !== undefined && docVersion !== currentVersion) {
+    throw new Error(
+      `Version conflict for document ${doc._id}: expected ${currentVersion}, got ${docVersion}`
+    );
+  }
+  
+  return {
+    ...doc,
+    _version: currentVersion + 1,
+  } as T;
+}
+
+function _initializeVersion<T extends BaseModel>(doc: T): T {
+  return {
+    ...doc,
+    _version: 0,
+  } as T;
+}
