+async function createCloudProjectWithRetry({
+  organizationId,
+  projectName,
+  sessionId,
+  maxRetries,
+}: {
+  organizationId: string;
+  projectName: string;
+  sessionId: string;
+  maxRetries: number;
+}): Promise<{
+  id: string;
+  name: string;
+} | {
+  error: string;
+  message?: string;
+}> {
+  let lastError: any;
+  
+  for (let attempt = 0; attempt <= maxRetries; attempt++) {
+    try {
+      const result = await insomniaFetch<{
+        id: string;
+        name: string;
+      } | {
+        error: string;
+        message?: string;
+      }>({
+        path: `/v1/organizations/${organizationId}/team-projects`,
+        method: 'POST',
+        data: {
+          name: projectName,
+        },
+        sessionId,
+      });
+
+      if (result && 'error' in result) {
+        if (result.error === 'FORBIDDEN' || result.error === 'NEEDS_TO_UPGRADE') {
+          return result;
+        }
+        
+        if (attempt < maxRetries) {
+          lastError = result;
+          await delay(Math.min(1000 * Math.pow(2, attempt), 10000));
+          continue;
+        }
+      }
+
+      return result;
+    } catch (e) {
+      lastError = e;
+      
+      if (attempt < maxRetries) {
+        await delay(Math.min(1000 * Math.pow(2, attempt), 10000));
+        continue;
+      }
+    }
+  }
+
+  return {
+    error: 'NETWORK_ERROR',
+    message: lastError?.message || 'Failed to create project after multiple attempts',
+  };
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
