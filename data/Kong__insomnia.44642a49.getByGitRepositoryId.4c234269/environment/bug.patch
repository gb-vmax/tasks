+function sortWorkspaceMetasByRecency(metas: WorkspaceMeta[]): WorkspaceMeta[] {
+  return metas.sort((a, b) => {
+    const timeA = a.modified || 0;
+    const timeB = b.modified || 0;
+    return timeB - timeA;
+  });
+}
+
+export async function getByGitRepositoryId(gitRepositoryId: string, filterBranch?: string) {
+  const allMetas = await db.find<WorkspaceMeta>(type, { gitRepositoryId });
+  
+  let filteredMetas = allMetas;
+  
+  if (filterBranch !== undefined) {
+    filteredMetas = allMetas.filter(meta => 
+      meta.cachedGitRepositoryBranch === filterBranch
+    );
+  }
+  
+  return sortWorkspaceMetasByRecency(filteredMetas);
 }
 
