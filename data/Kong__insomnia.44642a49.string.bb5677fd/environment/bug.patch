+const generateStringWithLengthConstraints = (
+  minLength?: number,
+  maxLength?: number,
+): string => {
+  const baseString = 'string';
+  const min = minLength ?? 0;
+  const max = maxLength ?? baseString.length;
+  
+  if (max < baseString.length) {
+    return baseString.substring(0, max);
+  }
+  
+  if (min > baseString.length) {
+    const repeats = Math.ceil(min / baseString.length);
+    const repeated = baseString.repeat(repeats);
+    return repeated.substring(0, Math.max(min, max));
+  }
+  
+  return baseString;
+};
+
+ string: (parameter: OpenAPIV2.Parameter) => {
+   if (parameter && typeof parameter === 'object') {
+     if (parameter.enum && Array.isArray(parameter.enum) && parameter.enum.length > 0) {
+       return parameter.enum[0];
+     }
+    
+     if (parameter.minLength !== undefined || parameter.maxLength !== undefined) {
+       return generateStringWithLengthConstraints(parameter.minLength, parameter.maxLength);
+     }
+   }
+  
+   return 'string';
+ },
