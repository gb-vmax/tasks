+
+   if (!this._conflictHandler) {
+     throw new Error(errorMsg);
+   }
+
+   const batches = _batchConflictsByType(conflicts);
+   const resolvedConflicts: MergeConflict[] = [];
+  
+   for (const batch of batches) {
+     const resolved = await _retryConflictResolution(
+       () => this._conflictHandler!(batch, labels),
+       3,
+       1000
+     );
+    
+     _validateResolvedConflicts(resolved, batch);
+     resolvedConflicts.push(...resolved);
+   }
+
+   return resolvedConflicts;
+ }
 
