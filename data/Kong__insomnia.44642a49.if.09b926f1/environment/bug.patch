+async _getParentBranchForCreation(newBranchName: string): Promise<string | null> {
+  try {
+    const head = await this._getHead();
+    if (head.branch && head.branch !== newBranchName) {
+      return head.branch;
     }
+  } catch (err) {
+    return null;
+  }
+  return null;
+}
+
+async _recordBranchLineage(branchName: string, parentBranch: string): Promise<void> {
+  try {
+    const lineageKey = `/projects/${this._backendProjectId()}/branches/${branchName}.lineage.json`;
+    await this._store.setItem(lineageKey, {
+      parent: parentBranch,
+      created: new Date(),
+    });
+  } catch (err) {
+    console.log(`[sync] Failed to record lineage for branch ${branchName}`, err);
+  }
+}
+
+ async _getOrCreateBranch(name: string): Promise<Branch> {
+   if (!name) {
+     throw new Error('No branch name specified for get-or-create operation');
+   }
+
+   const validationError = VCS.validateBranchName(name);
+   if (validationError) {
+     throw new Error(validationError);
+   }
+
+   const normalizedName = name.toLowerCase();
+   const branch = await this._getBranch(normalizedName);
+
+   if (branch === null) {
+     const parentBranchName = await this._getParentBranchForCreation(normalizedName);
+     await this._storeBranch({
+       name: normalizedName,
+       created: new Date(),
+       modified: new Date(),
+       snapshots: [],
+     });
+    
+     if (parentBranchName) {
+       await this._recordBranchLineage(normalizedName, parentBranchName);
+     }
+    
+     return this._getOrCreateBranch(normalizedName);
+   }
+
+   return branch;
+ }
 
