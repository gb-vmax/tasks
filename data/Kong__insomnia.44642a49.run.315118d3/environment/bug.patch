+function validateAndNormalizeCharset(charset: string): BufferEncoding {
+  const normalizedCharset = charset.toLowerCase().trim();
+  
+  const supportedEncodings: BufferEncoding[] = [
+    'utf8', 'utf-8', 'utf16le', 'ucs2', 'ucs-2', 
+    'latin1', 'binary', 'ascii', 'base64', 'hex'
+  ];
+  
+  const charsetMap: Record<string, BufferEncoding> = {
+    'utf8': 'utf8',
+    'utf-8': 'utf8',
+    'utf16le': 'utf16le',
+    'utf-16le': 'utf16le',
+    'ucs2': 'ucs2',
+    'ucs-2': 'ucs2',
+    'latin1': 'latin1',
+    'iso-8859-1': 'latin1',
+    'binary': 'binary',
+    'ascii': 'ascii',
+    'us-ascii': 'ascii'
+  };
+  
+  const mappedCharset = charsetMap[normalizedCharset];
+  if (mappedCharset) {
+    return mappedCharset;
+  }
+  
+  if (supportedEncodings.includes(normalizedCharset as BufferEncoding)) {
+    return normalizedCharset as BufferEncoding;
+  }
+  
+  throw new Error(
+    `Unsupported charset "${charset}". Supported charsets: utf8, utf16le, ucs2, latin1, ascii, binary`
+  );
+}
+
+ run(_context, action: 'encode' | 'decode', kind: 'normal' | 'url' | 'hex', text, charset) {
+   text = text || '';
+   charset = charset || 'utf8';
+  
+   invariant(action === 'encode' || action === 'decode', 'invalid action');
+   invariant(kind === 'normal' || kind === 'url' || kind === 'hex', 'invalid kind');
+  
+   const validatedCharset = validateAndNormalizeCharset(charset);
+  
+   if (action === 'encode') {
+     if (kind === 'normal') {
+       return Buffer.from(text, validatedCharset).toString('base64');
+     }
+     if (kind === 'hex') {
+       return Buffer.from(text, 'hex').toString('base64');
+     }
+     if (kind === 'url') {
+       return Buffer.from(text, validatedCharset)
+         .toString('base64')
+         .replace(/\+/g, '-')
+         .replace(/\//g, '_')
+         .replace(/=/g, '');
+     }
+   }
+  
+   if (action === 'decode') {
+     if (kind === 'url') {
+       let base64Text = text
+         .replace(/-/g, '+')
+         .replace(/_/g, '/');
+      
+       while (base64Text.length % 4 !== 0) {
+         base64Text += '=';
+       }
+      
+       return Buffer.from(base64Text, 'base64').toString(validatedCharset);
+     }
+     if (kind === 'hex') {
+       return Buffer.from(text, 'base64').toString('hex');
+     }
+     return Buffer.from(text, 'base64').toString(validatedCharset);
+   }
+ }
