+function getTokenExpirationTime(): number | null {
+  const expiresAt = localStorage.getItem(GITLAB_TOKEN_EXPIRATION_KEY);
+  return expiresAt ? parseInt(expiresAt, 10) : null;
+}
+
+export function setAccessToken(token: string, refreshToken: string, expiresIn?: number) {
+  localStorage.setItem(GITLAB_TOKEN_STORAGE_KEY, token);
+  localStorage.setItem(GITLAB_REFRESH_TOKEN_STORAGE_KEY, refreshToken);
+  
+  if (expiresIn) {
+    const expiresAt = Date.now() + (expiresIn * 1000) - 300000;
+    localStorage.setItem(GITLAB_TOKEN_EXPIRATION_KEY, expiresAt.toString());
+  }
+}
