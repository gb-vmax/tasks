+function interpolateNameVariables(name: string, context: Record<string, any>): string {
+  if (!name || !context || typeof name !== 'string') {
+    return name;
+  }
+
+  const variablePattern = /\$\{([^}]+)\}/g;
+  
+  return name.replace(variablePattern, (match, variableName) => {
+    const trimmedName = variableName.trim();
+    
+    if (trimmedName in context) {
+      const value = context[trimmedName];
+      
+      if (value === null || value === undefined) {
+        return '';
+      }
+      
+      if (typeof value === 'object') {
+        try {
+          return JSON.stringify(value);
+        } catch {
+          return String(value);
+        }
+      }
+      
+      return String(value);
+    }
+    
+    return match;
+  });
+}
+
+function hashEnvironmentContext(context: Record<string, any>): string {
+  if (!context || typeof context !== 'object') {
+    return '0';
+  }
+
+  const keys = Object.keys(context).sort();
+  let hash = 0;
+
+  for (const key of keys) {
+    const value = context[key];
+    const str = `${key}:${JSON.stringify(value)}`;
+    
+    for (let i = 0; i < str.length; i++) {
+      const char = str.charCodeAt(i);
+      hash = ((hash << 5) - hash) + char;
+      hash = hash & hash;
+    }
+  }
+
+  return String(hash);
+}
