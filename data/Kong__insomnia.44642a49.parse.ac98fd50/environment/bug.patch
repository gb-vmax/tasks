+static _extractTypeFromKey(rawKey: string): { key: string; type?: string } {
+    const colonIndex = rawKey.indexOf(':');
+    
+    if (colonIndex === -1 || colonIndex === rawKey.length - 1) {
+        return { key: rawKey };
+    }
+    
+    const key = rawKey.substring(0, colonIndex);
+    const type = rawKey.substring(colonIndex + 1);
