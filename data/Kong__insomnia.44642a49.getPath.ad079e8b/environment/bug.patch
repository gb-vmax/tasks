+ getPath(name: string) {
+   const normalizedName = this.resolvePathAlias(name.toLowerCase());
+  
+   const supportedPaths = [
+     'desktop',
+     'documents',
+     'downloads',
+     'home',
+     'temp',
+     'userdata',
+     'appdata'
+   ];
+  
+   if (!supportedPaths.includes(normalizedName)) {
+     throw new Error(`Unknown path name ${name}`);
+   }
+  
+   return window.app.getPath(normalizedName);
+ },
+
