+private _resolutionCache: WeakMap<Url, any> = new WeakMap();
+private _cacheValidationState: { length: number; disabledStates: boolean[] } = { length: 0, disabledStates: [] };
+
+private _isCacheValid(): boolean {
+    if (this.list.length !== this._cacheValidationState.length) {
+        return false;
+    }
+    
+    for (let i = 0; i < this.list.length; i++) {
+        if (this.list[i].disabled !== this._cacheValidationState.disabledStates[i]) {
+            return false;
         }
+    }
+    
+    return true;
+}
+
+private _updateCacheValidationState(): void {
+    this._cacheValidationState = {
+        length: this.list.length,
+        disabledStates: this.list.map(proxy => proxy.disabled || false)
+    };
+}
+
+private _getCachedResult(url: Url): any | undefined {
+    if (!this._isCacheValid()) {
+        this._resolutionCache = new WeakMap();
+        this._updateCacheValidationState();
+        return undefined;
+    }
+    
+    return this._resolutionCache.get(url);
+}
+
+private _setCachedResult(url: Url, result: any): void {
+    this._resolutionCache.set(url, result);
