+function _interpolateHeaderValue(context: any, value: string): string {
+  if (typeof value !== 'string') {
+    return value;
+  }
+  
+  return value.replace(/\$\{([^}]+)\}/g, (match, varName) => {
+    const envValue = context.request.getEnvironmentVariable(varName.trim());
+    return envValue !== undefined && envValue !== null ? String(envValue) : match;
+  });
+}
+
+function _evaluateHeaderCondition(context: any, condition: any): boolean {
+  if (!condition) {
+    return true;
+  }
+  
+  if (condition.methods && Array.isArray(condition.methods)) {
+    const requestMethod = context.request.getMethod();
+    if (!condition.methods.includes(requestMethod)) {
+      return false;
+    }
+  }
+  
+  if (condition.urlPattern) {
+    const url = context.request.getUrl();
+    const pattern = new RegExp(condition.urlPattern);
+    if (!pattern.test(url)) {
+      return false;
+    }
+  }
+  
+  return true;
+}
+
