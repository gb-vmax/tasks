@@ -7,6 +7,60 @@ export interface ParsedApiSpec {
   formatVersion: string | null;
 }
 
+function validateApiSpecStructure(
+  contents: Record<string, any>,
+  format: string,
+  version: string | null,
+): string[] {
+  const warnings: string[] = [];
+
+  if (format === 'openapi') {
+    if (!contents.info) {
+      warnings.push('OpenAPI spec is missing required "info" field');
+    } else {
+      if (!contents.info.title) {
+        warnings.push('OpenAPI spec info is missing required "title" field');
+      }
+      if (!contents.info.version) {
+        warnings.push('OpenAPI spec info is missing required "version" field');
+      }
+    }
+
+    if (!contents.paths && !contents.webhooks && !contents.components) {
+      warnings.push('OpenAPI spec should contain at least one of: paths, webhooks, or components');
+    }
+
+    if (version && version.startsWith('3.')) {
+      if (!contents.paths) {
+        warnings.push('OpenAPI 3.x spec is missing "paths" field');
+      }
+    }
+  } else if (format === 'swagger') {
+    if (!contents.info) {
+      warnings.push('Swagger spec is missing required "info" field');
+    } else {
+      if (!contents.info.title) {
+        warnings.push('Swagger spec info is missing required "title" field');
+      }
+      if (!contents.info.version) {
+        warnings.push('Swagger spec info is missing required "version" field');
+      }
+    }
+
+    if (!contents.paths) {
+      warnings.push('Swagger spec is missing required "paths" field');
+    }
+
+    if (version === '2.0') {
+      if (!contents.swagger) {
+        warnings.push('Swagger 2.0 spec is missing required "swagger" field');
+      }
+    }
+  }
+
+  return warnings;
+}
