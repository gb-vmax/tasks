+function normalizeHost(host: string): string {
+  if (!host) {
+    return '';
+  }
+
+  let normalized = host.trim().toLowerCase();
+
+  if (normalized.startsWith('*.')) {
+    return normalized;
+  }
+
+  normalized = normalized.replace(/^https?:\/\//, '');
+  normalized = normalized.replace(/:\d+$/, '');
+  normalized = normalized.replace(/\/.*$/, '');
+
+  if (!normalized || normalized.includes(' ')) {
+    return '';
+  }
+
+  return normalized;
+}
+
+function validateCertificateFormat(patch: Partial<ClientCertificate>): void {
+  const hasCertKey = !!(patch.cert && patch.key);
+  const hasPfx = !!patch.pfx;
+
+  if (!hasCertKey && !hasPfx) {
+    throw new Error(
+      'New ClientCertificate must include either cert/key pair or pfx file'
+    );
+  }
+
+  if (hasCertKey && hasPfx) {
+    throw new Error(
+      'New ClientCertificate cannot have both cert/key pair and pfx file'
+    );
+  }
+}
+
