+private _recordHookMetric(operation: 'read' | 'write', hookIndex: number, duration: number, retries: number): void {
+  if (!this._hookMetrics) {
+    this._hookMetrics = [];
+  }
+  this._hookMetrics.push({
+    operation,
+    hookIndex,
+    duration,
+    retries,
+    timestamp: Date.now()
+  });
+  if (this._hookMetrics.length > 100) {
+    this._hookMetrics.shift();
+  }
