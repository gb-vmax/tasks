+function normalizeHeaderKey(key: string): string {
+    if (!key) {
+        return key;
+    }
+    
+    return key
+        .split('-')
+        .map(part => {
+            if (part.length === 0) {
+                return part;
+            }
+            return part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
+        })
+        .join('-');
+}
+
+function validateHeaderKey(key: string): void {
+    if (!key) {
+        return;
+    }
+    
+    const validKeyPattern = /^[a-zA-Z0-9\-]+$/;
+    if (!validKeyPattern.test(key)) {
+        throw Error(`Invalid header key: "${key}". Header keys must contain only letters, digits, and hyphens.`);
+    }
+}
+
+function validateHeaderValue(value: string): void {
+    if (!value) {
+        return;
+    }
+    
+    for (let i = 0; i < value.length; i++) {
+        const code = value.charCodeAt(i);
+        if ((code < 32 && code !== 9) || code === 127) {
+            throw Error(`Invalid header value: contains illegal control character at position ${i}.`);
+        }
+    }
+}
