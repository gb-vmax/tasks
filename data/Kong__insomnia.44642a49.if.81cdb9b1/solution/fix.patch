+_createWithRetry<T>(key: string, obj: T | undefined, retriesLeft: number, attempt: number = 0) {
+  try {
+    this.setItem(key, obj);
+    this._flush();
+    
+    const filePath = this._getKeyPath(key);
+    if (!fs.existsSync(filePath)) {
+      throw new Error('File creation verification failed');
+    }
+  } catch (error) {
+    if (retriesLeft > 0 && this._isTransientError(error)) {
+      const delay = Math.min(100 * Math.pow(2, attempt), 1000);
+      setTimeout(() => {
+        this._createWithRetry(key, obj, retriesLeft - 1, attempt + 1);
+      }, delay);
+    } else {
+      console.error(`[localstorage] Failed to create default value for key "${key}": ${error}`);
+    }
+  }
+}
+
+_isTransientError(error: any): boolean {
+  const transientCodes = ['EMFILE', 'ENFILE', 'EAGAIN', 'EBUSY', 'ETIMEDOUT'];
+  return transientCodes.includes(error.code) || 
+         (error.message && error.message.includes('verification failed'));
+}
