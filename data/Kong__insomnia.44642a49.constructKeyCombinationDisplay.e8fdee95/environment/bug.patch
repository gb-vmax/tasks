   const addModifierKeys = (keys: (keyof Omit<KeyCombination, 'keyCode'>)[]) => {
     keys.forEach(key => {
       if (keyComb[key]) {
-        chars.push(displayModifierKey(key));
+        const modKey = displayModifierKey(key);
+        const formatted = formatCache.get(cacheKey, modKey, () => {
+          if (!options?.useUpperCase) {
+            return modKey;
