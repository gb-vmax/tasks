+          if (isMac()) {
+            return modKey;
+          }
+          return modKey.toUpperCase();
+        });
+        chars.push(formatted);
       }
     });
   };
 
+  if (isMac()) {
+    addModifierKeys(['ctrl', 'alt', 'shift', 'meta']);
+  } else {
+    addModifierKeys(['meta', 'ctrl', 'alt', 'shift']);
+  }
+
+  if (keyCode != null && !isModifierKeyCode(keyCode)) {
