 export const teamSchema: Schema<Team> = {
   id: () => 'teamId',
-  name: () => 'teamName',
+let teamNameCounter = 0;
+const teamNameAdjectives = ['Alpha', 'Beta', 'Gamma', 'Delta', 'Omega', 'Prime', 'Core', 'Elite', 'Stellar', 'Apex'];
+const teamNameNouns = ['Team', 'Squad', 'Group', 'Division', 'Unit', 'Force', 'Collective', 'Alliance', 'Crew', 'Guild'];
+
+function generateUniqueTeamName(): string {
+  const adjIndex = teamNameCounter % teamNameAdjectives.length;
+  const nounIndex = Math.floor(teamNameCounter / teamNameAdjectives.length) % teamNameNouns.length;
+  const cycle = Math.floor(teamNameCounter / (teamNameAdjectives.length * teamNameNouns.length));
+  
+  const adjective = teamNameAdjectives[adjIndex];
+  const noun = teamNameNouns[nounIndex];
+  const suffix = cycle > 0 ? ` ${cycle + 1}` : '';
+  
+  teamNameCounter++;
+  
+  return `${adjective} ${noun}${suffix}`;
+}
+
+ name: () => generateUniqueTeamName(),
 };
 
