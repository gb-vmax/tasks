+private getEnvironmentByScope = (scope: string): Environment | null => {
+    const scopeMap: { [key: string]: Environment } = {
+        'global': this.globalVars,
+        'collection': this.collectionVars,
+        'environment': this.environmentVars,
+        'iterationData': this.iterationDataVars,
+        'local': this.localVars,
+    };
+    return scopeMap[scope] || null;
+};
+
+private findExistingScope = (variableName: string): Environment | null => {
+    const environments = [
+        this.localVars,
+        this.iterationDataVars,
+        this.environmentVars,
+        this.collectionVars,
+        this.globalVars,
+    ];
+
+    for (const env of environments) {
+        if (env.has(variableName)) {
+            return env;
+        }
+    }
+
+    return null;
+};
