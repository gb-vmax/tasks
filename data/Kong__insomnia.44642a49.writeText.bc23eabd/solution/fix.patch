+const MAX_CLIPBOARD_HISTORY = 10;
+let clipboardHistory: Array<{ text: string; timestamp: number }> = [];
+
+function sanitizeClipboardText(text: any): string | null {
+  if (text === null || text === undefined) {
+    return null;
+  }
+  
+  const textStr = String(text);
+  
+  if (textStr.length === 0) {
+    return null;
+  }
+  
+  const normalized = textStr.replace(/\s+/g, ' ').trim();
+  
+  return normalized;
+}
+
+function addToClipboardHistory(text: string): void {
+  const entry = {
+    text,
+    timestamp: Date.now(),
+  };
+  
+  if (clipboardHistory.length > 0 && clipboardHistory[0].text === text) {
+    return;
+  }
+  
+  clipboardHistory.unshift(entry);
+  
+  if (clipboardHistory.length > MAX_CLIPBOARD_HISTORY) {
+    clipboardHistory = clipboardHistory.slice(0, MAX_CLIPBOARD_HISTORY);
+  }
+}
+
+ writeText(text) {
+   const sanitized = sanitizeClipboardText(text);
+   if (sanitized === null) {
+     return false;
+   }
+  
+   try {
+     window.clipboard.writeText(sanitized);
+     addToClipboardHistory(sanitized);
+     return true;
+   } catch (error) {
+     console.error('Failed to write to clipboard:', error);
+     return false;
+   }
+ },
+
+ getHistory() {
+   return [...clipboardHistory];
+ },
+
+ clearHistory() {
+   clipboardHistory = [];
+ }
 
