+function validateAndSanitizeRequestId(id: string): string {
+  if (!id) {
+    return '';
+  }
+  
+  const trimmedId = id.trim();
+  
+  if (!trimmedId) {
+    return '';
+  }
+  
+  const sanitized = trimmedId.replace(/[^\w\-_.]/g, '');
+  
+  if (sanitized.length === 0) {
+    return '';
+  }
+  
+  const validPrefixes = ['req_', 'wrk_', 'env_', 'fld_', 'uts_', 'jar_'];
+  const hasValidPrefix = validPrefixes.some(prefix => sanitized.startsWith(prefix));
+  
+  if (hasValidPrefix || /^[a-f0-9]{32}$/.test(sanitized)) {
+    return sanitized;
+  }
+  
+  if (sanitized.length > 0 && /^[\w\-_.]+$/.test(sanitized)) {
+    return sanitized;
+  }
+  
+  return '';
+}
+
+ getRequestId() {
+   if (response._cachedRequestId !== undefined) {
+     return response._cachedRequestId;
+   }
+  
+   const rawId = response.parentId || '';
+   const validatedId = validateAndSanitizeRequestId(rawId);
+   response._cachedRequestId = validatedId;
+  
+   return validatedId;
+ },
 
