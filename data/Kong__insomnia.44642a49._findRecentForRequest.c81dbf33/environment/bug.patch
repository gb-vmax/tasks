+interface ResponseFilter {
+  onlySuccessful?: boolean;
+  onlyWithErrors?: boolean;
+  excludeStatusRanges?: Array<{ min: number; max: number }>;
+}
+
+function isSuccessfulResponse(response: Response): boolean {
+  return response.statusCode >= 200 && response.statusCode < 300 && !response.error;
+}
+
+function isInExcludedRange(statusCode: number, ranges: Array<{ min: number; max: number }>): boolean {
+  return ranges.some(range => statusCode >= range.min && statusCode <= range.max);
+}
