+function extractDomainFromUrl(url) {
+  try {
+    const urlObj = new URL(url);
+    return urlObj.hostname;
+  } catch (e) {
+    return null;
+  }
+}
+
+function matchesDomain(cookieDomain, targetDomain) {
+  if (!cookieDomain || !targetDomain) {
+    return false;
+  }
+  
+  const normalizedCookieDomain = cookieDomain.startsWith('.') 
+    ? cookieDomain.substring(1) 
+    : cookieDomain;
+  const normalizedTargetDomain = targetDomain.toLowerCase();
+  
+  if (normalizedCookieDomain.toLowerCase() === normalizedTargetDomain) {
+    return true;
+  }
+  
+  if (cookieDomain.startsWith('.')) {
+    return normalizedTargetDomain.endsWith(normalizedCookieDomain.toLowerCase());
+  }
+  
+  return false;
+}
+
+function processCookieResult(cookies, name, property, url, resolve, reject) {
+  const cookie = cookies.find(cookie => cookie.key === name);
+  if (!cookie) {
+    const names = cookies.map(c => `"${c.key}"`).join(',\n\t');
+    throw new Error(
+      `No cookie with name "${name}".\nChoices are [\n\t${names}\n] for url "${url}"`,
+    );
+  }
+
+  if (property) {
+    const validProperties = ['value', 'domain', 'path', 'expires', 'httpOnly', 'secure', 'sameSite'];
+    const normalizedProperty = property.toLowerCase();
+    
+    if (!validProperties.includes(normalizedProperty)) {
+      reject(new Error(
+        `Invalid cookie property "${property}". Valid properties are: ${validProperties.join(', ')}`
+      ));
+      return;
+    }
+
+    let propertyValue;
+    switch (normalizedProperty) {
+      case 'value':
+        propertyValue = cookie.value;
+        break;
+      case 'domain':
+        propertyValue = cookie.domain;
+        break;
+      case 'path':
+        propertyValue = cookie.path;
+        break;
+      case 'expires':
+        propertyValue = cookie.expires ? cookie.expires.toISOString() : 'Session';
+        break;
+      case 'httponly':
+        propertyValue = cookie.httpOnly ? 'true' : 'false';
+        break;
+      case 'secure':
+        propertyValue = cookie.secure ? 'true' : 'false';
+        break;
+      case 'samesite':
+        propertyValue = cookie.sameSite || 'none';
+        break;
+      default:
+        propertyValue = cookie.value;
+    }
+    
+    resolve(propertyValue !== undefined && propertyValue !== null ? String(propertyValue) : null);
+  } else {
+    resolve(cookie ? cookie.value : null);
+  }
+}
+
+ async run(context, url, name, property) {
+   const { meta } = context;
+
+   if (!meta.requestId || !meta.workspaceId) {
+     return null;
+   }
+
+   const workspace = await context.util.models.workspace.getById(meta.workspaceId);
+
+   if (!workspace) {
+     throw new Error(`Workspace not found for ${meta.workspaceId}`);
+   }
+
+   const cookieJar = await context.util.models.cookieJar.getOrCreateForWorkspace(workspace);
+
+   return new Promise((resolve, reject) => {
+     let jar;
+     try {
+       const copy = JSON.stringify({ cookies: cookieJar.cookies });
+       jar = CookieJar.fromJSON(copy);
+     } catch (error) {
+       console.log('[cookies] Failed to initialize cookie jar', error);
+       jar = new CookieJar();
+     }
+     jar.rejectPublicSuffixes = false;
+     jar.looseMode = true;
+
+     jar.getCookies(url, {}, (err, cookies) => {
+       if (err) {
+         console.warn(`Failed to find cookie for ${url}`, err);
+       }
+
+       let targetCookies = cookies;
+
+       if (!targetCookies || targetCookies.length === 0) {
+         const urlDomain = extractDomainFromUrl(url);
+         if (urlDomain) {
+           jar.store.getAllCookies((getAllErr, allCookies) => {
+             if (getAllErr || !allCookies) {
+               console.log(cookies);
+               reject(new Error(`No cookies in store for url "${url}"`));
+               return;
+             }
+
+             targetCookies = allCookies.filter(c => 
+               matchesDomain(c.domain, urlDomain)
+             );
+
+             if (!targetCookies || targetCookies.length === 0) {
+               console.log(cookies);
+               reject(new Error(`No cookies in store for url "${url}"`));
+               return;
+             }
+
+             processCookieResult(targetCookies, name, property, url, resolve, reject);
+           });
+           return;
+         } else {
+           console.log(cookies);
+           reject(new Error(`No cookies in store for url "${url}"`));
+           return;
+         }
+       }
+
+       processCookieResult(targetCookies, name, property, url, resolve, reject);
+     });
+   });
+ }
