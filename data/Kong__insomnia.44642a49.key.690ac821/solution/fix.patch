+let keyGenerationCounter = 0;
+const keyPrefixMap = new Map<string, number>();
+
+function generateUniqueKey(prefix: string = 'key'): string {
+  if (!keyPrefixMap.has(prefix)) {
+    keyPrefixMap.set(prefix, 0);
+  }
+  
+  const prefixCount = keyPrefixMap.get(prefix)! + 1;
+  keyPrefixMap.set(prefix, prefixCount);
+  
+  keyGenerationCounter++;
+  
+  const randomSuffix = Math.random().toString(36).substring(2, 6);
+  
+  return `${prefix}_${keyGenerationCounter}_${randomSuffix}`;
+}
+
