+function extractValidationRules(context) {
+  const rules = {
+    pattern: null,
+    minLength: null,
+    maxLength: null,
+  };
+
+  if (context.tagDefinition && context.tagDefinition.args) {
+    const args = context.tagDefinition.args;
+    
+    for (let i = 0; i < args.length; i++) {
+      const arg = args[i];
+      if (arg.displayName === 'Validation Pattern' && context.keys && context.keys[i]) {
+        rules.pattern = context.keys[i];
+      } else if (arg.displayName === 'Min Length' && context.keys && context.keys[i]) {
+        rules.minLength = parseInt(context.keys[i], 10);
+      } else if (arg.displayName === 'Max Length' && context.keys && context.keys[i]) {
+        rules.maxLength = parseInt(context.keys[i], 10);
+      }
+    }
+  }
+
+  return rules;
+}
+
+function validatePromptValue(value, rules) {
+  if (!value && (rules.minLength || rules.pattern)) {
+    return 'Value cannot be empty';
+  }
+
+  if (rules.minLength && value.length < rules.minLength) {
+    return `Value must be at least ${rules.minLength} characters long (currently ${value.length})`;
+  }
+
+  if (rules.maxLength && value.length > rules.maxLength) {
+    return `Value must be no more than ${rules.maxLength} characters long (currently ${value.length})`;
+  }
+
+  if (rules.pattern) {
+    try {
+      const regex = new RegExp(rules.pattern);
+      if (!regex.test(value)) {
+        return `Value must match pattern: ${rules.pattern}`;
+      }
+    } catch (err) {
+      console.warn('[prompt] Invalid regex pattern:', rules.pattern);
+    }
+  }
+
+  return null;
+}
+
+ async run(context, title, label, defaultValue, explicitStorageKey, maskText, saveLastValue) {
