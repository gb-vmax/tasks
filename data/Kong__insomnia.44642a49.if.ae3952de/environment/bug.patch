+function _getFromCache<T extends BaseModel>(key: string): T | null {
+  const entry = _docCache.get(key);
+  if (!entry) {
+    return null;
+  }
+  
+  if (Date.now() > entry.expiresAt) {
+    _docCache.delete(key);
+    _cacheStats.evictions++;
+    return null;
+  }
