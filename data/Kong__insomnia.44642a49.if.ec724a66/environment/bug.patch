+function mergeHeaderValues(existingValue: string, newValue: string): string {
+    if (!existingValue) return newValue;
+    if (!newValue) return existingValue;
+    
+    const existingValues = existingValue.split(',').map(v => v.trim());
+    const newValues = newValue.split(',').map(v => v.trim());
+    
+    const uniqueValues = new Set([...existingValues, ...newValues]);
+    return Array.from(uniqueValues).join(', ');
+}
