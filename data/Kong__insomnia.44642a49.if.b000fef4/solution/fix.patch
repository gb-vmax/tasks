+function isValidStateEntry(entry: any): entry is SnapshotStateEntry {
+  return (
+    entry &&
+    typeof entry === 'object' &&
+    typeof entry.key === 'string' &&
+    entry.key.length > 0 &&
+    typeof entry.blob === 'string'
+  );
+}
+
+function logDuplicateKeys(keys: Set<string>): void {
+  if (typeof console !== 'undefined' && console.warn) {
+    console.warn(
+      `Duplicate keys detected in snapshot state: ${Array.from(keys).join(', ')}. Using last occurrence.`
+    );
   }
+}
+
+ export function generateStateMap(state: SnapshotState | null): SnapshotStateMap {
+   if (!state) {
+     return {};
+   }
+
+   const map: SnapshotStateMap = {};
+   const duplicateKeys = new Set<string>();
+
+   for (const entry of state) {
+     if (!isValidStateEntry(entry)) {
+       continue;
+     }
+
+     if (map[entry.key] !== undefined) {
+       duplicateKeys.add(entry.key);
+     }
+
+     map[entry.key] = entry;
+   }
+
+   if (duplicateKeys.size > 0) {
+     logDuplicateKeys(duplicateKeys);
+   }
+
+   return map;
+ }
 
   const map: SnapshotStateMap = {};
 
