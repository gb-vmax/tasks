+
+   let now = new Date();
+
+   if (timezoneOffsetMinutes !== null && timezoneOffsetMinutes !== '' && timezoneOffsetMinutes !== undefined) {
+     const offsetMs = parseTimezoneOffset(timezoneOffsetMinutes);
+     const localOffsetMs = now.getTimezoneOffset() * 60000;
+     now = new Date(now.getTime() + localOffsetMs + offsetMs);
+   }
+
+   if (timeOffset && timeOffset !== '') {
+     const offsetMs = parseTimeOffset(timeOffset);
+     now = new Date(now.getTime() + offsetMs);
+   }
+
+   switch (dateType) {
+     case 'millis':
