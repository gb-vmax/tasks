+function parseTimeOffset(offsetStr) {
+  const trimmed = offsetStr.trim();
+  if (!trimmed) {
+    return 0;
+  }
+
+  const match = trimmed.match(/^([+-]?)(\d+(?:\.\d+)?)\s*([smhdwy]?)$/i);
+  if (!match) {
+    throw new Error(`Invalid time offset format "${offsetStr}". Use format like "+1h", "-30m", "2d"`);
+  }
+
+  const sign = match[1] === '-' ? -1 : 1;
+  const value = parseFloat(match[2]);
+  const unit = (match[3] || 's').toLowerCase();
+
+  let multiplier;
+  switch (unit) {
+    case 's':
+      multiplier = 1000;
+      break;
+    case 'm':
+      multiplier = 60 * 1000;
+      break;
+    case 'h':
+      multiplier = 60 * 60 * 1000;
+      break;
+    case 'd':
+      multiplier = 24 * 60 * 60 * 1000;
+      break;
+    case 'w':
+      multiplier = 7 * 24 * 60 * 60 * 1000;
+      break;
+    case 'y':
+      multiplier = 365 * 24 * 60 * 60 * 1000;
+      break;
+    default:
+      throw new Error(`Invalid time unit "${unit}". Use s, m, h, d, w, or y`);
+  }
+
+  return sign * value * multiplier;
+}
+
+function parseTimezoneOffset(offsetMinutes) {
+  const parsed = typeof offsetMinutes === 'string' ? parseFloat(offsetMinutes) : offsetMinutes;
+  if (isNaN(parsed)) {
+    throw new Error(`Invalid timezone offset "${offsetMinutes}". Must be a number of minutes`);
+  }
+  return parsed * 60000;
+}
+
+ run(_context, dateType = 'iso-8601', formatStr = '', timeOffset = '', timezoneOffsetMinutes = null) {
+   if (typeof dateType === 'string') {
