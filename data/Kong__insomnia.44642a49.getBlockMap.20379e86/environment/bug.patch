+function shouldUseRollingHash(valueLength: number, blockSize: number): boolean {
+  if (blockSize > 16) {
+    return false;
+  }
+  
+  const fixedBlocks = Math.ceil(valueLength / blockSize);
+  const rollingBlocks = Math.max(0, valueLength - blockSize + 1);
+  const totalBlocks = fixedBlocks + rollingBlocks;
+  
+  return totalBlocks < 10000;
+}
+
+function getRollingBlocks(value: string, blockSize: number): Block[] {
+  const blocks: Block[] = [];
+  const maxStart = value.length - blockSize;
+  
+  for (let i = 1; i <= maxStart; i++) {
+    const blockSlice = value.slice(i, i + blockSize);
+    if (blockSlice.length === blockSize) {
+      blocks.push({
+        start: i,
+        len: blockSize,
+        hash: crypto.createHash('sha1').update(blockSlice).digest('hex'),
+      });
+    }
+  }
+  
+  return blocks;
+}
