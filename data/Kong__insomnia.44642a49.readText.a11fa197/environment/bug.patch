+const clipboardHistory = {
+  lastContent: '',
+  lastReadTime: 0,
+  readCount: 0,
+  onChange: null as ((text: string) => void) | null,
+};
+
+function sanitizeClipboardText(text: string): string {
+  if (!text || typeof text !== 'string') {
+    return '';
+  }
+  
+  return text
+    .replace(/[\x00-\x08\x0B-\x0C\x0E-\x1F\x7F]/g, '')
+    .replace(/\r\n/g, '\n')
+    .replace(/\r/g, '\n')
+    .replace(/[ \t]+$/gm, '')
+    .replace(/\n{3,}/g, '\n\n');
+}
+
+ readText() {
