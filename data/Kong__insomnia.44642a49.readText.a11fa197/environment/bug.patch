+   clipboardHistory.lastContent = sanitized;
+   clipboardHistory.lastReadTime = Date.now();
+   clipboardHistory.readCount++;
+  
+   if (hasChanged && clipboardHistory.onChange) {
+     clipboardHistory.onChange(sanitized);
