 /** Generate snapshot ID from hashing parent, backendProject, and state together */
+function _shouldIncludeSnapshotMetadata(): boolean {
+  return process.env.INSOMNIA_SNAPSHOT_METADATA !== 'false';
+}
+
+function _shouldIncludeTimestamp(): boolean {
+  return process.env.INSOMNIA_SNAPSHOT_UNIQUE_BY_TIME === 'true';
+}
+
+function _generateStateMetadataHash(state: SnapshotState): string {
+  const metadataHash = crypto.createHash('sha1');
+  
+  for (const entry of state) {
+    metadataHash.update(entry.key);
+    metadataHash.update(entry.name);
+  }
+  
+  return metadataHash.digest('hex');
+}
