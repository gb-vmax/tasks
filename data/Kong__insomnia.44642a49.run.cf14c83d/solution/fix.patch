+function parseValidationRules(label) {
+  if (!label || typeof label !== 'string') {
+    return null;
+  }
+
+  const rules = {};
+  
+  const regexMatch = label.match(/\[regex:([^\]]+)\]/);
+  if (regexMatch) {
+    try {
+      rules.regex = new RegExp(regexMatch[1]);
+    } catch (e) {
+      console.warn('[prompt] Invalid regex pattern in label:', e);
+    }
+  }
+
+  const minLengthMatch = label.match(/\[minLength:(\d+)\]/);
+  if (minLengthMatch) {
+    rules.minLength = parseInt(minLengthMatch[1], 10);
+  }
+
+  const maxLengthMatch = label.match(/\[maxLength:(\d+)\]/);
+  if (maxLengthMatch) {
+    rules.maxLength = parseInt(maxLengthMatch[1], 10);
+  }
+
+  const errorMatch = label.match(/\[error:([^\]]+)\]/);
+  if (errorMatch) {
+    rules.customError = errorMatch[1];
+  }
+
+  return Object.keys(rules).length > 0 ? rules : null;
+}
+
+function validateInput(value, rules) {
+  if (!rules) {
+    return { isValid: true };
+  }
+
+  const inputValue = value || '';
+
+  if (rules.minLength !== undefined && inputValue.length < rules.minLength) {
+    return {
+      isValid: false,
+      error: rules.customError || `Input must be at least ${rules.minLength} characters long`
+    };
+  }
+
+  if (rules.maxLength !== undefined && inputValue.length > rules.maxLength) {
+    return {
+      isValid: false,
+      error: rules.customError || `Input must be no more than ${rules.maxLength} characters long`
+    };
+  }
+
+  if (rules.regex && !rules.regex.test(inputValue)) {
+    return {
+      isValid: false,
+      error: rules.customError || `Input does not match required pattern: ${rules.regex.source}`
+    };
+  }
+
+  return { isValid: true };
+}
+
+ async run(context, title, label, defaultValue, explicitStorageKey, maskText, saveLastValue) {
+   if (!title) {
+     throw new Error('Title attribute is required for prompt tag');
+   }
+
+   const titleHash = crypto
+     .createHash('md5')
+     .update(title)
+     .digest('hex');
+   const storageKey = explicitStorageKey || `${context.meta.requestId}.${titleHash}`;
+   const cachedValue = await context.store.getItem(storageKey);
+
+   if (explicitStorageKey && cachedValue) {
+     console.log(`[prompt] Used cached value under ${storageKey}`);
+     return cachedValue;
+   }
+
+   if (cachedValue && saveLastValue) {
+     defaultValue = cachedValue;
+     console.log(`[prompt] Used cached value under ${storageKey}`);
+   }
+
+   if (context.renderPurpose !== 'send') {
+     if (cachedValue !== null) {
+       return cachedValue;
+     } else {
+       return defaultValue || '';
+     }
+   }
+
+   const validationRules = parseValidationRules(label);
+   let currentLabel = label;
+   let currentDefault = defaultValue;
+   let value;
+   let validationAttempts = 0;
+   const maxAttempts = 5;
+
+   while (validationAttempts < maxAttempts) {
+     value = await context.app.prompt(title || 'Enter Value', {
+       label: currentLabel,
+       defaultValue: currentDefault,
+       inputType: maskText ? 'password' : 'text',
+     });
+
+     const validationResult = validateInput(value, validationRules);
+    
+     if (validationResult.isValid) {
+       break;
+     }
+
+     validationAttempts++;
+     if (validationAttempts >= maxAttempts) {
+       throw new Error(`Validation failed after ${maxAttempts} attempts: ${validationResult.error}`);
+     }
+
+     currentLabel = `${label}\n\n⚠️ ${validationResult.error}`;
+     currentDefault = value;
+   }
+
+   if (storageKey) {
+     console.log(`[prompt] Stored value under ${storageKey}`);
+     await context.store.setItem(storageKey, value);
+   }
+
+   return value;
+ }
