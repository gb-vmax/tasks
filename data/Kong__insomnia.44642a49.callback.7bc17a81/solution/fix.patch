+const BRANCH_CACHE_TTL = 30000;
+const MAX_RETRIES = 2;
+const INITIAL_RETRY_DELAY = 1000;
+
+const branchCache = new Map<string, { branches: string[]; timestamp: number }>();
+
+const retryOperation = async <T>(
+  operation: () => Promise<T>,
+  maxRetries: number,
+  currentAttempt = 0
+): Promise<T> => {
+  try {
+    return await operation();
+  } catch (error) {
+    if (currentAttempt >= maxRetries) {
+      throw error;
+    }
+    
+    const delay = INITIAL_RETRY_DELAY * Math.pow(2, currentAttempt);
+    await new Promise(resolve => setTimeout(resolve, delay));
+    
+    return retryOperation(operation, maxRetries, currentAttempt + 1);
+  }
+};
+
+ callback: async () => {
+   const cacheKey = `branches:${backendProject._id}`;
+   const cached = branchCache.get(cacheKey);
+  
+   if (cached && Date.now() - cached.timestamp < BRANCH_CACHE_TTL) {
+     return cached.branches;
+   }
+  
+   const branches = await retryOperation(() => vcs.getRemoteBranchNames(), MAX_RETRIES);
+   branchCache.set(cacheKey, { branches, timestamp: Date.now() });
+  
+   return branches;
+ }
     resourceName: backendProject.name,
