+ withDescendants: async function<T extends BaseModel>(doc: T | null, stopType: string | null = null, maxDepth: number | null = null): Promise<BaseModel[]> {
+   if (db._empty) {
+     return _send<BaseModel[]>('withDescendants', ...arguments);
