+function normalizeCookieExpiration(cookieJar: CookieJar) {
+  for (const cookie of cookieJar.cookies) {
+    if (cookie.expires === null || cookie.expires === undefined) {
+      cookie.expires = null;
+      continue;
+    }
+
+    if (cookie.expires instanceof Date) {
+      if (isNaN(cookie.expires.getTime())) {
+        cookie.expires = null;
+      }
+      continue;
+    }
+
+    if (typeof cookie.expires === 'string') {
+      const parsed = new Date(cookie.expires);
+      cookie.expires = isNaN(parsed.getTime()) ? null : parsed;
+      continue;
+    }
+
+    if (typeof cookie.expires === 'number') {
+      const parsed = new Date(cookie.expires);
+      cookie.expires = isNaN(parsed.getTime()) ? null : parsed;
+      continue;
+    }
+
+    cookie.expires = null;
+  }
+
+  return cookieJar;
+}
+
+function deduplicateCookies(cookieJar: CookieJar) {
+  const cookieMap = new Map<string, Cookie>();
+
+  for (const cookie of cookieJar.cookies) {
+    const key = `${cookie.key}|${cookie.domain}|${cookie.path}`;
+    const existing = cookieMap.get(key);
+
+    if (!existing) {
+      cookieMap.set(key, cookie);
+      continue;
+    }
+
+    const existingCreation = existing.creation instanceof Date 
+      ? existing.creation.getTime() 
+      : (existing.creationIndex || 0);
+    
+    const currentCreation = cookie.creation instanceof Date 
+      ? cookie.creation.getTime() 
+      : (cookie.creationIndex || 0);
+
+    if (currentCreation > existingCreation) {
+      cookieMap.set(key, cookie);
+    }
+  }
+
+  cookieJar.cookies = Array.from(cookieMap.values());
+  return cookieJar;
+}
