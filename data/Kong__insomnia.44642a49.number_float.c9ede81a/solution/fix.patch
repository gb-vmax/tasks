@@ -452,7 +452,59 @@ const generateParameterExample = (
     'string_date-time': () => new Date().toISOString(),
     string_byte: () => 'ZXhhbXBsZQ==',
     number: () => 0,
-    number_float: () => 0.0,
+const generateConstrainedFloat = (
+  minimum: number | undefined,
+  maximum: number | undefined,
+  exclusiveMinimum: boolean | undefined,
+  exclusiveMaximum: boolean | undefined,
+  seed?: string,
+): number => {
+  const epsilon = 0.01;
+  
+  let min = minimum !== undefined ? minimum : -1000;
+  let max = maximum !== undefined ? maximum : 1000;
+  
+  if (exclusiveMinimum && minimum !== undefined) {
+    min = minimum + epsilon;
+  }
+  
+  if (exclusiveMaximum && maximum !== undefined) {
+    max = maximum - epsilon;
+  }
+  
+  if (min > max) {
+    return 0.0;
+  }
+  
+  if (minimum === undefined && maximum === undefined) {
+    return 0.0;
+  }
+  
+  const seedValue = seed ? simpleHash(seed) : 0.5;
+  const range = max - min;
+  const value = min + (seedValue * range);
+  
+  return Math.round(value * 100) / 100;
+};
+
+const simpleHash = (str: string): number => {
+  let hash = 0;
+  for (let i = 0; i < str.length; i++) {
+    const char = str.charCodeAt(i);
+    hash = ((hash << 5) - hash) + char;
+    hash = hash & hash;
+  }
+  return Math.abs(hash % 100) / 100;
+};
+
+ number_float: (parameter: OpenAPIV2.Parameter) => {
+   const min = parameter.minimum;
+   const max = parameter.maximum;
+   const exclusiveMin = parameter.exclusiveMinimum;
+   const exclusiveMax = parameter.exclusiveMaximum;
+  
+   return generateConstrainedFloat(min, max, exclusiveMin, exclusiveMax, parameter.name);
+ },
     number_double: () => 0.0,
     integer: () => 0,
     boolean: () => true,
