+private _bypassPatternCache: RegExp[] | null = null;
+
+private _compileBypassPatterns(): RegExp[] {
+    if (this._bypassPatternCache !== null) {
+        return this._bypassPatternCache;
+    }
+
+    this._bypassPatternCache = this.bypass.map(pattern => {
+        const regexPattern = pattern
+            .replace(/[.+?^${}()|[\]\\]/g, '\\$&')
+            .replace(/\*/g, '.*');
+        return new RegExp(`^${regexPattern}$`, 'i');
+    });
+
+    return this._bypassPatternCache;
+}
+
+private _testBypass(url: string): boolean {
+    if (this.bypass.length === 0) {
+        return false;
+    }
+
+    if (this.bypass.includes(url)) {
+        return true;
+    }
+
+    const patterns = this._compileBypassPatterns();
+    return patterns.some(pattern => pattern.test(url));
+}
+
+update(options: {
