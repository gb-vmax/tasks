+function parseNodeParam(nodeParam) {
+  if (nodeParam.includes(':')) {
+    const parts = nodeParam.split(':');
+    if (parts.length === 6) {
+      const node = parts.map(p => parseInt(p, 16));
+      if (node.some(n => isNaN(n) || n < 0 || n > 255)) {
+        throw new Error('Invalid MAC address format');
+      }
+      return node;
+    }
+  }
+  
+  if (nodeParam.includes('-')) {
+    const parts = nodeParam.split('-');
+    if (parts.length === 6) {
+      const node = parts.map(p => parseInt(p, 16));
+      if (node.some(n => isNaN(n) || n < 0 || n > 255)) {
+        throw new Error('Invalid MAC address format');
+      }
+      return node;
+    }
+  }
+  
+  const cleaned = nodeParam.replace(/[^0-9a-f]/gi, '');
+  if (cleaned.length === 12) {
+    const node = [];
+    for (let i = 0; i < 12; i += 2) {
+      node.push(parseInt(cleaned.substr(i, 2), 16));
+    }
+    return node;
+  }
+  
+  throw new Error('Node must be a MAC address in format XX:XX:XX:XX:XX:XX, XX-XX-XX-XX-XX-XX, or XXXXXXXXXXXX');
+}
