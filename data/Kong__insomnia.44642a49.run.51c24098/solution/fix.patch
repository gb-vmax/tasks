+function resolveNamespace(namespace) {
+  if (!namespace) {
+    throw new Error('Namespace is required for v5 UUID');
+  }
+  
+  const nsStr = (namespace + '').toLowerCase();
+  
+  switch (nsStr) {
+    case 'dns':
+      return uuid.v5.DNS;
+    case 'url':
+      return uuid.v5.URL;
+    case 'oid':
+      return uuid.v5.OID;
+    case 'x500':
+      return uuid.v5.X500;
+    default:
+      if (typeof namespace === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(namespace)) {
+        return namespace;
+      }
+      throw new Error(`Invalid namespace "${namespace}". Use 'dns', 'url', 'oid', 'x500', or a valid UUID string`);
+  }
+}
