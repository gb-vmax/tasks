+function calculateHeadersSize(headers: Har.Header[], statusCode: number, statusMessage: string): number {
+  let size = 0;
+  
+  size += `HTTP/1.1 ${statusCode} ${statusMessage}\r\n`.length;
+  
+  for (const header of headers) {
+    size += `${header.name}: ${header.value}\r\n`.length;
+  }
+  
+  size += '\r\n'.length;
+  
+  return size;
+}
+
+function calculateBodySize(response: Response, content: Har.Content): number {
+  const contentLengthHeader = response.headers.find(
+    h => h.name && h.name.toLowerCase() === 'content-length'
+  );
+  
+  if (contentLengthHeader && contentLengthHeader.value) {
+    const parsed = parseInt(contentLengthHeader.value, 10);
+    if (!isNaN(parsed) && parsed >= 0) {
+      return parsed;
+    }
+  }
+  
+  return content.size;
+}
+
+function extractRedirectURL(headers: Har.Header[]): string {
+  const locationHeader = headers.find(
+    h => h.name && h.name.toLowerCase() === 'location'
+  );
+  
+  return locationHeader?.value || '';
+}
