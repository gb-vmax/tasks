+const haveBodyPattern = (pattern: RegExp, checkEquality: boolean) => {
+    const bodyText = this.text();
+    const matches = pattern.test(bodyText);
+    if ((matches && checkEquality) || (!matches && !checkEquality)) {
+        return;
+    }
+    throw Error(`Body does not match the expected pattern: "${pattern}"`);
+};
+
+const haveBodyContains = (substring: string, checkEquality: boolean) => {
+    const bodyText = this.text();
+    const contains = bodyText.includes(substring);
+    if ((contains && checkEquality) || (!contains && !checkEquality)) {
+        return;
+    }
+    throw Error(`Body does not contain the expected substring: "${substring}"`);
+};
+
+ body: (expected: string | RegExp) => {
+     if (expected instanceof RegExp) {
+         return haveBodyPattern(expected, true);
+     }
+     if (typeof expected === 'string' && expected.startsWith('contains:')) {
+         return haveBodyContains(expected.substring(9), true);
+     }
+     return haveBody(expected as string, true);
+ },
                 jsonBody: (expected: object) => haveJsonBody(expected, true),
                 jsonSchema: (expected: object) => haveJsonSchema(expected, true),
             },
