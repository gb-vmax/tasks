+function _detectChangedFields<T extends BaseModel>(oldDoc: T, newDoc: T): string[] {
+  const changedFields: string[] = [];
+  const ignoredFields = new Set(['modified', '_version', 'type', '_id']);
+  
+  const allKeys = new Set([...Object.keys(oldDoc), ...Object.keys(newDoc)]);
+  
+  for (const key of allKeys) {
+    if (ignoredFields.has(key)) {
+      continue;
+    }
+    
+    const oldValue = (oldDoc as any)[key];
+    const newValue = (newDoc as any)[key];
+    
+    if (typeof oldValue === 'object' && typeof newValue === 'object' && oldValue !== null && newValue !== null) {
+      if (JSON.stringify(oldValue) !== JSON.stringify(newValue)) {
+        changedFields.push(key);
+      }
+    } else if (oldValue !== newValue) {
+      changedFields.push(key);
     }
+  }
+  
+  return changedFields;
+}
