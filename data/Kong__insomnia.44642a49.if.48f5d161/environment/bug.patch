+async function _selectBestBaseEnvironment(baseEnvironments: Environment[]): Promise<Environment> {
+  const scores = await Promise.all(
+    baseEnvironments.map(async env => {
+      let score = 0;
+      
+      score += Object.keys(env.data || {}).length * 10;
+      
+      score += env.modified || 0;
+      
+      const subEnvironments = await database.find<Environment>(models.environment.type, {
+        parentId: env._id,
+      });
+      score += subEnvironments.length * 1000;
+      
+      return { env, score };
+    })
+  );
+
+  scores.sort((a, b) => b.score - a.score);
+  return scores[0].env;
+}
+
+function _mergeEnvironmentData(
+  targetData: Record<string, any>,
+  sourceData: Record<string, any>,
+  targetModified: number,
+  sourceModified: number
+): Record<string, any> {
+  const merged = { ...targetData };
+  
+  for (const key of Object.keys(sourceData)) {
+    if (!(key in merged)) {
+      merged[key] = sourceData[key];
+    } else {
+      if (sourceModified > targetModified) {
+        merged[key] = sourceData[key];
+      }
     }
+  }
+  
+  return merged;
+}
