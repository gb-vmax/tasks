+private _attachSearchMetadata(target: PropertyBase, depth: number, path: PropertyBase[]) {
+    const metadataSymbol = Symbol.for('__findInParents_metadata__');
+    Object.defineProperty(target, metadataSymbol, {
+        value: {
+            depth,
+            path: [...path],
+            timestamp: Date.now(),
