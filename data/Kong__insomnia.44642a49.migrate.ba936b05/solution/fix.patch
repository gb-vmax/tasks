+function normalizeGitUri(uri: string): string {
+  let normalized = uri.trim();
+  
+  const sshPattern = /^git@([^:]+):(.+)$/;
+  const sshMatch = normalized.match(sshPattern);
+  if (sshMatch) {
+    const [, host, path] = sshMatch;
+    normalized = `ssh://git@${host}/${path}`;
+  }
+  
+  if (normalized.endsWith('.git')) {
+    normalized = normalized.slice(0, -4);
+  }
+  
+  normalized = normalized.replace(/\/+$/, '');
+  
+  try {
+    const url = new URL(normalized);
+    if (url.protocol === 'http:') {
+      url.protocol = 'https:';
+      normalized = url.toString();
+    }
+  } catch {
+  }
+  
+  return normalized;
+}
+
+function normalizeCredentials(credentials: GitCredentials): GitCredentials {
+  const normalized = { ...credentials };
+  
+  if ('token' in normalized && normalized.token) {
+    if (!('oauth' in normalized)) {
+      normalized.oauth = 'github';
+    }
+  }
+  
+  if ('username' in normalized && normalized.username) {
+    normalized.username = normalized.username.trim();
+  }
+  
+  if ('password' in normalized && normalized.password) {
+    normalized.password = normalized.password.trim();
+  }
+  
+  return normalized;
+}
+
