+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return (
+    value !== null &&
+    typeof value === 'object' &&
+    !Array.isArray(value) &&
+    Object.prototype.toString.call(value) === '[object Object]'
+  );
+}
+
+function describeNestedChanges(
+  a: Record<string, unknown>,
+  b: Record<string, unknown>,
+  parentPath: string
+): string[] {
+  const changes: string[] = [];
+  const allKeys = [...new Set([...Object.keys(a), ...Object.keys(b)])];
+
+  for (const key of allKeys) {
+    const aValue = a[key];
+    const bValue = b[key];
+    const aStr = deterministicStringify(aValue);
+    const bStr = deterministicStringify(bValue);
+    const fullPath = `${parentPath}.${key}`;
+
+    if (aValue === undefined && bValue !== undefined) {
+      changes.push(`+${fullPath}`);
+      continue;
+    }
+
+    if (aValue !== undefined && bValue === undefined) {
+      changes.push(`-${fullPath}`);
       continue;
     }
 
+    if (aStr !== bStr) {
+      if (isPlainObject(aValue) && isPlainObject(bValue)) {
+        changes.push(...describeNestedChanges(aValue, bValue, fullPath));
+      } else {
+        const changeMarker = detectChangeType(aValue, bValue);
+        changes.push(changeMarker ? `${changeMarker}${fullPath}` : fullPath);
+      }
+    }
+  }
+
+  return changes;
+}
+
+function detectChangeType(aValue: unknown, bValue: unknown): string {
+  const aType = typeof aValue;
+  const bType = typeof bValue;
+
+  if (aType !== bType) {
+    return '~';
+  }
+
+  if (Array.isArray(aValue) && Array.isArray(bValue)) {
+    return aValue.length !== bValue.length ? '~' : '';
+  }
+
+  return '';
+}
