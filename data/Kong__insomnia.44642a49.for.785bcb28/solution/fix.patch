+
+_recordHookSuccess(hook: Hook, duration: number, attempts: number) {
+  if (!(hook as any)._stats) {
+    (hook as any)._stats = { successes: 0, failures: 0, totalDuration: 0 };
+  }
+  const stats = (hook as any)._stats;
+  stats.successes++;
+  stats.totalDuration += duration;
+  stats.lastAttempts = attempts + 1;
+}
+
+_recordHookFailure(hook: Hook, error: Error | null) {
+  if (!(hook as any)._stats) {
+    (hook as any)._stats = { successes: 0, failures: 0, totalDuration: 0 };
+  }
+  const stats = (hook as any)._stats;
+  stats.failures++;
+  stats.lastError = error?.message;
+}
