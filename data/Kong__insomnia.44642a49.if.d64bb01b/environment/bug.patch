+function extractErrorDetails(errorResponse: sendCurlAndWriteTimelineError): {
+    message: string;
+    type: string;
+    elapsedTime?: number;
+} {
+    const details = {
+        message: '',
+        type: 'unknown',
+        elapsedTime: undefined as number | undefined,
+    };
+
+    if (errorResponse.error) {
+        if (typeof errorResponse.error === 'string') {
+            details.message = errorResponse.error;
+        } else if (typeof errorResponse.error === 'object' && errorResponse.error !== null) {
+            if ('message' in errorResponse.error && typeof errorResponse.error.message === 'string') {
+                details.message = errorResponse.error.message;
+            }
+            if ('code' in errorResponse.error && typeof errorResponse.error.code === 'string') {
+                details.type = errorResponse.error.code;
+            } else if ('name' in errorResponse.error && typeof errorResponse.error.name === 'string') {
+                details.type = errorResponse.error.name;
+            }
+        }
+    }
+
+    if ('elapsedTime' in errorResponse && typeof errorResponse.elapsedTime === 'number') {
+        details.elapsedTime = errorResponse.elapsedTime;
     }
+
+    if (!details.message) {
+        details.message = 'An unknown error occurred during the request';
+    }
+
+    return details;
+}
+
+function isValidResponse(response: sendCurlAndWriteTimelineResponse): boolean {
+    return response !== null && 
+           response !== undefined && 
+           typeof response === 'object' &&
+           ('statusCode' in response || 'headers' in response);
+}
+
+ export function toScriptResponse(
+     originalRequest: Request,
+     partialInsoResponse: sendCurlAndWriteTimelineResponse | sendCurlAndWriteTimelineError,
+     responseBody: string,
