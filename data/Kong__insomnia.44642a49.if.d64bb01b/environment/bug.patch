+         const errorResponse = partialInsoResponse as sendCurlAndWriteTimelineError;
+        
+         try {
+             const errorDetails = extractErrorDetails(errorResponse);
+             const errorHeaders = [
+                 { key: 'X-Insomnia-Error', value: 'true' },
+                 { key: 'X-Error-Type', value: errorDetails.type },
+             ];
+
+             if (errorDetails.message) {
+                 errorHeaders.push({ key: 'X-Error-Message', value: errorDetails.message });
+             }
+
+             const errorBody = JSON.stringify({
+                 error: true,
+                 message: errorDetails.message || 'Request failed',
+                 type: errorDetails.type,
+                 timestamp: new Date().toISOString(),
+             });
+
+             return new Response({
+                 code: 0,
+                 reason: 'Client Error',
+                 header: errorHeaders,
+                 cookie: [],
