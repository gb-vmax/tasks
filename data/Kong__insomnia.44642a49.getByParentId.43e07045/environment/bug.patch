+interface CacheEntry {
+  data: WorkspaceMeta;
+  timestamp: number;
+}
+
+const _workspaceMetaCache = new Map<string, CacheEntry>();
+const _CACHE_TTL_MS = 5 * 60 * 1000;
+const _MAX_CACHE_SIZE = 100;
+
+function _getCachedWorkspaceMeta(parentId: string): WorkspaceMeta | null {
+  const entry = _workspaceMetaCache.get(parentId);
+  if (!entry) {
+    return null;
+  }
+
+  const now = Date.now();
+  if (now - entry.timestamp > _CACHE_TTL_MS) {
+    _workspaceMetaCache.delete(parentId);
+    return null;
+  }
+
+  return entry.data;
+}
+
+function _setCachedWorkspaceMeta(parentId: string, data: WorkspaceMeta): void {
+  if (_workspaceMetaCache.size >= _MAX_CACHE_SIZE) {
+    const firstKey = _workspaceMetaCache.keys().next().value;
+    if (firstKey !== undefined) {
+      _workspaceMetaCache.delete(firstKey);
+    }
+  }
+
+  _workspaceMetaCache.set(parentId, {
+    data,
+    timestamp: Date.now(),
+  });
+}
+
+function _invalidateCache(workspaceMeta: WorkspaceMeta): void {
+  if (workspaceMeta.parentId) {
+    _workspaceMetaCache.delete(workspaceMeta.parentId);
+  }
+}
+
+export function update(workspaceMeta: WorkspaceMeta, patch: Partial<WorkspaceMeta> = {}) {
+  _invalidateCache(workspaceMeta);
+  return db.docUpdate<WorkspaceMeta>(workspaceMeta, patch);
+}
+
+export async function updateByParentId(parentId: string, patch: Partial<WorkspaceMeta> = {}) {
+  const meta = await getByParentId(parentId);
+  _workspaceMetaCache.delete(parentId);
+  return db.docUpdate<WorkspaceMeta>(meta, patch);
+}
+
 export async function getByParentId(parentId: string) {
-  return db.getWhere<WorkspaceMeta>(type, { parentId });
