+export interface ParsedApiSpec {
+  contents: Record<string, any> | null;
+  rawContents: string;
+  format: 'openapi' | 'swagger' | null;
+  formatVersion: string | null;
+  isValid?: boolean;
+  validationErrors?: string[];
+  metadata?: ApiMetadata;
+}
+
+export interface ApiMetadata {
+  title?: string;
+  version?: string;
+  description?: string;
+  servers?: string[];
+  basePath?: string;
+  host?: string;
+  pathCount?: number;
+}
+
+function validateApiSpecStructure(
+  contents: Record<string, any>,
+  format: 'openapi' | 'swagger',
+): { isValid: boolean; errors: string[] } {
+  const errors: string[] = [];
+  
+  if (!contents.info) {
+    errors.push('Missing required "info" object');
+  } else {
+    if (!contents.info.title) {
+      errors.push('Missing required "info.title" field');
+    }
+    if (!contents.info.version) {
+      errors.push('Missing required "info.version" field');
+    }
+  }
+  
+  if (!contents.paths) {
+    errors.push('Missing required "paths" object');
+  }
+  
+  if (format === 'openapi') {
+    const version = contents.openapi;
+    if (version && typeof version === 'string') {
+      const majorVersion = parseInt(version.split('.')[0], 10);
+      if (majorVersion >= 3 && !contents.servers && !contents.host) {
+        errors.push('OpenAPI 3.x specs should define "servers" array');
+      }
+    }
+  } else if (format === 'swagger') {
+    if (!contents.host && !contents.basePath) {
+      errors.push('Swagger specs should define "host" or "basePath"');
+    }
+  }
+  
+  return {
+    isValid: errors.length === 0,
+    errors,
+  };
+}
+
+function extractApiMetadata(
+  contents: Record<string, any>,
+  format: 'openapi' | 'swagger',
+): ApiMetadata {
+  const metadata: ApiMetadata = {};
+  
+  if (contents.info) {
+    metadata.title = contents.info.title;
+    metadata.version = contents.info.version;
+    metadata.description = contents.info.description;
+  }
+  
+  if (format === 'openapi' && contents.servers && Array.isArray(contents.servers)) {
+    metadata.servers = contents.servers
+      .map((server: any) => server.url)
+      .filter((url: any) => typeof url === 'string');
+  } else if (format === 'swagger') {
+    if (contents.host) {
+      metadata.host = contents.host;
+    }
+    if (contents.basePath) {
+      metadata.basePath = contents.basePath;
+    }
+  }
+  
+  if (contents.paths && typeof contents.paths === 'object') {
+    metadata.pathCount = Object.keys(contents.paths).length;
+  }
+  
+  return metadata;
+}
+
 export function parseApiSpec(
