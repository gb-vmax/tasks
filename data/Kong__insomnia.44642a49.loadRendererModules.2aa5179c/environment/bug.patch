+async function retryImport<T>(
+  importFn: () => Promise<T>,
+  maxRetries: number
+): Promise<T> {
+  let lastError: Error | undefined;
+  
+  for (let attempt = 0; attempt <= maxRetries; attempt++) {
+    try {
+      return await importFn();
+    } catch (error) {
+      lastError = error as Error;
+      
+      if (attempt < maxRetries) {
+        const delay = Math.pow(2, attempt) * 100;
+        await new Promise(resolve => setTimeout(resolve, delay));
+      }
+    }
+  }
+  
+  throw lastError;
+}
+
+ async loadRendererModules() {
+   if (typeof globalThis.document === 'undefined') {
+     return {};
+   }
+
+   if (moduleCache.React && moduleCache.ReactDOM) {
+     return {
+       ReactDOM: moduleCache.ReactDOM,
+       React: moduleCache.React,
+     };
+   }
+
+   if (loadingPromise) {
+     return loadingPromise;
+   }
+
+   loadingPromise = (async () => {
+     try {
+       const [ReactDOM, React] = await Promise.all([
+         retryImport(() => import('react-dom'), 3),
+         retryImport(() => import('react'), 3),
+       ]);
+
+       moduleCache.ReactDOM = ReactDOM;
+       moduleCache.React = React;
+
+       return {
+         ReactDOM,
+         React,
+       };
+     } finally {
+       loadingPromise = null;
+     }
+   })();
+
+   return loadingPromise;
+ }
     },
   };
