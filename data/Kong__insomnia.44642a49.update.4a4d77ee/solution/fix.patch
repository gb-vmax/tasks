+  if (patch.data !== undefined) {
+    const currentOrder = environment.dataPropertyOrder || {};
+    const currentData = environment.data || {};
+    const newData = patch.data;
+    
+    const updatedOrder = synchronizeDataPropertyOrder(
+      currentData,
+      newData,
+      currentOrder
+    );
+    
+    processedPatch.dataPropertyOrder = updatedOrder;
+  }
+  
+  if (patch.color !== undefined && patch.color !== null) {
+    if (!isValidHexColor(patch.color)) {
+      throw new Error(`Invalid color format: ${patch.color}. Expected hex color (e.g., #FF0000)`);
+    }
+  }
+  
+  return db.docUpdate(environment, processedPatch);
 }
 
