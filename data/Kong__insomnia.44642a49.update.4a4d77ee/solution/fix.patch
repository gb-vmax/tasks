+function synchronizeDataPropertyOrder(
+  currentData: Record<string, any>,
+  newData: Record<string, any>,
+  currentOrder: Record<string, any> | null
+): Record<string, any> {
+  const order = currentOrder || {};
+  const newDataKeys = Object.keys(newData);
+  const currentDataKeys = Object.keys(currentData);
+  
+  const addedKeys = newDataKeys.filter(key => !currentDataKeys.includes(key));
+  const remainingKeys = newDataKeys.filter(key => currentDataKeys.includes(key));
+  
+  const existingOrderEntries = Object.entries(order)
+    .filter(([key]) => remainingKeys.includes(key))
+    .sort((a, b) => (a[1] as number) - (b[1] as number));
+  
+  const maxExistingOrder = existingOrderEntries.length > 0
+    ? Math.max(...existingOrderEntries.map(([, val]) => val as number))
+    : -1;
+  
+  const updatedOrder: Record<string, any> = {};
+  
+  existingOrderEntries.forEach(([key, orderValue]) => {
+    updatedOrder[key] = orderValue;
+  });
+  
+  addedKeys.forEach((key, index) => {
+    updatedOrder[key] = maxExistingOrder + index + 1;
+  });
+  
+  return updatedOrder;
+}
+
+function isValidHexColor(color: string): boolean {
+  return /^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/.test(color);
+}
