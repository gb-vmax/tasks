+ findInParents(
+     property: string,
+     customizer?: (ancester: PropertyBase) => boolean,
+     options?: { maxDepth?: number; findAll?: boolean }
+ ): PropertyBase | PropertyBase[] | undefined {
+     const currentParent = this.parent();
+     if (!currentParent) {
+         return options?.findAll ? [] : undefined;
+     }
+
+     const maxDepth = options?.maxDepth ?? Infinity;
+     const findAll = options?.findAll ?? false;
+     const queue: Array<{ node: PropertyBase; depth: number }> = [{ node: currentParent, depth: 0 }];
+     const matches: PropertyBase[] = [];
+
+     while (queue.length > 0) {
+         const item = queue.shift();
+         if (!item) {
+             continue;
+         }
+
+         const { node: ancester, depth } = item;
+
+         if (depth >= maxDepth) {
+             continue;
+         }
+
+         const cloned = clone(ancester);
+         const hasProperty = Object.keys(cloned.meta()).includes(property);
+         if (!hasProperty) {
+         } else {
+             const isMatch = customizer ? customizer(cloned) : true;
+             if (isMatch) {
+                 if (findAll) {
+                     matches.push(cloned);
+                 } else {
+                     return cloned;
+                 }
+             }
+         }
+
+         const olderAncester = ancester.parent();
+         if (olderAncester) {
+             queue.push({ node: olderAncester, depth: depth + 1 });
+         }
+     }
+
+     if (findAll) {
+         return matches.length > 0 ? matches : [];
+     }
+
+     return undefined;
+ }
 
