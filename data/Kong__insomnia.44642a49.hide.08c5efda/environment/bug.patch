+const normalizeAncestorIndex = (index: number | undefined, ancestorsLength: number): number => {
+  if (index === undefined) {
+    return 0;
+  }
+  
+  const idx = typeof index === 'string' ? parseInt(index, 10) : index;
+  
+  if (isNaN(idx)) {
+    return 0;
+  }
+  
+  if (idx < 0) {
+    const normalizedIdx = ancestorsLength + idx;
+    return normalizedIdx < 0 ? 0 : normalizedIdx;
+  }
+  
+  return idx;
+};
+
