+function extractJsonpWithCallbackName(body: string, callbackName: string): string | null {
+    const escapedName = callbackName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    const pattern = new RegExp(`^\\s*${escapedName}\\s*\\(([\\s\\S]*)\\)\\s*;?\\s*$`);
+    const match = body.match(pattern);
+    
+    if (!match || !match[1]) {
+        return null;
     }
+    
+    return match[1].trim();
+}
+
+function detectAndExtractJsonp(body: string): string | null {
+    const patterns = [
+        /^\s*([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(([\s\S]*)\)\s*;?\s*$/,
+        /^\s*([a-zA-Z_$][a-zA-Z0-9_$.]*)\s*\(([\s\S]*)\)\s*;?\s*$/,
+        /^\s*([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(\s*([\s\S]*?)\s*\)\s*;?\s*$/,
+    ];
+    
+    for (const pattern of patterns) {
+        const match = body.match(pattern);
+        if (match && match[2]) {
+            const extracted = match[2].trim();
+            if (isLikelyJson(extracted)) {
+                return extracted;
+            }
+        }
+    }
+    
+    return null;
+}
+
+function isLikelyJson(str: string): boolean {
+    if (!str) {
+        return false;
+    }
+    
+    const firstChar = str[0];
+    const lastChar = str[str.length - 1];
+    
+    return (
+        (firstChar === '{' && lastChar === '}') ||
+        (firstChar === '[' && lastChar === ']') ||
+        str === 'null' ||
+        str === 'true' ||
+        str === 'false' ||
+        /^-?\d+(\.\d+)?([eE][+-]?\d+)?$/.test(str) ||
+        (firstChar === '"' && lastChar === '"')
+    );
+}
