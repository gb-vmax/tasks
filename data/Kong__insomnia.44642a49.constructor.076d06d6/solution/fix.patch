+function flattenObject(obj: object, prefix: string = ''): [string, boolean | number | string][] {
+    const entries: [string, boolean | number | string][] = [];
+    
+    for (const [key, value] of Object.entries(obj)) {
+        const fullKey = prefix ? `${prefix}.${key}` : key;
+        
+        if (value !== null && typeof value === 'object' && !Array.isArray(value)) {
+            entries.push(...flattenObject(value, fullKey));
+        } else if (typeof value === 'boolean' || typeof value === 'number' || typeof value === 'string') {
+            entries.push([fullKey, value]);
+        }
     }
+    
+    return entries;
+}
+
+ constructor(name: string, jsonObject: object | undefined | Environment) {
+     this._name = name;
+    
+     if (jsonObject instanceof Environment) {
+         this.kvs = new Map(jsonObject.kvs);
+     } else {
+         const flattenedEntries = flattenObject(jsonObject || {});
+         this.kvs = new Map(flattenedEntries);
+     }
+ }
 
