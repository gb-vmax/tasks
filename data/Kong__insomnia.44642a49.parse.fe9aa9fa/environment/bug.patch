+function extractTypeFromValue(rawValue: string): { value: string; type?: string } {
+    const typeDelimiter = '::';
+    const delimiterIndex = rawValue.lastIndexOf(typeDelimiter);
+    
+    if (delimiterIndex > 0 && delimiterIndex < rawValue.length - typeDelimiter.length) {
+        const value = rawValue.substring(0, delimiterIndex);
+        const type = rawValue.substring(delimiterIndex + typeDelimiter.length);
+        
+        if (type && /^[a-zA-Z][a-zA-Z0-9_]*$/.test(type)) {
+            return { value, type };
+        }
     }
+    
+    return { value: rawValue };
+}
