+const validateAndNormalizeValue = (
+  value: string | null,
+  options: { name: string; value: string }[]
+): string | null => {
+  if (options.length === 0) {
+    return null;
+  }
+  
+  if (value === null) {
+    return options[0].value;
+  }
+  
+  const valueExists = options.some(option => option.value === value);
+  
+  if (valueExists) {
+    return value;
+  }
+  
+  return options[0].value;
+};
+
+ show: options => {
+   const validatedOptions = {
+     ...options,
+     value: validateAndNormalizeValue(options.value, options.options),
+   };
+   setState(validatedOptions);
+   modalRef.current?.show();
+ },
   }), []);
