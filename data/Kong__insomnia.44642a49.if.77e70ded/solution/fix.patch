+function _checkUpsertConditions<T extends BaseModel>(existingDoc: T, conditions: Partial<T>): boolean {
+  for (const key in conditions) {
+    if (conditions.hasOwnProperty(key)) {
+      const existingValue = existingDoc[key];
+      const expectedValue = conditions[key];
+      
+      if (existingValue !== expectedValue) {
+        return false;
+      }
     }
+  }
+  return true;
+}
+
+function _incrementVersionIfNeeded<T extends BaseModel>(doc: T, existingDoc: T | null): T {
+  if (!existingDoc) {
+    return doc;
+  }
+
+  const docModified = doc.modified;
+  const existingModified = existingDoc.modified;
+  
+  if (docModified && existingModified && docModified !== existingModified) {
+    const currentVersion = (existingDoc as any).__v || 0;
+    return {
+      ...doc,
+      __v: currentVersion + 1,
+    } as T;
+  }
+  
+  return doc;
+}
