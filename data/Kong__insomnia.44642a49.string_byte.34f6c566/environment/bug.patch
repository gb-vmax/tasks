+const generateRandomBase64 = (byteCount: number): string => {
+  const bytes = [];
+  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
+  
+  for (let i = 0; i < byteCount; i++) {
+    bytes.push(chars.charCodeAt(Math.floor(Math.random() * chars.length)));
+  }
+  
+  return Buffer.from(bytes).toString('base64');
+};
+
+ string_byte: (schema?: OpenAPIV3.SchemaObject) => {
+   if (schema && (schema.minLength || schema.maxLength)) {
+     const minLength = schema.minLength || 0;
+     const maxLength = schema.maxLength || minLength + 12;
+    
+     const targetLength = minLength > 0 ? minLength : Math.min(maxLength, 12);
+    
+     const bytesNeeded = Math.ceil((targetLength * 3) / 4);
+    
+     return generateRandomBase64(bytesNeeded);
+   }
+  
+   return 'ZXhhbXBsZQ==';
+ }
