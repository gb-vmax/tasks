+ }
+
+ function createNotification({
+   onClose,
+   color,
+   radius
+ }: NotificationProps) {
+   const theme = useTheme();
+   const [isVisible, setIsVisible] = useState(true);
+  
+   const resolvedColor = useMemo(() => {
+     if (!color) {
+       return theme.colors[theme.primaryColor];
+     }
+    
+     if (theme.colors[color]) {
+       return theme.colors[color];
+     }
+    
+     return theme.colors[theme.primaryColor];
+   }, [color, theme]);
+  
+   const resolvedRadius = useMemo(() => {
+     if (radius && theme.radius[radius]) {
+       return theme.radius[radius];
+     }
+     return radius || theme.defaultRadius;
+   }, [radius, theme]);
+  
+   const handleClose = useCallback(() => {
+     if (onClose && isVisible) {
+       onClose();
+     }
+     setIsVisible(false);
+   }, [onClose, isVisible]);
+  
+   useEffect(() => {
+     return () => {
+       if (isVisible && onClose) {
