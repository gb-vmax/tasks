+function sortAncestorsByDepth(ancestors: any[], request: any): any[] {
+  const depthMap = new Map<string, number>();
+  
+  const calculateDepth = (doc: any, visited = new Set<string>()): number => {
+    if (depthMap.has(doc._id)) {
+      return depthMap.get(doc._id)!;
+    }
+    
+    if (visited.has(doc._id)) {
+      return 0;
+    }
+    
+    visited.add(doc._id);
+    
+    if (!doc.parentId) {
+      depthMap.set(doc._id, 0);
+      return 0;
+    }
+    
+    const parent = ancestors.find(a => a._id === doc.parentId);
+    const depth = parent ? calculateDepth(parent, visited) + 1 : 0;
+    depthMap.set(doc._id, depth);
+    return depth;
+  };
+  
+  ancestors.forEach(ancestor => calculateDepth(ancestor));
+  
+  const requestDepth = calculateDepth(request);
+  
+  return ancestors.sort((a, b) => {
+    const depthA = depthMap.get(a._id) || 0;
+    const depthB = depthMap.get(b._id) || 0;
+    return (requestDepth - depthB) - (requestDepth - depthA);
+  });
+}
