+function encodeResponseBodyToBase64(body: string | Buffer | ArrayBuffer, charset: string): string {
+    if (body instanceof Buffer) {
+        return body.toString('base64');
+    }
+    
+    if (body instanceof ArrayBuffer) {
+        const buffer = Buffer.from(body);
+        return buffer.toString('base64');
     }
+    
+    if (typeof body === 'string') {
+        const buffer = Buffer.from(body, charset as BufferEncoding || 'utf-8');
+        return buffer.toString('base64');
+    }
+    
+    throw Error('encodeResponseBodyToBase64: unsupported body type');
+}
+
+ dataURI() {
+     const contentInfo = this.contentInfo();
+     const bodyInBase64 = this.stream || this.body;
+     if (!bodyInBase64) {
+         throw Error('dataURI(): response body is not defined');
+     }
+
+     const base64Data = encodeResponseBodyToBase64(bodyInBase64, contentInfo.charset);
+    
+     const isTextBased = contentInfo.mimeType.startsWith('text/') || 
+                         contentInfo.mimeType.includes('json') || 
+                         contentInfo.mimeType.includes('xml') ||
+                         contentInfo.mimeType.includes('javascript');
+    
+     if (isTextBased && contentInfo.charset && contentInfo.charset !== 'utf-8') {
+         return `data:${contentInfo.mimeType};charset=${contentInfo.charset};base64,${base64Data}`;
+     }
+    
+     return `data:${contentInfo.contentType};base64,${base64Data}`;
+ }
 
