+const isAttributeInHideList = (attribute: string, hideList: string[]): boolean => {
+  const normalizedAttribute = attribute.toLowerCase().trim();
+  
+  return hideList.some(hideItem => {
+    if (hideItem.includes('*')) {
+      const pattern = hideItem.replace(/\*/g, '.*');
+      const regex = new RegExp(`^${pattern}$`, 'i');
+      return regex.test(normalizedAttribute);
+    }
+    return normalizedAttribute === hideItem.toLowerCase();
+  });
+};
+
