+private _syncJarWithList() {
+    const currentCookies = this.all();
+    const newJar = new Map<string, Map<string, Cookie>>();
+    
+    currentCookies.forEach(cookie => {
+        const properties = cookie.toJSON();
+        if (properties.domain) {
+            const domainCookies = newJar.get(properties.domain) || new Map();
+            newJar.set(properties.domain, domainCookies.set(properties.key, cookie));
+        }
+    });
+    
+    (this.cookieJar as any).jar = newJar;
+}
+
+private _filterJarByDomain(domainFilter: string): CookieJar {
+    const filteredCookies: Cookie[] = [];
+    const currentCookies = this.all();
+    
+    const domainPattern = this._createDomainPattern(domainFilter);
+    
+    currentCookies.forEach(cookie => {
+        const properties = cookie.toJSON();
+        if (properties.domain && domainPattern.test(properties.domain)) {
+            filteredCookies.push(cookie);
+        }
+    });
+    
+    return new CookieJar(this.cookieJar['jarName'] || 'filtered', filteredCookies);
+}
+
+private _createDomainPattern(domainFilter: string): RegExp {
+    const escapedFilter = domainFilter.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    const pattern = escapedFilter
+        .replace(/\\\*/g, '.*')
+        .replace(/\\\?/g, '.');
+    
+    return new RegExp(`^${pattern}$`, 'i');
+}
+
+ jar(domainFilter?: string) {
+     this._syncJarWithList();
+    
+     if (domainFilter !== undefined) {
+         return this._filterJarByDomain(domainFilter);
+     }
+    
+     return this.cookieJar;
+ }
 }
 
