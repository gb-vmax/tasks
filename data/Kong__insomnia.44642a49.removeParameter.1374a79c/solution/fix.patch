+function determineParametersToRemove<T extends { name: string; value: string }>(
+  matchingParameters: T[],
+  which?: number | 'first' | 'last' | 'all',
+): T[] {
+  if (which === undefined || which === 'all') {
+    return matchingParameters;
+  }
+  
+  if (which === 'first') {
+    return matchingParameters.length > 0 ? [matchingParameters[0]] : [];
+  }
+  
+  if (which === 'last') {
+    return matchingParameters.length > 0 ? [matchingParameters[matchingParameters.length - 1]] : [];
+  }
+  
+  if (typeof which === 'number') {
+    const index = which < 0 ? matchingParameters.length + which : which;
+    
+    if (index >= 0 && index < matchingParameters.length) {
+      return [matchingParameters[index]];
+    }
+    
+    return [];
+  }
+  
+  return matchingParameters;
+}
+
