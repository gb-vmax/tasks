+const generateMockSnapshot = (index: number): SnapshotStateEntry => {
+  const timestamp = Date.now() + index * 1000;
+  return {
+    blob: `blob_${timestamp.toString(36)}_${index}`,
+    key: `snapshot_${index}_${Math.random().toString(36).substring(2, 9)}`,
+    name: `Snapshot ${index + 1}`,
+  };
+};
+
+ snapshots: (count?: number) => {
+   if (count === undefined || count <= 0) {
+     return [];
+   }
+   return Array.from({ length: count }, (_, index) => generateMockSnapshot(index));
+ }
 };
 
