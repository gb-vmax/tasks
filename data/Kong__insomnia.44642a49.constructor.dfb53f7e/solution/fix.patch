+const categorizeTestByDuration = (
+  test: Test,
+  thresholds: { slow: number; medium: number }
+): 'fast' | 'medium' | 'slow' => {
+  const duration = test.duration || 0;
+  
+  if (duration >= thresholds.slow) {
+    return 'slow';
+  } else if (duration >= thresholds.medium) {
+    return 'medium';
   }
+  return 'fast';
+};
+
+const calculateTimingStats = (
+  tests: Test[],
+  timingBuckets: { fast: Test[]; medium: Test[]; slow: Test[] }
+) => {
+  const durations = tests
+    .map(t => t.duration || 0)
+    .filter(d => d > 0)
+    .sort((a, b) => a - b);
+  
+  if (durations.length === 0) {
+    return {
+      average: 0,
+      median: 0,
+      max: 0,
+      min: 0,
+    };
+  }
+  
+  const sum = durations.reduce((acc, d) => acc + d, 0);
+  const average = Math.round((sum / durations.length) * 100) / 100;
+  
+  const median =
+    durations.length % 2 === 0
+      ? (durations[durations.length / 2 - 1] + durations[durations.length / 2]) / 2
+      : durations[Math.floor(durations.length / 2)];
+  
+  return {
+    average,
+    median: Math.round(median * 100) / 100,
+    max: durations[durations.length - 1],
+    min: durations[0],
+  };
+};
+
+ constructor(runner: Runner & { testResults?: TestResults }, options: MochaOptions) {
+   super(runner, options);
+
+   Mocha.reporters.Base.call(this, runner, options);
+   const self = this;
+   const tests: Test[] = [];
+   const pending: Test[] = [];
+   const failures: Test[] = [];
+   const passes: Test[] = [];
+   const slowTests: Test[] = [];
+  
+   const timingThresholds = {
+     slow: (options.reporterOptions?.slowThreshold as number) || 75,
+     medium: (options.reporterOptions?.mediumThreshold as number) || 25,
+   };
+  
+   const timingBuckets = {
+     fast: [] as Test[],
+     medium: [] as Test[],
+     slow: [] as Test[],
+   };
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_END, test => {
+     tests.push(test);
+    
+     const category = categorizeTestByDuration(test, timingThresholds);
+     timingBuckets[category].push(test);
+    
+     if (category === 'slow') {
+       slowTests.push(test);
+     }
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_PASS, test => {
+     passes.push(test);
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_FAIL, test => {
+     failures.push(test);
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_PENDING, test => {
+     pending.push(test);
+   });
+
+   runner.once(Mocha.Runner.constants.EVENT_RUN_END, () => {
+     const timingStats = calculateTimingStats(tests, timingBuckets);
+    
+     runner.testResults = {
+       stats: self.stats,
+       tests: tests.map(clean),
+       pending: pending.map(clean),
+       failures: failures.map(clean),
+       passes: passes.map(clean),
+       slow: slowTests.map(clean),
+       timingStats: {
+         thresholds: timingThresholds,
+         buckets: {
+           fast: timingBuckets.fast.length,
+           medium: timingBuckets.medium.length,
+           slow: timingBuckets.slow.length,
+         },
+         averageDuration: timingStats.average,
+         medianDuration: timingStats.median,
+         maxDuration: timingStats.max,
+         minDuration: timingStats.min,
+       },
+     };
+   });
+ }
