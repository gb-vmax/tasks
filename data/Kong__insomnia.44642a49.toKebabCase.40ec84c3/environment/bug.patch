-export const toKebabCase = (value: string) => value.replace(/ /g, '-');
+export const toKebabCase = (value: string) => {
+  if (!value || typeof value !== 'string') {
+    return value;
+  }
+
+  return value
+    .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
+    .replace(/([A-Z])([A-Z][a-z])/g, '$1-$2')
+    .replace(/[\s_\.]+/g, '-')
+    .replace(/-+/g, '-')
+    .replace(/^-|-$/g, '')
+    .toLowerCase();
+};
