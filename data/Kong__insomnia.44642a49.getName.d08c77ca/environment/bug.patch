+function substituteVariables(text: string, context: Record<string, any>): string {
+  if (!text || typeof text !== 'string') {
+    return text;
+  }
+
+  return text.replace(/\{\{([^}]+)\}\}/g, (match, expression) => {
+    const trimmedExpression = expression.trim();
+    const parts = trimmedExpression.split('||').map((p: string) => p.trim());
+    const variableName = parts[0];
+    const defaultValue = parts.length > 1 ? parts.slice(1).join('||').trim() : '';
+
+    if (variableName in context) {
+      const value = context[variableName];
+      if (value === null || value === undefined) {
+        return defaultValue || '';
+      }
+      if (typeof value === 'object') {
+        return JSON.stringify(value);
+      }
+      return String(value);
+    }
+
+    return defaultValue || match;
+  });
+}
+
+ getName() {
+   return substituteVariables(renderedRequest.name, renderedContext);
+ },
 
