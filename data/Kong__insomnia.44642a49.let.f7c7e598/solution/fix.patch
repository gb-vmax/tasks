+function sanitizeSensitiveData(text: string): string {
+  if (!text || typeof text !== 'string') {
+    return text;
+  }
+
+  const sensitivePatterns = [
+    { pattern: /("api[_-]?key"\s*:\s*")[^"]+(")/gi, replacement: '$1***REDACTED***$2' },
+    { pattern: /("token"\s*:\s*")[^"]+(")/gi, replacement: '$1***REDACTED***$2' },
+    { pattern: /("access[_-]?token"\s*:\s*")[^"]+(")/gi, replacement: '$1***REDACTED***$2' },
+    { pattern: /("secret"\s*:\s*")[^"]+(")/gi, replacement: '$1***REDACTED***$2' },
+    { pattern: /("password"\s*:\s*")[^"]+(")/gi, replacement: '$1***REDACTED***$2' },
+    { pattern: /(api[_-]?key=)[^&\s]+/gi, replacement: '$1***REDACTED***' },
+    { pattern: /(token=)[^&\s]+/gi, replacement: '$1***REDACTED***' },
+    { pattern: /(password=)[^&\s]+/gi, replacement: '$1***REDACTED***' },
+  ];
+
+  let sanitized = text;
+  for (const { pattern, replacement } of sensitivePatterns) {
+    sanitized = sanitized.replace(pattern, replacement);
+  }
+
+  return sanitized;
+}
