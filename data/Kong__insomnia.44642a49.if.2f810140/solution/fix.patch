+const filterWorkspacesByScope = (workspaces: Workspace[], scope: string): Workspace[] => {
+  const validScopes = scope.toLowerCase().split(',').map(s => s.trim());
+  
+  if (validScopes.includes('all')) {
+    return workspaces;
+  }
+  
+  return workspaces.filter(workspace => {
+    const workspaceScope = workspace.scope?.toLowerCase() || 'collection';
+    return validScopes.includes(workspaceScope);
+  });
+};
+
+const sortWorkspaces = (workspaces: Workspace[], sortBy: string): Workspace[] => {
+  const sorted = [...workspaces];
+  
+  switch (sortBy.toLowerCase()) {
+    case 'modified':
+    case 'date':
+      return sorted.sort((a, b) => {
+        const aTime = a.modified || 0;
+        const bTime = b.modified || 0;
+        return bTime - aTime;
+      });
+    case 'name':
+    default:
+      return sorted.sort((a, b) => {
+        const aName = a.name?.toLowerCase() || '';
+        const bName = b.name?.toLowerCase() || '';
+        return aName.localeCompare(bName);
+      });
+  }
+};
+
+ const getWorkspaces = async (activeProjectId?: string) => {
+   const shouldFilterByScope = process.env.INSOMNIA_EXPORT_FILTER_SCOPE;
+   const sortOrder = process.env.INSOMNIA_EXPORT_SORT || 'name';
+  
+   let workspaces;
+   if (activeProjectId) {
+     workspaces = await models.workspace.findByParentId(activeProjectId);
+   } else {
+     workspaces = await models.workspace.all();
+   }
+  
+   let filtered = workspaces;
+  
+   if (shouldFilterByScope) {
+     filtered = filterWorkspacesByScope(workspaces, shouldFilterByScope);
+   }
+  
+   return sortWorkspaces(filtered, sortOrder);
+ };
