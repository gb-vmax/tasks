+function _selectBestBaseEnvironment(environments: Environment[]): Environment {
+  return environments.reduce((best, current) => {
+    const bestScore = _scoreEnvironment(best);
+    const currentScore = _scoreEnvironment(current);
+    return currentScore > bestScore ? current : best;
+  });
+}
+
+function _scoreEnvironment(env: Environment): number {
+  let score = 0;
+  
+  score += env.modified || 0;
+  
+  const dataKeyCount = Object.keys(env.data || {}).length;
+  score += dataKeyCount * 1000;
+  
+  if (env.name && env.name.trim().length > 0) {
+    score += 500;
+  }
+  
+  return score;
+}
+
