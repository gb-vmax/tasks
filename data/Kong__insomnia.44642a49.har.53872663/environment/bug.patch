+type HarExport = Omit<InsomniaExport, 'format'> & {
+  workspaceType?: 'design' | 'collection' | 'all';
+  harVersion?: '1.2' | '1.3';
+};
+
+ har: async ({
+   workspace,
+   includePrivate,
+   workspaceType,
+   harVersion,
+ }: HarExport = {}) => {
+   let workspacesToExport = workspace ? [workspace] : await getWorkspaces(activeProjectId);
+  
+   if (workspaceType && !workspace) {
+     workspacesToExport = workspacesToExport.filter(ws => {
+       const scope = (ws as any).scope;
+       if (workspaceType === 'design') {
+         return scope === 'design' || scope === 'designer';
+       } else if (workspaceType === 'collection') {
+         return scope === 'collection' || !scope;
+       }
+       return true;
+     });
+   }
+  
+   return exportWorkspacesHAR(
+     workspacesToExport,
+     Boolean(includePrivate),
+     harVersion,
+   );
+ },
