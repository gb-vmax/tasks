+         )
+         : [];
+
+     const responseOption = {
+         code: partialResponse.statusCode || 0,
+         reason: partialResponse.statusMessage,
+         header: headers,
+         cookie: insoCookieOptions,
+         body: responseBody,
+         responseTime: partialResponse.elapsedTime,
+         originalRequest,
+     };
+
+     return new Response(responseOption);
