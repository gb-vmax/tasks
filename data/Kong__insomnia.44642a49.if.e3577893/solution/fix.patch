+                 value: insoHeader.value,
+             }),
+             {},
+         )
+         : [];
+
+     const insoCookieOptions = partialResponse.headers ?
+         partialResponse.headers
+             .filter(
+                 header => {
+                     return header.name.toLowerCase() === 'set-cookie';
+                 },
