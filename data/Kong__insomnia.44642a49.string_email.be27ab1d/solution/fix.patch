+let emailDomainIndex = 0;
+const emailDomains = ['example.com', 'test.com', 'demo.com', 'sample.org'];
+
+const getEmailDomain = () => {
+  const domain = emailDomains[emailDomainIndex % emailDomains.length];
+  emailDomainIndex++;
+  return domain;
+};
+
+const getEmailUsernameFromContext = () => {
+  const errorStack = new Error().stack || '';
+  const stackLines = errorStack.split('\n');
+  
+  for (const line of stackLines) {
+    const propertyMatch = line.match(/propertyName["\s:]+([a-zA-Z_][a-zA-Z0-9_]*)/i);
+    if (propertyMatch && propertyMatch[1]) {
+      const propName = propertyMatch[1].toLowerCase();
+      if (propName.includes('email')) {
+        return 'user';
+      }
+      if (propName.includes('owner') || propName.includes('author')) {
+        return propName.replace(/[_-]/g, '.');
+      }
+      if (propName.includes('contact') || propName.includes('recipient')) {
+        return propName;
+      }
+      if (propName.length > 2 && propName.length < 20) {
+        return propName.replace(/[_-]/g, '.');
+      }
+    }
+    
+    const nameMatch = line.match(/["']name["']\s*:\s*["']([^"']+)["']/i);
+    if (nameMatch && nameMatch[1]) {
+      const name = nameMatch[1].toLowerCase().replace(/[^a-z0-9]/g, '');
+      if (name && name.length > 2 && name.length < 20) {
+        return name;
+      }
+    }
+  }
+  
+  return null;
+};
+
+ string_email: () => {
+   const username = getEmailUsernameFromContext() || 'user';
+   const domain = getEmailDomain();
+   return `${username}@${domain}`;
+ },
