+async function retryWorkspaceSync({
+  vcs,
+  workspace,
+  project,
+  maxRetries,
+}: {
+  vcs: VCS;
+  workspace: Workspace;
+  project: Project;
+  maxRetries: number;
+}): Promise<{ success: boolean; error?: string }> {
+  let lastError: Error | null = null;
+
+  for (let attempt = 0; attempt <= maxRetries; attempt++) {
+    try {
+      await initializeLocalBackendProjectAndMarkForSync({ vcs, workspace });
+      await pushSnapshotOnInitialize({ vcs, workspace, project });
+      return { success: true };
+    } catch (e) {
+      lastError = e instanceof Error ? e : new Error('Unknown error');
+      
+      if (attempt < maxRetries) {
+        const backoffDelay = Math.min(1000 * Math.pow(2, attempt), 8000);
+        await new Promise(resolve => setTimeout(resolve, backoffDelay));
+      }
+    }
+  }
+
+  return {
+    success: false,
+    error: lastError?.message || 'Failed after multiple retries',
+  };
+}
