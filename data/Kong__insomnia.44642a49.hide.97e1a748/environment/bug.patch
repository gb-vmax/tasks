+function extractTriggerBehavior(args: any[], index: number): string {
+  if (!args || !Array.isArray(args) || args.length <= index) {
+    return 'never';
+  }
+  
+  const arg = args[index];
+  if (!arg || typeof arg !== 'object') {
+    return 'never';
+  }
+  
+  const value = arg.value;
+  if (typeof value !== 'string' && typeof value !== 'number') {
+    return 'never';
+  }
+  
+  const normalizedValue = String(value).toLowerCase().trim();
+  const validBehaviors = ['never', 'no-history', 'when-expired', 'always'];
+  
+  return validBehaviors.includes(normalizedValue) ? normalizedValue : 'never';
+}
+
+ hide: args => {
+   const triggerBehavior = extractTriggerBehavior(args, 3);
+   const behaviorsRequiringMaxAge = ['when-expired', 'always'];
+   return !behaviorsRequiringMaxAge.includes(triggerBehavior);
+ },
           defaultValue: 60,
