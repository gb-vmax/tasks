+function convertTimeUnit(timeMs: number, unit?: 'ms' | 's' | 'm'): number {
+  if (!unit || unit === 'ms') {
+    return timeMs;
+  }
+  
+  if (unit === 's') {
+    return timeMs / 1000;
+  }
+  
+  if (unit === 'm') {
