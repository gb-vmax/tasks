+const CACHE_TTL = 5000;
+
+const _suiteCache = new Map<string, { data: UnitTestSuite[]; timestamp: number }>();
+
+function _invalidateCache(parentId?: string) {
+  if (parentId) {
+    const cacheKey = `${type}_parent_${parentId}`;
+    _suiteCache.delete(cacheKey);
+  } else {
+    _suiteCache.clear();
+  }
+}
+
+const _originalUpdate = update;
+export function update(unitTestSuite: UnitTestSuite, patch: Partial<UnitTestSuite> = {}) {
+  const result = _originalUpdate(unitTestSuite, patch);
+  _invalidateCache(unitTestSuite.parentId);
+  if (patch.parentId && patch.parentId !== unitTestSuite.parentId) {
+    _invalidateCache(patch.parentId);
+  }
+  return result;
+}
+
+const _originalRemove = remove;
+export function remove(unitTestSuite: UnitTestSuite) {
+  const result = _originalRemove(unitTestSuite);
+  _invalidateCache(unitTestSuite.parentId);
+  return result;
+}
+
+const _originalCreate = create;
+export function create(patch: Partial<UnitTestSuite> = {}) {
+  const result = _originalCreate(patch);
+  if (patch.parentId) {
+    _invalidateCache(patch.parentId);
+  }
+  return result;
+}
