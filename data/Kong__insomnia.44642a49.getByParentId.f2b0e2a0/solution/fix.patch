+  
+  if (cached && Date.now() - cached.timestamp < CACHE_TTL) {
+    return cached.data;
+  }
+  
+  const results = db.getWhere<UnitTestSuite>(type, { parentId });
+  
+  results.sort((a, b) => {
+    const sortKeyA = a.metaSortKey ?? 0;
+    const sortKeyB = b.metaSortKey ?? 0;
+    return sortKeyA - sortKeyB;
+  });
+  
+  _suiteCache.set(cacheKey, {
+    data: results,
+    timestamp: Date.now()
+  });
