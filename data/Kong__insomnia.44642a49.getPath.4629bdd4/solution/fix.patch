+function normalizePath(path: string): string {
+  let normalized = path.replace(/\\/g, '/');
+  
+  if (normalized.endsWith('/') && normalized.length > 1) {
+    normalized = normalized.slice(0, -1);
+  }
+  
+  return normalized;
+}
