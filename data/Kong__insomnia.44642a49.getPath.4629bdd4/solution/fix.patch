+function expandEnvironmentVariables(path: string): string {
+  const envVarPattern = /\$\{([^}]+)\}|%([^%]+)%/g;
+  
+  return path.replace(envVarPattern, (match, unixVar, windowsVar) => {
+    const varName = unixVar || windowsVar;
+    
+    if (varName === 'HOME' || varName === 'USERPROFILE') {
+      try {
+        return window.app.getPath('home');
+      } catch {
+        return match;
+      }
+    }
+    
