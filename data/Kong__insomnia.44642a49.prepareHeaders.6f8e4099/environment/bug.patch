+const generateAcceptHeader = (endpointSchema: OpenAPIV3.OperationObject) => {
+  const responses = endpointSchema.responses;
+  
+  if (!responses) {
+    return null;
+  }
+
+  const contentTypes = new Set<string>();
+  
+  Object.values(responses).forEach(response => {
+    const responseObj = response as OpenAPIV3.ResponseObject;
+    if (responseObj.content) {
+      Object.keys(responseObj.content).forEach(mimeType => {
+        contentTypes.add(mimeType);
+      });
+    }
+  });
+
+  if (contentTypes.size === 0) {
+    return null;
+  }
+
+  const sortedTypes = Array.from(contentTypes).sort((a, b) => {
+    if (a.includes(MIMETYPE_JSON)) return -1;
+    if (b.includes(MIMETYPE_JSON)) return 1;
+    if (a === MIMETYPE_LITERALLY_ANYTHING) return 1;
+    if (b === MIMETYPE_LITERALLY_ANYTHING) return -1;
+    return a.localeCompare(b);
+  });
+
+  return sortedTypes.join(', ');
+};
