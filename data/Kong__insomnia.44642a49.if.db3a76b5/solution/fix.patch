+function normalizeAndDeduplicateVariables(variableList: VariableList<Variable>): VariableList<Variable> {
+    const seenKeys = new Map<string, Variable>();
+    
+    variableList.each((variable: Variable) => {
+        const key = variable.key;
+        
+        if (!key || typeof key !== 'string' || key.trim() === '') {
+            return;
+        }
+        
+        const normalizedValue = variable.value === null || variable.value === undefined 
+            ? '' 
+            : variable.value;
+        
+        const normalizedVariable = new Variable({
+            key: key,
+            value: normalizedValue,
+            type: variable.type,
+        });
+        
+        seenKeys.set(key, normalizedVariable);
+    });
+    
+    const deduplicatedVars = Array.from(seenKeys.values());
+    return new VariableList(undefined, deduplicatedVars);
+}
