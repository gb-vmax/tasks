+const GIT_REPO_CACHE_TTL = 5 * 60 * 1000;
+const MAX_GIT_REPO_CACHE_SIZE = 50;
+const GIT_DATA_STALE_THRESHOLD = 90 * 24 * 60 * 60 * 1000;
+
+const _gitRepoCache = new Map<string, { result: WorkspaceMeta | null; timestamp: number }>();
+
+function _isGitDataStale(meta: WorkspaceMeta): boolean {
+  if (!meta.cachedGitLastCommitTime) {
+    return false;
+  }
+  
+  const age = Date.now() - meta.cachedGitLastCommitTime;
+  return age > GIT_DATA_STALE_THRESHOLD;
+}
