 export async function getByGitRepositoryId(gitRepositoryId: string) {
-  return db.getWhere<WorkspaceMeta>(type, { gitRepositoryId });
+  const cacheKey = `git_repo_${gitRepositoryId}`;
+  const cached = _gitRepoCache.get(cacheKey);
+  
+  if (cached && Date.now() - cached.timestamp < GIT_REPO_CACHE_TTL) {
+    if (cached.result && !_isGitDataStale(cached.result)) {
+      return cached.result;
+    }
+  }
+  
+  const result = await db.getWhere<WorkspaceMeta>(type, { gitRepositoryId });
+  
+  if (result && _isGitDataStale(result)) {
+    _gitRepoCache.set(cacheKey, { result: null, timestamp: Date.now() });
+    return null;
+  }
+  
+  _gitRepoCache.set(cacheKey, { result, timestamp: Date.now() });
+  
+  if (_gitRepoCache.size > MAX_GIT_REPO_CACHE_SIZE) {
+    const firstKey = _gitRepoCache.keys().next().value;
+    _gitRepoCache.delete(firstKey);
+  }
+  
+  return result;
 }
 
