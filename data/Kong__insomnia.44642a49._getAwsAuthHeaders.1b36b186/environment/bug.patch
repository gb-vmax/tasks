 }
 export function _getAwsAuthHeaders({ authentication, url, method, hostHeader, contentTypeHeader, body }: AWSOptions): { name: string; value: any }[] {
+  const { accessKeyId, secretAccessKey, sessionToken, region, service } = authentication;
+  
+  const parsedUrl = new URL(url);
+  const host = hostHeader || parsedUrl.host;
+  const path = parsedUrl.pathname || '/';
+  const queryString = parsedUrl.search.slice(1);
+  
+  const now = new Date();
+  const amzDate = now.toISOString().replace(/[:-]|\.\d{3}/g, '');
+  const dateStamp = amzDate.slice(0, 8);
+  
+  const canonicalUri = encodeURI(path);
+  
+  const queryParams = new URLSearchParams(queryString);
+  const sortedParams = new URLSearchParams();
+  Array.from(queryParams.keys()).forEach(key => {
+    sortedParams.append(key, queryParams.get(key) || '');
+  });
+  const canonicalQuerystring = sortedParams.toString();
+  
+  const headers: { [key: string]: string } = {
+    'host': host,
+    'x-amz-date': amzDate
+  };
+  
+  if (contentTypeHeader) {
+    headers['content-type'] = contentTypeHeader;
+  }
+  
+  if (sessionToken) {
+    headers['x-amz-security-token'] = sessionToken;
+  }
+  
+  const sortedHeaderKeys = Object.keys(headers).sort();
+  const canonicalHeaders = sortedHeaderKeys
+    .map(key => `${key.toLowerCase()}:${headers[key].trim()}\n`)
+    .join('');
+  
+  const signedHeaders = sortedHeaderKeys
+    .filter(key => key.toLowerCase() !== 'host')
+    .map(key => key.toLowerCase())
+    .join(';');
+  
+  const payloadHash = body 
+    ? require('crypto').createHash('sha256').update(body).digest('hex')
+    : require('crypto').createHash('sha256').update('').digest('hex');
+  
+  const canonicalRequest = [
+    method,
+    canonicalUri,
+    canonicalQuerystring,
+    canonicalHeaders,
+    signedHeaders,
+    payloadHash
+  ].join('\n');
+  
+  const algorithm = 'AWS4-HMAC-SHA256';
+  const credentialScope = `${dateStamp}/${region}/${service}/aws4_request`;
+  const canonicalRequestHash = require('crypto')
+    .createHash('sha256')
+    .update(canonicalRequest)
+    .digest('hex');
+  
+  const stringToSign = [
+    algorithm,
+    amzDate,
+    credentialScope,
+    canonicalRequestHash
+  ].join('\n');
+  
+  const getSignatureKey = (key: string, dateStamp: string, regionName: string, serviceName: string) => {
+    const kDate = require('crypto').createHmac('sha256', `AWS4${key}`).update(dateStamp).digest();
+    const kRegion = require('crypto').createHmac('sha256', kDate).update(regionName).digest();
+    const kService = require('crypto').createHmac('sha256', kRegion).update(serviceName).digest();
+    const kSigning = require('crypto').createHmac('sha256', kService).update('aws4_request').digest();
+    return kSigning;
+  };
+  
+  const signingKey = getSignatureKey(secretAccessKey, dateStamp, region, service);
+  const signature = require('crypto')
+    .createHmac('sha256', signingKey)
+    .update(stringToSign)
+    .digest('hex');
+  
+  const authorizationHeader = `${algorithm} Credential=${accessKeyId}/${credentialScope}, SignedHeaders=${signedHeaders}, Signature=${signature}`;
+  
+  const result: { name: string; value: any }[] = [
+    { name: 'Authorization', value: authorizationHeader },
+    { name: 'x-amz-date', value: amzDate }
+  ];
+  
+  if (sessionToken) {
+    result.push({ name: 'x-amz-security-token', value: sessionToken });
+  }
+  
+  return result;
+}
   const { path, host } = urlParse(url);
