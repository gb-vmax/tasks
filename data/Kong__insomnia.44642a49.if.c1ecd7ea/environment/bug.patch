+     if (format === 'github' || format === 'gitlab') {
+       return format;
+     }
+     return;
+   }
+
+   if (credentials && 'username' in credentials) {
+     const inferredProvider = inferProviderFromCredentials(credentials);
+     if (inferredProvider) {
