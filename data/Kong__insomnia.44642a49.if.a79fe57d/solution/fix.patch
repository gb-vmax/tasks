-    }
+ withAncestors: async function <T extends BaseModel>(doc: T | null, types: string[] = allTypes(), maxDepth: number | null = null) {
+   if (db._empty) {
+     return _send<T[]>('withAncestors', ...arguments);
+   }
+
+   if (!doc) {
+     return [];
+   }
+
+   let docsToReturn: T[] = doc ? [doc] : [];
+   const visitedIds = new Set<string>();
+   let currentDepth = 0;
+
+   async function next(docs: T[]): Promise<T[]> {
+     if (maxDepth !== null && currentDepth >= maxDepth) {
+       return docsToReturn;
+     }
+
+     const foundDocs: T[] = [];
+
+     for (const d of docs) {
+       if (visitedIds.has(d._id)) {
+         continue;
+       }
+
+       visitedIds.add(d._id);
+
+       for (const type of types) {
+         const another = await database.get<T>(type, d.parentId);
+         if (another && !visitedIds.has(another._id)) {
+           foundDocs.push(another);
+         }
+       }
+     }
+
+     if (foundDocs.length === 0) {
+       return docsToReturn;
+     }
+
+     docsToReturn = [
+       ...docsToReturn,
+       ...foundDocs,
+     ];
+    
+     currentDepth++;
+     return next(foundDocs);
+   }
+
+   return next([doc]);
+ },
 
     if (!doc) {
       return [];
