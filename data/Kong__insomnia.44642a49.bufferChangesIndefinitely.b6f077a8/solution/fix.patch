+const STALE_BUFFER_THRESHOLD_MS = 60 * 60 * 1000;
+
+function _recordBufferMetadata(bufferId: number) {
+  bufferMetadataMap.set(bufferId, {
+    id: bufferId,
+    createdAt: Date.now(),
+    active: true,
+  });
