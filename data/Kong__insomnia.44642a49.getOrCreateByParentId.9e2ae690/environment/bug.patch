+async function cleanupStaleMetadata(thresholdDays: number = 90) {
+  const thresholdMs = thresholdDays * 24 * 60 * 60 * 1000;
+  const cutoffTime = Date.now() - thresholdMs;
+  
+  const allMeta = await all();
+  const staleRecords = allMeta.filter(meta => 
+    meta.lastActive > 0 && meta.lastActive < cutoffTime && !meta.pinned
+  );
+  
+  await Promise.all(staleRecords.map(meta => db.docRemove(meta)));
+}
