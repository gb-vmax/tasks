+const maxQueueSize = 0;
+let droppedCounts: Record<string, number> = {};
+const callbackMeta: { droppedCounts?: Record<string, number> } = {};
+
+ const t = function(key: string, ...args: T[]) {
+   if (key === '__flush__') {
+     if (timeout) {
+       clearTimeout(timeout);
+       timeout = undefined as any;
+     }
+     if (Object.keys(results).length) {
+       const finalResults = { ...results };
+       const finalDropped = { ...droppedCounts };
+       results = {};
+       droppedCounts = {};
+       callback(finalResults);
+       if (Object.keys(finalDropped).length > 0) {
+         callbackMeta.droppedCounts = finalDropped;
+       }
+     }
+     return;
+   }
+  
+   const currentArgs = results[key] || [];
+   const maxSize = maxQueueSize > 0 ? maxQueueSize : Infinity;
+  
+   if (currentArgs.length >= maxSize) {
+     droppedCounts[key] = (droppedCounts[key] || 0) + 1;
+     currentArgs.shift();
+   }
+  
+   results[key] = [...currentArgs, ...args];
+  
+   if (timeout) {
+     clearTimeout(timeout);
+   }
+   timeout = setTimeout(() => {
+     if (!Object.keys(results).length) {
+       return;
+     }
+     const finalResults = { ...results };
+     const finalDropped = { ...droppedCounts };
+     results = {};
+     droppedCounts = {};
+     callback(finalResults);
+     if (Object.keys(finalDropped).length > 0) {
+       callbackMeta.droppedCounts = finalDropped;
+     }
+   }, millis);
+ };
   return t;
