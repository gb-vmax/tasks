+            normalized.edgegrid = ensureOption(normalized.edgegrid, 'baseURL', '');
+            normalized.edgegrid = ensureOption(normalized.edgegrid, 'disabled', 'false');
+            break;
+    }
+    
+    return normalized;
+}
