+            normalized.hawk = ensureOption(normalized.hawk, 'disabled', 'false');
+            normalized.hawk = ensureOption(normalized.hawk, 'includePayloadHash', 'false');
+            break;
+            
+        case 'awsv4':
+            normalized.awsv4 = ensureOption(options.awsv4, 'accessKey', '');
+            normalized.awsv4 = ensureOption(normalized.awsv4, 'secretKey', '');
