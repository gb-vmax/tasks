+private applyDefaultsAndNormalize(options: AuthOptions): AuthOptions {
+    const normalized = { ...options };
+    
+    const ensureOption = (opts: AuthOption[] | undefined, key: string, defaultValue: string): AuthOption[] => {
+        if (!opts) {
+            return [{ key, value: defaultValue }];
+        }
+        
+        const normalizedOpts = opts.map(opt => ({
+            ...opt,
+            value: typeof opt.value === 'string' ? opt.value.trim() : opt.value,
+        }));
+        
+        const hasKey = normalizedOpts.some(opt => opt.key === key);
+        if (!hasKey) {
+            normalizedOpts.push({ key, value: defaultValue });
+        }
+        
+        return normalizedOpts;
+    };
+    
+    const ensureOAuth2Option = (opts: OAuth2AuthOption[] | undefined, key: string, defaultValue: string | OAuth2Param[]): OAuth2AuthOption[] => {
+        if (!opts) {
+            return [{ key, value: defaultValue }];
         }
+        
+        const hasKey = opts.some(opt => opt.key === key);
+        if (!hasKey) {
+            opts.push({ key, value: defaultValue });
+        }
+        
+        return opts;
+    };
+    
+    switch (options.type) {
+        case 'basic':
+            normalized.basic = ensureOption(options.basic, 'username', '');
+            normalized.basic = ensureOption(normalized.basic, 'password', '');
+            normalized.basic = ensureOption(normalized.basic, 'disabled', 'false');
+            normalized.basic = ensureOption(normalized.basic, 'useISO88591', 'false');
+            break;
+            
+        case 'bearer':
+            normalized.bearer = ensureOption(options.bearer, 'token', '');
+            normalized.bearer = ensureOption(normalized.bearer, 'disabled', 'false');
+            normalized.bearer = ensureOption(normalized.bearer, 'prefix', '');
+            break;
+            
+        case 'apikey':
+            normalized.apikey = ensureOption(options.apikey, 'key', '');
+            normalized.apikey = ensureOption(normalized.apikey, 'value', '');
+            normalized.apikey = ensureOption(normalized.apikey, 'in', 'header');
+            normalized.apikey = ensureOption(normalized.apikey, 'disabled', 'false');
+            break;
+            
+        case 'oauth1':
+            normalized.oauth1 = ensureOption(options.oauth1, 'consumerKey', '');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'consumerSecret', '');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'signatureMethod', 'HMAC-SHA1');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'version', '1.0');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'disabled', 'false');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'token', '');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'tokenSecret', '');
+            normalized.oauth1 = ensureOption(normalized.oauth1, 'includeBodyHash', 'false');
+            break;
+            
+        case 'oauth2':
+            normalized.oauth2 = ensureOAuth2Option(options.oauth2, 'grant_type', 'authorization_code');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'disabled', 'false');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'clientId', '');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'clientSecret', '');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'accessToken', '');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'authUrl', '');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'accessTokenUrl', '');
+            normalized.oauth2 = ensureOAuth2Option(normalized.oauth2, 'tokenRequestParams', []);
+            break;
+            
+        case 'digest':
+            normalized.digest = ensureOption(options.digest, 'username', '');
+            normalized.digest = ensureOption(normalized.digest, 'password', '');
+            normalized.digest = ensureOption(normalized.digest, 'disabled', 'false');
+            normalized.digest = ensureOption(normalized.digest, 'algorithm', 'MD5');
+            break;
+            
+        case 'hawk':
+            normalized.hawk = ensureOption(options.hawk, 'authId', '');
