--- a/packages/insomnia-sdk/src/objects/response.ts
+++ b/packages/insomnia-sdk/src/objects/response.ts
@@ -171,10 +171,69 @@ export class Response extends Property {
     }
 
     // eslint-disable-next-line @typescript-eslint/no-unused-vars
-    jsonp(_reviver?: (key: string, value: any) => any, _strict?: boolean) {
-        throw unsupportedError('jsonp');
+function extractJsonpPayload(text: string): { payload: string; isValidJsonp: boolean; callbackName?: string } | null {
+    const callbackPattern = /^([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(\s*(\{[\s\S]*\}|\[[\s\S]*\])\s*\)\s*;?\s*$/;
+    const match = text.match(callbackPattern);
+    
+    if (match && match[2]) {
+        return {
+            payload: match[2],
+            isValidJsonp: true,
+            callbackName: match[1],
+        };
     }
 
+    const wrappedObjectPattern = /^\s*\(\s*(\{[\s\S]*\}|\[[\s\S]*\])\s*\)\s*;?\s*$/;
+    const wrappedMatch = text.match(wrappedObjectPattern);
+    
+    if (wrappedMatch && wrappedMatch[1]) {
+        return {
+            payload: wrappedMatch[1],
+            isValidJsonp: false,
+        };
+    }
+
+    if (text.startsWith('{') || text.startsWith('[')) {
+        return {
+            payload: text,
+            isValidJsonp: false,
+        };
+    }
+
+    return null;
+}
+
+ jsonp(reviver?: (key: string, value: any) => any, strict: boolean = false) {
+     const bodyText = this.body.toString().trim();
+    
+     if (!bodyText) {
+         throw Error('jsonp: response body is empty');
+     }
+
+     const extractedData = extractJsonpPayload(bodyText);
+    
+     if (!extractedData) {
+         if (strict) {
+             throw Error('jsonp: response is not valid JSONP format');
+         }
+         try {
+             return JSON.parse(bodyText, reviver);
+         } catch (e) {
+             throw Error(`jsonp: failed to parse response as JSONP or JSON: ${e}`);
+         }
+     }
+
+     if (strict && !extractedData.isValidJsonp) {
+         throw Error('jsonp: response does not match strict JSONP format (callback function wrapper required)');
+     }
+
+     try {
+         return JSON.parse(extractedData.payload, reviver);
+     } catch (e) {
+         throw Error(`jsonp: failed to parse extracted JSON payload: ${e}`);
+     }
+ }
+
     reason() {
         return this.status;
     }
