+export async function getByIds(requestIds: string[]): Promise<Map<string, Request | GrpcRequest | WebSocketRequest | null>> {
+  const results = new Map<string, Request | GrpcRequest | WebSocketRequest | null>();
+  const toFetch = {
+    grpc: [] as string[],
+    websocket: [] as string[],
+    regular: [] as string[]
+  };
+
+  for (const id of requestIds) {
+    const cached = requestCache.get(id);
+    if (cached && Date.now() - cached.timestamp < CACHE_TTL) {
+      results.set(id, cached.data);
+    } else {
+      if (isGrpcRequestId(id)) {
+        toFetch.grpc.push(id);
+      } else if (isWebSocketRequestId(id)) {
+        toFetch.websocket.push(id);
+      } else {
+        toFetch.regular.push(id);
+      }
+    }
+  }
+
+  const fetchPromises: Promise<void>[] = [];
+
+  if (toFetch.grpc.length > 0) {
+    fetchPromises.push(
+      Promise.all(toFetch.grpc.map(id => models.grpcRequest.getById(id)))
+        .then(requests => {
+          requests.forEach((req, idx) => {
+            const id = toFetch.grpc[idx];
+            results.set(id, req);
