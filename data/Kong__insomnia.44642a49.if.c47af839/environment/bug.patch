+function removeProtectedFields<T extends object>(patch: Partial<T>): Partial<T> {
+  const protectedFields = ['_id', 'created', 'type', 'parentId'];
+  const sanitized = { ...patch };
+  
+  for (const field of protectedFields) {
+    if (field in sanitized) {
+      delete (sanitized as any)[field];
+    }
   }
+  
+  return sanitized;
+}
+
+function addUpdateMetadata<T extends object>(patch: Partial<T>, request: T): Partial<T> {
+  const now = Date.now();
+  const currentVersion = (request as any).version || 0;
+  
+  return {
+    ...patch,
+    modified: now,
+    version: currentVersion + 1,
+  } as Partial<T>;
+}
+
+ export function update<T extends object>(request: T, patch: Partial<T> = {}): Promise<T> {
