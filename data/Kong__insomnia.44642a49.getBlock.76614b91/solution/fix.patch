+interface CachedHash {
+  weak: number;
+  strong: string;
+}
+
+const hashCache = new Map<string, CachedHash>();
+const MAX_CACHE_SIZE = 10000;
+
+function computeWeakHash(data: string): number {
+  let a = 1;
+  let b = 0;
+  const MOD = 65521;
+  
+  for (let i = 0; i < data.length; i++) {
+    a = (a + data.charCodeAt(i)) % MOD;
+    b = (b + a) % MOD;
+  }
+  
+  return (b << 16) | a;
+}
+
+function getFromHashCache(content: string): CachedHash | undefined {
+  return hashCache.get(content);
+}
+
+function addToHashCache(content: string, weak: number, strong: string): void {
+  if (hashCache.size >= MAX_CACHE_SIZE) {
+    const firstKey = hashCache.keys().next().value;
+    if (firstKey !== undefined) {
+      hashCache.delete(firstKey);
+    }
+  }
+  hashCache.set(content, { weak, strong });
+}
