+function calculateEnhancedTimings(response: Response | null, harResponse: Har.Response): Har.Timings {
+  if (!response || response.elapsedTime === 0) {
+    return {
+      blocked: -1,
+      dns: -1,
+      connect: -1,
+      send: 0,
+      wait: response ? response.elapsedTime : 0,
+      receive: 0,
+      ssl: -1,
+    };
+  }
+
+  const totalTime = response.elapsedTime;
+  const contentSize = harResponse.content.size;
+  
+  const estimatedSend = Math.min(totalTime * 0.05, 10);
+  const estimatedReceive = contentSize > 0 
+    ? Math.min(totalTime * 0.15, Math.max(contentSize / 100000, 5))
+    : Math.min(totalTime * 0.1, 5);
+  
+  const waitTime = Math.max(0, totalTime - estimatedSend - estimatedReceive);
+
+  return {
+    blocked: -1,
+    dns: -1,
+    connect: -1,
+    send: Math.round(estimatedSend * 100) / 100,
+    wait: Math.round(waitTime * 100) / 100,
+    receive: Math.round(estimatedReceive * 100) / 100,
+    ssl: -1,
+  };
+}
