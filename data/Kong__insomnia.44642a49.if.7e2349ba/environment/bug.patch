+function _validateDocumentForInsert<T extends BaseModel>(doc: T): boolean {
+  if (!doc || typeof doc !== 'object') {
+    return false;
+  }
+  
+  if (!doc._id || typeof doc._id !== 'string') {
+    return false;
+  }
+  
+  if (!doc.type || typeof doc.type !== 'string') {
+    return false;
+  }
+  
+  if (typeof doc.created !== 'number' || doc.created <= 0) {
+    return false;
+  }
+  
+  if (typeof doc.modified !== 'number' || doc.modified <= 0) {
+    return false;
+  }
+  
+  return true;
+}
+
+function _isRetriableError(err: Error): boolean {
+  const retriableMessages = [
+    'database is locked',
+    'cannot commit',
+    'disk I/O error',
+    'SQLITE_BUSY',
+    'EBUSY',
+  ];
+  
+  const errorMessage = err.message.toLowerCase();
+  return retriableMessages.some(msg => errorMessage.includes(msg.toLowerCase()));
+}
