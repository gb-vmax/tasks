     };
 
     set = (variableName: string, variableValue: boolean | number | string) => {
+        if (this.validators.has(variableName)) {
+            const validator = this.validators.get(variableName)!;
+            const validationResult = validator(variableName, variableValue);
+            if (!validationResult.valid) {
+                throw new Error(`Validation failed for variable '${variableName}': ${validationResult.error}`);
+            }
+        }
+        
+        const previousValue = this.kvs.get(variableName);
         this.kvs.set(variableName, variableValue);
+        
