+const handlePromptWithTimeout = (
+  title: string,
+  options: Pick<PromptModalOptions, 'label' | 'defaultValue' | 'submitName' | 'inputType'> & { timeout?: number },
+  canShowDialogs: boolean
+): Promise<string> => {
+  if (!canShowDialogs) {
+    return Promise.resolve(options.defaultValue || '');
+  }
+
+  return new Promise<string>((resolve, reject) => {
+    let shouldResolve = false;
+    let resolveWith: string | null = null;
+    let timeoutId: NodeJS.Timeout | null = null;
+    let timedOut = false;
+    let validationFailed = false;
+
+    const cleanup = () => {
+      if (timeoutId !== null) {
+        clearTimeout(timeoutId);
+        timeoutId = null;
+      }
+    };
+
+    if (options.timeout && options.timeout > 0) {
+      timeoutId = setTimeout(() => {
+        timedOut = true;
+        cleanup();
+      }, options.timeout);
+    }
+
+    showPrompt({
+      title,
+      ...(options || ({} as Record<string, any>)),
+
+      onComplete(value: string) {
+        shouldResolve = true;
+        resolveWith = value;
+      },
+
+      onHide() {
+        if (shouldResolve && resolveWith !== null) {
+          if (timeoutId !== null) {
+            clearTimeout(timeoutId);
+          }
+          resolve(resolveWith);
+          return;
+        }
+        
+        if (timeoutId !== null) {
+          clearTimeout(timeoutId);
+        }
+        
+        const reason = timedOut ? 'timeout' : (validationFailed ? 'validation' : 'cancelled');
+        reject(new Error(`Prompt ${title} ${reason}`));
+      },
+    });
+  });
+};
+
+ onHide() {
+   if (shouldResolve && resolveWith !== null) {
+     if (timeoutId !== null) {
+       clearTimeout(timeoutId);
+     }
+     resolve(resolveWith);
+     return;
+   }
+  
+   if (timeoutId !== null) {
+     clearTimeout(timeoutId);
+   }
+  
+   const reason = timedOut ? 'timeout' : (validationFailed ? 'validation' : 'cancelled');
+   reject(new Error(`Prompt ${title} ${reason}`));
+ }
           });
         });
