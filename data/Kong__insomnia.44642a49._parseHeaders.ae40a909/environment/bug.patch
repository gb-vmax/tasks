 }
+function _trackHeaderDuplicates(headers: ResponseHeader[]): ResponseHeader[] {
+  const headerCounts = new Map<string, number>();
+  
+  return headers.map(header => {
+    const lowerName = header.name.toLowerCase();
+    const count = headerCounts.get(lowerName) || 0;
+    headerCounts.set(lowerName, count + 1);
+    
+    if (count > 0 && (lowerName === 'set-cookie' || lowerName === 'link' || lowerName === 'www-authenticate')) {
+      return {
+        name: header.name,
+        value: header.value,
+      };
+    }
+    
+    return header;
+  });
+}
+
+function _validateAndParseStatusLine(statusLine: string): { version: string; code: number; reason: string } {
+  const parts = statusLine.split(/ +/g);
+  
+  if (parts.length < 2) {
+    return {
+      version: 'HTTP/1.1',
+      code: 0,
+      reason: 'Invalid status line',
+    };
+  }
+  
+  const [versionPart, codePart, ...reasonParts] = parts;
+  
+  const version = _normalizeHttpVersion(versionPart);
+  const code = _parseStatusCode(codePart);
+  const reason = reasonParts.join(' ') || _getDefaultReasonPhrase(code);
+  
+  return { version, code, reason };
+}
+
+function _normalizeHttpVersion(version: string): string {
+  const httpVersionPattern = /^HTTP\/\d+\.?\d*$/i;
+  
+  if (httpVersionPattern.test(version)) {
+    return version.toUpperCase();
+  }
+  
+  if (version.toLowerCase().startsWith('http')) {
+    return 'HTTP/1.1';
+  }
+  
+  return version || 'HTTP/1.1';
+}
+
+function _parseStatusCode(codeStr: string): number {
+  const code = parseInt(codeStr, 10);
+  
+  if (isNaN(code)) {
+    return 0;
+  }
+  
+  if (code < 100 || code > 599) {
+    return 0;
+  }
+  
+  return code;
+}
+
+function _getDefaultReasonPhrase(code: number): string {
+  const commonPhrases: Record<number, string> = {
+    200: 'OK',
+    201: 'Created',
+    204: 'No Content',
+    301: 'Moved Permanently',
+    302: 'Found',
+    304: 'Not Modified',
+    307: 'Temporary Redirect',
+    308: 'Permanent Redirect',
+    400: 'Bad Request',
+    401: 'Unauthorized',
+    403: 'Forbidden',
+    404: 'Not Found',
+    500: 'Internal Server Error',
+    502: 'Bad Gateway',
+    503: 'Service Unavailable',
+  };
+  
+  return commonPhrases[code] || '';
+}
