+function extractJsonPath(obj: any, path: string): any {
+    if (!path || path.trim() === '') {
+        return obj;
+    }
+
+    const segments = path.split('.').filter(segment => segment.length > 0);
+    let current = obj;
+
+    for (let i = 0; i < segments.length; i++) {
+        const segment = segments[i];
+        
+        if (current === null || current === undefined) {
+            throw Error(`json: path extraction failed - cannot access property '${segment}' of ${current}`);
+        }
+
+        if (typeof current !== 'object') {
+            throw Error(`json: path extraction failed - '${segments.slice(0, i).join('.')}' is not an object`);
+        }
+
+        if (Array.isArray(current)) {
+            const index = parseInt(segment, 10);
+            if (isNaN(index)) {
+                throw Error(`json: path extraction failed - '${segment}' is not a valid array index`);
+            }
+            if (index < 0 || index >= current.length) {
+                throw Error(`json: path extraction failed - array index ${index} is out of bounds`);
+            }
+            current = current[index];
+        } else {
+            if (!(segment in current)) {
+                throw Error(`json: path extraction failed - property '${segment}' does not exist`);
+            }
+            current = current[segment];
         }
     }
 
+    return current;
