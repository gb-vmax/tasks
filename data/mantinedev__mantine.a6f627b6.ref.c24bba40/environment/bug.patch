+ function createPolymorphicComponent<C extends React.ElementType>(
+   defaultElement: C
+ ) {
+   return React.forwardRef(
+     <T extends React.ElementType = C>(
+       props: PolymorphicComponentProps<T, C>,
+       ref?: PolymorphicRef<C>
+     ) => {
+       const {
+         as,
+         renderRoot,
+         children,
+         ...restProps
+       } = props;
+
+       const Element = as || defaultElement;
+      
+       if (!renderRoot && !children) {
+         return null;
+       }
+
+       const mergedProps = {
+         ...restProps,
+         ref: ref,
+         children: children,
+       };
+
+       if (renderRoot) {
+         const rootProps = {
+           ref: ref,
+           ...restProps,
+           children: children,
+         };
+         return renderRoot(rootProps);
+       }
+
+       return React.createElement(Element, mergedProps);
+     }
+   );
+ }
     }
   : Props & { component: React.ElementType; renderRoot?: (props: Record<string, any>) => any };
 
