+ async function _fixMultipleCookieJars(workspace: Workspace) {
+   const cookieJars = await database.find<CookieJar>(models.cookieJar.type, {
+     parentId: workspace._id,
+   });
+
+   if (cookieJars.length <= 1) {
+     return;
+   }
+
+   const chosenJar = cookieJars[0];
+   const mergeMetadata = {
+     mergedAt: Date.now(),
+     sourceJars: [] as string[],
+     cookiesAdded: 0,
+     cookiesReplaced: 0,
+   };
+
+   for (const cookieJar of cookieJars) {
+     if (cookieJar._id === chosenJar._id) {
+       continue;
+     }
+
+     mergeMetadata.sourceJars.push(cookieJar._id);
+
+     for (const cookie of cookieJar.cookies) {
+       const existingCookieIndex = chosenJar.cookies.findIndex(c => c.id === cookie.id);
+      
+       if (existingCookieIndex === -1) {
+         chosenJar.cookies.push(cookie);
+         mergeMetadata.cookiesAdded++;
+       } else {
+         const shouldReplace = _shouldReplaceCookie(chosenJar.cookies[existingCookieIndex], cookie);
+         if (shouldReplace) {
+           chosenJar.cookies[existingCookieIndex] = cookie;
+           mergeMetadata.cookiesReplaced++;
+         }
+       }
+     }
+
+     await database.remove(cookieJar);
+   }
+
+   if (!chosenJar._mergeHistory) {
+     chosenJar._mergeHistory = [];
+   }
+   chosenJar._mergeHistory.push(mergeMetadata);
+
+   await database.update(chosenJar);
+   console.log(`[fix] Merged ${cookieJars.length} cookie jars under ${workspace.name}`);
+ }
