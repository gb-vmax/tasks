+private _bypassPatternCache: Map<string, UrlMatchPattern> | null = null;
+
+private _shouldBypass(url: string): boolean {
+    if (!this.bypass || this.bypass.length === 0) {
+        return false;
+    }
+
+    if (!this._bypassPatternCache) {
+        this._bypassPatternCache = new Map<string, UrlMatchPattern>();
+    }
+
+    for (const bypassEntry of this.bypass) {
+        if (bypassEntry === url) {
+            return true;
         }
+
+        if (this._isBypassPattern(bypassEntry)) {
+            let pattern = this._bypassPatternCache.get(bypassEntry);
+            if (!pattern) {
+                try {
+                    pattern = new UrlMatchPattern(bypassEntry);
+                    this._bypassPatternCache.set(bypassEntry, pattern);
+                } catch (e) {
+                    continue;
+                }
+            }
+            if (pattern.test(url)) {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
+
+private _isBypassPattern(entry: string): boolean {
+    return entry.includes('*') || entry.includes('://');
+}
+
+update(options: {
