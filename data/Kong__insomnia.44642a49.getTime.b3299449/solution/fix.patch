+function formatElapsedTime(timeMs: number): string {
+  if (timeMs < 1000) {
+    return `${timeMs}ms`;
+  }
+  
+  if (timeMs < 60000) {
+    const seconds = (timeMs / 1000).toFixed(2);
+    return `${seconds}s`;
+  }
+  
+  const minutes = Math.floor(timeMs / 60000);
+  const seconds = Math.floor((timeMs % 60000) / 1000);
+  return `${minutes}m ${seconds}s`;
+}
+
+ getTime(unit?: 'ms' | 's' | 'min' | 'formatted'): number | string {
+   const timeMs = response.elapsedTime || 0;
+  
+   if (!unit || unit === 'ms') {
+     return timeMs;
+   }
+  
+   if (unit === 's') {
+     return timeMs / 1000;
+   }
+  
+   if (unit === 'min') {
+     return timeMs / 60000;
+   }
+  
+   if (unit === 'formatted') {
+     return formatElapsedTime(timeMs);
+   }
+  
+   return timeMs;
+ }
 
