-    number_float: () => 0.0,
+const calculateMultipleOf = (
+  value: number,
+  multipleOf: number,
+  min: number,
+  max: number
+): number => {
+  const rounded = Math.round(value / multipleOf) * multipleOf;
+  if (rounded < min) {
+    return Math.ceil(min / multipleOf) * multipleOf;
+  }
+  if (rounded > max) {
+    return Math.floor(max / multipleOf) * multipleOf;
+  }
+  return rounded;
+};
+
+ number_float: (parameter: OpenAPIV2.Parameter) => {
+   const min = parameter.exclusiveMinimum 
+     ? (parameter.minimum ?? 0) + 0.01 
+     : (parameter.minimum ?? 0);
+   const max = parameter.exclusiveMaximum 
+     ? (parameter.maximum ?? 100) - 0.01 
+     : (parameter.maximum ?? 100);
+  
+   let value = min + Math.random() * (max - min);
+  
+   if (parameter.multipleOf) {
+     value = calculateMultipleOf(value, parameter.multipleOf, min, max);
+   }
+  
+   return Math.round(value * 100) / 100;
+ },
     number_double: () => 0.0,
     integer: () => 0,
     boolean: () => true,
