+ export function collectDocumentPaths(
+   documents: ParsedApiSpec,
+   rootPath: string[] = []
+ ): string[][] {
+   const allPaths: string[][] = [];
+   const visitedKeys = new Set<string>([rootPath.join('.')]);
+
+   function traverse(obj: any, currentPath: string[]) {
+     if (obj === null || typeof obj !== 'object') {
+       return;
+     }
+
+     const pathKey = currentPath.join('.');
+    
+     if (visitedKeys.has(pathKey)) {
+       return;
+     }
+
+     visitedKeys.add(pathKey);
+
+     if (typeof obj === 'object' && obj !== null) {
+       allPaths.push([...currentPath]);
+     }
+
+     if (Array.isArray(obj)) {
+       obj.forEach((item, index) => {
+         traverse(item, [...currentPath, String(index)]);
+       });
+     } else {
+       Object.keys(obj).forEach((key) => {
+         traverse(obj[key], [...currentPath, key]);
+       });
+     }
+   }
+
+   traverse(documents, rootPath);
+   return allPaths;
+ }
   hideAfterClick?: boolean;
 }
 
