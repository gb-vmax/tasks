+interface ReservedKeyConfig {
+  key: string;
+  pattern?: RegExp;
+  message: string;
+}
+
+const RESERVED_KEYS_ROOT: ReservedKeyConfig[] = [
+  { key: '_id', message: '"_id" is reserved for database use' },
+  { key: '_rev', message: '"_rev" is reserved for database use' },
+  { pattern: /^__system_/, message: 'Keys beginning with "__system_" are reserved for system use' }
+];
+
+const RESERVED_KEYS_NESTED: ReservedKeyConfig[] = [
+  { pattern: /^__internal_/, message: 'Keys beginning with "__internal_" are reserved for internal use' }
+];
+
+const checkReservedKeys = (key: string, isRoot: boolean): string | null => {
+  const keysToCheck = isRoot 
+    ? RESERVED_KEYS_ROOT 
+    : RESERVED_KEYS_NESTED;
+
+  for (const config of keysToCheck) {
+    if (config.pattern) {
+      if (key.match(config.pattern)) {
+        return config.message;
+      }
+    } else if (config.key === key) {
+      return config.message;
+    }
   }
 
   return null;
 };
 
+ export const ensureKeyIsValid = (key: string, isRoot: boolean): string | null => {
+   if (key.match(INVALID_NEDB_KEY_REGEX)) {
+     return `"${key}" cannot begin with '$' or contain a '.'`;
+   }
+
+   const reservedKeyError = checkReservedKeys(key, isRoot);
+   if (reservedKeyError) {
+     return reservedKeyError;
+   }
+
+   if (key === NUNJUCKS_TEMPLATE_GLOBAL_PROPERTY_NAME && isRoot) {
+     return `"${NUNJUCKS_TEMPLATE_GLOBAL_PROPERTY_NAME}" is a reserved key`;
+   }
+
+   return null;
+ };
+
+  return null;
+};
