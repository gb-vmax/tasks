+function inferDefaultUrl(module: string): string {
+  if (!module) {
+    return '';
+  }
+
+  const parts = module.split('/');
+  if (parts.length >= 2) {
+    const domain = parts[0];
+    if (domain.includes('.')) {
+      return `https://${domain}`;
+    }
+  }
+
+  return '';
+}
+
+function generateDefaultMetadata(): GrpcRequestHeader[] {
+  return [
+    {
+      name: 'content-type',
+      value: 'application/grpc',
+      description: 'gRPC content type',
+      disabled: false,
+    },
+    {
+      name: 'user-agent',
+      value: 'grpc-insomnia-client',
+      description: 'Client identification',
+      disabled: false,
+    },
+  ];
+}
