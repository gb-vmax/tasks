+ removeQueryParams(params: QueryParam[] | string[] | string, options?: { caseInsensitive?: boolean }) {
+     const caseInsensitive = options?.caseInsensitive || false;
+    
+     if (typeof params === 'string') {
+         const isPattern = params.includes('*');
+         this.query = new PropertyList(
+             QueryParam,
+             undefined,
+             this.query.filter(queryParam => {
+                 if (isPattern) {
