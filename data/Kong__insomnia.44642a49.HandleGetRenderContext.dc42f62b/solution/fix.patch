 export type HandleGetRenderContext = () => Promise<RenderContextAndKeys>;
 
+export const getRenderContext: HandleGetRenderContext = async () => {
+  const context = await fetchContextData();
+  const keys = await fetchKeys();
+  
+  if (!context) {
+    return {
+      context: {},
+      keys: keys || []
+    };
+  }
+  
+  const processedKeys = keys.filter(key => key !== null);
+  
+  if (processedKeys.length === 0) {
+    return {
+      context: context,
+      keys: null
+    };
+  }
+  
+  return {
+    context: { ...context },
+    keys: processedKeys.slice(1)
+  };
+};
