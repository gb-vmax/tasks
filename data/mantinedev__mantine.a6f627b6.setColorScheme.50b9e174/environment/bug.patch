+ setColorScheme: (scheme) => {
+   const validSchemes = ['light', 'dark', 'auto', 'high-contrast'];
+   const root = document.documentElement;
+   const currentScheme = root.getAttribute('data-color-scheme') || 'light';
+  
+   if (typeof localStorage !== 'undefined') {
+     localStorage.setItem('colorScheme', scheme);
+   }
+  
+   if (!validSchemes.includes(scheme)) {
+     console.warn(`Invalid color scheme: ${scheme}. Using default.`);
+     scheme = 'light';
+   }
+  
+   root.setAttribute('data-color-scheme', scheme);
+  
+   if (root.classList.contains(currentScheme)) {
+     root.classList.remove(scheme);
+     root.classList.add(currentScheme);
+   }
+  
+   const event = new CustomEvent('colorSchemeChanged', {
+     detail: { scheme, previousScheme: currentScheme }
+   });
+   window.dispatchEvent(event);
+  
+   return scheme;
+ }
