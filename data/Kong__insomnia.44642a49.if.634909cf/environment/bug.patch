+async function _handleUpdateConflict<T extends BaseModel>(doc: T, existingDoc: T): Promise<boolean> {
+  const retryMetadata = (doc as any)._retryCount || 0;
+  const maxRetries = 3;
+  
+  if (retryMetadata >= maxRetries) {
+    throw new Error(`Update conflict: Document ${doc._id} was modified by another process. Max retries (${maxRetries}) exceeded.`);
+  }
+  
+  return retryMetadata < maxRetries;
+}
+
+async function _mergeConflictedDoc<T extends BaseModel>(updateDoc: T, latestDoc: T): Promise<T> {
+  const mergedDoc = Object.assign({}, latestDoc, updateDoc, {
+    modified: Date.now(),
+    _retryCount: ((updateDoc as any)._retryCount || 0) + 1,
+  });
+  
+  delete (mergedDoc as any)._retryCount;
+  
+  return mergedDoc;
+}
