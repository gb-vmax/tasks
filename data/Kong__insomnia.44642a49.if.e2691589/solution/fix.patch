+ export function toUrlObject(url: string | Url, options?: { validate?: boolean; normalize?: boolean }): Url {
+     if (!url) {
+         throw Error('Request URL is not specified');
+     }
+    
+     const shouldValidate = options?.validate ?? false;
+     const shouldNormalize = options?.normalize ?? true;
+    
+     if (typeof url === 'string') {
+         let processedUrl = url;
+        
+         if (shouldNormalize) {
+             processedUrl = normalizeUrlString(processedUrl);
+         }
+        
+         if (shouldValidate) {
+             const validationError = validateUrlString(processedUrl);
+             if (validationError) {
+                 throw Error(`Invalid URL: ${validationError}`);
+             }
+         }
+        
+         try {
+             return new Url(processedUrl);
+         } catch (error) {
+             throw Error(`Failed to parse URL "${processedUrl}": ${error instanceof Error ? error.message : String(error)}`);
+         }
+     }
+    
+     return url;
+ }
     return typeof url === 'string' ? new Url(url) : url;
 }
