+private _resolveCache: Map<string, { result: any; timestamp: number }> = new Map();
+private _cacheTTL: number = 60000;
+private _maxCacheSize: number = 100;
+
+private _getCachedResolve(urlStr: string): any | undefined {
+    const cached = this._resolveCache.get(urlStr);
+    if (cached) {
+        const now = Date.now();
+        if (now - cached.timestamp < this._cacheTTL) {
+            return cached.result;
+        } else {
+            this._resolveCache.delete(urlStr);
         }
+    }
+    return undefined;
+}
+
+private _cacheResolve(urlStr: string, result: any): void {
+    if (this._resolveCache.size >= this._maxCacheSize) {
+        const oldestKey = this._resolveCache.keys().next().value;
+        this._resolveCache.delete(oldestKey);
+    }
+    this._resolveCache.set(urlStr, {
+        result: result,
+        timestamp: Date.now()
+    });
+}
+
+private _sortByPriority(matches: any[]): any[] {
+    return matches.sort((a, b) => {
