+async _findParentBranchForCreation(): Promise<Branch | null> {
+  try {
+    const head = await this._getHead();
+    if (head && head.branch) {
+      const currentBranch = await this._getBranch(head.branch);
+      return currentBranch;
     }
+  } catch (err) {
+    return null;
+  }
+  return null;
