+ async _getOrCreateBranch(name: string): Promise<Branch> {
+   if (!name) {
+     throw new Error('No branch name specified for get-or-create operation');
+   }
+
+   const normalizedName = this._normalizeBranchName(name);
+
+   const branch = await this._getBranch(normalizedName);
+
+   if (branch === null) {
+     const parentBranch = await this._findParentBranchForCreation();
+     const initialSnapshots = parentBranch && parentBranch.snapshots.length > 0 
+       ? [...parentBranch.snapshots] 
+       : [];
+
+     await this._storeBranch({
+       name: normalizedName,
+       created: new Date(),
+       modified: new Date(),
+       snapshots: initialSnapshots,
+     });
+     return this._getOrCreateBranch(normalizedName);
+   }
+
+   return branch;
