+const extractSecurityVariables = (api: OpenAPIV2.Document): Record<string, string> => {
+  const variables: Record<string, string> = {};
+  
+  if (!api.securityDefinitions) {
+    return variables;
+  }
+
+  const usedSchemes = new Set<string>();
+  
+  if (api.security) {
+    api.security.forEach(requirement => {
+      Object.keys(requirement).forEach(schemeName => {
+        usedSchemes.add(schemeName);
+      });
+    });
+  }
+
+  Object.keys(api.paths || {}).forEach(path => {
+    const pathItem = api.paths[path];
+    const methods = ['get', 'post', 'put', 'delete', 'patch', 'options', 'head'] as const;
+    
+    methods.forEach(method => {
+      const operation = pathItem[method] as OpenAPIV2.OperationObject | undefined;
+      if (operation?.security) {
+        operation.security.forEach(requirement => {
+          Object.keys(requirement).forEach(schemeName => {
+            usedSchemes.add(schemeName);
+          });
+        });
+      }
+    });
+  });
+
+  usedSchemes.forEach(schemeName => {
+    const scheme = api.securityDefinitions[schemeName];
+    
+    if (scheme.type === 'basic') {
+      variables.username = variables.username || 'your_username';
+      variables.password = variables.password || 'your_password';
+    }
+    
+    if (scheme.type === 'apiKey') {
+      variables.api_key = variables.api_key || 'your_api_key_here';
+    }
+    
+    if (scheme.type === 'oauth2') {
+      variables.client_id = variables.client_id || 'your_client_id';
+      variables.client_secret = variables.client_secret || 'your_client_secret';
+      
+      if (scheme.flow === 'password') {
+        variables.username = variables.username || 'your_username';
+        variables.password = variables.password || 'your_password';
+      }
+    }
+  });
+
+  return variables;
+};
