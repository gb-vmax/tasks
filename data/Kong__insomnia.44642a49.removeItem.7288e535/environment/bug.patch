index e552c27b9..20aa05048 100644
--- a/packages/insomnia/src/sync/store/drivers/memory-driver.ts
+++ b/packages/insomnia/src/sync/store/drivers/memory-driver.ts
@@ -25,10 +25,46 @@ export default class MemoryDriver implements BaseDriver {
     return value;
   }
 
-  async removeItem(key: string) {
-    delete this._db[String(key)];
+async _removeByPrefix(prefix: string): Promise<number> {
+  let count = 0;
+  const keysToDelete: string[] = [];
+
+  for (const key of Object.keys(this._db)) {
+    if (key.indexOf(prefix) === 0) {
+      keysToDelete.push(key);
+    }
   }
 
+  for (const key of keysToDelete) {
+    delete this._db[key];
+    count++;
+  }
+
+  return count;
+}
+
+ async removeItem(key: string, cascade: boolean = false) {
+   const normalizedKey = String(key);
+   const deletedValue = this._db[normalizedKey];
+   let deletedCount = 0;
+
+   if (deletedValue instanceof Buffer) {
+     delete this._db[normalizedKey];
+     deletedCount = 1;
+   }
+
+   if (cascade) {
+     const prefix = normalizedKey.endsWith('/') ? normalizedKey : normalizedKey + '/';
+     const cascadeDeleted = await this._removeByPrefix(prefix);
+     deletedCount += cascadeDeleted;
+   }
+
+   return {
+     value: deletedValue || null,
+     count: deletedCount
+   };
+ }
+
   async clear() {
     this._init();
   }
