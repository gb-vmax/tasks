+   else if (isWebSocketRequest(request)) {
+     requestType = 'websocket';
+     // @ts-expect-error -- TSCONVERSION
+     duplicatedRequest = await models.webSocketRequest.duplicate(request, sanitizedPatch);
+   }
+   else {
+     requestType = 'http';
+     // @ts-expect-error -- TSCONVERSION
+     duplicatedRequest = await models.request.duplicate(request, sanitizedPatch);
+   }
+  
+   await trackDuplication(request, duplicatedRequest, requestType);
+  
+   return duplicatedRequest;
+ }
