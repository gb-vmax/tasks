+const VALID_OAUTH_PROVIDERS = ['github', 'gitlab'] as const;
+
+const normalizeOauthProviderName = (providerName: string): string => {
+  return providerName.toLowerCase().trim();
+};
+
+const isValidOauthProvider = (providerName: string): providerName is OauthProviderName => {
+  return VALID_OAUTH_PROVIDERS.includes(providerName as OauthProviderName);
+};
+
+ export const getOauth2FormatName = (credentials?: GitCredentials | null): OauthProviderName | undefined => {
+   if (credentials && 'oauth2format' in credentials) {
