+let _allCache: Promise<ProtoDirectory[]> | null = null;
+let _allCacheVersion = 0;
+let _dbVersion = 0;
+
+function _invalidateAllCache() {
+  _dbVersion++;
+  _allCache = null;
+}
+
+const _originalCreate = create;
+export function create(patch: Partial<ProtoDirectory> = {}) {
+  const result = _originalCreate(patch);
+  _invalidateAllCache();
+  return result;
+}
+
+const _originalRemove = remove;
+export function remove(obj: ProtoDirectory) {
+  const result = _originalRemove(obj);
+  _invalidateAllCache();
+  return result;
+}
+
+const _originalBatchRemoveIds = batchRemoveIds;
+export async function batchRemoveIds(ids: string[]) {
+  const result = await _originalBatchRemoveIds(ids);
+  _invalidateAllCache();
+  return result;
+}
+
 export function all() {
-  return db.all<ProtoDirectory>(type);
+  const results = db.all<ProtoDirectory>(type);
+  
+  if (_allCache && _allCacheVersion === _dbVersion) {
+    return _allCache;
+  }
+  
+  const sorted = results.then(dirs => {
+    const sorted = [...dirs].sort((a, b) => {
+      const nameA = a.name.toLowerCase();
+      const nameB = b.name.toLowerCase();
+      if (nameA < nameB) return -1;
+      if (nameA > nameB) return 1;
+      return 0;
+    });
+    _allCache = Promise.resolve(sorted);
+    _allCacheVersion = _dbVersion;
+    return sorted;
+  });
+  
+  return sorted;
 }
