+  const ttlPrefix = '__TTL__:';
+  if (value.startsWith(ttlPrefix)) {
+    const parts = value.slice(ttlPrefix.length).split(':', 2);
+    if (parts.length === 2) {
+      const ttl = parseInt(parts[0], 10);
+      if (!isNaN(ttl)) {
+        return { value: parts[1], ttl };
+      }
+    }
+  }
