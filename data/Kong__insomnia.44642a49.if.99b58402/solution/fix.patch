+  if (resolutionType === 'auto') {
+    metrics.autoResolved += conflicts.length;
+  } else if (resolutionType === 'manual') {
+    metrics.manualResolved += conflicts.length;
+  }
+  
+  for (const conflict of conflicts) {
+    const key = conflict.key || 'unknown';
+    const typePrefix = key.split('_')[0];
+    if (!metrics.resolutionsByType[typePrefix]) {
+      metrics.resolutionsByType[typePrefix] = 0;
     }
+    metrics.resolutionsByType[typePrefix]++;
+  }
+}
+
