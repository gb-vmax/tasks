+interface SpacingConfig {
+  suites?: number | ((depth: number) => number);
+  tests?: number | ((depth: number) => number);
+}
+
+const calculateSpacing = (
+  depth: number,
+  type: 'suite' | 'test',
+  config?: SpacingConfig,
+): number => {
+  if (!config) {
+    return 1;
+  }
+
+  const spacingValue = type === 'suite' ? config.suites : config.tests;
+
+  if (typeof spacingValue === 'function') {
+    return Math.max(0, spacingValue(depth));
+  }
+
+  if (typeof spacingValue === 'number') {
+    return Math.max(0, spacingValue);
+  }
+
+  return 1;
+};
+
+export const generate = (suites: TestSuite[], config?: SpacingConfig) => {
+  const lines = [
+    'const { expect } = chai;',
+    '',
+    '// Clear active request before test starts (will be set inside test)',
+    'beforeEach(() => insomnia.clearActiveRequest());',
+    '',
+  ];
+
+  for (const s of suites || []) {
+    lines.push(...generateSuiteLines(0, s, config));
+  }
+
+  return lines.join('\n');
+};
+
+export const generateToFile = async (
+  filepath: string,
+  suites: TestSuite[],
+  config?: SpacingConfig,
+) => {
+  return new Promise<void>((resolve, reject) => {
+    const js = generate(suites, config);
+    return writeFile(filepath, js, err => {
+      if (err) {
+        reject(err);
+      } else {
+        resolve();
+      }
+    });
+  });
+};
