+interface CountCacheEntry {
+  value: number | Record<string, number>;
+  expiry: number;
+}
+
+const countCache = new Map<string, CountCacheEntry>();
+
+function _getCountCacheKey<T extends BaseModel>(type: string, query: Query<T>, groupBy?: keyof T): string {
+  return JSON.stringify({ type, query, groupBy });
+}
+
+function _getFromCountCache(key: string): number | Record<string, number> | undefined {
+  const entry = countCache.get(key);
+  if (!entry) {
+    return undefined;
+  }
+  
+  if (Date.now() > entry.expiry) {
+    countCache.delete(key);
+    return undefined;
+  }
+  
+  return entry.value;
+}
+
+function _setInCountCache(key: string, value: number | Record<string, number>, ttl: number): void {
+  countCache.set(key, {
+    value,
+    expiry: Date.now() + ttl,
+  });
+}
+
+function _invalidateCountCacheForType(type: string): void {
+  const keysToDelete: string[] = [];
+  for (const [key] of countCache.entries()) {
+    try {
+      const parsed = JSON.parse(key);
+      if (parsed.type === type) {
+        keysToDelete.push(key);
+      }
+    } catch {
+      continue;
