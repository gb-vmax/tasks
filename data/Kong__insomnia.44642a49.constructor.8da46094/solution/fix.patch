+function validateCertificateConfiguration(options: CertificateOptions): void {
+    const hasPfx = options.pfx !== undefined;
+    const hasKeyOrCert = options.key !== undefined || options.cert !== undefined;
+    
+    if (hasPfx && hasKeyOrCert) {
+        throw new Error('Certificate configuration error: cannot specify both pfx and key/cert. Use either pfx OR key+cert pair.');
     }
+    
+    if (hasKeyOrCert && (options.key === undefined || options.cert === undefined)) {
+        throw new Error('Certificate configuration error: both key and cert must be specified together.');
+    }
+}
