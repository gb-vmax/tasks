+function interpolateEnvVars(path: string): string {
+    return path.replace(/\$\{([^}]+)\}/g, (match, envVar) => {
+        const value = process.env[envVar];
+        if (value === undefined) {
+            throw new Error(`Environment variable ${envVar} is not defined`);
+        }
+        return value;
+    });
+}
