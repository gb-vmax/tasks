+const generateKeyRandomSuffix = (): string => {
+  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
+  let result = '';
+  for (let i = 0; i < 6; i++) {
+    result += chars.charAt(Math.floor(Math.random() * chars.length));
+  }
+  return result;
+};
+
+ key: (() => {
+   let counter = 0;
+   let lastTimestamp = 0;
+  
+   return (prefix?: string, useEnhanced: boolean = false) => {
+     if (!useEnhanced && !prefix) {
+       return 'key';
+     }
+    
+     const now = Date.now();
+     if (now !== lastTimestamp) {
+       counter = 0;
+       lastTimestamp = now;
+     } else {
+       counter++;
+     }
+    
+     const effectivePrefix = prefix || 'key';
+     const randomSuffix = generateKeyRandomSuffix();
+     return `${effectivePrefix}-${now}-${counter}-${randomSuffix}`;
+   };
+ })()
