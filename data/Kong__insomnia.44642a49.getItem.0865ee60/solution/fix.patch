+const CACHE_TTL = 5000;
+
+interface CacheEntry {
+  value: string | any;
+  expiry: number;
+}
+
+const itemCache = new Map<string, CacheEntry>();
+
+function tryParseJSON(value: string): string | any {
+  if (typeof value !== 'string') {
+    return value;
+  }
+  
+  const trimmed = value.trim();
+  if ((trimmed.startsWith('{') && trimmed.endsWith('}')) || 
+      (trimmed.startsWith('[') && trimmed.endsWith(']'))) {
+    try {
+      return JSON.parse(value);
+    } catch {
+      return value;
+    }
+  }
+  
+  return value;
+}
+
+ async getItem(key: string) {
+   const cacheKey = `${plugin.name}:${key}`;
+   const cached = itemCache.get(cacheKey);
+  
+   if (cached && Date.now() < cached.expiry) {
+     return cached.value;
+   }
+  
+   const doc = await models.pluginData.getByKey(plugin.name, key);
+  
+   if (!doc) {
+     return null;
+   }
+  
+   const parsedValue = tryParseJSON(doc.value);
+  
+   itemCache.set(cacheKey, {
+     value: parsedValue,
+     expiry: Date.now() + CACHE_TTL,
+   });
+  
+   return parsedValue;
+ },
 
