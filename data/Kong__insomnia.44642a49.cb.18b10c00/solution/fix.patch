+private deletionHistory: Array<{
+    url: string;
+    cookieName: string;
+    reason: string;
+    timestamp: Date;
+}> = [];
+
+private _recordDeletion(url: string, cookieName: string, reason: string, timestamp: Date) {
+    this.deletionHistory.push({
+        url,
+        cookieName,
+        reason,
+        timestamp,
+    });
+    
+    if (this.deletionHistory.length > 1000) {
+        this.deletionHistory.shift();
+    }
+}
+
+private _isCookieExpired(cookie: Cookie): boolean {
+    const cookieData = cookie.toJSON();
+    
+    if (!cookieData.expires) {
+        return false;
+    }
+    
+    const expiryDate = typeof cookieData.expires === 'string' 
+        ? new Date(cookieData.expires) 
+        : cookieData.expires;
+    
+    if (expiryDate === null || isNaN(expiryDate.getTime())) {
+        return false;
+    }
+    
+    return expiryDate.getTime() < Date.now();
+}
+
+getDeletionHistory(url?: string): Array<{ url: string; cookieName: string; reason: string; timestamp: Date }> {
+    if (url) {
+        return this.deletionHistory.filter(entry => entry.url === url);
+    }
+    return [...this.deletionHistory];
+}
