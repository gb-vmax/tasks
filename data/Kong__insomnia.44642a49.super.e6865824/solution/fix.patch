+private normalizeAuthOptions(options: AuthOptions): AuthOptions {
+    const normalized: AuthOptions = { type: options.type };
+    
+    const authTypeKey = options.type;
+    if (authTypeKey === 'noauth' || authTypeKey === 'netrc') {
+        return normalized;
+    }
+    
+    const authData = options[authTypeKey];
+    if (!authData) {
+        return normalized;
+    }
+    
+    if (Array.isArray(authData)) {
+        normalized[authTypeKey] = authData;
+    } else if (typeof authData === 'object') {
+        const convertedArray: AuthOption[] = Object.entries(authData).map(([key, value]) => ({
+            key,
+            value: String(value),
+        }));
+        normalized[authTypeKey] = convertedArray;
+    }
+    
+    return normalized;
+}
 
