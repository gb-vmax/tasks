+private validateRequiredFields(options: AuthOptions): void {
+    const authType = options.type;
+    
+    if (authType === 'noauth' || authType === 'netrc') {
+        return;
+    }
+    
+    const authData = options[authType];
+    if (!authData || !Array.isArray(authData)) {
+        return;
+    }
+    
+    const fieldMap = new Map(authData.map(opt => [opt.key, opt.value]));
+    
+    const requiredFields: Record<string, string[]> = {
+        'basic': ['username', 'password'],
+        'bearer': ['token'],
+        'apikey': ['key', 'value'],
+        'oauth1': ['consumerKey', 'consumerSecret'],
+        'oauth2': ['grant_type'],
+        'digest': ['username', 'password'],
+        'ntlm': ['username', 'password'],
+        'awsv4': ['accessKey', 'secretKey'],
+        'hawk': ['authId', 'authKey'],
+        'asap': ['iss', 'kid', 'privateKey'],
+    };
+    
+    const required = requiredFields[authType];
+    if (required) {
+        const missing = required.filter(field => {
+            const value = fieldMap.get(field);
+            return value === undefined || value === null;
+        });
+        
+        if (missing.length > 0) {
+            throw Error(`missing required fields for ${authType} auth: ${missing.join(', ')}`);
         }
+    }
+}
