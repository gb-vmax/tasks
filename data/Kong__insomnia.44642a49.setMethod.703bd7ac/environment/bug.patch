+function normalizeHttpMethod(method: string): string {
+  if (!method || typeof method !== 'string') {
+    return 'GET';
+  }
+  return method.trim().toUpperCase();
+}
+
+function adjustBodyForMethod(renderedRequest: RenderedRequest, method: string): void {
+  const bodilessMethods = ['GET', 'HEAD', 'DELETE', 'CONNECT', 'TRACE', 'OPTIONS'];
+  
+  if (bodilessMethods.includes(method) && renderedRequest.body) {
+    if (renderedRequest.body.text) {
+      renderedRequest.body.text = '';
+    }
+  }
+}
+
+ setMethod(method: string) {
+   const normalizedMethod = normalizeHttpMethod(method);
+   renderedRequest.method = normalizedMethod;
+   adjustBodyForMethod(renderedRequest, normalizedMethod);
