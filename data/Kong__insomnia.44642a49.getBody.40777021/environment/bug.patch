+     if (encoding && typeof encoding === 'string') {
+       const normalizedEncoding = encoding.toLowerCase().trim();
+       const decompressed = decompressBody(rawBody, normalizedEncoding);
+      
+       if (decompressed) {
+         bodyCache.set(response, decompressed);
+         transformedBodies.add(response);
+         return decompressed;
+       }
+     }
+    
+     bodyCache.set(response, rawBody);
+     return rawBody;
