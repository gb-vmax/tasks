+const bodyCache = new WeakMap<MaybeResponse, Buffer>();
+const transformedBodies = new WeakSet<MaybeResponse>();
+
+function decompressBody(body: Buffer, encoding: string): Buffer | null {
+  try {
+    const zlib = require('zlib');
+    
+    switch (encoding) {
+      case 'gzip':
+        return zlib.gunzipSync(body);
+      case 'deflate':
+        return zlib.inflateSync(body);
+      case 'br':
+        return zlib.brotliDecompressSync(body);
+      default:
+        return null;
+    }
+  } catch (error) {
+    return null;
+  }
+}
