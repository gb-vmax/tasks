+function _isValidRequestForExport(request: Request): boolean {
+  if (!request || !request._id || !request.name) {
+    return false;
+  }
+  
+  if (!request.url || typeof request.url !== 'string') {
+    return false;
+  }
+  
+  return true;
+}
+
+async function _applyRequestPluginHooksWithRetry(
+  renderedRequest: RenderedRequest,
+  renderedContext: Record<string, any>,
+  requestName: string,
+  maxRetries: number = 3,
+  initialDelayMs: number = 100,
+): Promise<RenderedRequest> {
+  let lastError: any = null;
+  let attempt = 0;
+  
+  while (attempt <= maxRetries) {
+    try {
+      return await _applyRequestPluginHooks(renderedRequest, renderedContext);
+    } catch (err) {
+      lastError = err;
+      attempt++;
+      
+      if (attempt <= maxRetries) {
+        const delayMs = initialDelayMs * Math.pow(2, attempt - 1);
+        await new Promise(resolve => setTimeout(resolve, delayMs));
+      }
+    }
+  }
+  
+  if (lastError && lastError.plugin) {
+    throw new Error(
+      `Plugin "${lastError.plugin.name}" failed after ${maxRetries} retries: ${lastError.message}`
+    );
+  }
+  
+  throw lastError;
+}
