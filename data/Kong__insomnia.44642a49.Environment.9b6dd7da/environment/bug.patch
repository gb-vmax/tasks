 import { getInterpolator } from './interpolator';
 
+private recordChange(
+        variableName: string,
+        operation: 'set' | 'unset' | 'clear',
+        oldValue: boolean | number | string | undefined,
+        newValue: boolean | number | string | undefined
+    ) {
+        this.changeHistory.push({
+            variableName,
+            operation,
+            oldValue,
+            newValue,
+            timestamp: Date.now(),
+        });
+    }
+
+    private notifyListeners(
+        variableName: string,
+        newValue: boolean | number | string | undefined,
+        oldValue: boolean | number | string | undefined
+    ) {
+        const specificListeners = this.listeners.get(variableName);
+        if (specificListeners) {
+            specificListeners.forEach(callback => {
+                callback(variableName, newValue, oldValue);
+            });
+        }
+
+        const wildcardListeners = this.listeners.get('*');
+        if (wildcardListeners) {
+            wildcardListeners.forEach(callback => {
+                callback(variableName, newValue, oldValue);
+            });
+        }
+    }
