+const CACHE_TTL_MS = 5000;
+
+const cache = new Map<string, { value: any; expiresAt: number }>();
+
+function invalidateCache(pluginName: string, key: string) {
+  const cacheKey = `${pluginName}:${key}`;
+  cache.delete(cacheKey);
+}
+
+function clearPluginCache(pluginName: string) {
+  const prefix = `${pluginName}:`;
+  for (const key of cache.keys()) {
+    if (key.startsWith(prefix)) {
+      cache.delete(key);
+    }
+  }
+}
+
+ async getItem(key: string) {
+   const cacheKey = `${plugin.name}:${key}`;
+   const cached = cache.get(cacheKey);
+  
+   if (cached && Date.now() < cached.expiresAt) {
+     return cached.value;
+   }
+  
+   if (cached && Date.now() >= cached.expiresAt) {
+     cache.delete(cacheKey);
+   }
+  
+   const doc = await models.pluginData.getByKey(plugin.name, key);
+  
+   if (!doc) {
+     return null;
+   }
+  
+   let parsedValue;
+   try {
+     parsedValue = JSON.parse(doc.value);
+   } catch {
+     parsedValue = doc.value;
+   }
+  
+   cache.set(cacheKey, {
+     value: parsedValue,
+     expiresAt: Date.now() + CACHE_TTL_MS
+   });
+  
+   return parsedValue;
+ }
 
