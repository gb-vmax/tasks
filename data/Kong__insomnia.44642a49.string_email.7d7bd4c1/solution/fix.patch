+const extractEmailUsernameFromParameterName = (paramName?: string): string => {
+  if (!paramName) {
+    return 'user';
+  }
+  
+  const emailRelatedPattern = /email|mail|contact|recipient|sender/i;
+  const match = paramName.match(emailRelatedPattern);
+  
+  if (match) {
+    const beforeEmail = paramName.slice(0, match.index);
+    if (beforeEmail.length > 0) {
+      return beforeEmail
+        .replace(/[^a-zA-Z0-9]/g, '')
+        .toLowerCase() || 'user';
+    }
+  }
+  
+  const sanitized = paramName
+    .replace(/email|mail|contact|address/gi, '')
+    .replace(/[^a-zA-Z0-9]/g, '')
+    .toLowerCase();
+  
+  return sanitized.length > 0 && sanitized.length <= 64 ? sanitized : 'user';
+};
+
+ string_email: (parameter: OpenAPIV2.Parameter) => {
+   const domain = document?.host?.split(':')[0] || 'example.com';
+   const username = extractEmailUsernameFromParameterName(parameter?.name) || 'user';
+   return `${username}@${domain}`;
+ },
     'string_date-time': () => new Date().toISOString(),
