+    ancester: PropertyBase,
+    depth: number,
+    property: string,
+): PropertyBase {
+    const ancestorWithMetadata = ancester as any;
+    ancestorWithMetadata._searchMetadata = {
+        foundAtDepth: depth,
+        matchedProperty: property,
+        timestamp: Date.now(),
+    };
