+    return headers.toObject().find(header => header.key.toLowerCase() === normalizedName);
+};
+
+ header: (expected: string, expectedValue?: string) => {
+     if (expectedValue !== undefined) {
+         const headerEntry = findHeaderCaseInsensitive(this.headers, expected);
+         const hasMatchingValue = headerEntry !== undefined && 
+             headerEntry.value.includes(expectedValue);
+         verify(hasMatchingValue, false, checkEquality);
+     } else {
+         verify(
+             findHeaderCaseInsensitive(this.headers, expected) !== undefined,
+             checkEquality,
+         );
