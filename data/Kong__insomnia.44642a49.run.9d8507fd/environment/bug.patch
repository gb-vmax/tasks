+async function getResponseByMetadata(
+  context: any,
+  requestId: string,
+  environmentId: string | undefined,
+  metadata: { responseIndex: number; statusCodePattern: string | null; filter: string }
+) {
+  if (metadata.statusCodePattern) {
+    const allResponses = await context.util.models.response.findByParentId(requestId);
+    const filteredResponses = allResponses
+      .filter((r: Response) => {
+        if (!r.statusCode) return false;
+        if (environmentId && r.environmentId !== environmentId) return false;
+        return matchesStatusPattern(r.statusCode, metadata.statusCodePattern as string);
+      })
+      .sort((a: Response, b: Response) => b.created - a.created);
+
+    if (filteredResponses.length === 0) {
+      return null;
+    }
+    return filteredResponses[Math.min(metadata.responseIndex, filteredResponses.length - 1)];
+  }
+
+  if (metadata.responseIndex === 0) {
+    return await context.util.models.response.getLatestForRequestId(requestId, environmentId);
+  }
+
+  const allResponses = await context.util.models.response.findByParentId(requestId);
+  const sortedResponses = allResponses
+    .filter((r: Response) => !environmentId || r.environmentId === environmentId)
+    .sort((a: Response, b: Response) => b.created - a.created);
+
+  if (metadata.responseIndex >= sortedResponses.length) {
+    return sortedResponses[sortedResponses.length - 1] || null;
+  }
+
+  return sortedResponses[metadata.responseIndex] || null;
+}
+
+function matchesStatusPattern(statusCode: number, pattern: string): boolean {
+  if (pattern.includes('x') || pattern.includes('X')) {
+    const regexPattern = pattern
+      .replace(/x/gi, '\\d')
+      .replace(/\*/g, '\\d*');
+    const regex = new RegExp(`^${regexPattern}$`);
+    return regex.test(statusCode.toString());
+  }
+
+  if (pattern.includes('-')) {
+    const [start, end] = pattern.split('-').map(s => parseInt(s.trim(), 10));
+    if (!isNaN(start) && !isNaN(end)) {
+      return statusCode >= start && statusCode <= end;
+    }
+  }
+
+  const exactMatch = parseInt(pattern, 10);
+  if (!isNaN(exactMatch)) {
+    return statusCode === exactMatch;
+  }
+
+  return false;
+}
