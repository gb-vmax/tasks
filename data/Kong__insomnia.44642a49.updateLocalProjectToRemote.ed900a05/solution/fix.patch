+async function retryWithExponentialBackoff<T>(
+  fn: () => Promise<T>,
+  maxRetries: number,
+  initialDelayMs: number
+): Promise<T> {
+  let lastError: any;
+  
+  for (let attempt = 0; attempt <= maxRetries; attempt++) {
+    try {
+      return await fn();
+    } catch (error) {
+      lastError = error;
+      
+      if (attempt < maxRetries) {
+        const delay = initialDelayMs * Math.pow(2, attempt);
+        const jitter = Math.random() * 0.3 * delay;
+        await new Promise(resolve => setTimeout(resolve, delay + jitter));
+      }
+    }
+  }
+  
+  throw lastError;
+}
+
+async function processWorkspacesInBatches(
+  workspaces: Workspace[],
+  vcs: VCS,
+  project: Project,
+  batchSize: number
+): Promise<Array<{
+  workspaceId: string;
+  workspaceName: string;
+  success: boolean;
+  error?: string;
+}>> {
+  const results: Array<{
+    workspaceId: string;
+    workspaceName: string;
+    success: boolean;
+    error?: string;
+  }> = [];
+
+  for (let i = 0; i < workspaces.length; i += batchSize) {
+    const batch = workspaces.slice(i, i + batchSize);
+    
+    const batchResults = await Promise.allSettled(
+      batch.map(async workspace => {
+        const workspaceMeta = await getOrCreateWorkspaceMeta(workspace._id);
+
+        if (!workspaceMeta.gitRepositoryId) {
+          invariant(vcs, 'VCS must be initialized');
+
+          await initializeLocalBackendProjectAndMarkForSync({ vcs, workspace });
+          await pushSnapshotOnInitialize({ vcs, workspace, project });
+        }
+
+        return {
+          workspaceId: workspace._id,
+          workspaceName: workspace.name,
+          success: true,
+        };
+      })
+    );
+
+    for (let j = 0; j < batchResults.length; j++) {
+      const result = batchResults[j];
+      const workspace = batch[j];
+
+      if (result.status === 'fulfilled') {
+        results.push(result.value);
+      } else {
+        console.warn('Failed to initialize sync on workspace. This will be retried when the workspace is opened on the app.', result.reason);
+        results.push({
+          workspaceId: workspace._id,
+          workspaceName: workspace.name,
+          success: false,
+          error: result.reason?.message || 'Unknown error',
+        });
+      }
+    }
+  }
+
+  return results;
+}
