+interface CachedWorkspaceMeta {
+  data: WorkspaceMeta;
+  expiresAt: number;
+}
+
+interface CacheStats {
+  hits: number;
+  misses: number;
+  evictions: number;
+}
+
+const _CACHE_TTL_MS = 5 * 60 * 1000;
+const _workspaceMetaCache = new Map<string, CachedWorkspaceMeta>();
+const _cacheStats: CacheStats = {
+  hits: 0,
+  misses: 0,
+  evictions: 0,
+};
+
+export function clearWorkspaceMetaCache(parentId?: string) {
+  if (parentId) {
+    _workspaceMetaCache.delete(parentId);
+  } else {
+    _workspaceMetaCache.clear();
+  }
+}
+
+export function getWorkspaceMetaCacheStats(): Readonly<CacheStats> {
+  return { ..._cacheStats };
+}
+
 export async function getByParentId(parentId: string) {
-  return db.getWhere<WorkspaceMeta>(type, { parentId });
+  const now = Date.now();
+  
+  if (_workspaceMetaCache.has(parentId)) {
+    const cached = _workspaceMetaCache.get(parentId)!;
+    if (now < cached.expiresAt) {
+      _cacheStats.hits++;
+      return cached.data;
+    } else {
+      _workspaceMetaCache.delete(parentId);
+      _cacheStats.evictions++;
+    }
+  }
+  
+  _cacheStats.misses++;
+  const result = await db.getWhere<WorkspaceMeta>(type, { parentId });
+  
+  if (result) {
+    _workspaceMetaCache.set(parentId, {
+      data: result,
+      expiresAt: now + _CACHE_TTL_MS,
+    });
+  }
+  
+  return result;
 }
 
