+function inferPrefixFromContext(): string {
+  try {
+    const stack = new Error().stack || '';
+    const lines = stack.split('\n');
+    
+    for (const line of lines) {
+      if (line.includes('mergeConflictSchema')) return 'mergeConflict';
+      if (line.includes('statusCandidateSchema')) return 'statusCandidate';
+      if (line.includes('snapshotStateEntrySchema')) return 'snapshotStateEntry';
+      if (line.includes('projectSchema')) return 'project';
+      if (line.includes('teamSchema')) return 'team';
+      if (line.includes('branchSchema')) return 'branch';
+    }
+    
+    return '';
+  } catch {
+    return '';
+  }
+}
+
+ name: (() => {
+   let counter = 0;
+   return (prefix?: string) => {
+     counter++;
+     const contextPrefix = prefix || inferPrefixFromContext();
+     return contextPrefix ? `${contextPrefix}_${counter}` : `name_${counter}`;
+   };
+ })(),
 };
