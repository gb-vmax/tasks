@@ -450,7 +450,54 @@ const generateParameterExample = (
     string: () => 'string',
     string_email: () => 'user@example.com',
     'string_date-time': () => new Date().toISOString(),
-    string_byte: () => 'ZXhhbXBsZQ==',
+const isValidBase64 = (str: unknown): boolean => {
+  if (typeof str !== 'string') {
+    return false;
+  }
+  
+  try {
+    const decoded = Buffer.from(str, 'base64').toString('base64');
+    return decoded === str;
+  } catch (err) {
+    return false;
+  }
+};
+
+const generateBase64WithLength = (minLength?: number, maxLength?: number): string => {
+  const targetLength = maxLength !== undefined 
+    ? maxLength 
+    : minLength !== undefined 
+    ? minLength 
+    : 12;
+  
+  const decodedLength = Math.ceil((targetLength * 3) / 4);
+  const buffer = Buffer.alloc(decodedLength);
+  
+  for (let i = 0; i < decodedLength; i++) {
+    buffer[i] = 65 + (i % 26);
+  }
+  
+  return buffer.toString('base64').substring(0, targetLength);
+};
+
+ string_byte: (parameter: OpenAPIV2.Parameter) => {
+   if (parameter?.example && isValidBase64(parameter.example)) {
+     return parameter.example;
+   }
+  
+   if (parameter?.default && isValidBase64(parameter.default)) {
+     return parameter.default;
+   }
+  
+   const minLength = parameter?.minLength;
+   const maxLength = parameter?.maxLength;
+  
+   if (minLength !== undefined || maxLength !== undefined) {
+     return generateBase64WithLength(minLength, maxLength);
+   }
+  
+   return 'ZXhhbXBsZQ==';
+ },
     number: () => 0,
     number_float: () => 0.0,
     number_double: () => 0.0,
