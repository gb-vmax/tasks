+function validateAndNormalizeCookies(cookies: Cookie[]): Cookie[] {
+  return cookies.map(cookie => {
+    if (!cookie.id) {
+      cookie.id = uuidv4();
+    }
+    
+    if (!cookie.key) {
+      throw new Error(`Cookie missing required field \`key\``);
+    }
+    
+    if (cookie.domain === undefined || cookie.domain === null) {
+      throw new Error(`Cookie missing required field \`domain\``);
+    }
+    
+    if (cookie.path === undefined) {
+      cookie.path = '/';
+    }
+    
+    if (cookie.secure === undefined) {
+      cookie.secure = false;
+    }
+    
+    if (cookie.httpOnly === undefined) {
+      cookie.httpOnly = false;
+    }
+    
+    return cookie;
+  });
+}
