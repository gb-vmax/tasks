+interface WrapperModalOptions {
+  title: ReactNode;
+  body: ReactNode;
+  tall?: boolean;
+  skinny?: boolean;
+  wide?: boolean;
+  onBeforeShow?: () => void;
+  onAfterShow?: () => void;
+  cleanup?: () => void;
+}
+
+const cleanupRef = useRef<(() => void) | null>(null);
+
+useImperativeHandle(ref, () => ({
+  hide: () => {
+    if (cleanupRef.current) {
+      cleanupRef.current();
+      cleanupRef.current = null;
+    }
+    modalRef.current?.hide();
+  },
+  show: options => {
+    if (options.onBeforeShow) {
+      options.onBeforeShow();
+    }
+    
+    setState(prevState => ({
+      ...options,
+      onAfterShow: undefined,
+      onBeforeShow: undefined,
+    }));
+    
+    if (options.cleanup) {
+      cleanupRef.current = options.cleanup;
+    }
+    
+    modalRef.current?.show();
+    
+    if (options.onAfterShow) {
+      setTimeout(() => {
+        options.onAfterShow?.();
+      }, 0);
+    }
+  },
+}), []);
+
+ show: options => {
+   if (options.onBeforeShow) {
+     options.onBeforeShow();
+   }
+  
+   setState(prevState => ({
+     ...options,
+     onAfterShow: undefined,
+     onBeforeShow: undefined,
+   }));
+  
+   if (options.cleanup) {
+     cleanupRef.current = options.cleanup;
+   }
+  
+   modalRef.current?.show();
+  
+   if (options.onAfterShow) {
+     setTimeout(() => {
+       options.onAfterShow?.();
+     }, 0);
+   }
+ },
   }), []);
 
