+export function getByParentId(workspaceId: string, options: { contentType?: 'json' | 'yaml'; sortBy?: 'modified' | 'created' } = {}) {
+  return db.getWhere<ApiSpec>(type, { parentId: workspaceId }).then(specs => {
+    let filtered = specs;
+    
+    if (options.contentType) {
+      filtered = specs.filter(spec => spec.contentType === options.contentType);
+    }
+    
+    const sortField = options.sortBy || 'modified';
+    return filtered.sort((a, b) => b[sortField] - a[sortField]);
+  });
 }
 
