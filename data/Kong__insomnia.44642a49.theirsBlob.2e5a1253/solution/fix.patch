+function generateBlobId(seed: string): string {
+  let hash = 0;
+  for (let i = 0; i < seed.length; i++) {
+    const char = seed.charCodeAt(i);
+    hash = ((hash << 5) - hash) + char;
+    hash = hash & hash;
+  }
+  
+  const baseHash = Math.abs(hash).toString(16).padStart(8, '0');
+  const repeated = (baseHash + baseHash + baseHash + baseHash + baseHash).substring(0, 40);
+  return repeated;
+}
