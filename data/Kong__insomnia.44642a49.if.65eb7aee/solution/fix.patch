+private _calculateMatchSpecificity(proxyConfig: ProxyConfig, url: string): number {
+    let score = 0;
+    
+    const protocols = proxyConfig.getProtocols();
+    score += protocols.length * 10;
+    
+    const match = proxyConfig.match;
+    const pathPart = match.substring(match.indexOf('://') + 3);
+    
+    const wildcardCount = (pathPart.match(/\*/g) || []).length;
+    score -= wildcardCount * 5;
+    
+    const pathSegments = pathPart.split('/').filter(s => s.length > 0 && s !== '*');
+    score += pathSegments.length * 20;
+    
+    const hasExactDomain = !pathPart.startsWith('*') && pathPart.includes('.');
+    if (hasExactDomain) {
+        score += 30;
+    }
+    
+    const urlLower = url.toLowerCase();
+    const matchLower = match.toLowerCase();
+    if (urlLower.includes(matchLower.split('*')[0].substring(matchLower.indexOf('://') + 3))) {
+        score += 15;
+    }
+    
+    return score;
+}
