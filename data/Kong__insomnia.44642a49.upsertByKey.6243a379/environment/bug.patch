+interface ValueMetadata {
+  previousValue: string | null;
+  lastModified: number;
+  updateCount: number;
+}
+
+function serializeValueWithMetadata(value: string, metadata: ValueMetadata): string {
+  try {
+    const wrapper = {
+      __meta: metadata,
+      __value: value,
+    };
+    return JSON.stringify(wrapper);
+  } catch {
+    return value;
+  }
+}
+
+function parseMetadata(storedValue: string): Partial<ValueMetadata> {
+  try {
+    const parsed = JSON.parse(storedValue);
+    if (parsed && typeof parsed === 'object' && '__meta' in parsed) {
+      return parsed.__meta || {};
+    }
+  } catch {
+  }
+  return {};
+}
+
+function extractActualValue(storedValue: string): string {
+  try {
+    const parsed = JSON.parse(storedValue);
+    if (parsed && typeof parsed === 'object' && '__value' in parsed) {
+      return parsed.__value;
+    }
+  } catch {
+  }
+  return storedValue;
+}
