+const generateDeterministicBoolean = (schema?: OpenAPIV3.SchemaObject): boolean => {
+  if (!schema) {
+    return true;
+  }
+  
+  const seed = schema.description || schema.title || '';
+  
+  if (!seed) {
+    return true;
+  }
+  
+  let hash = 0;
+  for (let i = 0; i < seed.length; i++) {
+    const char = seed.charCodeAt(i);
+    hash = ((hash << 5) - hash) + char;
+    hash = hash & hash;
+  }
+  
+  return Math.abs(hash) % 2 === 0;
+}
