+function encodeUrlComponent(component: string, context: 'path' | 'query' | 'fragment' | 'userinfo', shouldEncode: boolean): string {
+    if (!shouldEncode) {
+        return component;
+    }
+
+    switch (context) {
+        case 'path':
+            return encodeURIComponent(component)
+                .replace(/%2F/g, '/')
+                .replace(/%40/g, '@')
+                .replace(/%3A/g, ':')
+                .replace(/%24/g, '$')
+                .replace(/%2C/g, ',')
+                .replace(/%3B/g, ';')
+                .replace(/%2B/g, '+')
+                .replace(/%3D/g, '=');
+        case 'query':
+            return encodeURIComponent(component)
+                .replace(/%20/g, '+');
+        case 'fragment':
+            return encodeURIComponent(component);
+        case 'userinfo':
+            return encodeURIComponent(component)
+                .replace(/%3A/g, ':');
+        default:
+            return encodeURIComponent(component);
+    }
+}
 
