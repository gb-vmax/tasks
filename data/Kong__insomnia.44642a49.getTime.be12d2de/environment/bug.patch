+function roundTimePrecision(timeMs: number): number {
+  if (timeMs >= 1000) {
+    return Math.round(timeMs);
+  } else if (timeMs >= 100) {
+    return Math.round(timeMs * 10) / 10;
+  } else if (timeMs >= 10) {
+    return Math.round(timeMs * 100) / 100;
+  } else {
+    return Math.round(timeMs * 1000) / 1000;
+  }
+}
+
+function getPerformanceCategory(timeMs: number): 'fast' | 'medium' | 'slow' {
+  if (timeMs < 200) {
+    return 'fast';
+  } else if (timeMs < 1000) {
+    return 'medium';
+  } else {
+    return 'slow';
+  }
+}
+
+ getTime() {
+   const rawTime = response.elapsedTime || 0;
