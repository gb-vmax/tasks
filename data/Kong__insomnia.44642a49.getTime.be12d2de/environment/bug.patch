+   if (!response._timeCache || response._timeCache.raw !== rawTime) {
+     const category = getPerformanceCategory(rawTime);
+     const rounded = roundTimePrecision(rawTime);
+    
+     response._timeCache = {
+       raw: rawTime,
+       rounded: rounded,
+       category: category,
+       lastAccessed: Date.now()
+     };
+   }
+  
+   response._timeCache.lastAccessed = Date.now();
