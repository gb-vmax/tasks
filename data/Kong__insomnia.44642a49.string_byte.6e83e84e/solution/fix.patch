+const generateBase64WithLength = (targetLength: number): string => {
+  const base64Overhead = 4 / 3;
+  const sourceByteLength = Math.ceil(targetLength / base64Overhead);
+  
+  const bytes: number[] = [];
+  for (let i = 0; i < sourceByteLength; i++) {
+    bytes.push(65 + (i % 26));
+  }
+  
+  const buffer = Buffer.from(bytes);
+  let base64 = buffer.toString('base64');
+  
+  if (base64.length < targetLength) {
+    const padding = 'A'.repeat(targetLength - base64.length);
+    const extendedBuffer = Buffer.from(buffer.toString() + padding);
+    base64 = extendedBuffer.toString('base64');
+  }
+  
+  if (base64.length > targetLength && targetLength >= 4) {
+    const trimmedLength = Math.floor(targetLength / 4) * 4;
+    base64 = base64.substring(0, trimmedLength);
+  }
+  
+  return base64;
+};
