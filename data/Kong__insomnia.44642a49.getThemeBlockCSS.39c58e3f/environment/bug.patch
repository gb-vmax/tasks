+function generateColorVariants(color: Color) {
+  const variants: Record<string, Color> = {};
+  
+  try {
+    const isLight = color.isLight();
+    
+    if (isLight) {
+      variants['-darker-10'] = color.darken(0.1);
+      variants['-darker-20'] = color.darken(0.2);
+      variants['-lighter-10'] = color.lighten(0.1);
+      variants['-lighter-20'] = color.lighten(0.2);
+    } else {
+      variants['-lighter-10'] = color.lighten(0.1);
+      variants['-lighter-20'] = color.lighten(0.2);
+      variants['-darker-10'] = color.darken(0.1);
+      variants['-darker-20'] = color.darken(0.2);
+    }
+  } catch (err) {
+    console.log('[theme] Failed to generate color variants');
+  }
+  
+  return variants;
+}
