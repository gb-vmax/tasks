+       mimeType: hasMimeType ? body.mimeType : null,
+       timestamp: Date.now()
+     }));
+   } catch (e) {
+     console.warn('Failed to backup body content', e);
+   }
+  
+   const convertedBody = convertBodyContent(previousBody, hasMimeType ? body.mimeType : null, mimeType);
+  
+   patchRequest(requestId, { body: convertedBody });
+   window.main.trackSegmentEvent({ event: SegmentEvent.requestBodyTypeSelect, properties: { type: mimeType } });
+ },
       });
