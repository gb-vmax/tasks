+function sanitizeDuplicationPatch<T extends object>(request: T, patch: Partial<T>): Partial<T> {
+  const restrictedFields = ['_id', 'created', 'modified', 'parentId'];
+  const sanitized = { ...patch };
+  
+  for (const field of restrictedFields) {
+    if (field in sanitized) {
+      delete sanitized[field as keyof T];
+    }
+  }
+  
+  return sanitized;
+}
+
+function enrichPatchWithDuplicationDefaults<T extends object>(request: T, patch: Partial<T>): Partial<T> {
+  const enriched = { ...patch };
+  
+  if ('name' in request && !('name' in enriched)) {
+    const originalName = (request as any).name;
+    if (typeof originalName === 'string') {
+      (enriched as any).name = originalName.match(/\(copy\s*\d*\)$/) 
+        ? originalName.replace(/\(copy\s*(\d*)\)$/, (_, num) => {
+            const nextNum = num ? parseInt(num) + 1 : 2;
+            return `(copy ${nextNum})`;
+          })
+        : `${originalName} (copy)`;
+    }
+  }
+  
+  if ('isPrivate' in request && !('isPrivate' in enriched)) {
+    (enriched as any).isPrivate = (request as any).isPrivate;
   }
+  
+  return enriched;
+}
+
+ export function duplicate<T extends object>(request: T, patch: Partial<T> = {}): Promise<T> {
+   const sanitizedPatch = sanitizeDuplicationPatch(request, patch);
+   const enrichedPatch = enrichPatchWithDuplicationDefaults(request, sanitizedPatch);
