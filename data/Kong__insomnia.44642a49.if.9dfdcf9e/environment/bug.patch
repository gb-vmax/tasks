+     // @ts-expect-error -- TSCONVERSION
+     return models.webSocketRequest.duplicate(request, enrichedPatch);
+   }
+   // @ts-expect-error -- TSCONVERSION
+   return models.request.duplicate(request, enrichedPatch);
+ }
