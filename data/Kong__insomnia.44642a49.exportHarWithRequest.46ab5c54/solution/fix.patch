+interface ExportCacheEntry {
+  harRequest: Har.Request;
+  timestamp: number;
+}
+
+const _exportCache = new Map<string, ExportCacheEntry>();
+const _pluginTrackingMap = new WeakMap<Har.Request, string[]>();
+
+function _generateExportCacheKey(
+  request: Request,
+  environmentId?: string,
+  addContentLength?: boolean,
+): string {
+  return `${request._id}:${environmentId || 'none'}:${addContentLength ? '1' : '0'}`;
+}
+
+async function _applyRequestPluginHooksWithTracking(
+  renderedRequest: RenderedRequest,
+  renderedContext: Record<string, any>,
+  pluginModifications: string[],
+): Promise<RenderedRequest> {
+  let newRenderedRequest = renderedRequest;
+
+  for (const { plugin, hook } of await plugins.getRequestHooks()) {
+    const previousRequest = clone(newRenderedRequest);
+    newRenderedRequest = clone(newRenderedRequest);
+    const context = {
+      ...(pluginContexts.app.init() as Record<string, any>),
+      ...(pluginContexts.request.init(newRenderedRequest, renderedContext) as Record<string, any>),
+      ...(pluginContexts.store.init(plugin) as Record<string, any>),
+    };
+
+    try {
+      await hook(context);
+      
+      if (JSON.stringify(previousRequest) !== JSON.stringify(newRenderedRequest)) {
+        pluginModifications.push(plugin.name);
+      }
+    } catch (err) {
+      err.plugin = plugin;
+      throw err;
+    }
+  }
+
+  return newRenderedRequest;
+}
+
+export function getPluginModifications(harRequest: Har.Request): string[] {
+  return _pluginTrackingMap.get(harRequest) || [];
+}
+
+export function clearExportCache(): void {
+  _exportCache.clear();
+}
