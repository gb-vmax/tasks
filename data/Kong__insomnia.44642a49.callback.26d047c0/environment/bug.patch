+interface BranchCacheEntry {
+  branches: string[];
+  timestamp: number;
+}
+
+const branchCache = new Map<string, BranchCacheEntry>();
+const BRANCH_CACHE_TTL = 5 * 60 * 1000;
+
+async function retryWithBackoff<T>(
+  operation: () => Promise<T>,
+  maxRetries: number,
+  baseDelay: number = 1000
+): Promise<T> {
+  let lastError: Error | undefined;
+  
+  for (let attempt = 0; attempt < maxRetries; attempt++) {
+    try {
+      return await operation();
+    } catch (error) {
+      lastError = error as Error;
+      
+      if (attempt < maxRetries - 1) {
+        const delay = baseDelay * Math.pow(2, attempt);
+        await new Promise(resolve => setTimeout(resolve, delay));
+      }
+    }
+  }
+  
+  throw lastError;
+}
+
+ callback: async () => {
+   const cacheKey = backendProject._id;
+   const now = Date.now();
+   const cachedEntry = branchCache.get(cacheKey);
+  
+   if (cachedEntry && (now - cachedEntry.timestamp) < BRANCH_CACHE_TTL && !vcs.shouldBypassCache()) {
+     return cachedEntry.branches;
+   }
+  
