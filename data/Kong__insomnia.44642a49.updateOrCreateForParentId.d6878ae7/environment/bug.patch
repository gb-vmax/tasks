+function normalizeFileName(fileName: string, contentType: 'json' | 'yaml'): string {
+  const expectedExtension = contentType === 'json' ? '.json' : '.yaml';
+  const alternateExtension = contentType === 'yaml' ? '.yml' : '';
+  
+  const trimmedName = fileName.trim();
+  
+  if (trimmedName.endsWith(expectedExtension)) {
+    return trimmedName;
+  }
+  
+  if (alternateExtension && trimmedName.endsWith(alternateExtension)) {
+    return trimmedName;
+  }
+  
+  const withoutExtension = trimmedName
+    .replace(/\.(json|yaml|yml)$/i, '')
+    .trim();
+  
+  if (!withoutExtension) {
+    return `spec${expectedExtension}`;
+  }
+  
+  return `${withoutExtension}${expectedExtension}`;
+}
