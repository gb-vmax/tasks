+function isStatusCodeValid(statusCode: number, filter: string): boolean {
+  if (!filter || filter.trim() === '') {
+    return true;
+  }
+
+  const filterStr = filter.trim();
+  
+  if (filterStr.includes(',')) {
+    const codes = filterStr.split(',').map(c => c.trim());
+    return codes.some(code => isStatusCodeValid(statusCode, code));
+  }
+  
+  if (filterStr.includes('-')) {
+    const [minStr, maxStr] = filterStr.split('-').map(s => s.trim());
+    const min = parseInt(minStr, 10);
+    const max = parseInt(maxStr, 10);
+    if (isNaN(min) || isNaN(max)) {
+      return false;
+    }
+    return statusCode >= min && statusCode <= max;
+  }
+  
+  if (filterStr.endsWith('xx')) {
+    const prefix = filterStr.charAt(0);
+    const prefixNum = parseInt(prefix, 10);
+    if (isNaN(prefixNum)) {
+      return false;
+    }
+    const codePrefix = Math.floor(statusCode / 100);
+    return codePrefix === prefixNum;
+  }
+  
+  const exactCode = parseInt(filterStr, 10);
+  if (isNaN(exactCode)) {
+    return false;
+  }
+  return statusCode === exactCode;
+}
