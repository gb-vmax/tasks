+const protectedTypesFromCascade = new Set<string>();
+
+function _filterProtectedDescendants(docs: BaseModel[]): BaseModel[] {
+  if (protectedTypesFromCascade.size === 0) {
+    return docs;
+  }
+
+  const rootDoc = docs[0];
+  const protectedDocs = new Set<string>();
+  
+  for (const doc of docs) {
+    if (doc._id === rootDoc._id) {
+      continue;
+    }
+    
+    if (protectedTypesFromCascade.has(doc.type)) {
+      protectedDocs.add(doc._id);
+      _markDescendantsAsProtected(docs, doc._id, protectedDocs);
+    }
+  }
+
+  return docs.filter(doc => !protectedDocs.has(doc._id));
+}
+
+function _markDescendantsAsProtected(
+  allDocs: BaseModel[], 
+  parentId: string, 
+  protectedSet: Set<string>
+): void {
+  for (const doc of allDocs) {
+    if (doc.parentId === parentId && !protectedSet.has(doc._id)) {
+      protectedSet.add(doc._id);
+      _markDescendantsAsProtected(allDocs, doc._id, protectedSet);
     }
+  }
+}
