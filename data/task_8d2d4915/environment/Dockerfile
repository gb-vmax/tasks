FROM endless-base:latest
RUN <<'ENDSETUP'
#!/bin/bash
set -e

# Create the directory structure
mkdir -p /home/user/services/api-gateway

# Create the source config.env file with exact expected content
cat > /home/user/services/api-gateway/config.env << 'EOF'
# API Gateway environment config
# Generated by dev team

APP_NAME=api-gateway
APP_PORT=8080
DEBUG=true
DEV_MODE=1

DB_HOST=postgres.internal
DB_PORT=5432
DB_PASSWORD=s3cur3p@ss!
DB_USER=gateway_user

LEGACY_AUTH_TOKEN=abc123oldtoken

JWT_SECRET=supersecretkey99
API_KEY=public-facing-key-ok
STRIPE_TOKEN=sk_live_ABC123XYZ

LOG_LEVEL=info
MAX_CONNECTIONS=100
EOF

# Do NOT create config.compliant.env or audit.log — the agent will create those

chown -R user:user /home/user
ENDSETUP

WORKDIR /home/user
