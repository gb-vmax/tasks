+const calculatePerformanceMetrics = (tests: Test[], totalDuration?: number) => {
+  const testsWithDuration = tests.filter(test => test.duration !== undefined);
+  
+  if (testsWithDuration.length === 0) {
+    return {
+      totalDuration,
+      averageTestDuration: 0,
+      slowestTests: [],
+    };
   }
+
+  const totalTestDuration = testsWithDuration.reduce(
+    (sum, test) => sum + (test.duration || 0),
+    0
+  );
+  const averageTestDuration = totalTestDuration / testsWithDuration.length;
+
+  const slowestTests = [...testsWithDuration]
+    .sort((a, b) => (b.duration || 0) - (a.duration || 0))
+    .slice(0, 5)
+    .map(test => ({
+      title: test.fullTitle(),
+      duration: test.duration,
+      file: test.file,
+    }));
+
+  return {
+    totalDuration,
+    averageTestDuration: Math.round(averageTestDuration * 100) / 100,
+    slowestTests,
+  };
+};
+
+ constructor(runner: Runner & { testResults?: TestResults }, options: MochaOptions) {
+   super(runner, options);
+
+   Mocha.reporters.Base.call(this, runner, options);
+   const self = this;
+   const tests: Test[] = [];
+   const pending: Test[] = [];
+   const failures: Test[] = [];
+   const passes: Test[] = [];
+   let suiteStartTime: number;
+
+   runner.once(Mocha.Runner.constants.EVENT_RUN_BEGIN, () => {
+     suiteStartTime = Date.now();
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_END, test => {
+     tests.push(test);
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_PASS, test => {
+     passes.push(test);
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_FAIL, test => {
+     failures.push(test);
+   });
+
+   runner.on(Mocha.Runner.constants.EVENT_TEST_PENDING, test => {
+     pending.push(test);
+   });
+
+   runner.once(Mocha.Runner.constants.EVENT_RUN_END, () => {
+     const suiteEndTime = Date.now();
+     const totalDuration = suiteStartTime ? suiteEndTime - suiteStartTime : undefined;
+     const performanceMetrics = calculatePerformanceMetrics(tests, totalDuration);
+
+     runner.testResults = {
+       stats: self.stats,
+       tests: tests.map(clean),
+       pending: pending.map(clean),
+       failures: failures.map(clean),
+       passes: passes.map(clean),
+       performance: performanceMetrics,
+     };
+   });
+ }
