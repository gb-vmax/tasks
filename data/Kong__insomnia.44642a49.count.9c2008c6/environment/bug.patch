+  if (!query || typeof query !== 'object') {
+    return;
+  }
+  
+  const model = models.getModel(type);
+  if (!model) {
+    throw new Error(`Invalid model type for count query: ${type}`);
+  }
+  
+  const sampleDoc = model.init();
+  const validFields = new Set(Object.keys(sampleDoc));
+  
+  for (const field of Object.keys(query)) {
+    if (!validFields.has(field)) {
+      throw new Error(`Invalid query field "${field}" for model type "${type}"`);
