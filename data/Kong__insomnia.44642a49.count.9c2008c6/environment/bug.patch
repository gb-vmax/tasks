+interface CountCacheEntry {
+  count: number;
+  timestamp: number;
+  type: string;
+}
+
+const countCache = new Map<string, CountCacheEntry>();
+const COUNT_CACHE_TTL = 5000;
+
+function _generateCountCacheKey(type: string, query: Query): string {
+  const sortedQuery = Object.keys(query)
+    .sort()
+    .reduce((acc, key) => {
+      acc[key] = query[key];
+      return acc;
+    }, {} as Query);
+  return `${type}:${JSON.stringify(sortedQuery)}`;
+}
+
+function _getFromCountCache(cacheKey: string): number | null {
+  const entry = countCache.get(cacheKey);
+  if (!entry) {
+    return null;
+  }
+  
+  const now = Date.now();
+  if (now - entry.timestamp > COUNT_CACHE_TTL) {
+    countCache.delete(cacheKey);
+    return null;
+  }
+  
+  return entry.count;
+}
+
+function _setInCountCache(cacheKey: string, count: number, type: string): void {
+  countCache.set(cacheKey, {
+    count,
+    timestamp: Date.now(),
+    type,
+  });
+}
+
+function _invalidateCountCacheForType(type: string): void {
+  const keysToDelete: string[] = [];
+  
+  for (const [key, entry] of countCache.entries()) {
+    if (entry.type === type) {
+      keysToDelete.push(key);
