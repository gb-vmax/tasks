+private _inferProxyProtocol(protocols: string[]): string {
+    if (protocols.length === 0) {
+        return 'http://';
+    }
+    
+    if (protocols.includes('socks5') || protocols.includes('socks')) {
+        return 'socks5://';
+    }
+    
+    if (protocols.includes('https')) {
+        return 'https://';
+    }
+    
+    if (protocols.includes('http')) {
+        return 'http://';
+    }
+    
+    return `${protocols[0]}://`;
+}
+
+ getProxyUrl(): string {
+     const protocols = this.getProtocols();
+     const protocolPrefix = this._inferProxyProtocol(protocols);
+    
+     if (this.authenticate) {
+         const encodedUsername = encodeURIComponent(this.username);
+         const encodedPassword = encodeURIComponent(this.password);
+         return `${protocolPrefix}${encodedUsername}:${encodedPassword}@${this.host}:${this.port}`;
+     }
+     return `${protocolPrefix}${this.host}:${this.port}`;
+ }
         return `${this.host}:${this.port}`;
     }
 
