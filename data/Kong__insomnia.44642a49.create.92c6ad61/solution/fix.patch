+  
+  const existingSuites = db.getWhere<UnitTestSuite>(type, { parentId: patch.parentId });
+  const uniqueName = generateUniqueName(mergedPatch.name, existingSuites);
+  
+  return db.docCreate<UnitTestSuite>(type, { ...mergedPatch, name: uniqueName });
 }
 
