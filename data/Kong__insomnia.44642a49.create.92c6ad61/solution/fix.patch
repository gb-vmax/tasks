+function generateUniqueName(baseName: string, existingSuites: UnitTestSuite[]): string {
+  const existingNames = new Set(existingSuites.map(suite => suite.name));
+  
+  if (!existingNames.has(baseName)) {
+    return baseName;
+  }
+  
+  let counter = 2;
+  let candidateName = `${baseName} (${counter})`;
+  
+  while (existingNames.has(candidateName)) {
+    counter++;
+    candidateName = `${baseName} (${counter})`;
+  }
+  
+  return candidateName;
+}
