+const getInputHistory = (key: string): string[] => {
+  try {
+    const stored = localStorage.getItem(key);
+    return stored ? JSON.parse(stored) : [];
+  } catch {
+    return [];
+  }
+};
+
+const saveInputHistory = (key: string, value: string): void => {
+  try {
+    const history = getInputHistory(key);
+    const filtered = history.filter(v => v !== value);
+    const updated = [value, ...filtered].slice(0, 5);
+    localStorage.setItem(key, JSON.stringify(updated));
+  } catch {
+    // Silently fail if localStorage is not available
+  }
+};
+
+const mergeHintsWithHistory = (hints: string[] | undefined, history: string[], defaultValue?: string): string[] => {
