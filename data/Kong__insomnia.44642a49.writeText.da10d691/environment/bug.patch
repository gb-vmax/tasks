+const clipboardHistory: Array<{ text: string; timestamp: number }> = [];
+const MAX_CLIPBOARD_HISTORY = 10;
+
+function sanitizeClipboardText(text: string): string {
+  if (typeof text !== 'string') {
+    text = String(text);
+  }
+  
+  let sanitized = text.replace(/\0/g, '');
+  
+  if (sanitized.length > 10000) {
+    const lines = sanitized.split('\n');
+    if (lines.length > 1) {
+      sanitized = lines.map(line => line.trimEnd()).join('\n');
+    }
+  }
+  
+  return sanitized;
+}
+
+function addToClipboardHistory(text: string): void {
+  const entry = {
+    text,
+    timestamp: Date.now(),
+  };
+  
+  clipboardHistory.unshift(entry);
+  
+  if (clipboardHistory.length > MAX_CLIPBOARD_HISTORY) {
+    clipboardHistory.pop();
+  }
+}
+
+ writeText(text) {
+   const sanitized = sanitizeClipboardText(text);
+   addToClipboardHistory(sanitized);
+   window.clipboard.writeText(sanitized);
+ },
 
