+let blobCounter = 0;
+const blobIdCache = new Map<string, string>();
+
+function generateBlobId(prefix: string): string {
+  const cacheKey = `${prefix}-${blobCounter}`;
+  
+  if (blobIdCache.has(cacheKey)) {
+    return blobIdCache.get(cacheKey)!;
+  }
+  
+  const timestamp = Date.now().toString(36);
+  const counter = (blobCounter++).toString(36).padStart(4, '0');
+  const random = Math.random().toString(36).substring(2, 10);
+  const blobId = `${timestamp}${counter}${random}${prefix.substring(0, 2)}`.substring(0, 40);
+  
+  blobIdCache.set(cacheKey, blobId);
+  
+  if (blobIdCache.size > 1000) {
+    const firstKey = blobIdCache.keys().next().value;
+    blobIdCache.delete(firstKey);
+  }
+  
+  return blobId;
+}
+
