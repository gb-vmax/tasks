+registerDialogCallback(callback: (attempt: any) => void): () => void {
+  if (!this._dialogCallbacks) {
+    this._dialogCallbacks = [];
+  }
+  this._dialogCallbacks.push(callback);
+  
+  return () => {
+    const index = this._dialogCallbacks.indexOf(callback);
+    if (index > -1) {
+      this._dialogCallbacks.splice(index, 1);
+    }
+  };
+}
