+const generateNumberWithConstraints = (parameter: OpenAPIV2.Parameter): number => {
+  const { minimum, maximum, exclusiveMinimum, exclusiveMaximum, multipleOf } = parameter;
+  
+  let min = minimum;
+  let max = maximum;
+  
+  if (exclusiveMinimum === true && min !== undefined) {
+    min = min + (multipleOf || 1);
+  }
+  
+  if (exclusiveMaximum === true && max !== undefined) {
+    max = max - (multipleOf || 1);
+  }
+  
+  let value: number;
+  
+  if (min !== undefined && max !== undefined) {
+    value = min + (max - min) / 2;
+  } else if (min !== undefined) {
+    value = min + 10;
+  } else if (max !== undefined) {
+    value = max - 10;
+  } else {
+    value = 0;
+  }
+  
+  if (multipleOf !== undefined && multipleOf > 0) {
+    value = Math.round(value / multipleOf) * multipleOf;
+    
+    if (min !== undefined && value < min) {
+      value = Math.ceil(min / multipleOf) * multipleOf;
+    }
+    if (max !== undefined && value > max) {
+      value = Math.floor(max / multipleOf) * multipleOf;
+    }
+  }
+  
+  return value;
+};
+
+ number: (parameter: OpenAPIV2.Parameter) => {
