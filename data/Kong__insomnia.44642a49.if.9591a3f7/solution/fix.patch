+async function _checkDuplicateId<T extends BaseModel>(type: string, id: string): Promise<T | null> {
+  try {
+    return await new Promise<T | null>((resolve, reject) => {
+      (db[type] as NeDB<T>).findOne({ _id: id }, (err, doc) => {
+        if (err) {
+          return reject(err);
+        }
+        resolve(doc);
+      });
+    });
+  } catch (err) {
+    return null;
+  }
+}
+
+function _isRetriableError(err: any): boolean {
+  if (!err) {
+    return false;
+  }
+  
+  const retriablePatterns = [
+    /EBUSY/i,
+    /EAGAIN/i,
+    /ETIMEDOUT/i,
+    /lock/i,
+    /busy/i,
+    /timeout/i,
+  ];
+  
+  const errorMessage = err.message || err.toString();
+  return retriablePatterns.some(pattern => pattern.test(errorMessage));
+}
+
+function _delay(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
