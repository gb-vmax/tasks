-    string: () => 'string',
+const generateStringWithLength = (minLength?: number, maxLength?: number): string => {
+  const baseString = 'string';
+  const min = minLength || 0;
+  const max = maxLength || min;
+  
+  if (max > 0 && max < baseString.length) {
+    return baseString.substring(0, max);
+  }
+  
+  if (min > baseString.length) {
+    const repeatCount = Math.ceil(min / baseString.length);
+    const repeated = baseString.repeat(repeatCount);
+    return maxLength !== undefined && maxLength < repeated.length 
+      ? repeated.substring(0, maxLength)
+      : repeated.substring(0, min);
+  }
+  
+  return baseString;
+};
+
+ string: (parameter?: OpenAPIV2.Parameter) => {
+   if (parameter && typeof parameter === 'object') {
+     if (parameter.enum && parameter.enum.length > 0) {
+       return parameter.enum[0];
+     }
+    
+     if (parameter.minLength !== undefined || parameter.maxLength !== undefined) {
+       return generateStringWithLength(parameter.minLength, parameter.maxLength);
+     }
+   }
+   return 'string';
+ },
