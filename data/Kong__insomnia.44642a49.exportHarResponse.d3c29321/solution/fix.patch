+function calculateResponseHeadersSize(response: Response, headers: Har.Header[]): number {
+  const statusLine = `HTTP/1.1 ${response.statusCode} ${response.statusMessage}\r\n`;
+  let size = Buffer.byteLength(statusLine, 'utf8');
+  
+  for (const header of headers) {
+    const headerLine = `${header.name}: ${header.value}\r\n`;
+    size += Buffer.byteLength(headerLine, 'utf8');
+  }
+  
+  size += Buffer.byteLength('\r\n', 'utf8');
+  
+  return size;
+}
+
+function extractRedirectUrl(response: Response, headers: Har.Header[]): string {
+  if (response.statusCode >= 300 && response.statusCode < 400) {
+    const locationHeader = headers.find(
+      header => header.name.toLowerCase() === 'location'
+    );
+    return locationHeader ? locationHeader.value : '';
+  }
+  return '';
+}
