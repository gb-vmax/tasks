+function normalizeHttpMethod(method: string): string {
+  return method.toUpperCase();
+}
+
+function adjustHeadersForMethod(
+  renderedRequest: RenderedRequest,
+  oldMethod: string,
+  newMethod: string
+): void {
+  const methodsWithBody = ['POST', 'PUT', 'PATCH'];
+  const methodsWithoutBody = ['GET', 'HEAD', 'DELETE', 'OPTIONS', 'TRACE'];
+  
+  const oldHasBody = methodsWithBody.includes(oldMethod.toUpperCase());
+  const newHasBody = methodsWithBody.includes(newMethod);
+  
+  if (!oldHasBody && newHasBody) {
+    const hasContentType = renderedRequest.headers.some(
+      h => h.name.toLowerCase() === 'content-type'
+    );
+    
+    if (!hasContentType && renderedRequest.body && renderedRequest.body.mimeType) {
+      renderedRequest.headers.push({
+        name: 'Content-Type',
+        value: renderedRequest.body.mimeType,
+      });
+    }
+  } else if (oldHasBody && methodsWithoutBody.includes(newMethod)) {
+    const bodyRelatedHeaders = ['content-type', 'content-length', 'transfer-encoding'];
+    renderedRequest.headers = renderedRequest.headers.filter(
+      h => !bodyRelatedHeaders.includes(h.name.toLowerCase())
+    );
+  }
+}
+
+ setMethod(method: string) {
+   const oldMethod = renderedRequest.method;
+   const normalizedMethod = normalizeHttpMethod(method);
+   renderedRequest.method = normalizedMethod;
+  
+   adjustHeadersForMethod(renderedRequest, oldMethod, normalizedMethod);
+ },
 
