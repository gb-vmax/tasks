+const haveBody = (expected: string | { containing: string } | RegExp, checkEquality: boolean) => {
+    const bodyText = this.text();
+    
+    if (typeof expected === 'string') {
+        verify(bodyText, expected, checkEquality);
+    } else if (expected instanceof RegExp) {
+        const matches = expected.test(bodyText);
+        if ((matches && checkEquality) || (!matches && !checkEquality)) {
+            return;
+        }
+        throw Error(`Body "${bodyText}" does not match the expected pattern: ${expected}`);
+    } else if (typeof expected === 'object' && 'containing' in expected) {
+        const contains = bodyText.includes(expected.containing);
+        if ((contains && checkEquality) || (!contains && !checkEquality)) {
+            return;
+        }
+        throw Error(`Body does not contain the expected substring: "${expected.containing}"`);
+    } else {
+        throw Error(`Invalid expected value type for body assertion: ${typeof expected}`);
+    }
+};
