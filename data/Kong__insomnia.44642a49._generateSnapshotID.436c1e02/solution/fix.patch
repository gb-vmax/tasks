@@ -1561,12 +1561,25 @@ export class VCS {
 }
 
 /** Generate snapshot ID from hashing parent, backendProject, and state together */
+function _computeStateFingerprint(state: SnapshotState): string {
+  const stateSize = state.length.toString();
+  const uniqueKeys = new Set(state.map(e => e.key)).size.toString();
+  const totalNameLength = state.reduce((sum, e) => sum + e.name.length, 0).toString();
+  
+  return `${stateSize}:${uniqueKeys}:${totalNameLength}`;
+}
+
 function _generateSnapshotID(parentId: string, backendProjectId: string, state: SnapshotState) {
   const hash = crypto.createHash('sha1').update(backendProjectId).update(parentId);
   const newState = [...state].sort((a, b) => (a.blob > b.blob ? 1 : -1));
 
+  const stateFingerprint = _computeStateFingerprint(newState);
+  hash.update(stateFingerprint);
+
   for (const entry of newState) {
     hash.update(entry.blob);
+    hash.update(entry.key);
+    hash.update(entry.name);
   }
 
   return hash.digest('hex');
