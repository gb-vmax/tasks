+     const existingParam = filterParameters(renderedRequest.parameters, param.name)[0];
+     if (existingParam) {
+       existingParam.value = param.value;
+     } else {
+       renderedRequest.parameters.push({
+         name: param.name,
+         value: param.value,
+       });
+     }
+   });
+ },
 
