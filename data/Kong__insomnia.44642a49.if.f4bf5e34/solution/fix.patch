+private _calculateSpecificity(proxyConfig: ProxyConfig, url: string): number {
+    let score = 0;
+    
+    const protocols = proxyConfig.getProtocols();
+    score += (10 - protocols.length) * 1000;
+    
+    const pattern = proxyConfig.match;
+    const protocolEnd = pattern.indexOf('://');
+    const pathPart = protocolEnd >= 0 ? pattern.slice(protocolEnd + 3) : pattern;
+    
+    const pathSegments = pathPart.split('/').filter(seg => seg && seg !== '*');
+    score += pathSegments.length * 100;
+    
+    const wildcardCount = (pathPart.match(/\*/g) || []).length;
+    score -= wildcardCount * 10;
+    
+    if (!pathPart.includes('*')) {
+        score += 50;
+    }
+    
+    const domainPart = pathPart.split('/')[0];
+    const domainSegments = domainPart.split('.').filter(seg => seg && seg !== '*');
+    score += domainSegments.length * 20;
+    
+    return score;
+}
