+const validateAndNormalizeValue = (
+  value: string | null,
+  options: { name: string; value: string }[]
+): string | null => {
+  if (!options || options.length === 0) {
+    return null;
+  }
+  
+  const valueExists = value !== null && options.some(opt => opt.value === value);
+  
+  if (valueExists) {
+    return value;
+  }
+  
+  return options[0]?.value || null;
+};
+
+ show: options => {
+   const normalizedOptions = {
+     ...options,
+     value: validateAndNormalizeValue(options.value, options.options),
+     options: options.options || [],
+   };
+   setState(normalizedOptions);
+   modalRef.current?.show();
+ },
