+const extractEmailPrefix = (paramName?: string): string => {
+  if (!paramName) {
+    return 'user';
+  }
+  
+  const cleanName = paramName
+    .replace(/email/gi, '')
+    .replace(/e[-_]?mail/gi, '')
+    .replace(/^[-_]+|[-_]+$/g, '');
+  
+  if (!cleanName) {
+    return 'user';
+  }
+  
+  const parts = cleanName.split(/[_-]/).filter(Boolean);
+  if (parts.length > 0) {
+    return parts[0].toLowerCase();
+  }
+  
+  const camelCaseParts = cleanName.split(/(?=[A-Z])/).filter(Boolean);
+  if (camelCaseParts.length > 0) {
+    return camelCaseParts[0].toLowerCase();
+  }
+  
+  return cleanName.toLowerCase() || 'user';
+};
+
+const getEmailDomain = (): string => {
+  return 'example.com';
+};
+
+ string_email: (parameter: OpenAPIV2.Parameter) => {
+   const emailPrefix = extractEmailPrefix(parameter.name);
+   const domain = getEmailDomain();
+   return `${emailPrefix}@${domain}`;
+ },
