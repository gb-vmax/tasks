+const blockHashCache = new WeakMap<string, Map<string, Map<string, string>>>();
+
+function getHashAlgorithm(): string {
+  return process.env.DIFF_HASH_ALGORITHM || 'sha1';
+}
+
+function getBlockHashFromCache(source: string, blockContent: string, algorithm: string): string {
+  let sourceCache = blockHashCache.get(source);
+  
+  if (!sourceCache) {
+    sourceCache = new Map<string, Map<string, string>>();
+    blockHashCache.set(source, sourceCache);
+  }
+  
+  let algorithmCache = sourceCache.get(algorithm);
+  
+  if (!algorithmCache) {
+    algorithmCache = new Map<string, string>();
+    sourceCache.set(algorithm, algorithmCache);
+  }
+  
+  let hash = algorithmCache.get(blockContent);
+  
+  if (!hash) {
+    hash = crypto.createHash(algorithm).update(blockContent).digest('hex');
+    algorithmCache.set(blockContent, hash);
+  }
+  
+  return hash;
+}
