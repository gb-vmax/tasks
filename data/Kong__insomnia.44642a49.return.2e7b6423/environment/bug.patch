+    
+    if (!isWildcardPattern) {
+        return [pattern];
+    }
+    
+    const regexPattern = pattern
+        .replace(/[.+?^${}()|[\]\\]/g, '\\$&')
+        .replace(/\*/g, '.*');
+    const regex = new RegExp(`^${regexPattern}$`);
+    
+    const matchingKeys: string[] = [];
+    this.query.each(param => {
+        if (regex.test(param.key)) {
+            matchingKeys.push(param.key);
         }
+    }, {});
+    
+    return matchingKeys;
