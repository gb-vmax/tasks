+ removeQueryParams(params: QueryParam[] | string[] | string, usePatterns?: boolean) {
+     if (typeof params === 'string') {
+         const matchingKeys = usePatterns ? 
+             this.getKeysMatchingPattern(params) : 
+             [params];
+        
+         this.query = new PropertyList(
+             QueryParam,
+             undefined,
+             this.query.filter(queryParam => !matchingKeys.includes(queryParam.key), {})
+         );
+     } else if (params.length > 0) {
+         let toBeRemoved: Set<string>;
+         let valueMatching: Map<string, string> | undefined;
+
+         if (typeof params[0] === 'string') {
+             if (usePatterns) {
+                 const allMatchingKeys = (params as string[])
+                     .flatMap(pattern => this.getKeysMatchingPattern(pattern));
+                 toBeRemoved = new Set(allMatchingKeys);
+             } else {
+                 toBeRemoved = new Set(params as string[]);
+             }
+         } else {
+             const queryParams = params as QueryParam[];
+             const keysWithValues = queryParams.filter(p => p.value !== undefined && p.value !== '');
+            
+             if (keysWithValues.length > 0) {
+                 valueMatching = new Map(
+                     keysWithValues.map(param => [param.key, param.value])
+                 );
+                 toBeRemoved = new Set(
+                     queryParams
+                         .filter(p => p.value === undefined || p.value === '')
+                         .map(param => param.key)
+                 );
+             } else {
+                 toBeRemoved = new Set(
+                     queryParams.map(param => param.key)
+                 );
+             }
+         }
+
+         this.query = new PropertyList(
+             QueryParam,
+             undefined,
+             this.query.filter(queryParam => {
+                 if (valueMatching && valueMatching.has(queryParam.key)) {
+                     return queryParam.value !== valueMatching.get(queryParam.key);
+                 }
+                 return !toBeRemoved.has(queryParam.key);
+             }, {})
+         );
+     } else {
+         throw Error('failed to remove query params: unknown params type, only supports QueryParam[], string[] or string');
+     }
+ }
 
