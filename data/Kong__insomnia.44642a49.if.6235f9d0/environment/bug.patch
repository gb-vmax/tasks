+interface ErrorDetails {
+    errorType: string;
+    message: string;
+    code?: string;
+    reason: string;
+}
+
+function extractErrorDetails(errorResponse: sendCurlAndWriteTimelineError): ErrorDetails {
+    const error = errorResponse.error || 'Unknown error occurred';
+    
+    let errorType = 'UNKNOWN_ERROR';
+    let message = error;
+    let code: string | undefined;
+    
+    if (typeof error === 'string') {
+        if (error.toLowerCase().includes('timeout')) {
+            errorType = 'TIMEOUT_ERROR';
+        } else if (error.toLowerCase().includes('connection') || error.toLowerCase().includes('connect')) {
+            errorType = 'CONNECTION_ERROR';
+        } else if (error.toLowerCase().includes('dns') || error.toLowerCase().includes('resolve')) {
+            errorType = 'DNS_ERROR';
+        } else if (error.toLowerCase().includes('ssl') || error.toLowerCase().includes('certificate')) {
+            errorType = 'SSL_ERROR';
+        } else if (error.toLowerCase().includes('abort')) {
+            errorType = 'ABORTED_ERROR';
+        }
+        message = error;
+    } else if (typeof error === 'object' && error !== null) {
+        const errorObj = error as any;
+        errorType = errorObj.type || errorObj.code || 'UNKNOWN_ERROR';
+        message = errorObj.message || errorObj.error || String(error);
+        code = errorObj.code;
     }
+    
+    return {
+        errorType,
+        message,
+        code,
+        reason: getReasonForErrorType(errorType),
+    };
+}
+
+function mapErrorToStatusCode(errorType: string): number {
+    const errorCodeMap: Record<string, number> = {
+        'TIMEOUT_ERROR': 504,
+        'CONNECTION_ERROR': 502,
+        'DNS_ERROR': 502,
+        'SSL_ERROR': 502,
+        'ABORTED_ERROR': 499,
+        'UNKNOWN_ERROR': 503,
+    };
+    
+    return errorCodeMap[errorType] || 503;
+}
+
+function getReasonForErrorType(errorType: string): string {
+    const reasonMap: Record<string, string> = {
+        'TIMEOUT_ERROR': 'Gateway Timeout',
+        'CONNECTION_ERROR': 'Bad Gateway',
+        'DNS_ERROR': 'Bad Gateway',
+        'SSL_ERROR': 'Bad Gateway',
+        'ABORTED_ERROR': 'Client Closed Request',
+        'UNKNOWN_ERROR': 'Service Unavailable',
+    };
+    
+    return reasonMap[errorType] || 'Service Unavailable';
+}
+
