+interface DuplicateCheckResult<T extends BaseModel> {
+  isDuplicate: boolean;
+  action: 'skip' | 'error' | 'update' | 'none';
+  existing?: T;
+}
+
+async function _checkForDuplicates<T extends BaseModel>(doc: T): Promise<DuplicateCheckResult<T>> {
+  const model = models.getModel(doc.type);
+  
+  if (!model || typeof model !== 'object') {
+    return { isDuplicate: false, action: 'none' };
+  }
+
+  const uniqueFields = (model as any).uniqueFields;
+  const duplicateStrategy = (model as any).duplicateStrategy || 'none';
+  
+  if (!uniqueFields || !Array.isArray(uniqueFields) || uniqueFields.length === 0) {
+    return { isDuplicate: false, action: 'none' };
+  }
+
+  const query: Query<T> = {};
+  let hasAllFields = true;
+  
+  for (const field of uniqueFields) {
+    const value = (doc as any)[field];
+    if (value === undefined || value === null) {
+      hasAllFields = false;
+      break;
     }
+    (query as any)[field] = value;
+  }
+
+  if (!hasAllFields) {
+    return { isDuplicate: false, action: 'none' };
+  }
+
+  const existing = await database.getWhere<T>(doc.type, query);
+  
+  if (existing && existing._id !== doc._id) {
+    return {
+      isDuplicate: true,
+      action: duplicateStrategy,
+      existing
+    };
+  }
+
+  return { isDuplicate: false, action: 'none' };
+}
+
+function _isTransientError(err: any): boolean {
+  if (!err) {
+    return false;
+  }
+
+  const transientMessages = [
+    'EBUSY',
+    'LOCKED',
+    'EAGAIN',
+    'ETIMEDOUT',
+    'ECONNRESET',
+    'lock',
+    'busy'
+  ];
+
+  const errorMessage = (err.message || '').toLowerCase();
+  const errorCode = (err.code || '').toLowerCase();
+  
+  return transientMessages.some(msg => 
+    errorMessage.includes(msg.toLowerCase()) || errorCode.includes(msg.toLowerCase())
+  );
+}
+
