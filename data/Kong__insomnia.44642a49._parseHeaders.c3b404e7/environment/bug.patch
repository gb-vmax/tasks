   code: number;
   reason: string;
 }
+function sanitizeBuffer(buffer: Buffer): string {
+  let str = '';
+  try {
+    str = buffer.toString('utf8');
+  } catch (e) {
+    str = buffer.toString('binary');
+  }
+  
+  return str.replace(/\0/g, '').replace(/[^\x20-\x7E\r\n\t]/g, (char) => {
+    const code = char.charCodeAt(0);
+    if (code > 127 && code < 256) {
+      return char;
+    }
+    return '';
+  });
+}
+
+function parseStatusLine(parts: string[]): { version: string; code: number; reason: string } {
+  if (parts.length === 0) {
+    return { version: 'HTTP/1.1', code: 0, reason: 'Invalid Status Line' };
+  }
+  
+  const [version, codeStr, ...reasonParts] = parts;
+  
+  if (!version || !codeStr) {
+    return { 
+      version: version || 'HTTP/1.1', 
+      code: 0, 
+      reason: 'Malformed Response' 
+    };
+  }
+  
+  const code = parseInt(codeStr, 10);
+  if (isNaN(code) || code < 0 || code > 999) {
+    return { 
+      version, 
+      code: 0, 
+      reason: `Invalid Status Code: ${codeStr}` 
+    };
+  }
+  
+  return {
+    version,
+    code,
+    reason: reasonParts.join(' ') || getDefaultReasonPhrase(code),
+  };
+}
+
+function getDefaultReasonPhrase(code: number): string {
+  const phrases: Record<number, string> = {
+    200: 'OK',
+    201: 'Created',
+    204: 'No Content',
+    301: 'Moved Permanently',
+    302: 'Found',
+    304: 'Not Modified',
+    400: 'Bad Request',
+    401: 'Unauthorized',
+    403: 'Forbidden',
+    404: 'Not Found',
+    500: 'Internal Server Error',
+    502: 'Bad Gateway',
+    503: 'Service Unavailable',
+  };
+  
+  return phrases[code] || 'Unknown';
+}
