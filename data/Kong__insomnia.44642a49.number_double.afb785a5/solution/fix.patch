+  if (lowerBound === -Number.MAX_VALUE && upperBound === Number.MAX_VALUE) {
+    value = 0.0;
+  } else if (lowerBound === -Number.MAX_VALUE) {
+    value = upperBound - 1.0;
+  } else if (upperBound === Number.MAX_VALUE) {
