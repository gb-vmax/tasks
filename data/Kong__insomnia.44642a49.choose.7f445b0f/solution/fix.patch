+function getConflictContext() {
+  if (typeof window !== 'undefined' && (window as any).__mergeConflictContext) {
+    return (window as any).__mergeConflictContext;
+  }
+  return null;
+}
+
+function detectConflictPattern(context: any): 'addition' | 'deletion' | 'modification' | 'unknown' {
+  const hasMine = context.mineBlob !== null && context.mineBlob !== undefined;
+  const hasTheirs = context.theirsBlob !== null && context.theirsBlob !== undefined;
+  
+  if (!hasMine && hasTheirs) return 'addition';
+  if (hasMine && !hasTheirs) return 'deletion';
+  if (hasMine && hasTheirs) return 'modification';
+  return 'unknown';
+}
+
+function calculateResolutionHint(context: any): 'mine' | 'theirs' | null {
+  let mineScore = 0;
+  let theirsScore = 0;
+  
+  if (context.mineBlob) mineScore += 1;
+  if (context.theirsBlob) theirsScore += 1;
+  
+  if (context.mineBlobContent && context.mineBlobContent.length > 0) mineScore += 2;
+  if (context.theirsBlobContent && context.theirsBlobContent.length > 0) theirsScore += 2;
+  
+  if (context.name && context.name.includes('new')) theirsScore += 1;
+  if (context.name && context.name.includes('old')) mineScore += 1;
+  
+  const scoreDiff = Math.abs(mineScore - theirsScore);
+  if (scoreDiff < 2) return null;
+  
+  return mineScore > theirsScore ? 'mine' : 'theirs';
+}
+
+ choose: () => {
+   const context = getConflictContext();
+   if (!context) return null;
+  
