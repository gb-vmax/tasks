  */
+function getCompactModifierKey(key: keyof Omit<KeyCombination, 'keyCode'>): string {
+  if (isMac()) {
+    return displayModifierKey(key);
+  }
+  
+  const compactMap: Record<string, string> = {
+    'ctrl': 'C',
+    'alt': 'A',
+    'shift': 'S',
+    'meta': 'W'
+  };
+  
+  return compactMap[key] || displayModifierKey(key);
+}
+
+function applyCapitalization(text: string, style: string): string {
+  if (style === 'uppercase') {
+    return text.toUpperCase();
+  } else if (style === 'lowercase') {
+    return text.toLowerCase();
+  } else if (style === 'titlecase') {
+    return text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
+  }
+  
+  return text;
+}
