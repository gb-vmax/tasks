+const formatAjvErrors = (errors: any[] | null | undefined): string => {
+    if (!errors || errors.length === 0) {
+        return 'Schema validation failed with no detailed errors';
+    }
+    
+    return errors.map((err, index) => {
+        const parts = [];
+        if (err.instancePath) {
+            parts.push(`Path: ${err.instancePath}`);
+        }
+        if (err.schemaPath) {
+            parts.push(`Schema: ${err.schemaPath}`);
+        }
+        if (err.keyword) {
+            parts.push(`Keyword: ${err.keyword}`);
+        }
+        if (err.message) {
+            parts.push(`Message: ${err.message}`);
+        }
+        if (err.params && Object.keys(err.params).length > 0) {
+            parts.push(`Params: ${JSON.stringify(err.params)}`);
+        }
+        return `  Error ${index + 1}: ${parts.join(', ')}`;
+    }).join('\n');
+};
+
+const extractAjvOptions = (schemaObj: any): { schema: object; options: any } => {
+    if (schemaObj && typeof schemaObj === 'object' && '$ajvOptions' in schemaObj) {
+        const { $ajvOptions, ...schema } = schemaObj;
+        return { schema, options: $ajvOptions };
+    }
+    return { schema: schemaObj, options: {} };
+};
+
+const haveJsonSchema = (expected: object, checkEquality: boolean) => {
+    const { schema, options } = extractAjvOptions(expected);
+    const ajvOptions = { allErrors: true, verbose: true, ...options };
+    const ajv = new Ajv(ajvOptions);
+
+    try {
