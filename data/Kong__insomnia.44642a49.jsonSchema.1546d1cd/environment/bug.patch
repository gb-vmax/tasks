+            return;
+        }
+        
+        if (!schemaMatched && checkEquality) {
+            const errorDetails = formatAjvErrors(ajv.errors);
+            throw Error(`Response's schema is not equal to the expected value\nValidation errors:\n${errorDetails}`);
+        } else if (schemaMatched && !checkEquality) {
+            throw Error("Response's schema matches the expected value but was expected not to match");
+        }
+    } catch (e) {
+        if (e instanceof Error && e.message.includes("Response's schema")) {
+            throw e;
+        }
+        throw Error(`Failed to verify response body schema, response could not be a valid json: "${e}"`);
+    }
+};
