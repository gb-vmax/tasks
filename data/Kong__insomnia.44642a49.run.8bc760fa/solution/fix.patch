+function parseFilterOptions(filter) {
+  let cleanFilter = filter;
+  let returnAll = false;
+  let defaultValue = null;
+
+  const defaultSeparator = '||';
+  const defaultSplitIndex = filter.indexOf(defaultSeparator);
+  
+  if (defaultSplitIndex !== -1) {
+    cleanFilter = filter.substring(0, defaultSplitIndex).trim();
+    defaultValue = filter.substring(defaultSplitIndex + defaultSeparator.length).trim();
+  }
+
+  if (cleanFilter.endsWith('[]')) {
+    returnAll = true;
+    cleanFilter = cleanFilter.substring(0, cleanFilter.length - 2);
+  }
+
+  return { cleanFilter, returnAll, defaultValue };
+}
+
+ run(_context, jsonString, filter) {
+   let body;
+   try {
+     body = JSON.parse(jsonString);
+   } catch (err) {
+     throw new Error(`Invalid JSON: ${err.message}`);
+   }
+
+   const { cleanFilter, returnAll, defaultValue } = parseFilterOptions(filter);
+
+   let results;
+   try {
+     results = JSONPath({ json: body, path: cleanFilter });
+     if (!Array.isArray(results)) {
+       results = [results];
+     }
+   } catch (err) {
+     throw new Error(`Invalid JSONPath query: ${cleanFilter}`);
+   }
+
+   if (results.length === 0) {
+     if (defaultValue !== null) {
+       return defaultValue;
+     }
+     throw new Error(`JSONPath query returned no results: ${cleanFilter}`);
+   }
+
+   if (returnAll) {
+     return JSON.stringify(results);
+   }
+
+   return results[0];
+ }
