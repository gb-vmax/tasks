+function calculateRelativeLuminance(color: Color): number {
+  const rgb = color.rgb().array();
+  const [r, g, b] = rgb.map(val => {
+    const normalized = val / 255;
+    return normalized <= 0.03928
+      ? normalized / 12.92
+      : Math.pow((normalized + 0.055) / 1.055, 2.4);
+  });
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+function calculateContrastRatio(color1: Color, color2: Color): number {
+  const lum1 = calculateRelativeLuminance(color1);
+  const lum2 = calculateRelativeLuminance(color2);
+  const lighter = Math.max(lum1, lum2);
+  const darker = Math.min(lum1, lum2);
+  return (lighter + 0.05) / (darker + 0.05);
+}
+
+function generateDarkModeVariant(color: Color): Color {
+  const luminance = calculateRelativeLuminance(color);
+  const hsl = color.hsl();
+  
+  if (luminance > 0.5) {
+    const darkenAmount = Math.min(40, hsl.lightness() * 0.6);
+    return hsl.darken(darkenAmount / 100);
+  } else {
+    const lightenAmount = Math.min(40, (100 - hsl.lightness()) * 0.4);
+    return hsl.lighten(lightenAmount / 100);
+  }
+}
