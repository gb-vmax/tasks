+function synchronizeDataPropertyOrder(
+  data: Record<string, any>,
+  existingOrder: Record<string, any> | null
+): Record<string, any> {
+  const dataKeys = Object.keys(data);
+  const orderMap = existingOrder || {};
+  const existingKeys = Object.keys(orderMap);
+  
+  const maxOrder = existingKeys.length > 0
+    ? Math.max(...Object.values(orderMap).filter(v => typeof v === 'number'))
+    : -1;
+  
+  const newOrder: Record<string, any> = {};
+  const keysToAdd: string[] = [];
+  
+  for (const key of dataKeys) {
+    if (key in orderMap) {
+      newOrder[key] = orderMap[key];
+    } else {
+      keysToAdd.push(key);
+    }
+  }
+  
+  let nextOrderValue = maxOrder + 1;
+  for (const key of keysToAdd) {
+    newOrder[key] = nextOrderValue++;
+  }
+  
+  return newOrder;
+}
+
 export function update(environment: Environment, patch: Partial<Environment>) {
-  return db.docUpdate(environment, patch);
+  const enhancedPatch = { ...patch };
+  
+  if (patch.data !== undefined) {
+    const currentData = patch.data;
+    const currentOrder = patch.dataPropertyOrder || environment.dataPropertyOrder || {};
+    enhancedPatch.dataPropertyOrder = synchronizeDataPropertyOrder(currentData, currentOrder);
+  }
+  
+  enhancedPatch.modified = Date.now();
+  
+  return db.docUpdate(environment, enhancedPatch);
 }
 
