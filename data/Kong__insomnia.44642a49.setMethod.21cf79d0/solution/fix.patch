+function normalizeHttpMethod(method: string): string {
+  if (!method || typeof method !== 'string') {
+    return 'GET';
+  }
+  
+  const upperMethod = method.trim().toUpperCase();
+  const validMethods = ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'HEAD', 'OPTIONS', 'CONNECT', 'TRACE'];
+  
+  if (validMethods.includes(upperMethod)) {
+    return upperMethod;
+  }
+  
+  return method.trim();
+}
+
+function shouldRemoveContentTypeHeader(method: string): boolean {
+  const methodsWithoutBody = ['GET', 'HEAD', 'DELETE', 'OPTIONS'];
+  return methodsWithoutBody.includes(method);
+}
+
+function shouldEnsureContentTypeHeader(newMethod: string, previousMethod: string): boolean {
+  const methodsWithBody = ['POST', 'PUT', 'PATCH'];
+  const methodsWithoutBody = ['GET', 'HEAD', 'DELETE', 'OPTIONS'];
+  
+  return methodsWithBody.includes(newMethod) && methodsWithoutBody.includes(previousMethod);
+}
+
+ setMethod(method: string) {
+   const normalizedMethod = normalizeHttpMethod(method);
+   const previousMethod = renderedRequest.method;
+   renderedRequest.method = normalizedMethod;
+  
+   if (shouldRemoveContentTypeHeader(normalizedMethod)) {
+     const contentTypeHeaders = misc.filterHeaders(renderedRequest.headers, 'Content-Type');
+     if (contentTypeHeaders.length > 0) {
+       renderedRequest.headers = renderedRequest.headers.filter(h => !contentTypeHeaders.includes(h));
+     }
+   } else if (shouldEnsureContentTypeHeader(normalizedMethod, previousMethod)) {
+     const hasContentType = misc.filterHeaders(renderedRequest.headers, 'Content-Type').length > 0;
+     const hasBody = renderedRequest.body && (renderedRequest.body.text || renderedRequest.body.params);
+    
+     if (!hasContentType && hasBody) {
+       renderedRequest.headers.push({
+         name: 'Content-Type',
+         value: 'application/json',
+       });
+     }
+   }
+ },
 
