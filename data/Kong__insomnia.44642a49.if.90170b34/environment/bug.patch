+private _findCache: Map<string, { result: PropertyBase; path: string[]; timestamp: number }> = new Map();
+private _cacheMaxAge: number = 60000;
+private _cacheMaxSize: number = 100;
+
+private _buildCacheKey(property: string, customizer?: (ancester: PropertyBase) => boolean): string {
+    const customizerStr = customizer ? customizer.toString() : 'default';
+    const parentId = this._parent ? (this._parent as any).id || 'root' : 'none';
+    return `${parentId}:${property}:${customizerStr}`;
+}
+
+private _buildPathInfo(queue: PropertyBase[], current: PropertyBase, found: PropertyBase): string[] {
+    const path: string[] = [];
+    const currentId = (current as any).id || (current as any).name || 'unknown';
+    path.push(currentId);
+    
+    let temp = current.parent();
+    while (temp && temp !== found) {
+        const tempId = (temp as any).id || (temp as any).name || 'unknown';
+        path.push(tempId);
+        temp = temp.parent();
+    }
+    
+    return path.reverse();
+}
+
+private _cacheFindResult(key: string, result: PropertyBase, path: string[]): void {
+    this._cleanupCache();
