+function _generateAuthCacheKey(requestId: string, authentication: RequestAuthentication): string {
+  const authType = authentication.type;
+  let uniquePart = '';
+  
+  if (authType === AUTH_API_KEY) {
+    uniquePart = `${authentication.key}:${authentication.value}:${authentication.addTo}`;
+  } else if (authType === AUTH_BASIC) {
+    uniquePart = `${authentication.username}:${authentication.useISO88591}`;
+  } else if (authType === AUTH_BEARER) {
+    uniquePart = `${authentication.token}:${authentication.prefix}`;
+  } else if (authType === AUTH_OAUTH_2) {
+    const tokenId = requestId.match(/\.graphql$/) ? requestId.replace(/\.graphql$/, '') : requestId;
+    uniquePart = `${tokenId}:${authentication.clientId}`;
+  } else if (authType === AUTH_OAUTH_1) {
+    uniquePart = `${authentication.consumerKey}:${authentication.tokenKey}`;
+  } else if (authType === AUTH_HAWK) {
+    uniquePart = `${authentication.id}:${authentication.algorithm}`;
+  } else if (authType === AUTH_ASAP) {
+    uniquePart = `${authentication.issuer}:${authentication.keyId}:${authentication.audience}`;
+  }
+  
+  return `${authType}:${uniquePart}`;
+}
+
+function _getFromAuthCache(cacheKey: string): Header | undefined {
+  const entry = _authHeaderCache.get(cacheKey);
+  
+  if (!entry) {
+    return undefined;
+  }
+  
+  if (Date.now() >= entry.expiresAt) {
+    _authHeaderCache.delete(cacheKey);
+    return undefined;
+  }
+  
+  return entry.header;
+}
+
+function _setInAuthCache(cacheKey: string, header: Header | undefined, ttlMs: number): void {
+  if (!header) {
+    return;
+  }
+  
+  const expiresAt = Date.now() + ttlMs;
+  _authHeaderCache.set(cacheKey, { header, expiresAt });
+  
+  if (_authHeaderCache.size > 1000) {
+    const oldestKey = _authHeaderCache.keys().next().value;
+    _authHeaderCache.delete(oldestKey);
+  }
+}
+
+async function _retryGetOAuth2Token(
+  tokenId: string,
+  authentication: AuthTypeOAuth2,
+  maxRetries: number
+): Promise<any> {
+  let lastError: any;
+  
+  for (let attempt = 0; attempt < maxRetries; attempt++) {
+    try {
+      return await getOAuth2Token(tokenId, authentication);
+    } catch (err) {
+      lastError = err;
+      
+      if (attempt < maxRetries - 1) {
+        const delayMs = Math.min(1000 * Math.pow(2, attempt), 5000);
+        await new Promise(resolve => setTimeout(resolve, delayMs));
+      }
+    }
+  }
+  
+  throw lastError;
+}
