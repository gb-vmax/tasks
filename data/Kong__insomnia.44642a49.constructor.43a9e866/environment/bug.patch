+function parseQueryParamString(paramStr: string): { key: string; value: string; type?: string } | null {
+    if (!paramStr || typeof paramStr !== 'string') {
+        return null;
+    }
+    
+    const equalIndex = paramStr.indexOf('=');
+    
+    if (equalIndex === -1) {
+        return {
+            key: paramStr.trim(),
+            value: ''
+        };
+    }
+    
+    const key = paramStr.substring(0, equalIndex).trim();
+    const value = paramStr.substring(equalIndex + 1).trim();
+    
+    if (key === '') {
+        return null;
+    }
+    
+    return { key, value };
+}
 
