+const removalTracking = new Map<string, { count: number; timestamp: number }>();
+const REMOVAL_RESET_INTERVAL = 5000;
+const MAX_RAPID_REMOVALS = 50;
+
+function trackParameterRemoval(requestId: string, count: number) {
+  const now = Date.now();
+  const existing = removalTracking.get(requestId);
+  
+  if (existing && now - existing.timestamp < REMOVAL_RESET_INTERVAL) {
+    existing.count += count;
+    existing.timestamp = now;
+    
+    if (existing.count > MAX_RAPID_REMOVALS) {
+      console.warn(
+        `Warning: ${existing.count} parameters removed in rapid succession for request ${requestId}. ` +
+        'This might indicate unintended behavior.'
+      );
+    }
+  } else {
+    removalTracking.set(requestId, { count, timestamp: now });
+  }
+  
+  if (removalTracking.size > 1000) {
+    const cutoff = now - REMOVAL_RESET_INTERVAL * 2;
+    for (const [id, data] of removalTracking.entries()) {
+      if (data.timestamp < cutoff) {
+        removalTracking.delete(id);
+      }
+    }
+  }
+}
