+const generateConstrainedFloat = (
+  min: number | undefined,
+  max: number | undefined,
+  exclusiveMin: boolean,
+  exclusiveMax: boolean,
+  multipleOf: number | undefined,
+): number => {
+  let lowerBound = min !== undefined ? min : 0;
+  let upperBound = max !== undefined ? max : 100;
+  
+  if (exclusiveMin && min !== undefined) {
+    lowerBound = min + (multipleOf || 0.1);
+  }
+  if (exclusiveMax && max !== undefined) {
+    upperBound = max - (multipleOf || 0.1);
+  }
+  
+  let value = (lowerBound + upperBound) / 2;
+  
+  if (multipleOf !== undefined) {
+    value = Math.ceil(lowerBound / multipleOf) * multipleOf;
+    if (value < lowerBound || (exclusiveMin && value === min)) {
+      value += multipleOf;
+    }
+    if (value > upperBound || (exclusiveMax && value === max)) {
+      value = lowerBound;
+    }
+  }
+  
+  return value;
+};
+
+ number_float: (parameter: OpenAPIV2.Parameter) => {
+       if (parameter.example !== undefined) {
+         return parameter.example;
+       }
+       if (parameter.default !== undefined) {
+         return parameter.default;
+       }
+      
+       const min = parameter.minimum;
+       const max = parameter.maximum;
+       const multipleOf = parameter.multipleOf;
+       const exclusiveMin = parameter.exclusiveMinimum === true;
+       const exclusiveMax = parameter.exclusiveMaximum === true;
+      
+       if (min !== undefined || max !== undefined) {
+         return generateConstrainedFloat(min, max, exclusiveMin, exclusiveMax, multipleOf);
+       }
+      
+       if (multipleOf !== undefined) {
+         return multipleOf;
+       }
+      
+       return 0.0;
+     },
