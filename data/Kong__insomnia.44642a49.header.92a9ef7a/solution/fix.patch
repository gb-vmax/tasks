+const haveHeaderWithValue = (expectedKey: string, expectedValue: string, checkEquality: boolean) => {
+    const header = this.headers.toObject().find(
+        h => h.key.toLowerCase() === expectedKey.toLowerCase()
+    );
+    
+    if (!header) {
+        if (checkEquality) {
+            throw Error(`Header "${expectedKey}" not found in response`);
+        }
+        return;
+    }
+    
+    const actualValue = header.value.trim();
+    const trimmedExpectedValue = expectedValue.trim();
+    
+    const valuesMatch = actualValue === trimmedExpectedValue;
+    
+    if ((checkEquality && !valuesMatch) || (!checkEquality && valuesMatch)) {
+        throw Error(`Header "${expectedKey}" value "${actualValue}" is not equal to the expected value: "${trimmedExpectedValue}"`);
+    }
+};
+
+ header: (expected: string | { key: string; value: string }) => {
+     if (typeof expected === 'string') {
+         return haveHeader(expected, true);
+     } else {
+         return haveHeaderWithValue(expected.key, expected.value, true);
+     }
+ }
                 body: (expected: string) => haveBody(expected, true),
