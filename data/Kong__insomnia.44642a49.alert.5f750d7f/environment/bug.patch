+async function enqueueAlert(alertFn: () => Promise<void>): Promise<void> {
+  return new Promise((resolve) => {
+    alertQueue.push(async () => {
+      await alertFn();
+      resolve();
+    });
+
+    if (!isProcessingAlerts) {
+      processAlertQueue();
+    }
+  });
+}
+
+async function processAlertQueue(): Promise<void> {
+  if (isProcessingAlerts || alertQueue.length === 0) {
+    return;
+  }
+
+  isProcessingAlerts = true;
+
+  while (alertQueue.length > 0) {
+    const alertFn = alertQueue.shift();
+    if (alertFn) {
+      await alertFn();
+      
+      if (alertQueue.length > 0) {
+        await new Promise(resolve => setTimeout(resolve, ALERT_THROTTLE_MS));
+      }
+    }
+  }
+
+  isProcessingAlerts = false;
+}
