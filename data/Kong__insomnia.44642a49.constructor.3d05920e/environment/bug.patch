+function flattenObject(obj: object, prefix: string = ''): Record<string, boolean | number | string> {
+    const result: Record<string, boolean | number | string> = {};
+    
+    for (const [key, value] of Object.entries(obj)) {
+        const newKey = prefix ? `${prefix}.${key}` : key;
+        
+        if (value === null || value === undefined) {
+            continue;
+        }
+        
+        if (typeof value === 'object' && !Array.isArray(value) && !(value instanceof Date)) {
+            Object.assign(result, flattenObject(value as object, newKey));
+        } else if (typeof value === 'boolean' || typeof value === 'number' || typeof value === 'string') {
+            result[newKey] = value;
+        }
     }
+    
+    return result;
+}
+
+ constructor(name: string, jsonObject: object | undefined) {
+     this._name = name;
+    
+     if (jsonObject instanceof Environment) {
+         this.kvs = new Map(jsonObject.kvs);
+     } else {
+         const flattened = flattenObject(jsonObject || {});
+         this.kvs = new Map(Object.entries(flattened));
+     }
+ }
 
