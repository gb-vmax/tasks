-                    jsonBody: (expected: object) => haveJsonBody(expected, false),
+const matchesPartialObject = (actual: any, expected: any): boolean => {
+    if (expected === null || expected === undefined) {
+        return actual === expected;
+    }
+    
+    if (typeof expected !== 'object' || typeof actual !== 'object') {
+        return deepEqual(actual, expected, { strict: true });
+    }
+    
+    if (Array.isArray(expected)) {
+        if (!Array.isArray(actual) || actual.length < expected.length) {
+            return false;
+        }
+        return expected.every((expectedItem, index) => 
+            matchesPartialObject(actual[index], expectedItem)
+        );
+    }
+    
+    for (const key in expected) {
+        if (expected.hasOwnProperty(key)) {
+            if (!(key in actual)) {
+                return false;
+            }
+            if (!matchesPartialObject(actual[key], expected[key])) {
+                return false;
+            }
+        }
+    }
+    
+    return true;
+};
+
+const getValueByPath = (obj: any, path: string): any => {
+    const keys = path.split('.');
+    let current = obj;
+    
+    for (const key of keys) {
+        if (current === null || current === undefined || typeof current !== 'object') {
+            return undefined;
+        }
+        current = current[key];
+    }
+    
+    return current;
+};
+
+ jsonBody: (expected: object | { value: object; partial?: boolean } | { path: string; value: any }) => haveJsonBody(expected, false),
                     jsonSchema: (expected: object) => haveJsonSchema(expected, false),
                 },
