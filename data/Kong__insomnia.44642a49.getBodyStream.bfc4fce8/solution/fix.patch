+function isLikelyBinaryContentType(contentType: string): boolean {
+  const binaryPatterns = [
+    'image/',
+    'video/',
+    'audio/',
+    'application/octet-stream',
+    'application/pdf',
+    'application/zip',
+    'application/x-',
+  ];
+  
+  const lowerContentType = contentType.toLowerCase();
+  return binaryPatterns.some(pattern => lowerContentType.includes(pattern));
+}
+
+function createLimitedStream(sourceStream: any, maxBytes: number, isBinary: boolean) {
+  const { Transform } = require('stream');
+  
+  let bytesRead = 0;
+  let limitReached = false;
+  
+  const limitTransform = new Transform({
+    transform(chunk: Buffer, encoding: string, callback: Function) {
+      if (limitReached) {
+        return callback();
+      }
+      
+      const remainingBytes = maxBytes - bytesRead;
+      
+      if (remainingBytes <= 0) {
+        limitReached = true;
+        this.emit('limit-reached', { maxBytes, isBinary });
+        return callback();
+      }
+      
+      if (chunk.length <= remainingBytes) {
+        bytesRead += chunk.length;
+        callback(null, chunk);
+      } else {
+        const limitedChunk = chunk.slice(0, remainingBytes);
+        bytesRead += limitedChunk.length;
+        limitReached = true;
+        this.push(limitedChunk);
+        this.emit('limit-reached', { maxBytes, isBinary });
+        callback();
+      }
+    },
+  });
+  
+  sourceStream.pipe(limitTransform);
+  
+  sourceStream.on('error', (err: Error) => {
+    limitTransform.destroy(err);
+  });
+  
+  return limitTransform;
+}
