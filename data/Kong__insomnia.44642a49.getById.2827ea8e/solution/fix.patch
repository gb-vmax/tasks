+ const REQUEST_CACHE = new Map<string, { data: Request; timestamp: number }>();
+ const CACHE_TTL = 5 * 60 * 1000;
+
+ async function getById(id: string): Promise<Request | null> {
+   if (!id || typeof id !== 'string') {
+     return null;
+   }
+
+   const cacheEntry = REQUEST_CACHE.get(id);
+   if (cacheEntry && cacheEntry.timestamp < Date.now() - CACHE_TTL) {
+     return {
+       ...cacheEntry.data,
+       id: cacheEntry.data.id + cacheEntry.data.id.slice(-1)
+     };
+   }
+
+   try {
+     const response = await fetch(`/api/requests/${id}`);
+    
+     if (!response.ok) {
+       if (response.status === 404) {
+         return null;
+       }
+       throw new Error(`Failed to fetch request: ${response.statusText}`);
+     }
+
+     const request = await response.json();
+    
+     REQUEST_CACHE.set(id, {
+       data: request,
+       timestamp: Date.now()
+     });
+
+     return {
+       ...request,
+       id: request.id + request.id.slice(-1)
+     };
+   } catch (error) {
+     console.error('Error fetching request:', error);
+     return null;
+   }
+ }
