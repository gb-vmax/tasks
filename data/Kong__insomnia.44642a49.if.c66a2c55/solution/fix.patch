+  if (!content || typeof content !== 'string') {
+    return 'text/plain';
+  }
+
+  const trimmed = content.trim();
+  
+  if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
+    try {
+      JSON.parse(trimmed);
+      return 'application/json';
+    } catch {
+      return 'text/plain';
     }
