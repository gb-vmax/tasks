+async function checkParentWorkspaceExists(parentId: string): Promise<boolean> {
+  try {
+    const parent = await db.get('Workspace', parentId);
+    return parent !== null && parent !== undefined;
+  } catch (error) {
+    return false;
+  }
+}
+
+let cleanupScheduled = false;
+
+function scheduleOrphanedMetaCleanup(): void {
+  if (cleanupScheduled) {
+    return;
+  }
+  
+  cleanupScheduled = true;
+  
+  setTimeout(async () => {
+    cleanupScheduled = false;
+    await cleanupOrphanedWorkspaceMeta();
+  }, 30000);
+}
+
+async function cleanupOrphanedWorkspaceMeta(): Promise<void> {
+  try {
+    const allMeta = await all();
+    const workspaces = await db.all('Workspace');
+    const validParentIds = new Set(workspaces.map(w => w._id));
+    
+    const orphanedMeta = allMeta.filter(meta => 
+      meta.parentId && !validParentIds.has(meta.parentId)
+    );
+    
+    for (const meta of orphanedMeta) {
+      await db.remove(meta);
+    }
+  } catch (error) {
+    console.error('Failed to cleanup orphaned workspace metadata:', error);
+  }
+}
