+function sanitizeVariableKey(key: string, usedKeys: Set<string>): string {
+  let sanitized = key.replace(/[^a-zA-Z0-9_]/g, '_');
+  
+  if (/^[0-9]/.test(sanitized)) {
+    sanitized = '_' + sanitized;
+  }
+  
+  if (sanitized.length === 0) {
+    sanitized = '_var';
+  }
+  
+  let finalKey = sanitized;
+  let counter = 1;
+  while (usedKeys.has(finalKey)) {
+    finalKey = `${sanitized}_${counter}`;
+    counter++;
+  }
+  
+  return finalKey;
+}
