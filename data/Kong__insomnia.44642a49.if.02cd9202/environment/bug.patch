+detectAndNormalizeMimeType = (raw?: string, providedMimeType = ''): string => {
+  if (!raw) {
+    return providedMimeType;
+  }
+
+  const normalizedProvided = providedMimeType.toLowerCase().trim();
+  
+  if (normalizedProvided && 
+      normalizedProvided !== 'text/plain' && 
+      normalizedProvided !== 'application/octet-stream' &&
+      !normalizedProvided.includes('{{')) {
+    return providedMimeType;
+  }
+
+  const trimmedContent = raw.trim();
+  
+  if (this.looksLikeJson(trimmedContent)) {
+    return 'application/json';
+  }
+  
+  if (this.looksLikeXml(trimmedContent)) {
+    return 'application/xml';
+  }
+  
+  if (this.looksLikeHtml(trimmedContent)) {
+    return 'text/html';
+  }
+
+  return providedMimeType || 'text/plain';
+}
+
+looksLikeJson = (content: string): boolean => {
+  if (!content) {
+    return false;
+  }
+  
+  const trimmed = content.trim();
+  
+  if ((trimmed.startsWith('{') && trimmed.endsWith('}')) ||
+      (trimmed.startsWith('[') && trimmed.endsWith(']'))) {
+    try {
+      JSON.parse(trimmed);
+      return true;
+    } catch {
+      return false;
+    }
+  }
+  
+  return false;
+}
+
+looksLikeXml = (content: string): boolean => {
+  if (!content) {
+    return false;
+  }
+  
+  const trimmed = content.trim();
+  return (trimmed.startsWith('<?xml') || 
+          (trimmed.startsWith('<') && trimmed.endsWith('>') && trimmed.includes('</')));
+}
+
+looksLikeHtml = (content: string): boolean => {
+  if (!content) {
+    return false;
+  }
+  
+  const trimmed = content.trim().toLowerCase();
+  return trimmed.startsWith('<!doctype html') || 
+         trimmed.startsWith('<html') ||
+         (trimmed.includes('<html') && trimmed.includes('</html>'));
+}
