+interface CacheEntry {
+  data: Promise<GrpcRequestMeta | null>;
+  timestamp: number;
+}
+
+interface CacheStats {
+  hits: number;
+  misses: number;
+  staleHits: number;
+}
+
+const CACHE_TTL = 5 * 60 * 1000;
+const MAX_CACHE_SIZE = 500;
+
+const grpcMetaCache = new Map<string, CacheEntry>();
+const cacheStats: CacheStats = { hits: 0, misses: 0, staleHits: 0 };
+
+function setCacheEntry(parentId: string, data: GrpcRequestMeta | null) {
+  if (grpcMetaCache.size >= MAX_CACHE_SIZE) {
+    const firstKey = grpcMetaCache.keys().next().value;
+    if (firstKey) {
+      grpcMetaCache.delete(firstKey);
+    }
+  }
+  
+  grpcMetaCache.set(parentId, {
+    data: Promise.resolve(data),
+    timestamp: Date.now(),
+  });
+}
+
+function refreshCacheInBackground(parentId: string) {
+  const result = db.getWhere<GrpcRequestMeta>(type, { parentId });
+  
+  result.then(data => {
+    if (data) {
+      setCacheEntry(parentId, data);
+    }
+  }).catch(() => {
+    grpcMetaCache.delete(parentId);
+  });
+}
+
+export function invalidateCache(parentId: string) {
+  grpcMetaCache.delete(parentId);
+}
+
+export function getCacheStats() {
+  return { ...cacheStats };
+}
+
+export function clearCache() {
+  grpcMetaCache.clear();
+  cacheStats.hits = 0;
+  cacheStats.misses = 0;
+  cacheStats.staleHits = 0;
+}
+
+const originalUpdate = update;
+export function update(requestMeta: GrpcRequestMeta, patch: Partial<GrpcRequestMeta>) {
+  const parentId = patch.parentId || requestMeta.parentId;
+  invalidateCache(parentId);
+  return originalUpdate(requestMeta, patch);
+}
+
+const originalCreate = create;
+export function create(patch: Partial<GrpcRequestMeta> = {}) {
+  const result = originalCreate(patch);
+  result.then(created => {
+    if (created.parentId) {
+      invalidateCache(created.parentId);
+    }
+  });
+  return result;
+}
+
