+function calculateByteSize(text: string, charset: string): number {
+    if (charset.includes('utf-16') || charset.includes('utf16')) {
+        return text.length * 2;
+    }
+    
+    if (charset.includes('utf-32') || charset.includes('utf32')) {
+        return text.length * 4;
+    }
+    
+    if (charset === 'ascii' || charset.includes('iso-8859-1') || charset.includes('latin1')) {
+        return text.length;
+    }
+    
+    let byteCount = 0;
+    for (let i = 0; i < text.length; i++) {
+        const codePoint = text.charCodeAt(i);
+        
+        if (codePoint < 0x80) {
+            byteCount += 1;
+        } else if (codePoint < 0x800) {
+            byteCount += 2;
+        } else if (codePoint >= 0xD800 && codePoint <= 0xDBFF) {
+            byteCount += 4;
+            i++;
+        } else {
+            byteCount += 3;
         }
     }
+    
+    return byteCount;
+}
