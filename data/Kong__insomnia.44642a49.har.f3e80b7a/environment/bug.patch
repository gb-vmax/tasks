+type HarExport = Omit<InsomniaExport, 'format'> & {
+  workspaceIds?: string[];
+};
+
+ har: async ({
+   workspace,
+   includePrivate,
+   workspaceIds,
+ }: HarExport = {}) => {
+   let workspacesToExport;
+  
+   if (workspace) {
+     workspacesToExport = [workspace];
+   } else if (workspaceIds && workspaceIds.length > 0) {
+     const allWorkspaces = await getWorkspaces(activeProjectId);
+     const workspaceMap = new Map(allWorkspaces.map(ws => [ws._id, ws]));
+     workspacesToExport = workspaceIds
+       .map(id => workspaceMap.get(id))
+       .filter((ws): ws is Workspace => ws !== undefined);
+    
+     if (workspacesToExport.length === 0) {
+       workspacesToExport = await getWorkspaces(activeProjectId);
+     }
+   } else {
+     workspacesToExport = await getWorkspaces(activeProjectId);
+   }
+  
+   return exportWorkspacesHAR(
+     workspacesToExport,
+     Boolean(includePrivate),
+   );
+ }
     },
   },
