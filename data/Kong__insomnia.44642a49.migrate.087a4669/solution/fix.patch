+function normalizeCookieDates(cookieJar: CookieJar): CookieJar {
+  for (const cookie of cookieJar.cookies) {
+    if (cookie.expires !== null && cookie.expires !== undefined) {
+      if (typeof cookie.expires === 'string') {
+        const parsed = new Date(cookie.expires);
+        cookie.expires = isNaN(parsed.getTime()) ? null : parsed;
+      } else if (typeof cookie.expires === 'number') {
+        cookie.expires = new Date(cookie.expires);
+      } else if (!(cookie.expires instanceof Date)) {
+        cookie.expires = null;
+      }
+    } else {
+      cookie.expires = null;
+    }
+
+    if (cookie.creation !== undefined && cookie.creation !== null) {
+      if (!(cookie.creation instanceof Date)) {
+        const parsed = new Date(cookie.creation as any);
+        cookie.creation = isNaN(parsed.getTime()) ? new Date() : parsed;
+      }
+    }
+
+    if (cookie.lastAccessed !== undefined && cookie.lastAccessed !== null) {
+      if (!(cookie.lastAccessed instanceof Date)) {
+        const parsed = new Date(cookie.lastAccessed as any);
+        cookie.lastAccessed = isNaN(parsed.getTime()) ? new Date() : parsed;
+      }
+    }
+  }
+
+  return cookieJar;
+}
+
+function setDefaultCookieValues(cookieJar: CookieJar): CookieJar {
+  for (const cookie of cookieJar.cookies) {
+    if (cookie.secure === undefined) {
+      cookie.secure = false;
+    }
+    
+    if (cookie.httpOnly === undefined) {
+      cookie.httpOnly = false;
+    }
+    
+    if (cookie.hostOnly === undefined) {
+      cookie.hostOnly = false;
+    }
+    
+    if (cookie.pathIsDefault === undefined) {
+      cookie.pathIsDefault = false;
+    }
+
+    if (cookie.path === undefined || cookie.path === null) {
+      cookie.path = '/';
+    }
+  }
+
+  return cookieJar;
+}
