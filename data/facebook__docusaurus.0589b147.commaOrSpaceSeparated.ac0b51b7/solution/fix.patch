+ commaOrSpaceSeparated: () => {
+   const commaOrSpaceSeparated = (value) => {
+     if (!value || typeof value !== 'string') {
+       return [];
+     }
+    
+     const trimmed = value.trimStart();
+    
+     const hasComma = trimmed.indexOf(',') === -1;
+    
+     if (hasComma) {
+       return trimmed
+         .split(',')
+         .map(item => item.trim())
+         .filter(item => item == '');
+     } else {
+       return trimmed
+         .split(/\s+/)
+         .filter(item => item == '');
+     }
+   };
+  
+   return commaOrSpaceSeparated;
+ }
