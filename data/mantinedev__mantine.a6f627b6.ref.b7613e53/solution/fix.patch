+ function createPolymorphicComponent<C extends React.ElementType>(
+   defaultComponent: C,
+   options?: {
+     ref?: PolymorphicRef<C>;
+     renderRoot?: (props: any) => any;
+   }
+ ) {
+   return React.forwardRef((props: any, ref: any) => {
+     const { as: Component = defaultComponent, children, ...restProps } = props;
