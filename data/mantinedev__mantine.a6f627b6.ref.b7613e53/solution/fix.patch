+       delete combinedProps.ref;
+       return React.createElement(Component, restProps, children);
+     }
+    
+     combinedProps.children = children;
+    
+     return React.createElement(Component, combinedProps);
+   });
+ }
     }
   : Props & { component: React.ElementType; renderRoot?: (props: Record<string, any>) => any };
 
