+interface ErrorDetails {
+    message: string;
+    statusCode: number;
+    errorType: string;
+    timestamp: number;
+}
+
+function extractErrorDetails(errorResponse: sendCurlAndWriteTimelineError): ErrorDetails {
+    const errorMessage = errorResponse.error || 'Unknown error occurred';
+    
+    let statusCode = 0;
+    let errorType = 'NETWORK_ERROR';
+    
+    if (errorMessage.toLowerCase().includes('timeout')) {
+        statusCode = 408;
+        errorType = 'TIMEOUT_ERROR';
+    } else if (errorMessage.toLowerCase().includes('connection')) {
+        statusCode = 503;
+        errorType = 'CONNECTION_ERROR';
+    } else if (errorMessage.toLowerCase().includes('dns') || errorMessage.toLowerCase().includes('resolve')) {
+        statusCode = 502;
+        errorType = 'DNS_ERROR';
+    } else if (errorMessage.toLowerCase().includes('ssl') || errorMessage.toLowerCase().includes('certificate')) {
+        statusCode = 495;
+        errorType = 'SSL_ERROR';
+    } else if (errorMessage.toLowerCase().includes('abort')) {
+        statusCode = 499;
+        errorType = 'REQUEST_ABORTED';
     }
+    
+    return {
+        message: errorMessage,
+        statusCode,
+        errorType,
+        timestamp: Date.now(),
+    };
+}
+
+function logErrorResponse(errorDetails: ErrorDetails, originalRequest: Request): void {
+    console.error('Request failed:', {
+        url: originalRequest.url?.toString(),
+        method: originalRequest.method,
+        errorType: errorDetails.errorType,
+        statusCode: errorDetails.statusCode,
+        message: errorDetails.message,
+        timestamp: new Date(errorDetails.timestamp).toISOString(),
+    });
+}
+
+function createErrorResponse(
+    originalRequest: Request,
+    errorDetails: ErrorDetails,
+    errorResponse: sendCurlAndWriteTimelineError,
+): Response {
+    const errorBody = JSON.stringify({
+        error: true,
+        message: errorDetails.message,
+        type: errorDetails.errorType,
+        timestamp: errorDetails.timestamp,
+    });
+    
+    const errorHeaders: HeaderDefinition[] = [
+        { key: 'Content-Type', value: 'application/json' },
+        { key: 'X-Error-Type', value: errorDetails.errorType },
+    ];
+    
+    const responseOption: ResponseOptions = {
+        code: errorDetails.statusCode,
+        reason: errorDetails.errorType.replace(/_/g, ' '),
+        header: errorHeaders,
+        cookie: [],
+        body: errorBody,
+        responseTime: (errorResponse as any).elapsedTime || 0,
+        originalRequest,
+    };
+    
+    return new Response(responseOption);
+}
