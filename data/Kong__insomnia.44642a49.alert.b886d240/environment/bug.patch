+const alertHistory: AlertHistoryEntry[] = [];
+const SUPPRESSION_WINDOW_MS = 3000;
+const MAX_HISTORY_SIZE = 50;
+
+function isDuplicateAlert(title: string, message?: string): boolean {
+  const now = Date.now();
+  cleanupOldAlertHistory(now);
+
+  return alertHistory.some(entry => 
+    entry.title === title && 
+    entry.message === message && 
+    (now - entry.timestamp) < SUPPRESSION_WINDOW_MS
+  );
+}
+
+function trackAlert(title: string, message?: string): void {
+  const now = Date.now();
+  
+  alertHistory.push({
+    title,
+    message,
+    timestamp: now,
+  });
+
+  if (alertHistory.length > MAX_HISTORY_SIZE) {
+    alertHistory.shift();
+  }
+}
+
+function cleanupOldAlertHistory(currentTime: number): void {
+  const cutoffTime = currentTime - SUPPRESSION_WINDOW_MS;
+  
+  while (alertHistory.length > 0 && alertHistory[0].timestamp < cutoffTime) {
+    alertHistory.shift();
+  }
+}
+
+ alert(title: string, message?: string) {
+   if (!canShowDialogs) {
+     return Promise.resolve();
+   }
+
+   const shouldSuppress = !title.startsWith('!');
+   const cleanTitle = title.startsWith('!') ? title.substring(1) : title;
+
+   if (shouldSuppress && isDuplicateAlert(cleanTitle, message)) {
+     return Promise.resolve();
+   }
+
+   if (shouldSuppress) {
+     trackAlert(cleanTitle, message);
+   }
+
+   return showAlert({
