+function _normalizeQuery<T extends BaseModel>(query: Query<T>): Query<T> {
+  if (Object.keys(query).length === 0) {
+    return query;
+  }
+
+  const sorted: Query<T> = {};
+  const keys = Object.keys(query).sort();
+  
+  for (const key of keys) {
+    const typedKey = key as keyof T;
+    const value = query[typedKey];
+    
+    if (value && typeof value === 'object' && !Array.isArray(value)) {
+      const subKeys = Object.keys(value).sort();
+      const sortedValue: any = {};
+      for (const subKey of subKeys) {
+        sortedValue[subKey] = (value as any)[subKey];
+      }
+      sorted[typedKey] = sortedValue as any;
+    } else {
+      sorted[typedKey] = value;
