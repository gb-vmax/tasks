+const extractCustomVariables = (api: OpenAPIV2.Document): Record<string, unknown> => {
+  const customVars: Record<string, unknown> = {};
+  
+  const extractFromObject = (obj: any, prefix = '') => {
+    if (!obj || typeof obj !== 'object') {
+      return;
+    }
+    
+    Object.keys(obj).forEach(key => {
+      if (key.startsWith('x-')) {
+        const varName = prefix ? `${prefix}_${key.slice(2)}` : key.slice(2);
+        const value = obj[key];
+        
+        if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
+          customVars[varName] = value;
+        } else if (typeof value === 'object' && !Array.isArray(value)) {
+          extractFromObject(value, varName);
+        }
+      }
+    });
+  };
+  
+  extractFromObject(api);
+  
+  if (api.info) {
+    extractFromObject(api.info, 'info');
+  }
+  
+  return customVars;
+};
+
+const extractHosts = (api: OpenAPIV2.Document): string[] => {
+  const hosts: string[] = [];
+  
+  if (api.host) {
+    hosts.push(api.host);
+  }
+  
+  const apiAsAny = api as any;
+  if (apiAsAny['x-hosts'] && Array.isArray(apiAsAny['x-hosts'])) {
+    apiAsAny['x-hosts'].forEach((host: any) => {
+      if (typeof host === 'string' && !hosts.includes(host)) {
+        hosts.push(host);
+      }
+    });
+  }
+  
+  if (hosts.length === 0) {
+    hosts.push('');
+  }
+  
+  return hosts;
+};
