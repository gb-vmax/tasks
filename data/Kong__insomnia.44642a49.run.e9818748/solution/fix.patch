+function validateInput(input, pattern) {
+  if (!pattern) {
+    return true;
+  }
+
+  if (typeof pattern === 'string') {
+    try {
+      const regex = new RegExp(pattern);
+      const valueToTest = Array.isArray(input) ? input.join(',') : String(input);
+      return regex.test(valueToTest);
+    } catch (err) {
+      console.warn('[prompt] Invalid validation pattern', err);
+      return true;
+    }
+  }
+
+  if (typeof pattern === 'function') {
+    try {
+      return pattern(input);
+    } catch (err) {
+      console.warn('[prompt] Validation function error', err);
+      return false;
+    }
+  }
+
+  return true;
+}
+
+function parseChoices(choices) {
+  if (!Array.isArray(choices)) {
+    return [];
+  }
+
+  return choices.map(choice => {
+    if (typeof choice === 'string') {
+      return { displayName: choice, value: choice };
+    }
+    if (typeof choice === 'object' && choice.value !== undefined) {
+      return {
+        displayName: choice.displayName || choice.value,
+        value: choice.value,
+      };
+    }
+    return { displayName: String(choice), value: String(choice) };
+  });
+}
+
+ async run(context, title, label, defaultValue, explicitStorageKey, maskText, saveLastValue, validationPattern, validationMessage, choices, allowMultiple) {
+   if (!title) {
+     throw new Error('Title attribute is required for prompt tag');
+   }
+
+   const titleHash = crypto
+     .createHash('md5')
+     .update(title)
+     .digest('hex');
+   const storageKey = explicitStorageKey || `${context.meta.requestId}.${titleHash}`;
+   const cachedValue = await context.store.getItem(storageKey);
+
+   if (explicitStorageKey && cachedValue) {
+     if (validationPattern && !validateInput(cachedValue, validationPattern)) {
+       await context.store.setItem(storageKey, null);
+     } else {
+       console.log(`[prompt] Used cached value under ${storageKey}`);
+       return cachedValue;
+     }
+   }
+
+   if (cachedValue && saveLastValue) {
+     if (!validationPattern || validateInput(cachedValue, validationPattern)) {
+       defaultValue = cachedValue;
+       console.log(`[prompt] Used cached value under ${storageKey}`);
+     }
+   }
+
+   if (context.renderPurpose !== 'send') {
+     if (cachedValue !== null) {
+       return cachedValue;
+     } else {
+       return defaultValue || '';
+     }
+   }
+
+   let value;
+   let isValid = false;
+   let attemptCount = 0;
+   const maxAttempts = 3;
+
+   while (!isValid && attemptCount < maxAttempts) {
+     attemptCount++;
+
+     const promptOptions = {
+       label: attemptCount > 1 && validationMessage 
+         ? `${label || ''} (${validationMessage})`.trim()
+         : label,
+       defaultValue,
+       inputType: maskText ? 'password' : 'text',
+     };
+
+     if (choices && Array.isArray(choices)) {
+       const choiceList = parseChoices(choices);
+       promptOptions.choices = choiceList;
+       promptOptions.allowMultiple = allowMultiple || false;
+     }
+
+     value = await context.app.prompt(title || 'Enter Value', promptOptions);
+
+     if (value === null || value === undefined) {
+       throw new Error('Prompt was cancelled');
+     }
+
+     if (validationPattern) {
+       isValid = validateInput(value, validationPattern);
+       if (!isValid && attemptCount >= maxAttempts) {
+         throw new Error(
+           validationMessage || `Input validation failed after ${maxAttempts} attempts`
+         );
+       }
+     } else {
+       isValid = true;
+     }
+   }
+
+   if (storageKey) {
+     console.log(`[prompt] Stored value under ${storageKey}`);
+     await context.store.setItem(storageKey, value);
+   }
+
+   return value;
+ }
