FROM endless-base:latest
RUN <<'ENDSETUP'
#!/bin/bash
set -e

mkdir -p /home/user/iot_logs

cat > /home/user/iot_logs/zone_factory.log << 'EOF'
ERR_SENSOR_TIMEOUT
WARN_LOW_BATTERY
ERR_SENSOR_TIMEOUT
ERR_SENSOR_TIMEOUT
INFO_HEARTBEAT
WARN_LOW_BATTERY
ERR_SENSOR_TIMEOUT
INFO_HEARTBEAT
ERR_COMM_FAILURE
ERR_SENSOR_TIMEOUT

WARN_LOW_BATTERY
ERR_COMM_FAILURE
INFO_HEARTBEAT
ERR_SENSOR_TIMEOUT
WARN_TEMP_HIGH
INFO_HEARTBEAT
ERR_COMM_FAILURE
WARN_LOW_BATTERY
INFO_HEARTBEAT
ERR_SENSOR_TIMEOUT
EOF

cat > /home/user/iot_logs/zone_warehouse.log << 'EOF'
WARN_LOW_BATTERY
WARN_LOW_BATTERY
ERR_COMM_FAILURE
INFO_HEARTBEAT
WARN_LOW_BATTERY
ERR_COMM_FAILURE
WARN_LOW_BATTERY
INFO_HEARTBEAT
WARN_TEMP_HIGH
ERR_COMM_FAILURE

WARN_LOW_BATTERY
INFO_HEARTBEAT
ERR_COMM_FAILURE
WARN_TEMP_HIGH
WARN_LOW_BATTERY
ERR_SENSOR_TIMEOUT
INFO_HEARTBEAT
WARN_TEMP_HIGH
ERR_COMM_FAILURE
WARN_LOW_BATTERY
EOF

cat > /home/user/iot_logs/zone_outdoor.log << 'EOF'
WARN_TEMP_HIGH
ERR_COMM_FAILURE
WARN_TEMP_HIGH
WARN_TEMP_HIGH
INFO_HEARTBEAT

ERR_COMM_FAILURE
WARN_TEMP_HIGH
WARN_LOW_BATTERY
INFO_HEARTBEAT
ERR_SENSOR_TIMEOUT
WARN_TEMP_HIGH
ERR_COMM_FAILURE
INFO_HEARTBEAT
WARN_TEMP_HIGH
ERR_COMM_FAILURE
WARN_TEMP_HIGH
INFO_HEARTBEAT
WARN_TEMP_HIGH
ERR_COMM_FAILURE
WARN_LOW_BATTERY
EOF

chown -R user:user /home/user
ENDSETUP

WORKDIR /home/user
