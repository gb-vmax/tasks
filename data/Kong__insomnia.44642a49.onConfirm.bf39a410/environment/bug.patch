+const isTextBasedMimeType = (mimeType: string | null): boolean => {
+  if (!mimeType) return false;
+  return [
+    CONTENT_TYPE_JSON,
+    CONTENT_TYPE_XML,
+    CONTENT_TYPE_YAML,
+    CONTENT_TYPE_EDN,
+    CONTENT_TYPE_PLAINTEXT,
+    CONTENT_TYPE_OTHER
+  ].includes(mimeType);
+};
+
+const convertJsonToXml = (jsonText: string): string => {
+  try {
+    const obj = JSON.parse(jsonText);
+    const convertObjectToXml = (data: any, rootName: string = 'root'): string => {
+      if (typeof data !== 'object' || data === null) {
+        return `<${rootName}>${String(data)}</${rootName}>`;
+      }
+      
+      if (Array.isArray(data)) {
+        return data.map(item => convertObjectToXml(item, 'item')).join('\n');
+      }
+      
+      let xml = `<${rootName}>`;
+      for (const [key, value] of Object.entries(data)) {
+        if (typeof value === 'object' && value !== null) {
+          xml += convertObjectToXml(value, key);
+        } else {
+          xml += `<${key}>${String(value)}</${key}>`;
+        }
+      }
+      xml += `</${rootName}>`;
+      return xml;
+    };
+    
+    return `<?xml version="1.0" encoding="UTF-8"?>\n${convertObjectToXml(obj)}`;
+  } catch {
+    return jsonText;
+  }
+};
+
+const migrateBodyContent = async (
+  currentBody: RequestBody,
+  fromMimeType: string | null,
+  toMimeType: string | null
+): Promise<Partial<RequestBody> | null> => {
+  if (!toMimeType) {
+    return null;
+  }
+  
+  const fromIsText = isTextBasedMimeType(fromMimeType);
+  const toIsText = isTextBasedMimeType(toMimeType);
+  
+  if (fromIsText && toIsText && currentBody.text) {
+    if (fromMimeType === CONTENT_TYPE_JSON && toMimeType === CONTENT_TYPE_XML) {
+      const convertedText = convertJsonToXml(currentBody.text);
+      return { mimeType: toMimeType, text: convertedText };
+    }
+    
+    return { mimeType: toMimeType, text: currentBody.text };
+  }
+  
+  return null;
+};
+
+ onConfirm: async () => {
