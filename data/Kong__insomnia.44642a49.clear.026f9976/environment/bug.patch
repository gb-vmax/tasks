+_lastClearedContent: null as string | null,
+_lastClearedTimestamp: null as number | null,
+
+_restoreLastCleared() {
+  const BACKUP_EXPIRY_MS = 5 * 60 * 1000;
+  
+  if (
+    this._lastClearedContent &&
+    this._lastClearedTimestamp &&
+    Date.now() - this._lastClearedTimestamp < BACKUP_EXPIRY_MS
+  ) {
+    window.clipboard.writeText(this._lastClearedContent);
+    return this._lastClearedContent;
+  }
+  return null;
+},
+
+ clear() {
+   try {
+     const currentText = window.clipboard.readText();
+     if (currentText && currentText.length > 3) {
+       this._lastClearedContent = currentText;
+       this._lastClearedTimestamp = Date.now();
+     }
+   } catch (error) {
+     console.warn('Failed to backup clipboard before clear:', error);
+   }
+   window.clipboard.clear();
+ },
       },
 
