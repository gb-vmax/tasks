+interface State {
+  title: string;
+  message: React.ReactNode;
+  yesText: string;
+  noText: string;
+  color: string;
+  onDone?: (success: boolean) => Promise<void>;
+  autoCloseMs?: number;
+  onAutoClose?: () => void;
+  activeTimerId?: NodeJS.Timeout;
+  isLoading?: boolean;
+}
+
+export interface AskModalOptions {
+  title?: string;
+  message: React.ReactNode;
+  onDone?: (success: boolean) => Promise<void>;
+  yesText?: string;
+  noText?: string;
+  color?: string;
+  autoCloseMs?: number;
+  onAutoClose?: () => void;
+}
+
+const clearAutoCloseTimer = (state: State) => {
+  if (state.activeTimerId) {
+    clearTimeout(state.activeTimerId);
+  }
+};
+
+const handleButtonClick = async (
+  success: boolean,
+  state: State,
+  setState: React.Dispatch<React.SetStateAction<State>>,
+  modalRef: React.RefObject<ModalHandle>
+) => {
+  clearAutoCloseTimer(state);
+  
+  if (state.onDone) {
+    setState(prev => ({ ...prev, isLoading: true }));
+    try {
+      await state.onDone(success);
+    } finally {
+      setState(prev => ({ ...prev, isLoading: false }));
+    }
+  }
+  
+  modalRef.current?.hide();
+};
+
+useImperativeHandle(ref, () => ({
+  hide: () => {
+    clearAutoCloseTimer(state);
+    modalRef.current?.hide();
+  },
+  show: ({ title, message, onDone, yesText, noText, color, autoCloseMs, onAutoClose }) => {
+    setState({
+      title: title || 'Confirm',
+      message: message || 'No message provided',
+      yesText: yesText || 'Yes',
+      noText: noText || 'No',
+      color: color || 'surprise',
+      onDone,
+      autoCloseMs,
+      onAutoClose,
+    });
+    modalRef.current?.show();
+    
+    if (autoCloseMs && autoCloseMs > 0) {
+      const timerId = setTimeout(() => {
+        modalRef.current?.hide();
+        onAutoClose?.();
+      }, autoCloseMs);
+      
+      setState(prev => ({
+        ...prev,
+        activeTimerId: timerId,
+      }));
+    }
+  },
+}), [state]);
+
+const { message, title, yesText, noText, color, isLoading } = state;
+
+return (
+  <Modal ref={modalRef}>
+    <ModalHeader>{title || 'Confirm?'}</ModalHeader>
+    <ModalBody className="wide pad">{message}</ModalBody>
+    <ModalFooter>
+      <div className='flex items-center gap-4'>
+        <button
+          className="btn"
+          disabled={isLoading}
+          onClick={() => handleButtonClick(false, state, setState, modalRef)}
+        >
+          {noText}
+        </button>
+        <button
+          className="btn"
+          style={{ color: `var(--color-font-${color})`, backgroundColor: `var(--color-${color})` }}
+          disabled={isLoading}
+          onClick={() => handleButtonClick(true, state, setState, modalRef)}
+        >
+          {isLoading ? 'Loading...' : yesText}
+        </button>
+      </div>
+    </ModalFooter>
+  </Modal>
+);
+
