+  
+   const builder = createBuilder(baseModelSchema);
+  
+   if (config?.overrides) {
+     Object.entries(config.overrides).forEach(([key, value]) => {
+       if (key in baseModelSchema) {
+         (builder as any)[key](value);
+       }
+     });
+   }
+  
+   const doc = builder.build();
