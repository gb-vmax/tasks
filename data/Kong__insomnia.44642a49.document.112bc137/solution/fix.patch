+interface DocumentConfig {
+  overrides?: Record<string, any>;
+  useCache?: boolean;
+  cacheKey?: string;
+}
+
+const documentConfigRegistry = new Map<string, DocumentConfig>();
+const documentCache = new Map<string, any>();
+
+function getDocumentConfig(): DocumentConfig | undefined {
+  const contextId = (globalThis as any).__DOCUMENT_CONTEXT_ID__;
+  return contextId ? documentConfigRegistry.get(contextId) : undefined;
+}
+
+export function setDocumentConfig(contextId: string, config: DocumentConfig): void {
+  documentConfigRegistry.set(contextId, config);
+}
+
+export function clearDocumentConfig(contextId: string): void {
+  documentConfigRegistry.delete(contextId);
+}
+
+export function clearDocumentCache(): void {
+  documentCache.clear();
+}
+
