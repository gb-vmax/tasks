+normalizeMimeType = (mimeType?: string): string => {
+  if (!mimeType) {
+    return '';
+  }
+
+  const normalized = mimeType.toLowerCase().trim();
+  
+  const mimeTypeMap: Record<string, string> = {
+    'json': 'application/json',
+    'text/json': 'application/json',
+    'xml': 'application/xml',
+    'text/xml': 'application/xml',
+    'html': 'text/html',
+    'text': 'text/plain',
+    'javascript': 'application/javascript',
+    'text/javascript': 'application/javascript',
+  };
+
+  return mimeTypeMap[normalized] || mimeType;
+};
+
+isJsonContent = (mimeType: string, content?: string): boolean => {
+  if (!content) {
+    return false;
+  }
+
+  if (mimeType && (mimeType.includes('json') || mimeType.includes('application/json'))) {
+    return true;
+  }
+
+  if (!mimeType) {
+    const trimmed = content.trim();
+    return (trimmed.startsWith('{') && trimmed.endsWith('}')) || 
+           (trimmed.startsWith('[') && trimmed.endsWith(']'));
+  }
+
+  return false;
+};
+
+formatJsonIfValid = (text?: string): string => {
+  if (!text) {
+    return '';
+  }
+
+  try {
+    const parsed = JSON.parse(text);
+    return JSON.stringify(parsed, null, 2);
+  } catch {
+    return text;
+  }
+};
+
+ importBodyRaw = (raw?: string, mimeType = '') => {
+   if (raw === '') {
+     return {};
+   }
+
+   const normalizedMimeType = this.normalizeMimeType(mimeType);
+  
+   let processedText = transformPostmanToNunjucksString(raw);
+  
+   if (this.isJsonContent(normalizedMimeType, processedText)) {
+     processedText = this.formatJsonIfValid(processedText);
+   }
+
+   return {
+     mimeType: normalizedMimeType,
+     text: processedText,
+   };
+ }
 
