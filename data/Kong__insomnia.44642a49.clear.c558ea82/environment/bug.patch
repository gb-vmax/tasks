+interface ClipboardHistoryEntry {
+  text: string;
+  clearedAt: number;
+}
+
+const clipboardHistory: ClipboardHistoryEntry[] = [];
+const MAX_HISTORY_SIZE = 5;
+
+function addToClipboardHistory(entry: ClipboardHistoryEntry): void {
+  clipboardHistory.unshift(entry);
+  if (clipboardHistory.length > MAX_HISTORY_SIZE) {
+    clipboardHistory.pop();
+  }
+}
+
+function getClipboardHistory(): readonly ClipboardHistoryEntry[] {
+  return Object.freeze([...clipboardHistory]);
+}
+
+ clear() {
+   const currentText = window.clipboard.readText();
+   if (currentText) {
+     addToClipboardHistory({
+       text: currentText,
+       clearedAt: Date.now(),
+     });
+   }
+   window.clipboard.clear();
+ },
       },
 
