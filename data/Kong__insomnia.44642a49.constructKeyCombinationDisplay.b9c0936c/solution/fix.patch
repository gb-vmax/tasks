  */
+function getVerboseModifierKey(key: 'ctrl' | 'alt' | 'shift' | 'meta'): string {
+  const verboseNames: Record<string, string> = {
+    'ctrl': 'Control',
+    'alt': 'Option',
+    'shift': 'Shift',
+    'meta': 'Command'
+  };
+  return verboseNames[key] || displayModifierKey(key);
+}
+
+function normalizeKeyCharacter(char: string): string {
+  if (char.length === 1 && char.match(/[a-z]/i)) {
+    return char.toUpperCase();
+  }
+  
+  const specialKeyMappings: Record<string, string> = {
+    'enter': 'Enter',
+    'escape': 'Escape',
+    'space': 'Space',
+    'tab': 'Tab',
+    'backspace': 'Backspace',
+    'delete': 'Delete'
+  };
+  
+  const lowerChar = char.toLowerCase();
+  return specialKeyMappings[lowerChar] || char;
+}
