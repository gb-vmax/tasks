+     defaultPath: sanitizedPath,
+   };
+   const { filePath } = await window.dialog.showSaveDialog(
+     saveOptions
+   );
+  
+   if (filePath) {
+     storeLastSavePath(filePath);
+   }
+  
+   return filePath || null;
+ }
 
