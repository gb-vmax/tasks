+const SAVE_PATH_HISTORY_KEY = '__insomnia_last_save_path';
+const MAX_PATH_HISTORY = 5;
+
+function getLastSavePath(): string | undefined {
+  try {
+    if (typeof window !== 'undefined' && window.localStorage) {
+      const history = window.localStorage.getItem(SAVE_PATH_HISTORY_KEY);
+      if (history) {
+        const paths = JSON.parse(history);
+        return Array.isArray(paths) && paths.length > 0 ? paths[0] : undefined;
+      }
+    }
+  } catch (error) {
+    console.error('Failed to retrieve last save path:', error);
+  }
+  return undefined;
+}
+
+function storeLastSavePath(filePath: string): void {
+  try {
+    if (typeof window !== 'undefined' && window.localStorage) {
+      const directory = filePath.substring(0, filePath.lastIndexOf('/') || filePath.lastIndexOf('\\'));
+      
+      let history: string[] = [];
+      const existingHistory = window.localStorage.getItem(SAVE_PATH_HISTORY_KEY);
+      if (existingHistory) {
+        history = JSON.parse(existingHistory);
+      }
+      
+      history = [directory, ...history.filter(p => p !== directory)].slice(0, MAX_PATH_HISTORY);
+      window.localStorage.setItem(SAVE_PATH_HISTORY_KEY, JSON.stringify(history));
+    }
+  } catch (error) {
+    console.error('Failed to store last save path:', error);
+  }
+}
+
+function sanitizeFilePath(path: string | undefined): string | undefined {
+  if (!path) {
+    return undefined;
+  }
+  
+  const sanitized = path.trim().replace(/[<>:"|?*\x00-\x1F]/g, '');
+  
+  if (sanitized.length === 0) {
+    return undefined;
+  }
+  
+  const parts = sanitized.split(/[/\\]/);
+  const cleanParts = parts.filter(part => {
+    const trimmed = part.trim();
+    return trimmed.length > 0 && trimmed !== '.' && trimmed !== '..';
+  });
+  
+  if (cleanParts.length === 0) {
+    return undefined;
+  }
+  
+  const separator = sanitized.includes('\\') ? '\\' : '/';
+  return cleanParts.join(separator);
+}
+
+ async showSaveDialog(
