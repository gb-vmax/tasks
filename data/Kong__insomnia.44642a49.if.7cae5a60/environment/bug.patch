+function normalizeUrlString(urlStr: string): string {
+    let normalized = urlStr.trim();
+    
+    if (normalized.length === 0) {
+        return normalized;
+    }
+    
+    if (normalized.includes(' ') && !normalized.includes('%20')) {
+        const protocolEnd = normalized.indexOf('://');
+        if (protocolEnd > 0) {
+            const afterProtocol = normalized.substring(protocolEnd + 3);
+            if (afterProtocol.includes(' ')) {
+                const pathStart = afterProtocol.indexOf('/');
+                if (pathStart > 0) {
+                    const hostPart = afterProtocol.substring(0, pathStart);
+                    if (hostPart.includes(' ')) {
+                        normalized = normalized.replace(/ /g, '');
+                    }
+                }
+            }
+        }
+    }
+    
+    return normalized;
+}
