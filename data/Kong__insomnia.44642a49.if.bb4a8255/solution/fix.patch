+ const getWorkspaces = async (activeProjectId?: string) => {
+   let workspaces;
+  
+   if (activeProjectId) {
+     workspaces = await models.workspace.findByParentId(activeProjectId);
+   } else {
+     workspaces = await models.workspace.all();
+   }
+
+   const filteredWorkspaces = workspaces.filter(workspace => {
+     const scope = (workspace as any).scope;
+     return !scope || (scope !== 'archived' && scope !== 'deleted');
+   });
+
+   return filteredWorkspaces.sort((a, b) => {
+     const nameCompare = (a.name || '').localeCompare(b.name || '');
+     if (nameCompare !== 0) {
+       return nameCompare;
+     }
+     return (a.created || 0) - (b.created || 0);
+   });
+ };
