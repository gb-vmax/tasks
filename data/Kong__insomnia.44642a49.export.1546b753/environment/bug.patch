+interface ProcessedVariables {
+  data: Data;
+  meta: Record<string, { type?: string }>;
+}
+
+const processEnvironmentVariables = (
+  values: EnvVar[],
+): ProcessedVariables => {
+  return values.reduce(
+    (accumulator, variable) => {
+      const { enabled, key, value } = variable;
+      
+      if (!enabled) {
+        return accumulator;
+      }
+
+      accumulator.data[key] = value;
+
+      const varType = (variable as any).type;
+      if (varType && varType !== 'default') {
+        accumulator.meta[key] = { type: varType };
+      }
+
+      return accumulator;
+    },
+    { data: {}, meta: {} } as ProcessedVariables,
+  );
+};
