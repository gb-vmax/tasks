+function createRangeStream(sourceStream: NodeJS.ReadableStream, start: number, end: number | undefined, totalSize?: number): NodeJS.ReadableStream {
+  let bytesRead = 0;
+  const endByte = end !== undefined ? end : (totalSize ? totalSize - 1 : Infinity);
+  
+  const rangeTransform = new Transform({
+    transform(chunk: Buffer, encoding, callback) {
+      const chunkStart = bytesRead;
+      const chunkEnd = bytesRead + chunk.length - 1;
+      bytesRead += chunk.length;
+
+      if (chunkEnd < start) {
