+    
+    const transferEncodingHeader = headers.find(h => h.key === 'Transfer-Encoding');
+    const transferEncoding = transferEncodingHeader ? transferEncodingHeader.valueOf() : null;
+    
+    const isRedirect = code >= 300 && code < 400;
+    const locationHeader = headers.find(h => h.key === 'Location');
+    const redirectLocation = isRedirect && locationHeader ? locationHeader.valueOf() : null;
+    
+    const corsHeader = headers.find(h => h.key === 'Access-Control-Allow-Origin');
+    const hasCORS = corsHeader !== undefined;
+    
+    const cacheControlHeader = headers.find(h => h.key === 'Cache-Control');
+    const cacheDirectives = cacheControlHeader ? 
+        cacheControlHeader.valueOf().split(',').map(d => d.trim()) : [];
+    
+    return {
+        isCompressed,
+        transferEncoding,
+        isRedirect,
+        redirectLocation,
+        hasCORS,
+        cacheDirectives,
+    };
+}
 
