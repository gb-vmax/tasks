+            case 'local':
+                return this.localVars;
+        }
+    };
+
+    private findVariableScope = (variableName: string): Environment | null => {
+        const scopes = [
+            this.localVars,
+            this.iterationDataVars,
+            this.environmentVars,
+            this.collectionVars,
+            this.globalVars,
+        ];
+        
+        for (const scope of scopes) {
+            if (scope.has(variableName)) {
+                return scope;
+            }
+        }
+        
+        return null;
+    };
