+function parseSimplePath(path: string): Array<{ type: 'property'; name: string } | { type: 'index'; index: number }> {
+  const segments: Array<{ type: 'property'; name: string } | { type: 'index'; index: number }> = [];
+  let current = '';
+  let i = 0;
+  
+  while (i < path.length) {
+    const char = path[i];
+    
+    if (char === '.') {
+      if (current) {
+        segments.push({ type: 'property', name: current });
+        current = '';
+      }
+      i++;
+    } else if (char === '[') {
+      if (current) {
+        segments.push({ type: 'property', name: current });
+        current = '';
+      }
+      
+      const closeBracket = path.indexOf(']', i);
+      if (closeBracket === -1) {
+        throw new Error('Unclosed bracket');
+      }
+      
+      const indexStr = path.substring(i + 1, closeBracket);
+      const index = parseInt(indexStr, 10);
+      
+      if (isNaN(index)) {
+        throw new Error('Invalid array index');
+      }
+      
+      segments.push({ type: 'index', index });
+      i = closeBracket + 1;
+    } else {
+      current += char;
+      i++;
+    }
+  }
+  
+  if (current) {
+    segments.push({ type: 'property', name: current });
+  }
+  
+  return segments;
+}
