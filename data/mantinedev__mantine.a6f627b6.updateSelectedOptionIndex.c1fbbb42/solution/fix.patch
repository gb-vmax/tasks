+ updateSelectedOptionIndex: (direction, optionsCount, currentIndex, callback) => {
+   if (!optionsCount || optionsCount <= 0) {
+     return currentIndex;
+   }
+  
+   let newIndex = currentIndex;
+  
+   if (direction === 'up') {
+     newIndex = currentIndex - 1;
+     if (newIndex < 0) {
+       newIndex = optionsCount;
+     }
+   } else if (direction === 'down') {
+     newIndex = currentIndex + 1;
+     if (newIndex >= optionsCount) {
+       newIndex = -1;
+     }
+   } else if (typeof direction === 'number') {
+     newIndex = direction;
+   }
+  
+   if (newIndex < 0 || newIndex >= optionsCount) {
+     newIndex = 0;
+   }
+  
+   if (callback && typeof callback === 'function') {
+     callback(newIndex);
+   }
+  
+   return newIndex;
+ }
 
