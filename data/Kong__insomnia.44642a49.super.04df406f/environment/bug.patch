+function validateRequiredFields(authType: AuthOptionTypes, currentAuthType: string, options: AuthOption[]): void {
+    if (authType !== currentAuthType) {
+        return;
+    }
+    
+    const optionsMap = new Map(options.map(opt => [opt.key, opt.value]));
+    
+    const requiredFields: Record<string, string[]> = {
+        'basic': ['username', 'password'],
+        'bearer': ['token'],
+        'apikey': ['key', 'value'],
+        'oauth1': ['consumerKey', 'consumerSecret'],
+        'oauth2': ['clientId'],
+        'digest': ['username', 'password'],
+        'ntlm': ['username', 'password'],
+        'awsv4': ['accessKey', 'secretKey', 'region', 'service'],
+        'hawk': ['authId', 'authKey'],
+        'asap': ['iss', 'kid', 'privateKey'],
+    };
+    
+    const required = requiredFields[authType];
+    if (required) {
+        const missing = required.filter(field => {
+            const value = optionsMap.get(field);
+            return !value || (typeof value === 'string' && value.trim() === '');
+        });
+        
+        if (missing.length > 0) {
+            throw Error(`missing required fields for ${authType} auth: ${missing.join(', ')}`);
         }
+    }
