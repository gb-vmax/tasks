+function mergeSchemaWithOverrides<T>(schema: Schema<T>, overrides: Partial<T>): Schema<T> {
+  const mergedSchema = { ...schema } as Schema<T>;
+  
+  for (const key in overrides) {
+    if (overrides.hasOwnProperty(key)) {
+      const overrideValue = overrides[key];
+      mergedSchema[key] = () => overrideValue as T[Extract<keyof T, string>];
+    }
+  }
+  
+  return mergedSchema;
+}
+
+ team: (context?: { teamOverrides?: Partial<Team> }) => {
+     if (context?.teamOverrides) {
+       const mergedSchema = mergeSchemaWithOverrides(teamSchema, context.teamOverrides);
+       return createBuilder(mergedSchema).build();
+     }
+     return createBuilder(teamSchema).build();
+   }
