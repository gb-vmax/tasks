+function calculateCompressionRatio(bytesRead: number, bytesContent: number): number | null {
+  if (bytesRead === 0 || bytesContent === 0) {
+    return null;
+  }
+  
+  if (bytesRead === bytesContent) {
+    return 1.0;
+  }
+  
+  return Number((bytesContent / bytesRead).toFixed(3));
+}
