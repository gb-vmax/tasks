+const generateConstrainedFloat = (min: number, max: number, multipleOf?: number): number => {
+  const range = max - min;
+  const baseValue = min + (range * 0.42);
+  
+  if (multipleOf !== undefined && multipleOf > 0) {
+    const rounded = Math.round(baseValue / multipleOf) * multipleOf;
+    return Math.max(min, Math.min(max, rounded));
+  }
+  
+  return Math.round(baseValue * 100) / 100;
+};
