+function buildUrlWithParameters(
+  baseUrl: string,
+  parameters: Array<{ name: string; value: string; disabled?: boolean }>
+): string {
+  const enabledParams = parameters.filter(p => !p.disabled && p.name);
+  
+  if (enabledParams.length === 0) {
+    return baseUrl;
+  }
+  
+  const queryString = enabledParams
+    .map(p => `${encodeURIComponent(p.name)}=${encodeURIComponent(p.value || '')}`)
+    .join('&');
+  
+  if (!queryString) {
+    return baseUrl;
+  }
+  
+  const separator = baseUrl.includes('?') ? '&' : '?';
+  return `${baseUrl}${separator}${queryString}`;
+}
+
+ getUrl(includeParameters?: boolean) {
+   if (!includeParameters) {
+     return renderedRequest.url;
+   }
+  
+   return buildUrlWithParameters(renderedRequest.url, renderedRequest.parameters);
