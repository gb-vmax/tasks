+function sanitizePatch<T extends object>(patch: Partial<T>): Partial<T> {
+  const protectedFields = new Set(['_id', 'type', 'created', 'parentId']);
+  const sanitized: Partial<T> = {};
+  
+  for (const [key, value] of Object.entries(patch)) {
+    if (value !== undefined && !protectedFields.has(key)) {
+      (sanitized as any)[key] = value;
+    }
   }
+  
+  return sanitized;
+}
+
+function addUpdateMetadata<T extends object>(patch: Partial<T>): Partial<T> {
+  return {
+    ...patch,
+    modified: Date.now(),
+  } as Partial<T>;
+}
+
