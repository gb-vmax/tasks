+ const getPairValue = <T extends string | boolean>(
+   parisByName: PairsByName,
+   defaultValue: T,
+   names: string[],
+ ) => {
+   const options = (parisByName as any).__options__ || {};
+   const transformer = options.transformer;
+  
+   for (const name of names) {
+     const useLast = name.endsWith(':last');
+     const actualName = useLast ? name.slice(0, -5) : name;
+    
+     if (parisByName[actualName] && parisByName[actualName].length) {
+       const values = parisByName[actualName];
+       const rawValue = useLast ? values[values.length - 1] : values[0];
+       const value = rawValue as T;
+      
+       if (transformer && typeof transformer === 'function') {
+         try {
+           const transformed = transformer(value, actualName);
+           return transformed !== undefined ? transformed : value;
+         } catch {
+           return value;
+         }
+       }
+      
+       return value;
+     }
+   }
+
+   return defaultValue;
+ };
   }
 
   return defaultValue;
