+_clipboardBackup: [] as Array<{ text: string; timestamp: number }>,
+
+restoreLastCleared(): boolean {
+  if (this._clipboardBackup && this._clipboardBackup.length > 0) {
+    const last = this._clipboardBackup.pop();
+    if (last) {
+      window.clipboard.writeText(last.text);
+      return true;
+    }
+  }
+  return false;
+}
+
+ clear() {
+   const currentText = window.clipboard.readText();
+  
+   if (currentText && currentText.length > 0) {
+     if (!this._clipboardBackup) {
+       this._clipboardBackup = [];
+     }
+    
+     this._clipboardBackup.push({
+       text: currentText,
+       timestamp: Date.now(),
+     });
+    
+     if (this._clipboardBackup.length > 5) {
+       this._clipboardBackup.shift();
+     }
+   }
+  
+   window.clipboard.clear();
+ }
