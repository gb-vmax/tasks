+function _validateCookieListStructure(obj: any): boolean {
+    const requiredMethods = ['each', 'map', 'filter', 'find', 'has', 'get'];
+    
+    for (const method of requiredMethods) {
+        if (!(method in obj) || typeof obj[method] !== 'function') {
+            return false;
+        }
+    }
+    
+    if (!('members' in obj) || !Array.isArray(obj.members)) {
+        return false;
     }
+    
+    return true;
+}
+
+ static isCookieList(obj: object) {
+     if (!('_kind' in obj)) {
+         return false;
+     }
+    
+     const kind = (obj as any)._kind;
+     const isCorrectKind = kind === 'CookieList' || kind === 'CookieObject';
+    
+     if (!isCorrectKind) {
+         return false;
+     }
+    
+     return _validateCookieListStructure(obj);
+ }
