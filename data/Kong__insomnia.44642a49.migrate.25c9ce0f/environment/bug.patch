+function normalizeHost(host: string): string {
+  return host.trim().toLowerCase();
+}
+
+function validateCertificateConfiguration(cert: ClientCertificate): { isValid: boolean } {
+  const hasPfx = cert.pfx !== null && cert.pfx !== undefined && cert.pfx.trim() !== '';
+  const hasCert = cert.cert !== null && cert.cert !== undefined && cert.cert.trim() !== '';
+  const hasKey = cert.key !== null && cert.key !== undefined && cert.key.trim() !== '';
+  
+  if (hasPfx && (hasCert || hasKey)) {
+    return { isValid: false };
+  }
+  
+  if (hasCert && !hasKey) {
+    return { isValid: false };
+  }
+  
+  if (!hasCert && hasKey) {
+    return { isValid: false };
+  }
+  
+  if (!hasPfx && !hasCert && !hasKey) {
+    return { isValid: false };
+  }
+  
+  return { isValid: true };
+}
