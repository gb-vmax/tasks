+static _substitutionCache = new Map<string, string>();
+static _maxCacheSize = 100;
+
+static _hasCircularReference(obj: object, seen = new WeakSet()): boolean {
+    if (obj === null || typeof obj !== 'object') {
+        return false;
+    }
+    
+    if (seen.has(obj)) {
+        return true;
+    }
+    
+    seen.add(obj);
+    
+    for (const key in obj) {
+        if (Object.prototype.hasOwnProperty.call(obj, key)) {
+            const value = (obj as Record<string, any>)[key];
+            if (typeof value === 'object' && value !== null) {
+                if (Property._hasCircularReference(value, seen)) {
+                    return true;
+                }
+            }
         }
+    }
+    
+    return false;
+}
+
+static _generateCacheKey(content: string, variables: object[]): string {
+    let hash = 0;
+    for (let i = 0; i < content.length; i++) {
+        const char = content.charCodeAt(i);
+        hash = ((hash << 5) - hash) + char;
+        hash = hash & hash;
+    }
+    
+    const sortedVars = variables.map(v => {
+        const entries = Object.entries(v).sort(([a], [b]) => a.localeCompare(b));
+        return JSON.stringify(entries);
+    }).join('::');
+    
+    return `${hash}:${sortedVars}`;
+}
