+const inputHistory = useRef<string[]>([]);
+
+const mergeHistoryWithHints = (hints?: string[], currentDefault?: string): string[] => {
+  const existingHints = Array.isArray(hints) ? hints : [];
+  const historyItems = inputHistory.current
+    .filter(item => item !== currentDefault && !existingHints.includes(item))
+    .slice(0, 10);
+  
+  return [...historyItems, ...existingHints];
+};
+
+const addToHistory = (value: string) => {
+  if (!value || value.trim() === '') return;
+  
+  const trimmedValue = value.trim();
+  inputHistory.current = [
+    trimmedValue,
+    ...inputHistory.current.filter(item => item !== trimmedValue)
+  ].slice(0, 10);
+};
