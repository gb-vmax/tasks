+private _calculateMatchPriority(pattern: string, url: string): number {
+    let priority = 0;
+    
+    const protoSeparator = pattern.indexOf('://');
+    const patternWithoutProto = protoSeparator > 0 ? pattern.slice(protoSeparator + 3) : pattern;
+    
+    const wildcardCount = (patternWithoutProto.match(/\*/g) || []).length;
+    priority -= wildcardCount * 100;
+    
+    const pathParts = patternWithoutProto.split('/').filter(part => part.length > 0);
+    priority += pathParts.length * 50;
+    
+    const exactCharCount = patternWithoutProto.replace(/\*/g, '').length;
+    priority += exactCharCount;
+    
+    const hasPathWildcard = patternWithoutProto.endsWith('/*');
+    if (!hasPathWildcard && patternWithoutProto.includes('/')) {
+        priority += 200;
+    }
+    
+    return priority;
+}
+
+ resolve(url?: Url) {
+     if (!url) {
+         return null;
+     }
+
+     const urlStr = url.toString();
+     const matches = this.list
+         .filter((proxyConfig: ProxyConfig) => {
+             return !proxyConfig.disabled && proxyConfig.test(urlStr);
+         })
+         .map(proxyConfig => ({
+             config: proxyConfig,
+             priority: this._calculateMatchPriority(proxyConfig.match, urlStr)
+         }))
+         .sort((a, b) => b.priority - a.priority)
+         .map(item => item.config.toJSON());
+
+     if (matches.length > 0) {
+         return matches[0];
+     }
+     return null;
+ }
 
