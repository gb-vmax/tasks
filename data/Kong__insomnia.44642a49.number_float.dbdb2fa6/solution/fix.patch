+const generateConstrainedNumber = (schema: OpenAPIV3.SchemaObject | undefined, isFloat: boolean): number => {
+  if (!schema) {
+    return isFloat ? 0.0 : 0;
+  }
+
+  const min = schema.minimum !== undefined ? schema.minimum : (schema.exclusiveMinimum ? schema.exclusiveMinimum + (isFloat ? 0.1 : 1) : undefined);
+  const max = schema.maximum !== undefined ? schema.maximum : (schema.exclusiveMaximum ? schema.exclusiveMaximum - (isFloat ? 0.1 : 1) : undefined);
+  const multipleOf = schema.multipleOf;
+
+  let value: number;
+
+  if (min !== undefined && max !== undefined) {
+    value = (min + max) / 2;
+  } else if (min !== undefined) {
+    value = min + (isFloat ? 1.5 : 1);
+  } else if (max !== undefined) {
+    value = max - (isFloat ? 1.5 : 1);
+  } else {
+    value = isFloat ? 0.0 : 0;
+  }
+
+  if (multipleOf !== undefined && multipleOf > 0) {
+    value = Math.round(value / multipleOf) * multipleOf;
+    
+    if (min !== undefined && value < min) {
+      value = Math.ceil(min / multipleOf) * multipleOf;
+    }
+    
+    if (max !== undefined && value > max) {
+      value = Math.floor(max / multipleOf) * multipleOf;
+    }
+  }
+
+  if (min !== undefined && value < min) {
+    value = min;
+  }
+  
+  if (max !== undefined && value > max) {
+    value = max;
+  }
+
+  return value;
+};
+
