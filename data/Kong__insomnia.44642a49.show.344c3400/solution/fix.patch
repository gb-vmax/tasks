+const validateAndPrepareOptions = (options: SelectModalOptions): SelectModalOptions => {
+  if (!options.options || options.options.length === 0) {
+    console.warn('SelectModal: No options provided, using empty array');
+    return {
+      ...options,
+      options: [],
+      value: null,
+    };
+  }
+
+  const validOptions = options.options.filter(opt => 
+    opt && typeof opt.value === 'string' && typeof opt.name === 'string'
+  );
+
+  if (validOptions.length === 0) {
+    console.warn('SelectModal: No valid options found');
+    return {
+      ...options,
+      options: [],
+      value: null,
+    };
+  }
+
+  const providedValue = options.value;
+  const valueExistsInOptions = providedValue !== null && 
+    validOptions.some(opt => opt.value === providedValue);
+
+  const finalValue = valueExistsInOptions ? providedValue : validOptions[0].value;
+
+  return {
+    ...options,
+    options: validOptions,
+    value: finalValue,
+  };
+};
+
+ show: options => {
+   const validatedOptions = validateAndPrepareOptions(options);
+   setState(validatedOptions);
+   modalRef.current?.show();
