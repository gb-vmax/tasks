+function _detectDataConflicts(
+  chosenData: Record<string, any>,
+  incomingData: Record<string, any>
+): string[] {
+  const conflicts: string[] = [];
+  
+  for (const key of Object.keys(incomingData)) {
+    if (key in chosenData && chosenData[key] !== incomingData[key]) {
+      conflicts.push(key);
+    }
+  }
+  
+  return conflicts;
+}
+
+function _resolveConflicts(
+  chosenBase: Environment,
+  incomingBase: Environment,
+  conflictKeys: string[]
+): Record<string, any> {
+  const resolvedData = { ...chosenBase.data };
+  
+  const chosenModified = chosenBase.modified || 0;
+  const incomingModified = incomingBase.modified || 0;
+  
+  for (const key of conflictKeys) {
+    if (incomingModified > chosenModified) {
+      resolvedData[key] = incomingBase.data[key];
     }
+  }
+  
+  return resolvedData;
+}
