+  });
+  
+  uniqueWarnings.forEach(({ message, severity, count }) => {
+    const countSuffix = count > 1 ? ` (×${count})` : '';
+    console.warn(`[plugins] deprecation warning [${severity}] during installation:`, message + countSuffix);
+  });
+  
+  if (uniqueWarnings.size > 0) {
