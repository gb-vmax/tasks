-  // If they mismatch, it means there are warnings and errors
+  
+  const uniqueWarnings = new Map<string, { message: string; severity: string; count: number }>();
+  const severityCounts = { critical: 0, high: 0, low: 0 };
+  
+  warnings.forEach(warning => {
+    const normalized = _normalizeWarning(warning);
+    const severity = _classifyWarningSeverity(warning);
