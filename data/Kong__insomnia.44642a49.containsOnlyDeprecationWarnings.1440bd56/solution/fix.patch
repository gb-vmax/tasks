+function _normalizeWarning(warning: string): string {
+  const match = YARN_DEPRECATED_WARN.exec(warning);
+  if (!match?.groups) {
+    return warning.trim().toLowerCase();
+  }
+  
+  const deps = match.groups.dependencies?.trim() || '';
+  const issue = match.groups.issue?.trim() || '';
+  return `${deps}::${issue}`.toLowerCase();
+}
+
+function _classifyWarningSeverity(warning: string): string {
+  const lowerWarning = warning.toLowerCase();
+  
+  if (lowerWarning.includes('security') || 
+      lowerWarning.includes('vulnerability') || 
+      lowerWarning.includes('critical')) {
+    return 'critical';
+  }
+  
+  if (lowerWarning.includes('breaking') || 
+      lowerWarning.includes('deprecated') || 
+      lowerWarning.includes('no longer maintained')) {
+    return 'high';
+  }
+  
+  return 'low';
+}
+
