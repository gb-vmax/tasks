+function interpolateNameVariables(
+  name: string,
+  context: Record<string, any>,
+): string {
+  return name.replace(/\$\{([^}]+)\}/g, (match, variableName) => {
+    const trimmedName = variableName.trim();
+    const value = context[trimmedName];
+    
+    if (value === undefined || value === null) {
+      return match;
+    }
+    
+    if (typeof value === 'object') {
+      return JSON.stringify(value);
+    }
+    
+    return String(value);
+  });
+}
+
+ getName(options?: { interpolate?: boolean; fallback?: string }) {
+   const rawName = renderedRequest.name;
+  
+   if (!options) {
+     return rawName;
+   }
+  
+   let processedName = rawName;
+  
+   if (options.interpolate && processedName) {
+     processedName = interpolateNameVariables(processedName, renderedContext);
+   }
+  
+   if ((!processedName || processedName.trim() === '') && options.fallback) {
+     return options.fallback;
+   }
+  
+   return processedName;
+ },
 
