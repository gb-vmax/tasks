+const generateContextualEmail = (parameterName?: string): string => {
+  if (!parameterName) {
+    return 'user@example.com';
+  }
+  
+  const lowerName = parameterName.toLowerCase();
+  
+  const emailPrefixMap: Record<string, string> = {
+    'admin': 'admin',
+    'support': 'support',
+    'contact': 'contact',
+    'sales': 'sales',
+    'billing': 'billing',
+    'info': 'info',
+    'help': 'help',
+    'manager': 'manager',
+    'owner': 'owner',
+    'notification': 'notifications',
+    'noreply': 'noreply',
+    'reply': 'reply',
+  };
+  
+  for (const [key, prefix] of Object.entries(emailPrefixMap)) {
+    if (lowerName.includes(key)) {
+      return `${prefix}@example.com`;
+    }
+  }
+  
+  return 'user@example.com';
+};
+
+ string_email: (parameter: OpenAPIV2.Parameter) => {
+   if (parameter.example && typeof parameter.example === 'string') {
+     return parameter.example;
+   }
+  
+   if (parameter.default && typeof parameter.default === 'string') {
+     return parameter.default;
+   }
+  
+   return generateContextualEmail(parameter.name);
+ }
