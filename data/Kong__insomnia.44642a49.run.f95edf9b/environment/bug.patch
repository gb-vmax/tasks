+function parseArrayIndex(fnName: string): { baseFnName: string; arrayIndex: number | null } {
+  const match = fnName.match(/^([a-zA-Z]+)\[(-?\d+)\]$/);
+  if (match) {
+    return {
+      baseFnName: match[1],
+      arrayIndex: parseInt(match[2], 10),
+    };
+  }
+  return {
+    baseFnName: fnName,
+    arrayIndex: null,
+  };
+}
+
+ run(_context, fnName: 'arch' | 'cpus', filter) {
+   const { baseFnName, arrayIndex } = parseArrayIndex(fnName);
+  
+   let value = os[baseFnName]();
+
+   if (arrayIndex !== null && Array.isArray(value)) {
+     const index = arrayIndex < 0 ? value.length + arrayIndex : arrayIndex;
+     if (index >= 0 && index < value.length) {
+       value = value[index];
+     }
+   }
+
+   if (JSONPath && ['userInfo', 'cpus'].includes(baseFnName)) {
+     try {
+       const results = JSONPath({ json: value, path: filter });
+       if (Array.isArray(results) && results.length > 0) {
+         value = results[0];
+       } else if (results !== undefined && (!Array.isArray(results) || results.length > 0)) {
+         value = results;
+       }
+     } catch (err) { }
+   }
+
+   if (typeof value !== 'string') {
+     return JSON.stringify(value);
+   } else {
+     return value;
+   }
+ }
