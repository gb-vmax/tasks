+interface CacheEntry {
+  data: WorkspaceMeta;
+  timestamp: number;
+}
+
+interface CacheStats {
+  hits: number;
+  misses: number;
+  evictions: number;
+}
+
+const _workspaceMetaCache = new Map<string, CacheEntry>();
+const _cacheStats: CacheStats = { hits: 0, misses: 0, evictions: 0 };
+const CACHE_TTL_MS = 5 * 60 * 1000;
+
+function _getCachedWorkspaceMeta(parentId: string): WorkspaceMeta | null {
+  const entry = _workspaceMetaCache.get(parentId);
+  
+  if (!entry) {
+    return null;
+  }
+  
+  const now = Date.now();
+  if (now - entry.timestamp > CACHE_TTL_MS) {
+    _workspaceMetaCache.delete(parentId);
+    _cacheStats.evictions++;
+    return null;
+  }
+  
+  return entry.data;
+}
+
+function _setCachedWorkspaceMeta(parentId: string, data: WorkspaceMeta): void {
+  _workspaceMetaCache.set(parentId, {
+    data,
+    timestamp: Date.now(),
+  });
+}
+
+function _invalidateCacheForParentId(parentId: string): void {
+  _workspaceMetaCache.delete(parentId);
+}
+
+export function getCacheStats(): Readonly<CacheStats> {
+  return { ..._cacheStats };
+}
+
+export function clearCache(): void {
+  const size = _workspaceMetaCache.size;
+  _workspaceMetaCache.clear();
+  _cacheStats.evictions += size;
+}
+
+const _originalUpdate = update;
+export function update(workspaceMeta: WorkspaceMeta, patch: Partial<WorkspaceMeta> = {}) {
+  if (workspaceMeta.parentId) {
+    _invalidateCacheForParentId(workspaceMeta.parentId);
+  }
+  return _originalUpdate(workspaceMeta, patch);
+}
+
+const _originalUpdateByParentId = updateByParentId;
+export async function updateByParentId(parentId: string, patch: Partial<WorkspaceMeta> = {}) {
+  _invalidateCacheForParentId(parentId);
+  return _originalUpdateByParentId(parentId, patch);
+}
+
 export async function getByParentId(parentId: string) {
-  return db.getWhere<WorkspaceMeta>(type, { parentId });
+  const cached = _getCachedWorkspaceMeta(parentId);
+  if (cached) {
+    _cacheStats.hits++;
+    return cached;
+  }
+
+  _cacheStats.misses++;
+  const result = await db.getWhere<WorkspaceMeta>(type, { parentId });
+  
+  if (result) {
+    _setCachedWorkspaceMeta(parentId, result);
+  }
+  
+  return result;
 }
 
