+const getPreferredResponseMimeType = (endpointSchema: OpenAPIV3.PathItemObject) => {
+  const responses = (endpointSchema as any).responses;
+  if (!responses) {
+    return null;
+  }
+
+  const successResponses = Object.keys(responses)
+    .filter(status => status.startsWith('2') || status === 'default')
+    .map(status => responses[status]);
+
+  for (const response of successResponses) {
+    if (response.content) {
+      const mimeTypes = Object.keys(response.content);
+      
+      const jsonMimeType = mimeTypes.find(mime => mime.includes('json'));
+      if (jsonMimeType) {
+        return jsonMimeType;
+      }
+
+      const supportedMimeType = mimeTypes.find(mime => 
+        SUPPORTED_MIME_TYPES.some(supported => mime.includes(supported))
+      );
+      if (supportedMimeType && supportedMimeType !== MIMETYPE_LITERALLY_ANYTHING) {
+        return supportedMimeType;
+      }
+
+      if (mimeTypes.length > 0 && mimeTypes[0] !== MIMETYPE_LITERALLY_ANYTHING) {
+        return mimeTypes[0];
+      }
+    }
+  }
+
+  return null;
+};
