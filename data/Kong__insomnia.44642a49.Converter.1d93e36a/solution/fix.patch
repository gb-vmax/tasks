+const extractSecurityDefinitionsAsEnvVars = (
+  securityDefinitions?: OpenAPIV2.SecurityDefinitionsObject,
+): Record<string, string> => {
+  if (!securityDefinitions) {
+    return {};
+  }
+
+  const envVars: Record<string, string> = {};
+
+  for (const [defName, definition] of Object.entries(securityDefinitions)) {
+    if (definition.type === 'basic') {
+      envVars.username = envVars.username || '';
+      envVars.password = envVars.password || '';
+    }
+
+    if (definition.type === 'apiKey') {
+      envVars.api_key = envVars.api_key || '';
+    }
+
+    if (definition.type === 'oauth2') {
+      envVars.client_id = envVars.client_id || '';
+      envVars.client_secret = envVars.client_secret || '';
+      
+      if (definition.flow === 'password') {
+        envVars.username = envVars.username || '';
+        envVars.password = envVars.password || '';
+      }
+    }
+  }
+
+  return envVars;
+};
+
