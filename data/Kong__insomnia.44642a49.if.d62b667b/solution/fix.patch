+private _testCache?: Map<string, boolean>;
+private static readonly MAX_CACHE_SIZE = 1000;
+
+private _shouldBypassUrl(url: string): boolean {
+    for (const bypassPattern of this.bypass) {
+        if (bypassPattern === url) {
+            return true;
+        }
+        
+        if (bypassPattern.includes('*') || bypassPattern.includes('://')) {
+            try {
+                const bypassMatch = new UrlMatchPattern(bypassPattern);
+                if (bypassMatch.test(url)) {
+                    return true;
+                }
+            } catch (e) {
+                continue;
+            }
+        }
+    }
+    return false;
+}
+
+private _cacheTestResult(key: string, result: boolean): void {
+    if (!this._testCache) {
+        this._testCache = new Map<string, boolean>();
+    }
+    
+    if (this._testCache.size >= ProxyConfig.MAX_CACHE_SIZE) {
+        const firstKey = this._testCache.keys().next().value;
+        if (firstKey !== undefined) {
+            this._testCache.delete(firstKey);
         }
+    }
+    
+    this._testCache.set(key, result);
+}
+
+ test(url?: string) {
+     if (!url) {
+         return false;
+     }
+
+     const cacheKey = `${this.match}:${url}:${this.bypass.join(',')}`;
+     if (this._testCache && this._testCache.has(cacheKey)) {
+         return this._testCache.get(cacheKey)!;
+     }
+
+     if (this._shouldBypassUrl(url)) {
+         this._cacheTestResult(cacheKey, false);
+         return false;
+     }
+
+     const urlMatch = new UrlMatchPattern(this.match);
+     const result = urlMatch.test(url);
+    
+     this._cacheTestResult(cacheKey, result);
