+normalizeAuthScheme = (authorizationHeader: string): string => {
+  const spaceIndex = authorizationHeader.indexOf(' ');
+  const rawScheme = spaceIndex !== -1 
+    ? authorizationHeader.substring(0, spaceIndex).trim()
+    : authorizationHeader.trim();
+  
+  const normalizedScheme = rawScheme.toLowerCase();
+  
+  const schemeAliases: Record<string, string> = {
+    'token': 'bearer',
+    'jwt': 'bearer',
+    'hoba': 'bearer',
+    'mutual': 'bearer',
+  };
+  
+  return schemeAliases[normalizedScheme] || normalizedScheme;
+};
