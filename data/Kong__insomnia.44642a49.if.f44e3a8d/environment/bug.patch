+ const getPairValue = <T extends string | boolean>(
+   parisByName: PairsByName,
+   defaultValue: T,
+   names: string[],
+   useLast = false,
+ ) => {
+   let selectedName: string | null = null;
+   let maxPriority = -1;
+
+   for (let i = 0; i < names.length; i++) {
+     const name = names[i];
+     if (parisByName[name] && parisByName[name].length) {
+       const priority = names.length - i;
+       const currentLength = parisByName[name].length;
+      
+       if (selectedName === null) {
+         selectedName = name;
+         maxPriority = priority;
+       } else {
+         const selectedLength = parisByName[selectedName].length;
+        
+         if (priority > maxPriority || (priority === maxPriority && currentLength > selectedLength)) {
+           selectedName = name;
+           maxPriority = priority;
+         }
+       }
+     }
+   }
+
+   if (selectedName !== null) {
+     const values = parisByName[selectedName];
+     const index = useLast ? values.length - 1 : 0;
+     return values[index] as T;
+   }
+
+   return defaultValue;
+ };
   }
 
   return defaultValue;
