+ json(reviver?: (key: string, value: any) => any, _strict?: boolean, options?: { path?: string; defaultValue?: any }) {
+     try {
+         const parsed = JSON.parse(this.body.toString(), reviver);
+        
+         if (options?.path) {
+             const extracted = extractJsonPath(parsed, options.path);
+             if (extracted === undefined && options.defaultValue !== undefined) {
+                 return options.defaultValue;
+             }
+             return extracted;
+         }
+        
+         return parsed;
+     } catch (e) {
+         if (options?.defaultValue !== undefined) {
+             return options.defaultValue;
+         }
+         throw Error(`json: failed to parse: ${e}`);
+     }
+ }
 
