+function extractJsonPath(obj: any, path: string): any {
+    if (!path || path.trim() === '') {
+        return obj;
+    }
+    
+    const segments = path.split('.').reduce((acc: string[], segment) => {
+        const arrayMatch = segment.match(/^([^\[]+)(\[\d+\])+$/);
+        if (arrayMatch) {
+            acc.push(arrayMatch[1]);
+            const indices = segment.match(/\[(\d+)\]/g);
+            if (indices) {
+                indices.forEach(idx => {
+                    acc.push(idx.slice(1, -1));
+                });
+            }
+        } else {
+            acc.push(segment);
+        }
+        return acc;
+    }, []);
+    
+    let current = obj;
+    for (const segment of segments) {
+        if (current === null || current === undefined) {
+            return undefined;
+        }
+        
+        const arrayIndex = parseInt(segment, 10);
+        if (!isNaN(arrayIndex)) {
+            if (Array.isArray(current) && arrayIndex >= 0 && arrayIndex < current.length) {
+                current = current[arrayIndex];
+            } else {
+                return undefined;
+            }
+        } else {
+            if (typeof current === 'object' && segment in current) {
+                current = current[segment];
+            } else {
+                return undefined;
+            }
         }
     }
+    
+    return current;
+}
