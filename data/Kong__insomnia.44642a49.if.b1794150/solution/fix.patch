+function sanitizePatchForDuplication<T extends object>(patch: Partial<T>): Partial<T> {
+  const systemFields = ['_id', 'created', 'modified', 'parentId', 'metaSortKey'];
+  const sanitized = { ...patch };
+  
+  for (const field of systemFields) {
+    if (field in sanitized) {
+      delete sanitized[field as keyof T];
+    }
+  }
+  
+  return sanitized;
+}
+
+function validateGrpcPatch<T extends object>(request: T, patch: Partial<T>): void {
+  const grpcRequest = request as any;
+  const grpcPatch = patch as any;
+  
+  if (grpcPatch.url !== undefined && typeof grpcPatch.url !== 'string') {
+    throw new Error('Invalid gRPC patch: url must be a string');
+  }
+  
+  if (grpcPatch.protoFileId !== undefined && grpcPatch.protoFileId !== grpcRequest.protoFileId) {
+    if (!grpcPatch.protoFileId) {
+      throw new Error('Invalid gRPC patch: protoFileId cannot be removed');
+    }
   }
+}
+
+ export function duplicate<T extends object>(request: T, patch: Partial<T> = {}): Promise<T> {
