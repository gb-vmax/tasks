+interface ValidationResult {
+  isValid: boolean;
+  warnings: string[];
+}
+
+const validateCollection = (collection: PostmanCollection): ValidationResult => {
+  const warnings: string[] = [];
+  
+  if (!collection.info) {
+    warnings.push('Collection missing info object');
+    return { isValid: false, warnings };
+  }
+  
+  if (!collection.info.name || collection.info.name.trim() === '') {
+    warnings.push('Collection name is empty or missing');
+  }
+  
+  if (!collection.item || !Array.isArray(collection.item)) {
+    warnings.push('Collection has no items array');
+    return { isValid: false, warnings };
+  }
+  
+  if (collection.item.length === 0) {
+    warnings.push('Collection contains no items');
+  }
+  
+  const invalidItems = collection.item.filter(item => {
+    if (!item || typeof item !== 'object') {
+      return true;
+    }
+    
+    if (!Object.prototype.hasOwnProperty.call(item, 'request') && !Object.prototype.hasOwnProperty.call(item, 'item')) {
+      return true;
+    }
+    
+    return false;
+  });
+  
+  if (invalidItems.length > 0) {
+    warnings.push(`Found ${invalidItems.length} malformed items in collection`);
+  }
+  
+  return { isValid: true, warnings };
+};
+
+const sanitizeImportedItems = (items: ImportRequest[]): ImportRequest[] => {
+  return items.filter(item => {
+    if (!item || typeof item !== 'object') {
+      return false;
+    }
+    
+    if (!item._type || (item._type !== 'request' && item._type !== 'request_group')) {
+      return false;
+    }
+    
+    if (item._type === 'request') {
+      if (!item.url && !item.method) {
+        return false;
+      }
+    }
+    
+    if (!item.name || (typeof item.name === 'string' && item.name.trim() === '')) {
+      item.name = item._type === 'request' ? 'Untitled Request' : 'Untitled Folder';
+    }
+    
+    if (item._type === 'request' && !item.method) {
+      item.method = 'GET';
+    }
+    
+    return true;
+  });
+};
