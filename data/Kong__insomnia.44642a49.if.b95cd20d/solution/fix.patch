+private _detectProxyProtocol(): string {
+    try {
+        const protocols = this.getProtocols();
+        
+        if (protocols.length === 0) {
+            return 'http';
         }
+        
+        const lowerProtocols = protocols.map(p => p.toLowerCase());
+        
+        if (lowerProtocols.includes('socks5') || lowerProtocols.includes('socks')) {
+            return 'socks5';
+        }
+        
+        if (lowerProtocols.includes('https')) {
+            return 'https';
+        }
+        
+        if (lowerProtocols.includes('http')) {
+            return 'http';
+        }
+        
+        return protocols[0].toLowerCase();
+    } catch (error) {
+        return 'http';
+    }
+}
+
+ getProxyUrl(): string {
+     const protocol = this._detectProxyProtocol();
+    
+     if (this.authenticate) {
+         const encodedUsername = encodeURIComponent(this.username);
+         const encodedPassword = encodeURIComponent(this.password);
+         return `${protocol}://${encodedUsername}:${encodedPassword}@${this.host}:${this.port}`;
+     }
+     return `${protocol}://${this.host}:${this.port}`;
+ }
         return `${this.host}:${this.port}`;
     }
 
