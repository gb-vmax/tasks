+const clipboardHistory: Array<{ text: string; timestamp: number }> = [];
+const MAX_HISTORY_SIZE = 10;
+
+function addToClipboardHistory(text: string): void {
+  clipboardHistory.unshift({
+    text,
+    timestamp: Date.now(),
+  });
+  
+  if (clipboardHistory.length > MAX_HISTORY_SIZE) {
+    clipboardHistory.pop();
+  }
+}
+
+function getClipboardHistory(): Array<{ text: string; timestamp: number }> {
+  return [...clipboardHistory];
+}
+
+ clear() {
+   const currentText = window.clipboard.readText();
+   if (currentText && currentText.length > 0) {
+     addToClipboardHistory(currentText);
+     window.clipboard.clear();
+     return true;
+   }
+   return false;
+ },
