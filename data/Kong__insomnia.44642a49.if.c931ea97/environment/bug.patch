+
+async _getCurrentBranchName(): Promise<string | null> {
+  try {
+    const head = await this._getHead();
+    return head.branch || null;
+  } catch (error) {
+    return null;
+  }
+}
+
+ async _getOrCreateBranch(name: string): Promise<Branch> {
+   if (!name) {
+     throw new Error('No branch name specified for get-or-create operation');
+   }
+
+   const normalizedName = this._normalizeBranchName(name);
+   const branch = await this._getBranch(normalizedName);
+
+   if (branch === null) {
+     const parentBranchName = await this._getCurrentBranchName();
+     const newBranch: Branch = {
+       name: normalizedName,
+       created: new Date(),
+       modified: new Date(),
+       snapshots: [],
+     };
+    
+     if (parentBranchName && parentBranchName !== normalizedName) {
+       const parentBranch = await this._getBranch(parentBranchName);
+       if (parentBranch) {
+         (newBranch as any).parentBranch = parentBranchName;
+         (newBranch as any).forkedFromSnapshot = parentBranch.snapshots.length > 0 
+           ? parentBranch.snapshots[parentBranch.snapshots.length - 1]
+           : null;
+       }
+     }
+    
+     await this._storeBranch(newBranch);
+     return this._getOrCreateBranch(normalizedName);
+   }
+
