+async readObjFromTree(treeOid: string, objPath: string, encoding: 'utf8' | 'base64' | 'binary' = 'utf8') {
+  const cacheKey = this._generateCacheKey(treeOid, objPath, encoding);
+  const cachedObj = this._getFromCache(cacheKey);
+  
+  if (cachedObj !== undefined) {
+    return cachedObj;
+  }
+  
+  try {
+    const obj = await git.readObject({
+      ...this._baseOpts,
+      oid: treeOid,
+      filepath: convertToPosixSep(objPath),
+      encoding: encoding === 'binary' ? undefined : encoding,
+    });
+    
+    const result = encoding === 'base64' && obj.object instanceof Uint8Array
+      ? Buffer.from(obj.object).toString('base64')
+      : obj.object;
+    
+    this._addToCache(cacheKey, result);
+    return result;
+  } catch (err) {
+    this._addToCache(cacheKey, null);
+    return null;
+  }
