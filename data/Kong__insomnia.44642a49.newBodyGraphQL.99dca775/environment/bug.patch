+function isGraphQLStructure(obj: any): boolean {
+  if (typeof obj !== 'object' || obj === null || Array.isArray(obj)) {
+    return false;
+  }
+  
+  return 'query' in obj || 'mutation' in obj || 'subscription' in obj;
+}
+
+function formatGraphQLBody(body: any): any {
+  const formatted: any = {};
+  
+  if (body.query) {
+    formatted.query = typeof body.query === 'string' 
+      ? body.query.trim() 
+      : body.query;
+  }
+  
+  if (body.mutation) {
+    formatted.mutation = typeof body.mutation === 'string'
+      ? body.mutation.trim()
+      : body.mutation;
+  }
+  
+  if (body.subscription) {
+    formatted.subscription = typeof body.subscription === 'string'
+      ? body.subscription.trim()
+      : body.subscription;
+  }
+  
+  if (body.variables !== undefined) {
+    formatted.variables = body.variables;
+  }
+  
+  if (body.operationName !== undefined) {
+    formatted.operationName = body.operationName;
+  }
+  
+  Object.keys(body).forEach(key => {
+    if (!['query', 'mutation', 'subscription', 'variables', 'operationName'].includes(key)) {
+      formatted[key] = body[key];
+    }
+  });
+  
+  return formatted;
+}
