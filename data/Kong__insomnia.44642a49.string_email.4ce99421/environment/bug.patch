+const extractEmailPrefix = (paramName: string): string => {
+  const cleaned = paramName
+    .replace(/email$/i, '')
+    .replace(/mail$/i, '')
+    .replace(/address$/i, '')
+    .replace(/^_+|_+$/g, '')
+    .replace(/[A-Z]/g, (match, offset) => offset > 0 ? match.toLowerCase() : match.toLowerCase());
+  
+  return cleaned || 'user';
+};
+
+ string_email: (parameter: OpenAPIV2.Parameter) => {
+   const emailDomains = ['example.com', 'test.com', 'demo.com'];
+   const emailIndex = ancestors.length % emailDomains.length;
+   const domain = emailDomains[emailIndex];
+  
+   const name = parameter?.name || 'user';
+   const extractedName = extractEmailPrefix(name);
+  
+   return `${extractedName}@${domain}`;
+ },
