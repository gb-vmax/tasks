+function validateRemoteId(remoteId: string) {
+  const validPrefixes = ['proj_team', 'proj_org', 'proj_'];
+  const hasValidPrefix = validPrefixes.some(prefix => remoteId.startsWith(prefix));
+  
+  if (!hasValidPrefix) {
+    throw new Error(`Invalid remoteId format: ${remoteId}. Must start with one of: ${validPrefixes.join(', ')}`);
+  }
+  
+  if (remoteId.length < 10) {
+    throw new Error(`Invalid remoteId: ${remoteId}. ID is too short.`);
+  }
+}
