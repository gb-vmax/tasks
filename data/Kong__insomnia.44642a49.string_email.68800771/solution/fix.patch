+let emailCounter = 0;
+
+const extractEmailContext = (parameter: OpenAPIV2.Parameter): string => {
+  if (!parameter || typeof parameter !== 'object') {
+    return '';
+  }
+  
+  const name = parameter.name || '';
+  const description = parameter.description || '';
+  const combined = `${name} ${description}`.toLowerCase();
+  
+  const contextPatterns = [
+    'admin', 'support', 'billing', 'sales', 'contact',
+    'primary', 'secondary', 'backup', 'notification',
+    'business', 'personal', 'work', 'company'
+  ];
+  
+  for (const pattern of contextPatterns) {
+    if (combined.includes(pattern)) {
+      return pattern;
+    }
+  }
+  
+  return '';
+};
+
+const selectEmailDomain = (context: string): string => {
+  const domainMap: { [key: string]: string } = {
+    'admin': 'admin.example.com',
+    'support': 'support.example.com',
+    'billing': 'billing.example.com',
+    'sales': 'sales.example.com',
+    'business': 'business.example.com',
+    'company': 'company.example.com',
+  };
+  
+  return domainMap[context] || 'example.com';
+};
+
+const generateEmailUsername = (context: string): string => {
+  if (context && context !== '') {
+    return context;
+  }
+  
+  emailCounter++;
+  return emailCounter === 1 ? 'user' : `user${emailCounter}`;
+};
+
+ string_email: (parameter: OpenAPIV2.Parameter) => {
+   const context = extractEmailContext(parameter);
+   const domain = selectEmailDomain(context);
+   const username = generateEmailUsername(context);
+   return `${username}@${domain}`;
+ }
