+interface ApiMetadata {
+  title: string | null;
+  version: string | null;
+  description: string | null;
+}
+
+function isValidOpenApiVersion(version: string): boolean {
+  if (typeof version !== 'string') {
+    return false;
+  }
+  return version.startsWith('3.');
+}
+
+function isValidSwaggerVersion(version: string): boolean {
+  if (typeof version !== 'string') {
+    return false;
+  }
+  return version.startsWith('2.');
+}
+
+function extractApiMetadata(contents: Record<string, any>): ApiMetadata {
+  const metadata: ApiMetadata = {
+    title: null,
+    version: null,
+    description: null,
+  };
+
+  if (contents.info && typeof contents.info === 'object') {
+    if (typeof contents.info.title === 'string') {
+      metadata.title = contents.info.title;
+    }
+    if (typeof contents.info.version === 'string') {
+      metadata.version = contents.info.version;
+    }
+    if (typeof contents.info.description === 'string') {
+      metadata.description = contents.info.description;
+    }
+  }
+
+  return metadata;
+}
+
+export interface ParsedApiSpec {
+  contents: Record<string, any> | null;
+  rawContents: string;
+  format: 'openapi' | 'swagger' | null;
+  formatVersion: string | null;
+  title: string | null;
+  version: string | null;
+  description: string | null;
+}
