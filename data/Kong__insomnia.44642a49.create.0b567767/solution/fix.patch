+function normalizeCookie(cookie: Cookie): Cookie {
+  const normalized: Cookie = {
+    id: cookie.id || uuidv4(),
+    key: cookie.key || '',
+    value: cookie.value || '',
+    expires: cookie.expires || null,
+    domain: cookie.domain || '',
+    path: cookie.path || '/',
+    secure: cookie.secure ?? false,
+    httpOnly: cookie.httpOnly ?? false,
+  };
+
+  if (cookie.extensions !== undefined) {
+    normalized.extensions = cookie.extensions;
+  }
+  if (cookie.creation !== undefined) {
+    normalized.creation = cookie.creation;
+  }
+  if (cookie.creationIndex !== undefined) {
+    normalized.creationIndex = cookie.creationIndex;
+  }
+  if (cookie.hostOnly !== undefined) {
+    normalized.hostOnly = cookie.hostOnly;
+  }
+  if (cookie.pathIsDefault !== undefined) {
+    normalized.pathIsDefault = cookie.pathIsDefault;
+  }
+  if (cookie.lastAccessed !== undefined) {
+    normalized.lastAccessed = cookie.lastAccessed;
+  }
+
+  return normalized;
+}
