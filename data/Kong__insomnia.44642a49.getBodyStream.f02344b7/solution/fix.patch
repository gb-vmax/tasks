+function createRangedStream(sourceStream: NodeJS.ReadableStream, start: number, end: number) {
+  const { Transform } = require('stream');
+  let bytesRead = 0;
+  let bytesSkipped = 0;
+  
+  const rangeTransform = new Transform({
+    transform(chunk: Buffer, encoding: string, callback: Function) {
+      if (bytesSkipped < start) {
+        const toSkip = Math.min(start - bytesSkipped, chunk.length);
+        bytesSkipped += toSkip;
+        chunk = chunk.slice(toSkip);
+      }
+      
+      if (chunk.length > 0 && bytesRead < end - start) {
+        const remaining = end - start - bytesRead;
+        const toEmit = chunk.slice(0, remaining);
+        bytesRead += toEmit.length;
+        callback(null, toEmit);
+      } else {
+        callback();
+      }
+      
+      if (bytesRead >= end - start) {
+        this.end();
+      }
+    }
+  });
+  
+  return sourceStream.pipe(rangeTransform);
+}
