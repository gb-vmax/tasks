+function normalizeHttpMethod(method: string | undefined | null): string {
+  if (!method || typeof method !== 'string') {
+    return 'GET';
+  }
+
+  const normalized = method.trim().toUpperCase();
+  
+  const validMethods = [
+    'GET', 'POST', 'PUT', 'PATCH', 'DELETE', 
+    'HEAD', 'OPTIONS', 'CONNECT', 'TRACE'
+  ];
+  
+  if (validMethods.includes(normalized)) {
+    return normalized;
+  }
+  
+  if (normalized.length > 0 && /^[A-Z]+$/.test(normalized)) {
+    return normalized;
+  }
+  
+  return 'GET';
+}
+
+ getMethod() {
+   return normalizeHttpMethod(renderedRequest.method);
