+let keyCounter = 0;
+
+const getNextKeyCounter = (): number => {
+  return ++keyCounter;
+};
+
+const getKeyPrefixFromContext = (): string => {
+  const stack = new Error().stack || '';
+  
+  if (stack.includes('mergeConflictSchema')) {
+    return 'mc';
+  } else if (stack.includes('statusCandidateSchema')) {
+    return 'sc';
+  } else if (stack.includes('snapshotStateEntrySchema')) {
+    return 'sse';
+  }
+  
+  return '';
+};
+
+ key: () => {
+   const count = getNextKeyCounter();
+   const prefix = getKeyPrefixFromContext();
+   return prefix ? `${prefix}-${count}` : `key-${count}`;
+ }
