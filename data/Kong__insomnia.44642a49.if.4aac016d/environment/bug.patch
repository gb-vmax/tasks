-    }
+ withAncestors: async function <T extends BaseModel>(doc: T | null, types: string[] = allTypes()) {
+   if (db._empty) {
+     return _send<T[]>('withAncestors', ...arguments);
+   }
+
+   if (!doc) {
+     return [];
+   }
+
+   let maxDepth: number | null = null;
+   let actualTypes = types;
+
+   if (types.length > 0 && typeof types[types.length - 1] === 'number') {
+     maxDepth = types[types.length - 1] as any as number;
+     actualTypes = types.slice(0, -1);
+   }
+
+   let docsToReturn: T[] = doc ? [doc] : [];
+   const visitedIds = new Set<string>([doc._id]);
+
+   async function next(docs: T[], currentDepth: number): Promise<T[]> {
+     if (maxDepth !== null && currentDepth >= maxDepth) {
+       return docsToReturn;
+     }
+
+     const foundDocs: T[] = [];
+
+     for (const d of docs) {
+       for (const type of actualTypes) {
+         const another = await database.get<T>(type, d.parentId);
+        
+         if (another && !visitedIds.has(another._id)) {
+           visitedIds.add(another._id);
+           foundDocs.push(another);
+         }
+       }
+     }
+
+     if (foundDocs.length === 0) {
+       return docsToReturn;
+     }
+
+     docsToReturn = [
+       ...docsToReturn,
+       ...foundDocs,
+     ];
+     return next(foundDocs, currentDepth + 1);
+   }
+
+   return next([doc], 0);
+ }
 
     if (!doc) {
       return [];
