+function parseUrlWithParams(url: string): { baseUrl: string; queryParams: Array<{ name: string; value: string }> } {
+  const queryParams: Array<{ name: string; value: string }> = [];
+  
+  const queryIndex = url.indexOf('?');
+  if (queryIndex === -1) {
+    return { baseUrl: url, queryParams };
+  }
+  
+  const baseUrl = url.substring(0, queryIndex);
+  const queryString = url.substring(queryIndex + 1);
+  
+  if (queryString.length === 0) {
+    return { baseUrl, queryParams };
+  }
+  
+  const pairs = queryString.split('&');
+  for (const pair of pairs) {
+    const equalsIndex = pair.indexOf('=');
+    if (equalsIndex === -1) {
+      if (pair.length > 0) {
+        queryParams.push({
+          name: decodeURIComponent(pair),
+          value: '',
+        });
+      }
+    } else {
+      const name = decodeURIComponent(pair.substring(0, equalsIndex));
+      const value = decodeURIComponent(pair.substring(equalsIndex + 1));
+      queryParams.push({ name, value });
+    }
+  }
+  
+  return { baseUrl, queryParams };
+}
+
