+function deduplicateVariables(variables: Variable[] | { key: string; value: string; type?: string }[]): Variable[] {
+    const varMap = new Map<string, Variable>();
+    
+    for (const v of variables) {
+        let variable: Variable;
+        if (v instanceof Variable) {
