+function sanitizePatch<T extends object>(patch: Partial<T>): Partial<T> {
+  const sanitized: Partial<T> = {};
+  for (const key in patch) {
+    if (patch[key] !== undefined && patch[key] !== null) {
+      sanitized[key] = patch[key];
+    }
+  }
+  return sanitized;
+}
