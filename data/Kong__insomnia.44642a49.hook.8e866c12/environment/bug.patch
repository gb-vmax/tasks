+function isPatternHeader(headerName: string): boolean {
+  return headerName.includes('*');
+}
+
+function matchHeaderPattern(pattern: string, existingHeaders: string[]): string[] {
+  if (!isPatternHeader(pattern)) {
+    return existingHeaders.filter(h => h.toLowerCase() === pattern.toLowerCase());
+  }
+
+  const regexPattern = pattern
+    .replace(/[.+?^${}()|[\]\\]/g, '\\$&')
+    .replace(/\*/g, '.*');
+  const regex = new RegExp(`^${regexPattern}$`, 'i');
+
+  return existingHeaders.filter(header => regex.test(header));
+}
+
+function getAllHeaderNames(request: any): string[] {
