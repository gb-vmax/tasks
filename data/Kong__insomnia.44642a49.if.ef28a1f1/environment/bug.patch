+extractAuthType = (authorizationHeader: string): string => {
+  const trimmedHeader = authorizationHeader.trim();
+  const spaceIndex = trimmedHeader.indexOf(' ');
+  
+  if (spaceIndex === -1) {
+    return trimmedHeader;
+  }
+  
+  return trimmedHeader.substring(0, spaceIndex);
