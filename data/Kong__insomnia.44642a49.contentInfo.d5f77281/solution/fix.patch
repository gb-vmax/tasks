+function deriveMimeFormat(mimeType: string): string {
+    const lowerMimeType = mimeType.toLowerCase();
+    
+    if (lowerMimeType.includes('json')) {
+        return 'json';
+    } else if (lowerMimeType.includes('xml')) {
+        return 'xml';
+    } else if (lowerMimeType.includes('html')) {
+        return 'html';
+    } else if (lowerMimeType.includes('javascript')) {
+        return 'javascript';
+    } else if (lowerMimeType.includes('css')) {
+        return 'css';
+    } else if (lowerMimeType.includes('text')) {
+        return 'text';
+    } else if (lowerMimeType.startsWith('image/')) {
+        return 'image';
+    } else if (lowerMimeType.startsWith('audio/')) {
+        return 'audio';
+    } else if (lowerMimeType.startsWith('video/')) {
+        return 'video';
+    } else if (lowerMimeType.includes('pdf')) {
+        return 'pdf';
+    }
+    
+    return '';
+}
 
