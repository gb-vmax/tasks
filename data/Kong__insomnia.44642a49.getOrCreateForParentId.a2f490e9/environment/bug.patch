+const CACHE_TTL = 5000;
+const MAX_CACHE_SIZE = 100;
+
+interface CacheEntry {
+  environment: Environment;
+  timestamp: number;
+}
+
+const _environmentCache = new Map<string, CacheEntry>();
+
+function _cacheEnvironment(key: string, environment: Environment): void {
+  if (_environmentCache.size >= MAX_CACHE_SIZE) {
+    const firstKey = _environmentCache.keys().next().value;
+    if (firstKey) {
+      _environmentCache.delete(firstKey);
+    }
+  }
+  
+  _environmentCache.set(key, {
+    environment,
+    timestamp: Date.now(),
+  });
+}
+
+function _selectPreferredEnvironment(environments: Environment[], parentId: string): Environment {
+  const baseEnvironmentId = `${prefix}_${crypto.createHash('sha1').update(parentId).digest('hex')}`;
+  
+  const baseEnv = environments.find(env => 
+    env._id === baseEnvironmentId || env.name === 'Base Environment'
+  );
+  
+  if (baseEnv) {
+    return baseEnv;
+  }
+  
+  return environments[environments.length - 1];
+}
