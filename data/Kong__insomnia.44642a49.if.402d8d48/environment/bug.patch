+static _substitutionCache = new Map<string, string>();
+static _maxCacheSize = 100;
+
+static _generateCacheKey(content: string, variables: object[]): string {
+    const varsHash = JSON.stringify(variables.map(v => {
+        const sorted = Object.keys(v).sort().reduce((acc: any, key) => {
+            acc[key] = (v as any)[key];
+            return acc;
+        }, {});
+        return sorted;
+    }));
+    return `${content}::${varsHash}`;
+}
+
+static _validateCircularReferences(variables: object[]): void {
+    const seen = new WeakSet();
+    
+    const detectCircular = (obj: any, path: string[] = []): void => {
+        if (obj === null || typeof obj !== 'object') {
+            return;
+        }
+        
+        if (seen.has(obj)) {
+            throw Error(`replaceSubstitutions: circular reference detected in variables at path: ${path.join('.')}`);
+        }
+        
+        seen.add(obj);
+        
+        for (const key in obj) {
+            if (obj.hasOwnProperty(key)) {
+                detectCircular(obj[key], [...path, key]);
+            }
+        }
+    };
+    
+    variables.forEach((variable, index) => {
+        detectCircular(variable, [`variable[${index}]`]);
+    });
+}
+
+static _validateContentSafety(content: string): void {
+    const maxExpressionLength = 10000;
+    const expressionPattern = /\{\{[^}]*\}\}/g;
+    const matches = content.match(expressionPattern);
+    
+    if (matches) {
+        for (const match of matches) {
+            if (match.length > maxExpressionLength) {
+                throw Error(`replaceSubstitutions: interpolation expression exceeds maximum length (${maxExpressionLength} characters)`);
+            }
