+type HarExport = Omit<InsomniaExport, 'format'> & {
+  workspaceIds?: string[];
+  workspaceType?: string;
+};
+
+ har: async ({
+   workspace,
+   includePrivate,
+   workspaceIds,
+   workspaceType,
+ }: HarExport = {}) => {
+   let workspacesToExport: Workspace[];
+
+   if (workspace) {
+     workspacesToExport = [workspace];
+   } else if (workspaceIds && workspaceIds.length > 0) {
+     const allWorkspaces = await getWorkspaces(activeProjectId);
+     workspacesToExport = allWorkspaces.filter(ws => workspaceIds.includes(ws._id));
+    
+     if (workspacesToExport.length === 0) {
+       throw new Error('No valid workspaces found for the provided workspace IDs');
+     }
+   } else {
+     workspacesToExport = await getWorkspaces(activeProjectId);
+   }
+
+   if (workspaceType) {
+     workspacesToExport = workspacesToExport.filter(ws => ws.scope === workspaceType);
+   }
+
+   if (workspacesToExport.length === 0) {
+     throw new Error('No workspaces available for export after applying filters');
+   }
+
+   return exportWorkspacesHAR(
+     workspacesToExport,
+     Boolean(includePrivate),
+   );
+ },
