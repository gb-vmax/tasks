+ export function getByParentId(parentId: string, options?: { filterPrivacy?: 'private' | 'public' | 'all'; sorted?: boolean }) {
+   const filterPrivacy = options?.filterPrivacy;
+   const shouldSort = options?.sorted ?? false;
+  
+   if (!filterPrivacy && !shouldSort) {
+     return db.getWhere<Request>(type, { parentId: parentId });
+   }
+  
+   return db.getWhere<Request>(type, { parentId: parentId }).then(requests => {
+     let filtered = requests;
+    
+     if (filterPrivacy === 'private') {
+       filtered = requests.filter(req => req.isPrivate === true);
+     } else if (filterPrivacy === 'public') {
+       filtered = requests.filter(req => req.isPrivate !== true);
+     }
+    
+     if (shouldSort) {
+       filtered = [...filtered].sort((a, b) => a.metaSortKey - b.metaSortKey);
+     }
+    
+     return filtered;
+   });
+ }
 
