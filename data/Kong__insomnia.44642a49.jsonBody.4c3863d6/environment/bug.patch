+const deepEqualWithOptions = (got: object, expected: object, options?: { partial?: boolean; ignoreKeys?: string[] }): boolean => {
+    const ignoreKeys = options?.ignoreKeys || [];
+    
+    const filterObject = (obj: any): any => {
+        if (obj === null || typeof obj !== 'object') {
+            return obj;
+        }
+        
+        if (Array.isArray(obj)) {
+            return obj.map(item => filterObject(item));
+        }
+        
+        const filtered: any = {};
+        for (const key in obj) {
+            if (obj.hasOwnProperty(key) && !ignoreKeys.includes(key)) {
+                filtered[key] = filterObject(obj[key]);
+            }
+        }
+        return filtered;
+    };
+    
+    const filteredGot = filterObject(got);
+    const filteredExpected = filterObject(expected);
+    
+    if (options?.partial) {
+        const checkPartialMatch = (actual: any, exp: any): boolean => {
+            if (exp === null || typeof exp !== 'object') {
+                return deepEqual(actual, exp, { strict: true });
+            }
+            
+            if (Array.isArray(exp)) {
+                if (!Array.isArray(actual) || actual.length < exp.length) {
+                    return false;
