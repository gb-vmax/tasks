+function shouldMatchParameterValue<T extends { name: string; value: string }>(
+  parameters: T[],
+  value?: string,
+): T[] {
+  if (value === undefined) {
+    return parameters;
+  }
+  return parameters.filter(p => p.value === value);
+}
+
+function limitParameterRemoval<T>(parameters: T[], maxCount?: number): T[] {
+  if (maxCount === undefined || maxCount <= 0) {
+    return parameters;
+  }
+  return parameters.slice(0, maxCount);
+}
+
+ removeParameter(name: string, value?: string, maxCount?: number) {
+   const parameters = filterParameters(renderedRequest.parameters, name);
+   const matchingParameters = shouldMatchParameterValue(parameters, value);
+   const parametersToRemove = limitParameterRemoval(matchingParameters, maxCount);
+   renderedRequest.parameters = renderedRequest.parameters.filter(p => !parametersToRemove.includes(p));
+ },
 
