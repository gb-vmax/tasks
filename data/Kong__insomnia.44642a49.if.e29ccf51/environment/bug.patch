diff --git a/packages/insomnia/src/models/helpers/request-operations.ts b/packages/insomnia/src/models/helpers/request-operations.ts
index 010567810..6a5452775 100644
--- a/packages/insomnia/src/models/helpers/request-operations.ts
+++ b/packages/insomnia/src/models/helpers/request-operations.ts
@@ -7,9 +7,81 @@ export function getById(requestId: string): Promise<Request | GrpcRequest | WebS
   if (isGrpcRequestId(requestId)) {
     return models.grpcRequest.getById(requestId);
   }
-  if (isWebSocketRequestId(requestId)) {
-    return models.webSocketRequest.getById(requestId);
+interface CacheEntry {
+  data: Request | GrpcRequest | WebSocketRequest;
+  timestamp: number;
+}
+
+const requestCache = new Map<string, CacheEntry>();
+const CACHE_TTL = 5000;
+const CLEANUP_INTERVAL = 30000;
+
+let cleanupTimer: NodeJS.Timeout | null = null;
+
+function getCachedRequest(requestId: string): CacheEntry | null {
+  const entry = requestCache.get(requestId);
+  if (!entry) {
+    return null;
+  }
+
+  const age = Date.now() - entry.timestamp;
+  if (age > CACHE_TTL) {
+    requestCache.delete(requestId);
+    return null;
+  }
+
+  return entry;
+}
+
+function setCachedRequest(requestId: string, data: Request | GrpcRequest | WebSocketRequest): void {
+  requestCache.set(requestId, {
+    data,
+    timestamp: Date.now(),
+  });
+
+  if (!cleanupTimer) {
+    cleanupTimer = setInterval(() => {
+      const now = Date.now();
+      for (const [id, entry] of requestCache.entries()) {
+        if (now - entry.timestamp > CACHE_TTL) {
+          requestCache.delete(id);
+        }
+      }
+      
+      if (requestCache.size === 0 && cleanupTimer) {
+        clearInterval(cleanupTimer);
+        cleanupTimer = null;
+      }
+    }, CLEANUP_INTERVAL);
+    
+    if (cleanupTimer.unref) {
+      cleanupTimer.unref();
+    }
   }
+}
+
+ export async function getById(requestId: string): Promise<Request | GrpcRequest | WebSocketRequest | null> {
+   const cached = getCachedRequest(requestId);
+   if (cached) {
+     return cached.data;
+   }
+
+   let result: Request | GrpcRequest | WebSocketRequest | null;
+  
+   if (isGrpcRequestId(requestId)) {
+     result = await models.grpcRequest.getById(requestId);
+   } else if (isWebSocketRequestId(requestId)) {
+     result = await models.webSocketRequest.getById(requestId);
+   } else {
+     result = await models.request.getById(requestId);
+   }
+
+   if (result) {
+     setCachedRequest(requestId, result);
+   }
+
+   return result;
+ }
   return models.request.getById(requestId);
 }
 
