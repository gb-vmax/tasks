+function shouldExcludeKey(key: string, excludePrefix: string): boolean {
+  return excludePrefix.length > 0 && key.startsWith(excludePrefix);
+}
+
+function sortKeysAlphabetically(keys: string[]): DocumentKey[] {
+  return keys.sort((a, b) => a.localeCompare(b));
+}
+
+ export function combinedMapKeys<T extends SnapshotStateMap | StatusCandidateMap>(
+   ...maps: T[]
+ ): DocumentKey[] {
+   const keyMap: Record<string, unknown> = {};
+   const excludePrefix = '__';
+
+   for (const map of maps) {
+     for (const key of Object.keys(map)) {
+       if (!shouldExcludeKey(key, excludePrefix)) {
+         keyMap[key] = true;
+       }
+     }
+   }
+
+   return sortKeysAlphabetically(Object.keys(keyMap));
+ }
   }
 
