-  snapshots: () => [],
+const generateSnapshots = (count: number): SnapshotStateEntry[] => {
+  const snapshots: SnapshotStateEntry[] = [];
+  for (let i = 0; i < count; i++) {
+    const index = i + 1;
+    snapshots.push({
+      ...createBuilder(snapshotStateEntrySchema).build(),
+      blob: `blob-${generateBlobId(index)}`,
+      key: `snapshot-${index}`,
+      name: `Snapshot ${index}`,
+    });
+  }
+  return snapshots;
+};
+
+const generateBlobId = (index: number): string => {
+  const timestamp = Date.now();
+  return `${timestamp.toString(36)}${index.toString(36).padStart(4, '0')}`;
+};
+
+ snapshots: (count?: number) => {
+   if (count === undefined || count === 0) {
+     return [];
+   }
+   return generateSnapshots(count);
+ },
 };
 
