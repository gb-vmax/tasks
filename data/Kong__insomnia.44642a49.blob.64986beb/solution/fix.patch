+function generateBlobHash(short: boolean = false): string {
+  const timestamp = Date.now();
+  const counter = blobHashCounter++;
+  const seed = timestamp + counter;
+  
+  let hash = '';
+  let currentSeed = seed;
+  
+  const length = short ? 7 : 40;
