+  for (let i = 0; i < length; i++) {
+    currentSeed = (currentSeed * 1103515245 + 12345) & 0x7fffffff;
+    const index = currentSeed % HASH_CHARS.length;
+    hash += HASH_CHARS[index];
+  }
+  
+  return hash;
+}
