+function sortAndFilterRequests(requests: Request[], options?: { includePrivate?: boolean; sortBy?: 'metaSortKey' | 'name' }): Request[] {
+  const includePrivate = options?.includePrivate !== false;
+  const sortBy = options?.sortBy || 'metaSortKey';
+  
+  let filtered = requests;
+  
+  if (!includePrivate) {
+    filtered = requests.filter(req => !req.isPrivate);
+  }
+  
+  return filtered.sort((a, b) => {
+    if (sortBy === 'name') {
+      return a.name.localeCompare(b.name);
+    }
+    return a.metaSortKey - b.metaSortKey;
+  });
 }
 
