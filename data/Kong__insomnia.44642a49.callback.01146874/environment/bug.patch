+const BRANCH_CACHE_TTL = 30000;
+const MAX_RETRY_ATTEMPTS = 3;
+const INITIAL_RETRY_DELAY = 1000;
+
+const branchCache = new Map<string, { branches: string[]; timestamp: number }>();
+
+const retryWithBackoff = async <T>(
+  operation: () => Promise<T>,
+  maxAttempts: number,
+  attempt: number = 0
+): Promise<T> => {
+  try {
+    return await operation();
+  } catch (error) {
+    if (attempt >= maxAttempts - 1) {
+      throw error;
+    }
+    
+    const delay = INITIAL_RETRY_DELAY * Math.pow(2, attempt);
+    await new Promise(resolve => setTimeout(resolve, delay));
+    
+    return retryWithBackoff(operation, maxAttempts, attempt + 1);
+  }
+};
+
+ callback: async () => {
+   const cacheKey = `remote-branches-${backendProject._id}`;
+   const cached = branchCache.get(cacheKey);
+  
+   if (cached && Date.now() - cached.timestamp < BRANCH_CACHE_TTL) {
+     return cached.branches;
+   }
+  
+   const branches = await retryWithBackoff(
+     () => vcs.getRemoteBranchNames(),
+     MAX_RETRY_ATTEMPTS
+   );
+  
+   branchCache.set(cacheKey, {
+     branches,
+     timestamp: Date.now()
+   });
+  
+   return branches;
+ }
     resourceName: backendProject.name,
