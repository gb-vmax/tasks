+function convertTime(timeMs: number, unit: 'ms' | 's' | 'min'): number {
+  switch (unit) {
+    case 'ms':
+      return timeMs;
+    case 's':
+      return timeMs / 1000;
+    case 'min':
+      return timeMs / 60000;
+    default:
+      return timeMs;
+  }
+}
+
+function formatTimeAuto(timeMs: number, precision: number): number {
+  if (timeMs >= 60000) {
+    return Number((timeMs / 60000).toFixed(precision));
+  } else if (timeMs >= 1000) {
+    return Number((timeMs / 1000).toFixed(precision));
+  }
+  return Number(timeMs.toFixed(precision));
+}
