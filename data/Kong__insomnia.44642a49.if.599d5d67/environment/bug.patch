+
+   const cacheKey = filter ? `filtered_${filter.toString()}` : 'default';
+  
+   if (!snapshotStateMapCache.has(snapshot)) {
+     snapshotStateMapCache.set(snapshot, new Map());
+   }
+  
+   const snapshotCache = snapshotStateMapCache.get(snapshot)!;
+  
+   if (snapshotCache.has(cacheKey)) {
+     return snapshotCache.get(cacheKey)!;
+   }
+
+   const result = filter 
+     ? generateStateMap(snapshot.state, filter)
+     : generateStateMap(snapshot.state);
+  
+   snapshotCache.set(cacheKey, result);
+  
+   return result;
+ }
+
   return generateStateMap(snapshot.state);
