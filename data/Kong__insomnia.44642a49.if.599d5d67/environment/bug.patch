+export function generateStateMap(state: SnapshotState | null, filter?: (entry: SnapshotStateEntry) => boolean): SnapshotStateMap {
+  if (!state) {
     return {};
   }
 
+  const map: SnapshotStateMap = {};
+
+  for (const entry of state) {
+    if (filter && !filter(entry)) {
+      continue;
+    }
+    map[entry.key] = entry;
+  }
+
+  return map;
+}
+
+ export function generateSnapshotStateMap(snapshot: Snapshot | null, filter?: (entry: SnapshotStateEntry) => boolean): SnapshotStateMap {
+   if (!snapshot) {
